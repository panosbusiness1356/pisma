---
// Demo εργαλείου «Google Reviews στο Αυτόματο» — εικονικό κομμωτήριο «Salon Mirella».
// Αυτόνομη σελίδα (δεν χρησιμοποιεί το Base layout): προσομοιώνει αυτό που
// βλέπει ο πελάτης του μαγαζιού όταν σκανάρει το QR στον καθρέφτη/ρεσεψιόν.
const title = 'Salon Mirella · Κερδίστε το δώρο σας!';
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <style>
    :root {
      --cream: #fdf1f5;
      --crust: #f6dbe6;
      --tomato: #c2266b;
      --tomato-dark: #971c52;
      --basil: #8e5aa8;
      --ink: #33202b;
      --soft: #93707f;
      --gold: #d9a05a;
      --card: #ffffff;
      --radius: 20px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      background: var(--cream);
      color: var(--ink);
      display: flex;
      justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }
    .phone {
      width: 100%;
      max-width: 430px;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      background:
        radial-gradient(circle at 85% -5%, rgba(217,160,90,.16), transparent 40%),
        radial-gradient(circle at 0% 100%, rgba(142,90,168,.10), transparent 45%),
        var(--cream);
      position: relative;
      overflow: hidden;
    }

    /* ---------- Στάδια ---------- */
    .stage {
      display: none;
      flex: 1;
      flex-direction: column;
      align-items: center;
      padding: 28px 22px 118px;
      animation: fadeUp .45s ease both;
      position: relative;
      z-index: 1;
    }
    .stage.active { display: flex; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: none; }
    }

    .brand {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      margin-bottom: 8px;
    }
    .brand .logo { font-size: 44px; line-height: 1; }
    .brand .name {
      font-size: 26px; font-weight: 800; letter-spacing: .5px;
      color: var(--tomato);
      font-family: Georgia, 'Times New Roman', serif;
    }
    .brand .tag { font-size: 12px; color: var(--soft); letter-spacing: 2.5px; text-transform: uppercase; }

    h1, h2 { font-size: 28px; text-align: center; line-height: 1.2; margin-top: 18px; }
    h1 .accent, h2 .accent { color: var(--tomato); }
    /* Link επιστροφής — φαίνεται μόνο όταν η σελίδα ΔΕΝ είναι μέσα στο iframe των Κριτικών */
    .back-site { position: fixed; top: 10px; left: 12px; z-index: 50; font-size: 13px; font-weight: 600;
      color: #fff; background: rgba(0,0,0,.45); padding: 4px 11px; border-radius: 999px; text-decoration: none; }
    .back-site:hover { background: rgba(0,0,0,.65); }
    .sub { text-align: center; color: var(--soft); font-size: 15.5px; line-height: 1.5; margin-top: 10px; max-width: 300px; }

    .btn {
      appearance: none; border: 0; cursor: pointer;
      font: inherit; font-weight: 700; font-size: 17px;
      color: #fff; background: var(--tomato);
      padding: 15px 34px; border-radius: 999px;
      box-shadow: 0 6px 18px rgba(194,38,107,.35);
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }
    .btn:active { transform: scale(.96); }
    .btn.secondary {
      background: transparent; color: var(--soft);
      box-shadow: none; font-weight: 600; font-size: 14px;
    }
    .btn[disabled] { opacity: .45; pointer-events: none; }

    .steps {
      display: flex; gap: 8px; margin-top: 26px;
    }
    .steps .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: rgba(51,32,43,.15);
    }
    .steps .dot.on { background: var(--tomato); }

    /* ---------- Στάδιο 1: Καλωσόρισμα ---------- */
    #s-intro .hero-gift { width: 110px; margin-top: 26px; animation: bob 2.4s ease-in-out infinite; }
    #s-intro .hero-gift svg { width: 100%; height: auto; filter: drop-shadow(0 8px 16px rgba(51,32,43,.18)); }
    @keyframes bob { 50% { transform: translateY(-8px) rotate(-4deg); } }
    #s-intro .btn { margin-top: 30px; }
    .mark {
      font-weight: 800; color: var(--ink); font-style: normal;
      background: linear-gradient(transparent 62%, rgba(217,160,90,.5) 62%);
      padding: 0 2px;
    }

    /* ---------- Στάδιο 2: Τροχός ---------- */
    .wheel-wrap { position: relative; width: 300px; height: 300px; margin-top: 42px; }
    .wheel {
      width: 100%; height: 100%;
      transition: transform 4.6s cubic-bezier(.12,.78,.16,1);
      filter: drop-shadow(0 10px 22px rgba(51,32,43,.22));
    }
    .pointer {
      position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
      width: 0; height: 0; z-index: 3;
      border-left: 14px solid transparent;
      border-right: 14px solid transparent;
      border-top: 24px solid var(--ink);
      filter: drop-shadow(0 2px 3px rgba(0,0,0,.25));
    }
    .hub {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
      width: 64px; height: 64px; border-radius: 50%;
      background: #fff; border: 4px solid var(--gold);
      display: flex; align-items: center; justify-content: center;
      font-size: 28px; z-index: 2;
      box-shadow: 0 4px 12px rgba(51,32,43,.25);
    }
    #spinBtn { margin-top: 30px; }

    /* ---------- Στάδιο 3: Κέρδος + κριτική ---------- */
    @keyframes pop { from { transform: scale(.7); opacity: 0; } }
    .serve-scene { position: relative; width: 100%; height: 178px; margin-top: 30px; }
    .serve-gino {
      position: absolute; left: 14px; bottom: 0; width: 118px;
      animation: wBob 2.4s ease-in-out infinite;
    }
    .serve-gino svg { width: 100%; height: auto; display: block; transform: scaleX(-1); }
    .h-armR { transform-box: view-box; transform-origin: 80px 58px; animation: wSway 3s ease-in-out infinite; }
    .h-mou { transform-box: view-box; transform-origin: 65px 14px; animation: wWiggle 3.6s infinite; }
    .served-gift {
      position: absolute; left: 50%; bottom: 0; width: 132px;
      filter: drop-shadow(0 12px 20px rgba(51,32,43,.25));
      animation: serveGift 1.1s cubic-bezier(.3,1.25,.45,1) .4s both;
    }
    .served-gift svg { width: 100%; height: auto; display: block; }
    .served-lock { position: absolute; top: 34px; right: 16px; font-size: 27px; filter: drop-shadow(0 2px 3px rgba(0,0,0,.25)); }
    @keyframes serveGift {
      from { transform: translate(calc(-50% - 86px), -64px) scale(.3); opacity: .3; }
      70%  { transform: translate(calc(-50% + 7px), 5px) scale(1.05); opacity: 1; }
      to   { transform: translate(-50%, 0) scale(1); opacity: 1; }
    }
    #reviewBtn {
      position: relative; overflow: hidden;
      width: 100%; margin-top: 30px;
      display: flex; align-items: center; justify-content: center; gap: 11px;
      font-size: 18.5px; padding: 16px 14px;
      background: linear-gradient(135deg, #e2508f, var(--tomato) 55%, var(--tomato-dark));
      animation: pulseGlow 2.2s ease-in-out infinite;
    }
    @keyframes pulseGlow {
      0%, 100% {
        transform: scale(1);
        box-shadow: 0 6px 18px rgba(194,38,107,.35), 0 0 0 0 rgba(194,38,107,.5);
      }
      50% {
        transform: scale(1.035);
        box-shadow: 0 10px 28px rgba(194,38,107,.5), 0 0 0 14px rgba(194,38,107,0);
      }
    }
    #reviewBtn::after {
      content: ''; position: absolute; top: 0; left: -80%;
      width: 45%; height: 100%; transform: skewX(-20deg);
      background: linear-gradient(105deg, transparent, rgba(255,255,255,.5), transparent);
      animation: shine 2.6s ease-in-out infinite;
    }
    @keyframes shine {
      0% { left: -80%; }
      45%, 100% { left: 130%; }
    }
    .g-badge {
      flex: 0 0 auto; width: 34px; height: 34px; border-radius: 50%;
      background: #fff; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 6px rgba(0,0,0,.2);
    }
    .g-badge svg { width: 19px; height: 19px; display: block; }

    /* ---------- Mock φύλλο κριτικής ---------- */
    .sheet-veil {
      position: absolute; inset: 0; background: rgba(30,16,24,.45);
      display: none; align-items: flex-end; z-index: 10;
      animation: fadeUp .25s ease both;
    }
    .sheet-veil.open { display: flex; }
    .sheet {
      background: #fff; width: 100%; border-radius: 22px 22px 0 0;
      padding: 20px 22px 30px;
      animation: slideUp .3s ease both;
    }
    @keyframes slideUp { from { transform: translateY(100%); } }
    .sheet .demo-note {
      font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px;
      color: var(--soft); text-align: center; margin-bottom: 12px;
    }
    .sheet .place { font-weight: 700; font-size: 17px; }
    .sheet .place small { display: block; font-weight: 400; color: var(--soft); font-size: 12.5px; margin-top: 2px; }
    .rate-stars { display: flex; gap: 10px; justify-content: center; margin: 18px 0 6px; }
    .rate-stars button {
      appearance: none; border: 0; background: none; cursor: pointer;
      font-size: 38px; color: #ddd0d6; transition: transform .1s ease, color .1s ease;
      line-height: 1;
    }
    .rate-stars button.lit { color: var(--gold); }
    .rate-stars button:active { transform: scale(1.2); }
    .sheet textarea {
      width: 100%; border: 1px solid #e8dae1; border-radius: 12px;
      padding: 12px; font: inherit; font-size: 14.5px; resize: none; height: 76px;
      margin-top: 10px; color: var(--ink); background: #faf5f8;
    }
    .sheet textarea:focus { outline: 2px solid rgba(66,133,244,.4); }
    .sheet .publish {
      margin-top: 14px; width: 100%;
      background: #1a73e8; box-shadow: 0 6px 16px rgba(26,115,232,.3);
    }

    /* ---------- Στάδιο 4: Κουπόνι ---------- */
    .coupon {
      margin-top: 24px; width: 100%;
      background: var(--card); border-radius: var(--radius);
      box-shadow: 0 10px 30px rgba(51,32,43,.14);
      overflow: hidden;
      animation: pop .5s cubic-bezier(.3,1.6,.5,1) both;
    }
    .coupon .top {
      background: linear-gradient(135deg, var(--tomato), var(--tomato-dark));
      color: #fff; padding: 20px; text-align: center;
    }
    .coupon .top .c-emoji { font-size: 40px; }
    .coupon .top .c-name { font-size: 21px; font-weight: 800; margin-top: 4px; }
    .coupon .divider {
      position: relative; border-top: 2px dashed #ecd3de; margin: 0 14px;
    }
    .coupon .divider::before, .coupon .divider::after {
      content: ''; position: absolute; top: -11px; width: 22px; height: 22px;
      border-radius: 50%; background: var(--cream);
    }
    .coupon .divider::before { left: -25px; }
    .coupon .divider::after { right: -25px; }
    .coupon .bottom { padding: 18px 20px 22px; text-align: center; }
    .coupon .code {
      font-family: ui-monospace, 'SF Mono', Menlo, monospace;
      font-size: 26px; font-weight: 700; letter-spacing: 3px;
      background: var(--crust); border-radius: 12px; padding: 12px;
    }
    .coupon .hint { font-size: 13.5px; color: var(--soft); margin-top: 12px; line-height: 1.5; }
    .coupon .expiry { font-size: 12px; color: var(--soft); margin-top: 8px; }

    .skip-link {
      appearance: none; border: 0; background: none; cursor: pointer;
      position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
      padding: 10px;
      font: inherit; font-size: 11.5px; color: var(--soft); letter-spacing: .5px;
      text-decoration: underline; text-underline-offset: 3px;
    }
    .skip-link:active { opacity: .7; }
    .powered {
      position: absolute; bottom: 8px; left: 0; right: 0;
      font-size: 11.5px; color: var(--soft); text-align: center; letter-spacing: .5px;
    }
    .powered b { color: var(--ink); }

    /* ---------- Ροζ-χρυσή πινελιά ---------- */
    .phone::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
      background: linear-gradient(90deg, var(--tomato), var(--gold) 50%, var(--basil));
      z-index: 30;
    }

    /* ---------- Η Μιρέλλα, η κομμώτρια-μασκότ ---------- */
    .waiter {
      position: absolute; bottom: 40px; right: 4px; width: 124px; height: 172px;
      z-index: 4; pointer-events: none;
    }
    @keyframes walkIn { from { transform: translateX(150px); } }
    .waiter svg {
      width: 100%; height: 100%; overflow: visible;
      animation: walkIn 1.7s ease-out both;
    }
    #wAll { animation: wBob 2.4s ease-in-out infinite; transform-box: view-box; }
    @keyframes wBob { 50% { transform: translateY(2.5px); } }
    #wArmR {
      transform-box: view-box; transform-origin: 80px 58px;
      animation: wSway 3s ease-in-out infinite;
    }
    @keyframes wSway { 50% { transform: rotate(8deg); } }
    #wMoustache { transform-box: view-box; transform-origin: 65px 14px; animation: wWiggle 3.6s infinite; }
    @keyframes wWiggle {
      0%, 84%, 100% { transform: none; }
      88% { transform: rotate(3.5deg); }
      92% { transform: rotate(-3.5deg); }
      96% { transform: rotate(2deg); }
    }
    #wPizzaGrp {
      transform-box: view-box; transform-origin: 31px 46px;
      animation: wBalance 2.8s ease-in-out infinite;
    }
    @keyframes wBalance { 50% { transform: rotate(4deg) translateY(1.5px); } }
    #wLegL, #wLegR { transform-box: view-box; }
    #wLegL { transform-origin: 59px 128px; }
    #wLegR { transform-origin: 71px 128px; }
    .waiter.walk #wLegL { animation: stepA .42s linear infinite; }
    .waiter.walk #wLegR { animation: stepB .42s linear infinite; }
    @keyframes stepA { 0%, 100% { transform: rotate(16deg); } 50% { transform: rotate(-16deg); } }
    @keyframes stepB { 0%, 100% { transform: rotate(-16deg); } 50% { transform: rotate(16deg); } }
    .waiter.cheer { animation: wJump .55s ease-in-out infinite; }
    @keyframes wJump { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-14px); } }
    .waiter.cheer #wArmR { animation: wWave .3s ease-in-out infinite alternate; }
    @keyframes wWave { from { transform: rotate(-115deg); } to { transform: rotate(-150deg); } }
    .steam { opacity: 0; animation: rise 2.2s ease-in-out infinite; }
    .steam.s2 { animation-delay: .7s; }
    .steam.s3 { animation-delay: 1.4s; }
    @keyframes rise {
      0% { opacity: 0; transform: translate(2px, 0); }
      35% { opacity: .6; }
      100% { opacity: 0; transform: translate(-7px, -4px); }
    }
    /* Έντονες «δραστηριότητες» της Μιρέλλας (χωρίς λόγια) */
    .waiter.patrol { animation: patrol 5.2s ease-in-out both; }
    @keyframes patrol {
      0% { transform: translateX(0); }
      42% { transform: translateX(-235px); }
      56% { transform: translateX(-235px); }
      100% { transform: translateX(0); }
    }
    .waiter.patrol #wLegL { animation: stepA .42s linear infinite; }
    .waiter.patrol #wLegR { animation: stepB .42s linear infinite; }
    .waiter.toss #wPizzaGrp { animation: pizzaToss .95s cubic-bezier(.3,1.4,.5,1); }
    @keyframes pizzaToss {
      0%, 100% { transform: none; }
      35% { transform: translateY(-17px) rotate(-14deg); }
      62% { transform: translateY(2px) rotate(5deg); }
    }
    .waiter.twirl { animation: twirl 1.1s ease-in-out both; }
    @keyframes twirl {
      0%, 100% { transform: none; }
      30% { transform: translateY(-10px) rotate(-7deg); }
      60% { transform: translateY(-4px) rotate(6deg); }
    }

    /* ---------- Κομφετί ---------- */
    .confetti {
      position: absolute; top: -12px; width: 9px; height: 14px;
      z-index: 5; pointer-events: none;
      animation: fall linear both;
    }
    @keyframes fall {
      to { transform: translateY(110dvh) rotate(720deg); opacity: .2; }
    }
  </style>
</head>
<body>
  <a class="back-site" id="backSite" href="/kritikes/" hidden>← pisma.gr</a>
  <div class="phone" id="phone">

    <!-- Στάδιο 1 · Καλωσόρισμα (μετά το σκανάρισμα του QR) -->
    <section class="stage active" id="s-intro">
      <div class="brand">
        <div class="logo">💇‍♀️</div>
        <div class="name">Salon Mirella</div>
        <div class="tag">Hair Studio · Est. 2012</div>
      </div>
      <div class="hero-gift" aria-hidden="true">
        <svg viewBox="0 0 120 110">
          <rect x="22" y="46" width="76" height="54" rx="8" fill="#c2266b"/>
          <rect x="14" y="33" width="92" height="19" rx="6" fill="#971c52"/>
          <rect x="52" y="33" width="16" height="67" fill="#d9a05a"/>
          <path d="M60 31 C 44 8, 22 20, 41 33 Q52 38 60 31" fill="#d9a05a"/>
          <path d="M60 31 C 76 8, 98 20, 79 33 Q68 38 60 31" fill="#d9a05a"/>
          <circle cx="60" cy="32" r="7" fill="#b9853f"/>
          <rect x="28" y="54" width="10" height="40" rx="5" fill="#fff" opacity=".18"/>
        </svg>
      </div>
      <h1>Κερδίστε <span class="accent">δώρο</span></h1>
      <button class="btn" data-next="s-wheel">Παίξτε τώρα</button>
      <div class="steps"><i class="dot on"></i><i class="dot"></i><i class="dot"></i><i class="dot"></i></div>
      <div class="powered">Εργαλείο κριτικών από <b>PISMA</b> · σελίδα επίδειξης</div>
    </section>

    <!-- Στάδιο 2 · Τροχός -->
    <section class="stage" id="s-wheel">
      <div class="brand">
        <div class="logo">💇‍♀️</div>
        <div class="name">Salon Mirella</div>
      </div>
      <div class="wheel-wrap">
        <div class="pointer"></div>
        <svg class="wheel" id="wheelSvg" viewBox="0 0 200 200"></svg>
        <div class="hub">✂️</div>
      </div>
      <button class="btn" id="spinBtn">Γυρίστε τον</button>
      <div class="steps"><i class="dot"></i><i class="dot on"></i><i class="dot"></i><i class="dot"></i></div>
      <div class="powered">Εργαλείο κριτικών από <b>PISMA</b> · σελίδα επίδειξης</div>
    </section>

    <!-- Στάδιο 3 · Κέρδος + αίτημα κριτικής -->
    <section class="stage" id="s-review">
      <div class="brand">
        <div class="logo">💇‍♀️</div>
        <div class="name">Salon Mirella</div>
      </div>
      <h2>Κάντε κριτική για να ξεκλειδώσετε <span class="accent">το δώρο σας</span></h2>
      <!-- Η Μιρέλλα σερβίρει το κλειδωμένο δώρο μπροστά -->
      <div class="serve-scene" aria-hidden="true">
        <div class="serve-gino"><svg viewBox="0 0 130 175">
          <g><rect x="56" y="126" width="6.5" height="32" rx="3.2" fill="#f2c299"/><ellipse cx="57.5" cy="160" rx="7" ry="3.2" fill="#33202b"/></g>
          <g><rect x="67.5" y="126" width="6.5" height="32" rx="3.2" fill="#f2c299"/><ellipse cx="72.5" cy="160" rx="7" ry="3.2" fill="#33202b"/></g>
          <path d="M52 52 Q65 47.5 78 52 L81 86 Q86 120 79 127 L51 127 Q44 120 49 86 Z" fill="#3c2033"/>
          <path d="M58 51.5 L65 61 L72 51.5 Q65 48.5 58 51.5 Z" fill="#fbe3ec"/>
          <path d="M60 54 Q65 58.5 70 54" stroke="#d9a05a" stroke-width="1.2" fill="none"/>
          <circle cx="65" cy="58.5" r="1.6" fill="#d9a05a"/>
          <rect x="49.5" y="85" width="31" height="5" rx="2.5" fill="#d9a05a"/>
          <path d="M52 122.5 L78 122.5" stroke="#c2266b" stroke-width="1.5" opacity=".65"/>
          <rect x="74.5" y="79" width="3.6" height="12" rx="1.5" fill="#8e5aa8"/>
          <path d="M75.4 81.5 h1.8 M75.4 84 h1.8 M75.4 86.5 h1.8" stroke="#6d3f87" stroke-width=".8"/>
          <path d="M70.5 84 L69 78.5" stroke="#9a9aa0" stroke-width="1.3" stroke-linecap="round"/>
          <circle cx="68.6" cy="77" r="1.5" fill="none" stroke="#d9a05a" stroke-width="1.2"/>
          <rect x="66" y="87.5" width="15.5" height="14" rx="3" fill="#971c52"/>
          <g class="h-armR">
            <path d="M79 56 Q96 64 101 81" fill="none" stroke="#f2c299" stroke-width="7" stroke-linecap="round"/>
            <g transform="rotate(24 101 86)"><rect x="99.2" y="82" width="3.6" height="15" rx="1.5" fill="#8e5aa8"/><path d="M100.1 86 h1.8 M100.1 89 h1.8 M100.1 92 h1.8 M100.1 95 h1.8" stroke="#6d3f87" stroke-width=".8"/></g>
            <circle cx="101" cy="83" r="4.5" fill="#f2c299"/>
          </g>
          <g>
            <circle cx="65" cy="30" r="15.5" fill="#f2c299"/>
            <g class="h-mou">
              <circle cx="65" cy="9" r="8.5" fill="#5a3825"/>
              <path d="M59 5 Q65 2 71 5" stroke="#7a5136" stroke-width="1.4" fill="none" stroke-linecap="round"/>
              <ellipse cx="65" cy="16.5" rx="6.5" ry="2.6" fill="#d9a05a"/>
            </g>
            <path d="M49.5 28 Q48 11 65 11 Q82 11 80.5 28 Q79 16 68 15.5 Q59.5 15 54.5 19.5 Q50.5 23 49.5 28 Z" fill="#5a3825"/>
            <path d="M49.5 26 Q47.5 38 51 42 Q54 34 52.5 26 Z" fill="#5a3825"/>
            <path d="M80.5 26 Q82.5 38 79 42 Q76 34 77.5 26 Z" fill="#5a3825"/>
