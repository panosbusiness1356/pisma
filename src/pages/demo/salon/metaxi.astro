---
// Demo portfolio — εικονικό κομμωτήριο «ΜΕΤΑΞΙ hair atelier», εκδοχή 2.
// Μίνιμαλ & αέρινο: απαλές κινήσεις (Lenis + scroll reveals),
// «Δοκιμαστήριο» με φωτογραφία πελάτη (αλλαγή χρώματος μαλλιών με
// on-device segmentation + σιλουέτες κουρέματος), και κράτηση-πρόταση
// που συμπληρώνεται λέξη-λέξη. Όλα mock/τοπικά — κανένα backend.
const title = 'ΜΕΤΑΞΙ · hair atelier';
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Commissioner:wght@200;300;400;500&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --bone: #faf7f4;
      --bone-2: #f4efea;
      --ink: #221d1b;
      --soft: #8b7f78;
      --accent: #a98070;
      --hair: #eae3dc;
      --didot: 'GFS Didot', 'Didot', serif;
      --sans: 'Commissioner', 'Helvetica Neue', sans-serif;
      --ease: cubic-bezier(.22, .8, .25, 1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html.lenis, html.lenis body { height: auto; }
    .lenis.lenis-smooth { scroll-behavior: auto !important; }
    body {
      font-family: var(--sans);
      font-weight: 300;
      background: var(--bone);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    ::selection { background: var(--accent); color: #fff; }
    a { color: inherit; }
    button { font-family: inherit; cursor: pointer; }
    button:focus-visible, a:focus-visible, input:focus-visible, label:focus-within {
      outline: 1.5px solid var(--accent); outline-offset: 4px; border-radius: 2px;
    }

    /* ---------- αέρινα reveals ---------- */
    .rv { opacity: 0; transform: translateY(28px); transition: opacity 1.1s ease var(--d, 0s), transform 1.1s var(--ease) var(--d, 0s); }
    .rv.in { opacity: 1; transform: none; }

    /* ---------- nav ---------- */
    nav {
      position: fixed; inset: 0 0 auto 0; z-index: 50;
      display: flex; justify-content: space-between; align-items: center;
      padding: 22px 6vw;
      background: color-mix(in srgb, var(--bone) 78%, transparent);
      backdrop-filter: blur(16px);
    }
    .brand { font-family: var(--didot); font-size: 21px; letter-spacing: .34em; }
    .nav-links { display: flex; gap: 34px; align-items: center; }
    .nav-links a, .nav-links button {
      font-size: 13px; letter-spacing: .12em; color: var(--soft);
      text-decoration: none; background: none; border: none; text-transform: uppercase;
      transition: color .4s;
    }
    .nav-links a:hover, .nav-links button:hover { color: var(--ink); }
    .nav-links .cta { color: var(--ink); border-bottom: 1px solid var(--accent); padding-bottom: 3px; }

    /* ---------- hero ---------- */
    header {
      min-height: 100svh;
      display: grid; place-items: center; text-align: center;
      position: relative; padding: 120px 6vw 80px;
      overflow: hidden;
    }
    .blob {
      position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none;
      opacity: .5;
    }
    .blob.a { width: 46vw; height: 46vw; left: -12vw; top: 4vh; background: radial-gradient(circle, #efdfd5, transparent 65%); animation: drift 22s ease-in-out infinite alternate; }
    .blob.b { width: 38vw; height: 38vw; right: -10vw; bottom: -6vh; background: radial-gradient(circle, #e7d6cf, transparent 65%); animation: drift 26s ease-in-out -8s infinite alternate-reverse; }
    @keyframes drift { from { transform: translate(0, 0) scale(1); } to { transform: translate(6vw, -5vh) scale(1.12); } }
    .hero-inner { position: relative; max-width: 880px; }
    .kicker {
      font-size: 12px; letter-spacing: .5em; text-transform: uppercase; color: var(--soft);
      margin-bottom: 34px;
    }
    h1 {
      font-family: var(--didot); font-weight: 400;
      font-size: clamp(44px, 7vw, 96px);
      line-height: 1.08; letter-spacing: .01em;
    }
    h1 em { font-style: italic; color: var(--accent); }
    .hero-sub {
      margin: 34px auto 0; max-width: 52ch;
      color: var(--soft); font-size: 16.5px; line-height: 1.8;
    }
    .hero-actions { margin-top: 48px; display: flex; gap: 34px; justify-content: center; align-items: center; flex-wrap: wrap; }
    .btn {
      font: 400 13px/1 var(--sans); letter-spacing: .18em; text-transform: uppercase;
      background: var(--ink); color: var(--bone); border: none;
      padding: 18px 38px; border-radius: 999px;
      transition: background .5s, transform .5s var(--ease), box-shadow .5s;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 18px 34px -20px rgba(34,29,27,.5); }
    .btn.quiet { background: none; color: var(--ink); border: 1px solid var(--hair); }
    .btn.quiet:hover { border-color: var(--accent); box-shadow: none; }
    .btn:disabled { opacity: .35; cursor: not-allowed; transform: none; box-shadow: none; }
    .scroll-hint {
      position: absolute; bottom: 34px; left: 50%; transform: translateX(-50%);
      width: 1px; height: 56px; background: var(--hair); overflow: hidden;
    }
    .scroll-hint::after {
      content: ''; position: absolute; left: 0; top: -50%; width: 100%; height: 50%;
      background: var(--accent); animation: fall 2.6s var(--ease) infinite;
    }
    @keyframes fall { to { top: 110%; } }

    /* ---------- sections ---------- */
    section { padding: 130px 6vw; position: relative; }
    .measure { max-width: 1060px; margin: 0 auto; }
    .sec-label {
      font-size: 12px; letter-spacing: .5em; text-transform: uppercase; color: var(--accent);
      margin-bottom: 18px;
    }
    .sec-title { font-family: var(--didot); font-weight: 400; font-size: clamp(30px, 3.8vw, 50px); line-height: 1.15; }
    .sec-sub { margin-top: 16px; color: var(--soft); font-size: 15.5px; line-height: 1.75; max-width: 52ch; }

    /* υπηρεσίες: αραιή λίστα */
    .svc-list { margin-top: 64px; border-top: 1px solid var(--hair); }
    .svc-row {
      width: 100%; background: none; border: none; border-bottom: 1px solid var(--hair);
      display: grid; grid-template-columns: 1fr auto; gap: 4px 30px; align-items: baseline;
      text-align: left; color: var(--ink);
      padding: 30px 6px;
      transition: padding-left .5s var(--ease), background .5s;
    }
    .svc-row:hover { padding-left: 26px; background: color-mix(in srgb, var(--bone-2) 60%, transparent); }
    .svc-row .nm { font-family: var(--didot); font-size: clamp(20px, 2.2vw, 27px); }
    .svc-row .pr { font-size: 15px; color: var(--accent); letter-spacing: .06em; white-space: nowrap; }
    .svc-row .ds { grid-column: 1; color: var(--soft); font-size: 14px; line-height: 1.6; max-width: 62ch; }
    .svc-row .bk {
      grid-column: 2; grid-row: 2; font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
      color: var(--soft); opacity: 0; transform: translateX(-8px);
      transition: opacity .45s, transform .45s var(--ease);
    }
    .svc-row:hover .bk { opacity: 1; transform: none; color: var(--ink); }

    /* ---------- δοκιμαστήριο ---------- */
    .fit-wrap { margin-top: 70px; display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 60px; align-items: start; }
    .fit-stage {
      position: relative;
      border: 1px solid var(--hair);
      background: var(--bone-2);
      aspect-ratio: 3 / 4;
      max-width: 560px; margin: 0 auto; width: 100%;
      overflow: hidden;
    }
    .fit-stage canvas { width: 100%; height: 100%; display: block; touch-action: none; }
    .fit-empty {
      position: absolute; inset: 0; display: grid; place-items: center; text-align: center;
      padding: 30px; transition: opacity .6s;
    }
    .fit-empty.hide { opacity: 0; pointer-events: none; }
    .fit-empty .oval {
      width: 130px; height: 170px; border: 1px dashed var(--accent); border-radius: 50%;
      margin: 0 auto 26px; opacity: .6;
      animation: breathe 5s ease-in-out infinite;
    }
    @keyframes breathe { 50% { transform: scale(1.05); opacity: .9; } }
    .fit-empty p { color: var(--soft); font-size: 14.5px; line-height: 1.7; max-width: 30ch; margin: 0 auto; }
    .fit-hintbar {
      position: absolute; left: 0; right: 0; bottom: 0; padding: 12px 16px;
      font-size: 12px; letter-spacing: .08em; color: var(--soft); text-align: center;
      background: linear-gradient(transparent, color-mix(in srgb, var(--bone) 88%, transparent) 40%);
      opacity: 0; transition: opacity .6s;
    }
    .fit-hintbar.show { opacity: 1; }
    .fit-side h3 { font-size: 12px; letter-spacing: .34em; text-transform: uppercase; color: var(--soft); margin: 34px 0 16px; font-weight: 400; }
    .fit-side h3:first-child { margin-top: 0; }
    .upload-btn {
      display: inline-block; font-size: 13px; letter-spacing: .16em; text-transform: uppercase;
      border: 1px solid var(--ink); border-radius: 999px; padding: 15px 30px; cursor: pointer;
      transition: background .5s, color .5s;
    }
    .upload-btn:hover { background: var(--ink); color: var(--bone); }
    .privacy { margin-top: 12px; font-size: 12.5px; color: var(--soft); line-height: 1.6; }
    .chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip {
      font-size: 13px; letter-spacing: .04em; color: var(--ink);
      background: none; border: 1px solid var(--hair); border-radius: 999px;
      padding: 10px 18px;
      transition: border-color .4s, background .4s;
    }
    .chip:hover { border-color: var(--accent); }
    .chip.sel { background: var(--ink); color: var(--bone); border-color: var(--ink); }
    .shade-row { display: flex; flex-wrap: wrap; gap: 10px; }
    .shade {
      width: 34px; height: 34px; border-radius: 50%; border: none; cursor: pointer;
      background: var(--c); position: relative;
      transition: transform .35s var(--ease);
    }
    .shade:hover { transform: scale(1.15); }
    .shade.sel::after {
      content: ''; position: absolute; inset: -6px; border: 1px solid var(--accent); border-radius: 50%;
    }
    .shade[data-none] { background: var(--bone); border: 1px dashed var(--soft); }
    .slider-row { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
    .slider-row label { font-size: 13px; color: var(--soft); width: 70px; }
    .slider-row input[type=range] {
      flex: 1; appearance: none; height: 1px; background: var(--hair); outline-offset: 6px;
    }
    .slider-row input[type=range]::-webkit-slider-thumb {
      appearance: none; width: 16px; height: 16px; border-radius: 50%;
      background: var(--ink); border: 3px solid var(--bone); box-shadow: 0 0 0 1px var(--hair);
      cursor: grab;
    }
    .fit-status { font-size: 13px; color: var(--soft); line-height: 1.6; min-height: 20px; }
    .fit-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
    .text-btn {
      background: none; border: none; font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase;
      color: var(--soft); text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--hair);
      transition: color .4s;
    }
    .text-btn:hover { color: var(--ink); }
    .fit-note { margin-top: 26px; font-size: 12.5px; color: var(--soft); line-height: 1.7; border-top: 1px solid var(--hair); padding-top: 18px; }

    /* ---------- ομάδα ---------- */
    .team-list { margin-top: 60px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0; border-top: 1px solid var(--hair); }
    .team-row { padding: 34px 20px 38px; border-bottom: 1px solid var(--hair); }
    .team-row + .team-row { border-left: 1px solid var(--hair); }
    .team-row .ini { font-family: var(--didot); font-size: 40px; color: var(--accent); }
    .team-row h3 { font-size: 16px; font-weight: 400; letter-spacing: .06em; margin-top: 14px; }
    .team-row p { margin-top: 8px; font-size: 13.5px; color: var(--soft); line-height: 1.65; }

    /* ---------- κράτηση-πρόταση ---------- */
    .booking { background: var(--bone-2); }
    .sentence {
      margin-top: 70px;
      font-family: var(--didot); font-size: clamp(24px, 3.4vw, 44px); line-height: 1.9;
      max-width: 900px;
    }
    .blank {
      background: none; border: none; font: inherit; color: var(--accent);
      border-bottom: 1px solid var(--accent); padding: 0 6px 2px;
      transition: background .4s, color .4s;
      white-space: nowrap;
    }
    .blank:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
    .blank.empty { color: var(--soft); border-bottom: 1px dashed var(--soft); }
    .blank.active { background: color-mix(in srgb, var(--accent) 14%, transparent); }
    .panel-zone { margin-top: 50px; min-height: 150px; }
    .panel { display: none; }
    .panel.on { display: block; animation: rise .6s var(--ease) both; }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    .panel .p-label { font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--soft); margin-bottom: 20px; }
    .p-opts { display: flex; flex-wrap: wrap; gap: 10px; }
    .p-opt {
      background: var(--bone); border: 1px solid var(--hair); border-radius: 999px;
      padding: 14px 24px; font-size: 14.5px; color: var(--ink); text-align: left;
      transition: border-color .4s, transform .4s var(--ease), background .4s;
    }
    .p-opt:hover { border-color: var(--accent); transform: translateY(-2px); }
    .p-opt.sel { background: var(--ink); color: var(--bone); border-color: var(--ink); }
    .p-opt small { color: inherit; opacity: .55; margin-left: 8px; font-size: 12.5px; }
    .p-opt:disabled { opacity: .3; text-decoration: line-through; cursor: not-allowed; transform: none; }
    .details-zone {
      margin-top: 60px; display: none; gap: 16px; flex-wrap: wrap; align-items: flex-end;
    }
    .details-zone.on { display: flex; animation: rise .6s var(--ease) both; }
    .dfield { flex: 1; min-width: 220px; }
    .dfield label { display: block; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); margin-bottom: 10px; }
    .dfield input {
      width: 100%; background: none; border: none; border-bottom: 1px solid var(--hair);
      padding: 10px 2px; font: 300 17px var(--sans); color: var(--ink);
    }
    .dfield input:focus { outline: none; border-bottom-color: var(--accent); }
    .booked {
      display: none; margin-top: 70px; text-align: center; padding: 20px 0;
    }
    .booked.on { display: block; animation: rise .8s var(--ease) both; }
    .booked .mark {
      font-family: var(--didot); font-size: 30px; color: var(--accent);
      width: 76px; height: 76px; border: 1px solid var(--accent); border-radius: 50%;
      display: grid; place-items: center; margin: 0 auto 30px;
      animation: breathe 5s ease-in-out infinite;
    }
    .booked h3 { font-family: var(--didot); font-weight: 400; font-size: clamp(26px, 3vw, 38px); }
    .booked p { margin-top: 16px; color: var(--soft); font-size: 15.5px; line-height: 1.8; max-width: 52ch; margin-inline: auto; }
    .booked .code { margin-top: 20px; font-size: 13px; letter-spacing: .3em; color: var(--accent); text-transform: uppercase; }
    .booked .text-btn { margin-top: 30px; }

    footer { padding: 90px 6vw 50px; }
    .foot-grid { max-width: 1060px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 36px; }
    footer h4 { font-family: var(--didot); font-weight: 400; font-size: 17px; margin-bottom: 12px; letter-spacing: .08em; }
    footer p, footer a { font-size: 13.5px; color: var(--soft); line-height: 1.9; text-decoration: none; }
    .demo-note { max-width: 1060px; margin: 44px auto 0; font-size: 11.5px; color: var(--soft); opacity: .6; border-top: 1px solid var(--hair); padding-top: 22px; }

    @media (max-width: 940px) {
      .fit-wrap { grid-template-columns: 1fr; gap: 40px; }
      .nav-links a { display: none; }
      section { padding: 90px 6vw; }
      .team-row + .team-row { border-left: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
      .rv { opacity: 1; transform: none; }
    }
  </style>
</head>
<body>

<nav>
  <div class="brand">ΜΕΤΑΞΙ</div>
  <div class="nav-links">
    <a href="#ypiresies">Υπηρεσίες</a>
    <a href="#dokimastirio">Δοκιμαστήριο</a>
    <a href="#omada">Η ομάδα</a>
    <button class="cta" data-goto="#kratisi">Κράτηση</button>
  </div>
</nav>

<header>
  <div class="blob a"></div>
  <div class="blob b"></div>
  <div class="hero-inner">
    <p class="kicker rv">Hair atelier · Κολωνάκι</p>
    <h1 class="rv" style="--d:.12s">Μαλλιά ελαφριά<br />σαν <em>αέρας</em>.</h1>
    <p class="hero-sub rv" style="--d:.24s">
      Λιγότερα, καλύτερα. Ένα ήσυχο atelier, τρία ζευγάρια προσεκτικά χέρια,
      και χρόνος για τα μαλλιά σου — όχι πάνω από ένα ραντεβού στην ίδια καρέκλα.
    </p>
    <div class="hero-actions rv" style="--d:.36s">
      <button class="btn" data-goto="#kratisi">Κλείσε ραντεβού</button>
      <button class="btn quiet" data-goto="#dokimastirio">Δοκίμασε ένα χρώμα</button>
    </div>
  </div>
  <div class="scroll-hint" aria-hidden="true"></div>
</header>

<section id="ypiresies">
  <div class="measure">
    <p class="sec-label rv">Υπηρεσίες</p>
    <h2 class="sec-title rv" style="--d:.1s">Ό,τι χρειάζεσαι.<br />Τίποτα παραπάνω.</h2>
    <div class="svc-list rv" style="--d:.2s" id="svcList"></div>
  </div>
</section>

<section id="dokimastirio">
  <div class="measure">
    <p class="sec-label rv">Δοκιμαστήριο</p>
    <h2 class="sec-title rv" style="--d:.1s">Δες το, πριν το ζήσεις.</h2>
    <p class="sec-sub rv" style="--d:.18s">
      Ανέβασε μια φωτογραφία σου και δοκίμασε αποχρώσεις πάνω στα δικά σου μαλλιά,
      ή φόρεσε μια σιλουέτα κουρέματος για να δεις το μήκος που σου πάει.
    </p>

    <div class="fit-wrap rv" style="--d:.26s">
      <div class="fit-stage">
        <canvas id="fitCanvas" width="720" height="960" aria-label="Προεπισκόπηση φωτογραφίας"></canvas>
        <div class="fit-empty" id="fitEmpty">
          <div>
            <div class="oval"></div>
            <p>Μια φωτογραφία με το πρόσωπο μπροστά και καλό φως δουλεύει καλύτερα.</p>
          </div>
        </div>
        <div class="fit-hintbar" id="fitHint">Σκίτσο μήκους — σύρε το πάνω στο κεφάλι σου και ρύθμισε το μέγεθος</div>
      </div>

      <div class="fit-side">
        <h3>Η φωτογραφία σου</h3>
        <label class="upload-btn" tabindex="0">Ανέβασε φωτογραφία
          <input type="file" id="photoIn" accept="image/*" hidden />
        </label>
        <p class="privacy">Μένει στη συσκευή σου — δεν ανεβαίνει και δεν αποθηκεύεται πουθενά.</p>

        <h3>Σιλουέτα κουρέματος</h3>
        <div class="chip-row" id="styleRow"></div>

        <h3>Απόχρωση</h3>
        <div class="shade-row" id="shadeRow"></div>

        <h3>Ρυθμίσεις</h3>
        <div class="slider-row">
          <label for="intenIn">Ένταση</label>
          <input type="range" id="intenIn" min="0" max="100" value="75" />
        </div>
        <div class="slider-row">
          <label for="sizeIn">Μέγεθος</label>
          <input type="range" id="sizeIn" min="55" max="170" value="100" disabled />
        </div>
        <p class="fit-status" id="fitStatus"></p>
        <div class="fit-actions">
          <button class="text-btn" id="saveBtn" hidden>Αποθήκευση εικόνας</button>
          <button class="text-btn" id="resetBtn" hidden>Επαναφορά</button>
        </div>
        <p class="fit-note">
          Το δοκιμαστήριο είναι μια πρόβα, όχι υπόσχεση — το τελικό αποτέλεσμα
          το σχεδιάζουμε μαζί στην καρέκλα, πάνω στον δικό σου φυσικό τόνο.
        </p>
      </div>
    </div>
  </div>
</section>

<section id="omada">
  <div class="measure">
    <p class="sec-label rv">Η ομάδα</p>
    <h2 class="sec-title rv" style="--d:.1s">Τρία ζευγάρια χέρια.</h2>
    <div class="team-list rv" style="--d:.2s">
      <div class="team-row"><div class="ini">Ζ</div><h3>Ζωή</h3><p>Χρώμα. Δεκατέσσερα χρόνια φόρμουλες, καμία βιασύνη.</p></div>
      <div class="team-row"><div class="ini">Ι</div><h3>Ιάσονας</h3><p>Κούρεμα με ψαλίδι. Πιστεύει στο σχήμα, όχι στη μηχανή.</p></div>
      <div class="team-row"><div class="ini">Ν</div><h3>Νεφέλη</h3><p>Θεραπείες και χτενίσματα. Τα χέρια της είναι μασάζ.</p></div>
    </div>
  </div>
</section>

<section class="booking" id="kratisi">
