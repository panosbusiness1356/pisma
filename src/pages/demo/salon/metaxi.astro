<script is:inline type="module">
  /* ================= δεδομένα (mock) ================= */
  const SERVICES = [
    { id: 'cut',     name: 'Κούρεμα & styling', dur: 45,  price: 28,  desc: 'Συζήτηση, λούσιμο, κούρεμα, φινίρισμα. Φεύγεις έτοιμη.' },
    { id: 'color',   name: 'Βαφή ρίζας',        dur: 75,  price: 45,  desc: 'Η φόρμουλά σου μένει στην καρτέλα σου — ίδια ρίζα κάθε φορά.' },
    { id: 'balayage',name: 'Balayage',           dur: 150, price: 120, desc: 'Ανταύγειες με ελεύθερο χέρι, που μεγαλώνουν όμορφα.' },
    { id: 'keratin', name: 'Θεραπεία κερατίνης', dur: 120, price: 90,  desc: 'Λείανση και λάμψη για τρεις με τέσσερις μήνες.' },
    { id: 'updo',    name: 'Χτένισμα',           dur: 40,  price: 25,  desc: 'Για γάμο, γιορτή, ή απλώς επειδή είναι Σάββατο.' },
    { id: 'consult', name: 'Ραντεβού γνωριμίας', dur: 20,  price: 0,   desc: 'Κουβέντα πριν από μια μεγάλη αλλαγή. Δωρεάν.' },
  ];
  const STYLISTS = [
    { id: 'zoi',     name: 'τη Ζωή',     tag: 'χρώμα' },
    { id: 'iasonas', name: 'τον Ιάσονα', tag: 'κούρεμα' },
    { id: 'nefeli',  name: 'τη Νεφέλη',  tag: 'θεραπείες' },
    { id: 'any',     name: 'όποιον προτείνετε', tag: 'πιο σύντομη αναμονή' },
  ];
  const DAY_NAMES = ['Κυριακή','Δευτέρα','Τρίτη','Τετάρτη','Πέμπτη','Παρασκευή','Σάββατο'];
  const MONTHS = ['Ιανουαρίου','Φεβρουαρίου','Μαρτίου','Απριλίου','Μαΐου','Ιουνίου','Ιουλίου','Αυγούστου','Σεπτεμβρίου','Οκτωβρίου','Νοεμβρίου','Δεκεμβρίου'];
  const hashCode = s => { let h = 0; for (const c of s) h = (h * 31 + c.charCodeAt(0)) | 0; return Math.abs(h); };

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ================= απαλή κίνηση: lenis + reveals ================= */
  let lenis = null;
  if (!reduceMotion) {
    try {
      const { default: Lenis } = await import('https://cdn.jsdelivr.net/npm/lenis@1/dist/lenis.mjs');
      lenis = new Lenis({ duration: 1.5, smoothWheel: true });
      const raf = t => { lenis.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
    } catch { /* χωρίς lenis, το scroll μένει native */ }
  }
  const goto = el => {
    if (typeof el === 'string') el = document.querySelector(el);
    if (!el) return;
    if (lenis) lenis.scrollTo(el, { offset: -60, duration: 1.6 });
    else el.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
  };
  document.querySelectorAll('[data-goto]').forEach(b => b.addEventListener('click', () => goto(b.dataset.goto)));

  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { threshold: .12 });
  document.querySelectorAll('.rv').forEach(el => io.observe(el));

  /* ================= υπηρεσίες ================= */
  const svcList = document.getElementById('svcList');
  SERVICES.forEach(s => {
    const el = document.createElement('button');
    el.className = 'svc-row';
    el.innerHTML = `<span class="nm">${s.name}</span>
      <span class="pr">${s.price === 0 ? 'δωρεάν' : s.price + ' €'} · ${s.dur}′</span>
      <span class="ds">${s.desc}</span>
      <span class="bk">κλείσε ώρα →</span>`;
    el.addEventListener('click', () => { pickSvc(s); goto('#kratisi'); });
    svcList.appendChild(el);
  });

  /* ================= δοκιμαστήριο ================= */
  const canvas = document.getElementById('fitCanvas');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const statusEl = document.getElementById('fitStatus');
  const fit = {
    img: null, rect: null,
    maskCanvas: null, aiState: 'idle', // idle | loading | ready | off
    shade: null, inten: .75,
    style: 'none', wig: { x: 0, y: 0, s: 1 },
  };
  const SHADES = [
    { name: 'Έβενος',  c: '#241d1a', light: false },
    { name: 'Σοκολά',  c: '#4a332a', light: false },
    { name: 'Καστανό', c: '#6b4a36', light: false },
    { name: 'Μαόνι',   c: '#6e3240', light: false },
    { name: 'Χάλκινο', c: '#a45b32', light: true },
    { name: 'Μελί',    c: '#b98a4f', light: true },
    { name: 'Σαντρέ',  c: '#8d8391', light: true },
    { name: 'Πλατίνα', c: '#d6c9bd', light: true },
  ];
  const STYLES = [
    { id: 'none', name: 'Τα δικά μου' },
    { id: 'bob',  name: 'Καρέ' },
    { id: 'long', name: 'Μακριά' },
    { id: 'pixie',name: 'Πίξι' },
    { id: 'curls',name: 'Μπούκλες' },
  ];

  /* κουμπιά στυλ + αποχρώσεων */
  const styleRow = document.getElementById('styleRow');
  STYLES.forEach(st => {
    const b = document.createElement('button');
    b.className = 'chip' + (st.id === 'none' ? ' sel' : '');
    b.textContent = st.name;
    b.addEventListener('click', () => {
      fit.style = st.id;
      styleRow.querySelectorAll('.chip').forEach(x => x.classList.toggle('sel', x === b));
      document.getElementById('sizeIn').disabled = st.id === 'none';
      document.getElementById('fitHint').classList.toggle('show', st.id !== 'none' && !!fit.img);
      draw();
    });
    styleRow.appendChild(b);
  });
  const shadeRow = document.getElementById('shadeRow');
  const noneShade = document.createElement('button');
  noneShade.className = 'shade sel';
  noneShade.setAttribute('data-none', '');
  noneShade.setAttribute('aria-label', 'Φυσικό χρώμα');
  noneShade.addEventListener('click', () => { fit.shade = null; selShade(noneShade); draw(); });
  shadeRow.appendChild(noneShade);
  SHADES.forEach(sh => {
    const b = document.createElement('button');
    b.className = 'shade';
    b.style.setProperty('--c', sh.c);
    b.setAttribute('aria-label', sh.name);
    b.title = sh.name;
    b.addEventListener('click', () => { fit.shade = sh; selShade(b); ensureMask(); draw(); });
    shadeRow.appendChild(b);
  });
  function selShade(b) { shadeRow.querySelectorAll('.shade').forEach(x => x.classList.toggle('sel', x === b)); }

  document.getElementById('intenIn').addEventListener('input', e => { fit.inten = e.target.value / 100; draw(); });
  document.getElementById('sizeIn').addEventListener('input', e => { fit.wig.s = e.target.value / 100; draw(); });

  /* φόρτωση φωτογραφίας */
  document.getElementById('photoIn').addEventListener('change', e => {
    const f = e.target.files[0];
    if (!f) return;
    const url = URL.createObjectURL(f);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      fit.img = img;
      const sc = Math.min(W / img.width, H / img.height);
      const w = img.width * sc, h = img.height * sc;
      fit.rect = { x: (W - w) / 2, y: (H - h) / 2, w, h };
      fit.maskCanvas = null;
      fit.wig = { x: W / 2, y: H * .42, s: 1 };
      document.getElementById('sizeIn').value = 100;
      document.getElementById('fitEmpty').classList.add('hide');
      document.getElementById('saveBtn').hidden = false;
      document.getElementById('resetBtn').hidden = false;
      document.getElementById('fitHint').classList.toggle('show', fit.style !== 'none');
      if (fit.shade) ensureMask();
      draw();
    };
    img.src = url;
    e.target.value = '';
  });

  /* on-device ανίχνευση μαλλιών (MediaPipe) — φορτώνει μόνο όταν χρειαστεί */
  let segmenterPromise = null;
  function loadSegmenter() {
    if (!segmenterPromise) {
      segmenterPromise = (async () => {
        const v = await import('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs');
        const files = await v.FilesetResolver.forVisionTasks('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm');
        return v.ImageSegmenter.createFromOptions(files, {
          baseOptions: { modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/image_segmenter/hair_segmenter/float32/latest/hair_segmenter.tflite' },
          outputCategoryMask: true,
          runningMode: 'IMAGE',
        });
      })();
    }
    return segmenterPromise;
  }
  async function ensureMask() {
    if (!fit.img || fit.maskCanvas || fit.aiState === 'loading' || fit.aiState === 'off') return;
    fit.aiState = 'loading';
    statusEl.textContent = 'Βρίσκω τα μαλλιά στη φωτογραφία…';
    try {
      const seg = await loadSegmenter();
      const photo = document.createElement('canvas');
      photo.width = W; photo.height = H;
      const pctx = photo.getContext('2d');
      pctx.fillStyle = '#f4efea'; pctx.fillRect(0, 0, W, H);
      pctx.drawImage(fit.img, fit.rect.x, fit.rect.y, fit.rect.w, fit.rect.h);
      const res = seg.segment(photo);
      const arr = res.categoryMask.getAsUint8Array();
      const mw = res.categoryMask.width, mh = res.categoryMask.height;
      const raw = document.createElement('canvas');
      raw.width = mw; raw.height = mh;
      const rctx = raw.getContext('2d');
      const idata = rctx.createImageData(mw, mh);
      for (let i = 0; i < arr.length; i++) idata.data[i * 4 + 3] = arr[i] > 0 ? 255 : 0;
      rctx.putImageData(idata, 0, 0);
      res.close?.();
      const soft = document.createElement('canvas');
      soft.width = W; soft.height = H;
      const sctx = soft.getContext('2d');
      sctx.filter = 'blur(3px)';
      sctx.drawImage(raw, 0, 0, W, H);
      fit.maskCanvas = soft;
      fit.aiState = 'ready';
      statusEl.textContent = 'Έτοιμο — διάλεξε αποχρώσεις με την ησυχία σου.';
      draw();
    } catch (err) {
      console.warn('segmentation failed', err);
      fit.aiState = 'off';
      statusEl.textContent = 'Η αυτόματη ανίχνευση μαλλιών δεν φορτώθηκε εδώ — οι αποχρώσεις εφαρμόζονται στις σιλουέτες κουρέματος.';
      draw();
    }
  }

  /* σχέδιο */
  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#f4efea';
    ctx.fillRect(0, 0, W, H);
    if (!fit.img) return;
    ctx.drawImage(fit.img, fit.rect.x, fit.rect.y, fit.rect.w, fit.rect.h);

    if (fit.shade && fit.maskCanvas && fit.inten > 0) {
      const layer = document.createElement('canvas');
      layer.width = W; layer.height = H;
      const lctx = layer.getContext('2d');
      lctx.drawImage(fit.maskCanvas, 0, 0);
      lctx.globalCompositeOperation = 'source-in';
      lctx.fillStyle = fit.shade.c;
      lctx.fillRect(0, 0, W, H);
      ctx.save();
      ctx.globalCompositeOperation = 'color';
      ctx.globalAlpha = fit.inten * .95;
      ctx.drawImage(layer, 0, 0);
      ctx.globalCompositeOperation = fit.shade.light ? 'screen' : 'multiply';
      ctx.globalAlpha = fit.inten * (fit.shade.light ? .4 : .3);
      ctx.drawImage(layer, 0, 0);
      ctx.restore();
    }
    if (fit.style !== 'none') drawWig();
  }

  /* σκίτσο περιγράμματος: λεπτή γραμμή που δείχνει όγκο & μήκος */
  function wigPath() {
    const p = new Path2D();
    if (fit.style === 'bob') {
      p.moveTo(-30, 92);
      p.bezierCurveTo(-74, 86, -92, 60, -92, 20);
      p.bezierCurveTo(-94, -50, -70, -98, 0, -102);
      p.bezierCurveTo(70, -98, 94, -50, 92, 20);
      p.bezierCurveTo(92, 60, 74, 86, 30, 92);
    } else if (fit.style === 'pixie') {
      p.moveTo(-64, 26);
      p.bezierCurveTo(-84, -20, -70, -84, 0, -96);
      p.bezierCurveTo(70, -84, 84, -20, 64, 26);
    } else if (fit.style === 'long') {
      p.moveTo(-34, 230);
      p.bezierCurveTo(-72, 214, -84, 160, -80, 110);
      p.bezierCurveTo(-96, 60, -100, 10, -94, -30);
      p.bezierCurveTo(-86, -86, -50, -104, 0, -104);
      p.bezierCurveTo(50, -104, 86, -86, 94, -30);
      p.bezierCurveTo(100, 10, 96, 60, 80, 110);
      p.bezierCurveTo(84, 160, 72, 214, 34, 230);
    } else if (fit.style === 'curls') {
      let first = true;
      for (let a = 205; a >= -25; a -= 4) {
        const rad = a * Math.PI / 180;
        const wob = 10 * Math.sin(a * .16) + 5 * Math.sin(a * .45);
        const rx = 96 + wob, ry = 104 + wob;
        const px = Math.cos(rad) * rx, py = -Math.sin(rad) * ry - 4;
        if (first) { p.moveTo(px, py); first = false; } else p.lineTo(px, py);
      }
    }
    return p;
  }
  function drawWig() {
    const col = fit.shade ? fit.shade.c : '#a98070';
    const { x, y, s } = fit.wig;
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(s * 1.6, s * 1.6);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    const p = wigPath();
    /* απαλή «σκιά» της γραμμής */
    ctx.filter = 'blur(5px)';
    ctx.strokeStyle = col;
    ctx.globalAlpha = .4;
    ctx.lineWidth = 5;
    ctx.stroke(p);
    /* καθαρή γραμμή σκίτσου */
    ctx.filter = 'none';
    ctx.globalAlpha = .95;
    ctx.lineWidth = 2.2;
    ctx.setLineDash([1, 7]);
    ctx.stroke(p);
    ctx.restore();
  }

  /* σύρσιμο σιλουέτας */
  let dragging = false;
  canvas.addEventListener('pointerdown', e => {
    if (fit.style === 'none' || !fit.img) return;
    dragging = true;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', e => {
    if (!dragging) return;
    const r = canvas.getBoundingClientRect();
    fit.wig.x = (e.clientX - r.left) * (W / r.width);
    fit.wig.y = (e.clientY - r.top) * (H / r.height);
    draw();
  });
  canvas.addEventListener('pointerup', () => { dragging = false; });

  document.getElementById('resetBtn').addEventListener('click', () => {
    fit.shade = null; selShade(noneShade);
    fit.style = 'none';
    styleRow.querySelectorAll('.chip').forEach((x, i) => x.classList.toggle('sel', i === 0));
    document.getElementById('sizeIn').disabled = true;
    document.getElementById('fitHint').classList.remove('show');
    fit.wig = { x: W / 2, y: H * .42, s: 1 };
    document.getElementById('sizeIn').value = 100;
    draw();
  });
  document.getElementById('saveBtn').addEventListener('click', () => {
    const a = document.createElement('a');
    a.download = 'metaxi-dokimi.png';
    a.href = canvas.toDataURL('image/png');
    a.click();
  });

  /* ================= κράτηση-πρόταση ================= */
  const bk = { service: null, stylist: null, day: null, time: null };
  const blanks = { svc: document.getElementById('bSvc'), sty: document.getElementById('bSty'), day: document.getElementById('bDay'), time: document.getElementById('bTime') };
  const ORDER = ['svc', 'sty', 'day', 'time'];

  function showPanel(key) {
    document.querySelectorAll('.panel').forEach(p => p.classList.toggle('on', p.dataset.p === key));
    Object.entries(blanks).forEach(([k, b]) => b.classList.toggle('active', k === key));
    if (key === 'day') buildDays();
    if (key === 'time') buildTimes();
  }
  Object.entries(blanks).forEach(([k, b]) => b.addEventListener('click', () => showPanel(k)));

  function nextEmpty(after) {
    const map = { svc: bk.service, sty: bk.stylist, day: bk.day, time: bk.time };
    const start = ORDER.indexOf(after) + 1;
    for (let i = 0; i < ORDER.length; i++) {
      const k = ORDER[(start + i) % ORDER.length];
      if (!map[k]) return k;
    }
    return null;
  }
  function advance(from) {
    const nxt = nextEmpty(from);
    if (nxt) showPanel(nxt);
    else {
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('on'));
      Object.values(blanks).forEach(b => b.classList.remove('active'));
      document.getElementById('detailsZone').classList.add('on');
      checkDetails();
    }
  }

  /* επιλογές */
  const pSvc = document.getElementById('pSvc');
  SERVICES.forEach(s => {
    const b = document.createElement('button');
    b.className = 'p-opt';
    b.dataset.id = s.id;
    b.innerHTML = `${s.name}<small>${s.price === 0 ? 'δωρεάν' : s.price + ' €'} · ${s.dur}′</small>`;
    b.addEventListener('click', () => pickSvc(s));
    pSvc.appendChild(b);
  });
  function pickSvc(s) {
    bk.service = s;
    pSvc.querySelectorAll('.p-opt').forEach(x => x.classList.toggle('sel', x.dataset.id === s.id));
    blanks.svc.textContent = s.name.toLowerCase();
    blanks.svc.classList.remove('empty');
    bk.time = null; blanks.time.textContent = '…'; blanks.time.classList.add('empty');
    advance('svc');
  }
  const pSty = document.getElementById('pSty');
  STYLISTS.forEach(s => {
    const b = document.createElement('button');
    b.className = 'p-opt';
    b.dataset.id = s.id;
    b.innerHTML = `${s.name}<small>${s.tag}</small>`;
    b.addEventListener('click', () => {
      bk.stylist = s;
      pSty.querySelectorAll('.p-opt').forEach(x => x.classList.toggle('sel', x.dataset.id === s.id));
      blanks.sty.textContent = s.name;
      blanks.sty.classList.remove('empty');
      bk.time = null; blanks.time.textContent = '…'; blanks.time.classList.add('empty');
      advance('sty');
    });
    pSty.appendChild(b);
  });
  function buildDays() {
    const wrap = document.getElementById('pDay');
    wrap.innerHTML = '';
    const today = new Date();
    for (let i = 1; i <= 14; i++) {
      const d = new Date(today); d.setDate(today.getDate() + i);
      if (d.getDay() === 0 || d.getDay() === 1) continue;
      const b = document.createElement('button');
      b.className = 'p-opt' + (bk.day && bk.day.toDateString() === d.toDateString() ? ' sel' : '');
      b.textContent = DAY_NAMES[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()].slice(0, 3) + '.';
      b.addEventListener('click', () => {
        bk.day = d;
        blanks.day.textContent = DAY_NAMES[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()];
        blanks.day.classList.remove('empty');
        bk.time = null; blanks.time.textContent = '…'; blanks.time.classList.add('empty');
        advance('day');
      });
      wrap.appendChild(b);
    }
  }
  function buildTimes() {
    const wrap = document.getElementById('pTime');
    wrap.innerHTML = '';
    if (!bk.day || !bk.stylist) {
      wrap.innerHTML = '<p style="font-size:14px;color:var(--soft)">Διάλεξε πρώτα άτομο και ημέρα.</p>';
      return;
    }
    const base = ['10:00', '10:45', '11:30', '12:15', '13:00', '16:00', '16:45', '17:30', '18:15', '19:00'];
    const h = hashCode(bk.day.toISOString().slice(0, 10) + bk.stylist.id);
    let any = false;
    base.forEach((t, i) => {
      const free = ((h >> i) & 3) !== 0;
      if (free) any = true;
      const b = document.createElement('button');
      b.className = 'p-opt' + (bk.time === t ? ' sel' : '');
      b.textContent = t;
      b.disabled = !free;
      b.addEventListener('click', () => {
        bk.time = t;
        blanks.time.textContent = t;
        blanks.time.classList.remove('empty');
        advance('time');
      });
      wrap.appendChild(b);
    });
    if (!any) wrap.innerHTML = '<p style="font-size:14px;color:var(--soft)">Γεμάτη μέρα — δοκίμασε την επόμενη.</p>';
  }

  /* στοιχεία + επιβεβαίωση */
  const fName = document.getElementById('fName');
  const fPhone = document.getElementById('fPhone');
  function checkDetails() {
    document.getElementById('confirmBtn').disabled =
      !(bk.service && bk.stylist && bk.day && bk.time &&
        fName.value.trim().length > 2 && fPhone.value.replace(/\D/g, '').length >= 10);
  }
  fName.addEventListener('input', checkDetails);
  fPhone.addEventListener('input', checkDetails);
  document.getElementById('confirmBtn').addEventListener('click', () => {
    const code = 'MX-' + String(hashCode(fName.value + bk.time) % 9000 + 1000);
    document.getElementById('bookedTxt').textContent =
      `${fName.value.trim().split(' ')[0]}, ${DAY_NAMES[bk.day.getDay()]} ${bk.day.getDate()} ${MONTHS[bk.day.getMonth()]} στις ${bk.time}, για ${bk.service.name.toLowerCase()} με ${bk.stylist.id === 'any' ? 'την ομάδα μας' : bk.stylist.name}. Θα λάβεις SMS υπενθύμιση μία μέρα πριν.`;
    document.getElementById('bookedCode').textContent = 'Κωδικος · ' + code;
    document.getElementById('builder').style.display = 'none';
    document.getElementById('booked').classList.add('on');
    goto('#kratisi');
  });
  document.getElementById('againBtn').addEventListener('click', () => {
    Object.assign(bk, { service: null, stylist: null, day: null, time: null });
    fName.value = ''; fPhone.value = '';
    blanks.svc.textContent = 'μια περιποίηση';
    blanks.sty.textContent = 'όποιον προτείνετε';
    blanks.day.textContent = 'ημέρα που βολεύει';
    blanks.time.textContent = '…';
    Object.values(blanks).forEach(b => b.classList.add('empty'));
    document.querySelectorAll('.p-opt').forEach(x => x.classList.remove('sel'));
    document.getElementById('detailsZone').classList.remove('on');
    document.getElementById('booked').classList.remove('on');
    document.getElementById('builder').style.display = '';
    checkDetails();
  });
</script>
</body>
</html>
