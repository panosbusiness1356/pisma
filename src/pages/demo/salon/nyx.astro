---
// Demo portfolio — εικονικό κομμωτήριο «NYX studio».
// Εκδοχή Β: νυχτερινό studio· hero ένας καθρέφτης καμαρινιού με λάμπες,
// και η κράτηση γίνεται ΜΕΣΑ στον καθρέφτη. Όλα mock — κανένα backend.
const title = 'NYX studio · κομμωτήριο μετά τις έξι';
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Advent+Pro:wght@300;500;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --night: #17111f;
      --night-2: #211a2c;
      --glass: #2a2138;
      --bulb: #ffd9a0;
      --brass: #c9a15a;
      --lilac: #b69cff;
      --txt: #efe9f6;
      --dim: #9a8fae;
      --line: #3b3050;
      --disp: 'Advent Pro', sans-serif;
      --body: 'Inter', sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--body);
      background:
        radial-gradient(ellipse 90% 55% at 50% -10%, rgba(255,217,160,.09), transparent),
        radial-gradient(ellipse 60% 40% at 85% 100%, rgba(182,156,255,.07), transparent),
        var(--night);
      color: var(--txt);
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: var(--brass); color: var(--night); }
    a { color: inherit; }
    button { font-family: inherit; }

    nav {
      position: fixed; inset: 0 0 auto 0; z-index: 40;
      display: flex; justify-content: space-between; align-items: center;
      padding: 18px 5vw;
      background: color-mix(in srgb, var(--night) 78%, transparent);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid color-mix(in srgb, var(--line) 50%, transparent);
    }
    .brand { font-family: var(--disp); font-weight: 700; font-size: 26px; letter-spacing: .34em; }
    .brand i { font-style: normal; color: var(--bulb); text-shadow: 0 0 18px rgba(255,217,160,.8); }
    .nav-links { display: flex; gap: 26px; align-items: center; font-size: 14px; }
    .nav-links a { text-decoration: none; color: var(--dim); letter-spacing: .04em; }
    .nav-links a:hover { color: var(--txt); }
    .btn {
      font: 600 13px/1 var(--body); letter-spacing: .1em; text-transform: uppercase;
      background: var(--bulb); color: #2a1c0a; border: none; cursor: pointer;
      padding: 14px 24px; border-radius: 999px;
      box-shadow: 0 0 24px -6px rgba(255,217,160,.55);
      transition: transform .2s;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn.ghost { background: none; color: var(--txt); border: 1px solid var(--line); box-shadow: none; }
    .btn:disabled { opacity: .35; cursor: not-allowed; transform: none; }
    .btn:focus-visible, a:focus-visible { outline: 2px solid var(--lilac); outline-offset: 3px; }

    /* ---------- hero: ο καθρέφτης ---------- */
    header {
      min-height: 100svh;
      display: grid; place-items: center;
      padding: 110px 4vw 70px;
      position: relative;
    }
    .stage-note {
      position: absolute; top: 108px; left: 5vw; max-width: 300px;
      font-size: 14px; color: var(--dim); line-height: 1.65;
    }
    .stage-note b { color: var(--txt); font-weight: 500; }
    .hours-note {
      position: absolute; bottom: 36px; right: 5vw; text-align: right;
      font-family: var(--disp); font-weight: 300; font-size: 15px; letter-spacing: .18em;
      color: var(--dim);
    }
    .hours-note b { color: var(--bulb); font-weight: 500; }

    .mirror {
      width: min(660px, 94vw);
      border-radius: 34px;
      padding: 34px;
      background: linear-gradient(160deg, #3d3352, #241c31 60%);
      box-shadow:
        0 60px 120px -40px rgba(0,0,0,.8),
        inset 0 1px 0 rgba(255,255,255,.12);
      position: relative;
    }
    .bulbs { position: absolute; inset: 10px; pointer-events: none; }
    .bulb {
      position: absolute; width: 14px; height: 14px; border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #fff6e4, var(--bulb) 55%, #b3781f);
      box-shadow: 0 0 16px 4px rgba(255,217,160,.55);
      animation: flick 4.5s ease-in-out infinite;
    }
    @keyframes flick {
      0%, 100% { opacity: 1; } 92% { opacity: 1; } 94% { opacity: .55; } 96% { opacity: 1; }
    }
    .glass {
      border-radius: 22px;
      background:
        linear-gradient(115deg, rgba(255,255,255,.10) 0%, rgba(255,255,255,.02) 28%, transparent 45%),
        linear-gradient(180deg, #241d33, #1b1526);
      border: 1px solid rgba(255,255,255,.08);
      min-height: 460px;
      padding: 34px 34px 30px;
      display: flex; flex-direction: column;
      position: relative; overflow: hidden;
    }
    .glass::after {
      content: ''; position: absolute; top: -40%; left: -20%;
      width: 45%; height: 180%;
      background: linear-gradient(100deg, transparent, rgba(255,255,255,.05), transparent);
      transform: rotate(8deg);
      pointer-events: none;
    }

    .m-step { display: none; flex: 1; flex-direction: column; animation: mfade .4s ease both; }
    .m-step.on { display: flex; }
    @keyframes mfade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

    .m-kicker { font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--lilac); margin-bottom: 14px; }
    .m-title { font-family: var(--disp); font-weight: 700; font-size: clamp(34px, 5vw, 52px); line-height: 1.04; letter-spacing: .02em; }
    .m-title .glow { color: var(--bulb); text-shadow: 0 0 26px rgba(255,217,160,.6); }
    .m-sub { margin-top: 16px; color: var(--dim); font-size: 15px; line-height: 1.65; font-weight: 300; max-width: 42ch; }
    .m-actions { margin-top: auto; padding-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }

    .m-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; }
    .m-head h2 { font-family: var(--disp); font-weight: 500; font-size: 24px; letter-spacing: .08em; }
    .m-head span { font-size: 12px; color: var(--dim); letter-spacing: .2em; }
    .backlink { background: none; border: none; color: var(--dim); font-size: 13px; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }
    .backlink:hover { color: var(--txt); }

    .m-list { display: grid; gap: 9px; overflow-y: auto; }
    .m-opt {
      display: flex; justify-content: space-between; align-items: center; gap: 14px;
      background: rgba(255,255,255,.04);
      border: 1px solid var(--line); border-radius: 14px;
      padding: 14px 18px; cursor: pointer; text-align: left; color: var(--txt);
      transition: border-color .2s, background .2s;
    }
    .m-opt:hover { border-color: var(--brass); background: rgba(201,161,90,.08); }
    .m-opt.sel { border-color: var(--bulb); background: rgba(255,217,160,.09); }
    .m-opt b { display: block; font-size: 15px; font-weight: 500; }
    .m-opt small { color: var(--dim); font-size: 12.5px; }
    .m-opt .tag { font-family: var(--disp); font-weight: 700; font-size: 18px; color: var(--brass); white-space: nowrap; }

    .m-days { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 14px; }
    .m-day {
      min-width: 62px; padding: 10px 6px; text-align: center; cursor: pointer;
      background: rgba(255,255,255,.04); border: 1px solid var(--line); border-radius: 12px; color: var(--txt);
    }
    .m-day b { display: block; font-family: var(--disp); font-size: 20px; }
    .m-day small { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }
    .m-day.sel { border-color: var(--bulb); background: rgba(255,217,160,.12); }
    .m-day.sel small { color: var(--bulb); }
    .m-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(82px, 1fr)); gap: 8px; }
    .m-slot {
      padding: 11px 4px; border-radius: 10px; cursor: pointer; text-align: center;
      background: rgba(255,255,255,.04); border: 1px solid var(--line); color: var(--txt);
      font: 500 14px var(--body);
    }
    .m-slot.sel { background: var(--bulb); color: #2a1c0a; border-color: var(--bulb); box-shadow: 0 0 18px -4px rgba(255,217,160,.7); }
    .m-slot:disabled { opacity: .25; cursor: not-allowed; text-decoration: line-through; }
    .m-empty { color: var(--dim); font-size: 14px; padding: 8px 0; }

    .m-field { margin-bottom: 13px; }
    .m-field label { display: block; font-size: 12px; letter-spacing: .08em; color: var(--dim); margin-bottom: 6px; }
    .m-field input {
      width: 100%; padding: 13px 15px; border-radius: 12px;
      background: rgba(255,255,255,.05); border: 1px solid var(--line);
      color: var(--txt); font: 400 15px var(--body);
    }
    .m-field input::placeholder { color: #6e6383; }
    .m-field input:focus { outline: none; border-color: var(--bulb); }
    .m-summary {
      border: 1px dashed var(--line); border-radius: 14px; padding: 14px 18px; margin-bottom: 16px;
      font-size: 13.5px; color: var(--dim); line-height: 1.7;
    }
    .m-summary b { color: var(--txt); font-weight: 500; }

    .m-done { text-align: center; margin: auto 0; padding: 20px 0; }
    .m-done .neon {
      font-family: var(--disp); font-weight: 700; font-size: 46px; letter-spacing: .2em;
      color: var(--bulb); text-shadow: 0 0 30px rgba(255,217,160,.8), 0 0 60px rgba(255,217,160,.35);
      animation: neonOn 1.2s steps(6, end) both;
    }
    @keyframes neonOn { 0% { opacity: 0; } 40% { opacity: .3; } 60% { opacity: .9; } 70% { opacity: .4; } 100% { opacity: 1; } }
    .m-done p { margin-top: 16px; color: var(--dim); font-size: 15px; line-height: 1.7; }
    .m-done .code { margin-top: 12px; font-family: var(--disp); letter-spacing: .3em; color: var(--lilac); font-size: 18px; }

    /* ---------- sections ---------- */
    section { padding: 90px 5vw; }
    .sec-head { margin-bottom: 40px; }
    .sec-head span { font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--lilac); }
    .sec-head h2 { font-family: var(--disp); font-weight: 700; font-size: clamp(32px, 4.5vw, 54px); letter-spacing: .04em; margin-top: 8px; }

    .menu { border-top: 1px solid var(--line); }
    .menu-row {
      display: grid; grid-template-columns: 1fr auto auto; gap: 8px 26px; align-items: baseline;
      padding: 22px 0; border-bottom: 1px solid var(--line);
      cursor: pointer; transition: padding-left .25s ease; background: none; border-left: none; border-right: none; width: 100%; text-align: left; color: var(--txt);
      border-top: none;
    }
    .menu-row:hover { padding-left: 14px; }
    .menu-row:hover .m-name::after { opacity: 1; transform: none; }
    .m-name { font-family: var(--disp); font-weight: 500; font-size: 24px; letter-spacing: .04em; position: relative; }
    .m-name::after {
      content: '→ κλείσε ώρα'; font-family: var(--body); font-size: 12px; letter-spacing: .1em; color: var(--bulb);
      margin-left: 16px; opacity: 0; transform: translateX(-6px); transition: .25s ease; display: inline-block;
    }
    .m-desc { grid-column: 1; font-size: 13.5px; color: var(--dim); font-weight: 300; max-width: 60ch; }
    .m-dur { font-size: 13px; color: var(--dim); }
    .m-price { font-family: var(--disp); font-weight: 700; font-size: 24px; color: var(--brass); }

    .crew { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }
    .crew-card {
      background: var(--night-2); border: 1px solid var(--line); border-radius: 20px; padding: 26px;
      transition: transform .25s, border-color .25s;
    }
    .crew-card:hover { transform: translateY(-4px); border-color: var(--brass); }
    .crew-card .sig {
      font-family: var(--disp); font-weight: 300; font-size: 44px; color: var(--lilac);
      border-bottom: 1px solid var(--line); padding-bottom: 14px; margin-bottom: 14px;
    }
    .crew-card h3 { font-size: 17px; font-weight: 600; }
    .crew-card p { font-size: 13.5px; color: var(--dim); margin-top: 6px; line-height: 1.6; font-weight: 300; }

    footer { padding: 60px 5vw 40px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 30px; flex-wrap: wrap; }
    footer p { font-size: 14px; color: var(--dim); line-height: 1.8; }
    footer b { color: var(--txt); font-weight: 500; }
    .demo-note { width: 100%; font-size: 12px; color: var(--dim); opacity: .6; padding-top: 24px; }

    @media (max-width: 1450px) {
      .stage-note, .hours-note { position: static; margin: 0 auto 24px; text-align: center; max-width: 100%; }
      header { display: flex; flex-direction: column; justify-content: center; }
      .hours-note { margin: 24px auto 0; }
    }
    @media (max-width: 760px) {
      .nav-links a { display: none; }
      .mirror { padding: 22px; }
      .glass { padding: 24px 20px; }
      .menu-row { grid-template-columns: 1fr auto; }
      .m-dur { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body>

<nav>
  <div class="brand">NY<i>X</i></div>
  <div class="nav-links">
    <a href="#menu">Υπηρεσίες</a>
    <a href="#crew">Η ομάδα</a>
    <a href="#info">Πληροφορίες</a>
    <button class="btn" data-mirror-book>Στον καθρέφτη</button>
  </div>
</nav>

<header>
  <p class="stage-note">
    <b>Κομμωτήριο για όσους ζουν αργά.</b><br />
    Ανοιχτά ως τις 11 το βράδυ, με ραντεβού που κλείνεις εδώ —
    μέσα στον καθρέφτη.
  </p>

  <div class="mirror">
    <div class="bulbs" id="bulbs" aria-hidden="true"></div>
    <div class="glass" role="region" aria-label="Κράτηση ραντεβού">

      <div class="m-step on" data-m="intro">
        <p class="m-kicker">NYX studio · Γκάζι</p>
        <h1 class="m-title">Κοιτάξου.<br />Έτσι θα είσαι <span class="glow">απόψε</span>.</h1>
        <p class="m-sub">
          Ο καθρέφτης μπροστά σου είναι και το βιβλίο ραντεβού μας.
          Διάλεξε τι θέλεις να δεις μέσα του — κι εμείς αναλαμβάνουμε τα υπόλοιπα.
        </p>
        <div class="m-actions">
          <button class="btn" data-mirror-book>Ξεκίνα την κράτηση</button>
          <a class="backlink" href="#menu" style="text-decoration:underline">ή δες πρώτα τις τιμές</a>
        </div>
      </div>

      <div class="m-step" data-m="service">
        <div class="m-head"><h2>Τι κλείνουμε;</h2><span>1 / 4</span></div>
        <div class="m-list" id="mSvc"></div>
        <div class="m-actions"><button class="backlink" data-m-goto="intro">← πίσω στον καθρέφτη</button></div>
      </div>

      <div class="m-step" data-m="stylist">
        <div class="m-head"><h2>Σε ποια καρέκλα;</h2><span>2 / 4</span></div>
        <div class="m-list" id="mSty"></div>
        <div class="m-actions"><button class="backlink" data-m-goto="service">← άλλαξε υπηρεσία</button></div>
      </div>

      <div class="m-step" data-m="when">
        <div class="m-head"><h2>Πότε;</h2><span>3 / 4</span></div>
        <div class="m-days" id="mDays"></div>
        <div class="m-slots" id="mSlots"></div>
        <div class="m-actions">
          <button class="backlink" data-m-goto="stylist">← πίσω</button>
          <button class="btn" id="mToDetails" disabled>Συνέχεια</button>
        </div>
      </div>

      <div class="m-step" data-m="details">
        <div class="m-head"><h2>Ποιος έρχεται;</h2><span>4 / 4</span></div>
        <div class="m-summary" id="mSum"></div>
        <div class="m-field">
          <label for="mName">Όνομα</label>
          <input id="mName" type="text" autocomplete="name" placeholder="Το όνομά σου" />
        </div>
        <div class="m-field">
          <label for="mPhone">Κινητό</label>
          <input id="mPhone" type="tel" autocomplete="tel" placeholder="69..." />
        </div>
        <div class="m-actions">
          <button class="backlink" data-m-goto="when">← άλλαξε ώρα</button>
          <button class="btn" id="mConfirm" disabled>Κλείσ' το</button>
        </div>
      </div>

      <div class="m-step" data-m="done">
        <div class="m-done">
          <div class="neon">ΣΕ ΒΛΕΠΟΥΜΕ</div>
          <p id="mDoneTxt"></p>
          <p class="code" id="mDoneCode"></p>
          <div class="m-actions" style="justify-content:center">
            <button class="btn ghost" data-m-goto="intro">Πίσω στον καθρέφτη</button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <p class="hours-note">Τρ–Σάβ · <b>12:00 – 23:00</b><br />γιατί η καλή δουλειά θέλει βράδυ</p>
</header>

<section id="menu">
  <div class="sec-head">
    <span>Τιμοκατάλογος</span>
    <h2>Το μενού της νύχτας</h2>
  </div>
  <div class="menu" id="menuList"></div>
</section>

<section id="crew">
  <div class="sec-head">
    <span>Η ομάδα</span>
    <h2>Ποιοι δουλεύουν όταν οι άλλοι κοιμούνται</h2>
  </div>
  <div class="crew" id="crewGrid"></div>
</section>

<footer id="info">
  <p><b>NYX studio</b><br />Περσεφόνης 19, Γκάζι<br />Τρ–Σάβ 12:00–23:00</p>
  <p><b>Ραντεβού</b><br />Μόνο online, από τον καθρέφτη.<br />Ακυρώσεις ως 3 ώρες πριν, χωρίς χρέωση.</p>
  <p><b>Επικοινωνία</b><br />210 000 0000<br />night@nyx.gr</p>
  <p class="demo-note">Ενδεικτική σελίδα επίδειξης — το «NYX studio» είναι φανταστικό και οι κρατήσεις δεν αποθηκεύονται πουθενά.</p>
</footer>

<script>
  const SERVICES = [
    { id: 'cut',    name: 'Κούρεμα', dur: 45, price: 30, desc: 'Σχήμα που στέκεται και όταν ξυπνήσεις — όχι μόνο στο φινίρισμα.' },
    { id: 'fade',   name: 'Fade / undercut', dur: 40, price: 25, desc: 'Καθαρές γραμμές μηχανής, δουλεμένες στο φως του καθρέφτη.' },
    { id: 'color',  name: 'Χρώμα φαντασίας', dur: 150, price: 130, desc: 'Μπλε, ασημί, φούξια — αποχρωματισμός και βαφή σε μία βραδιά.' },
    { id: 'glow',   name: 'Gloss & τόνωση', dur: 60, price: 45, desc: 'Γυαλάδα και τόνος χωρίς μόνιμη δέσμευση. Κρατάει 5–6 εβδομάδες.' },
    { id: 'event',  name: 'Έτοιμος/η για έξοδο', dur: 50, price: 35, desc: 'Λούσιμο, styling, τελευταία ματιά στον καθρέφτη. Φεύγεις κατευθείαν για το ραντεβού σου.' },
    { id: 'barber', name: 'Γένια & περιποίηση', dur: 30, price: 18, desc: 'Ξύρισμα με πετσέτα ή σχήμα στα γένια, παλιά σχολή.' },
  ];
  const STYLISTS = [
    { id: 'alkis', name: 'Άλκης', sig: 'Α', role: 'Κουρέας 12 χρόνια· τα fade του δεν χρειάζονται φίλτρο.' },
    { id: 'roza',  name: 'Ρόζα', sig: 'Ρ', role: 'Χρώμα φαντασίας μόνο. Αν το ονειρεύεσαι, το ανακατεύει.' },
    { id: 'timos', name: 'Τίμος', sig: 'Τ', role: 'Styling για εξόδους και σκηνή — δουλεύει με μουσικούς χρόνια.' },
    { id: 'any',   name: 'Όποιος είναι ελεύθερος', sig: '✦', role: 'Η πιο γρήγορη διαθέσιμη καρέκλα.' },
  ];
  const DAY_NAMES = ['Κυρ','Δευ','Τρί','Τετ','Πέμ','Παρ','Σάβ'];
  const MONTHS = ['Ιαν','Φεβ','Μαρ','Απρ','Μαΐ','Ιουν','Ιουλ','Αυγ','Σεπ','Οκτ','Νοε','Δεκ'];
  const state = { service: null, stylist: null, day: null, time: null };

  /* λάμπες γύρω από τον καθρέφτη */
  const bulbWrap = document.getElementById('bulbs');
  const positions = [];
  for (let i = 0; i <= 8; i++) positions.push({ top: '-2px', left: (6 + i * 11) + '%' });          // πάνω
  for (let i = 1; i <= 5; i++) positions.push({ top: (i * 15.5) + '%', left: '-2px' });            // αριστερά
  for (let i = 1; i <= 5; i++) positions.push({ top: (i * 15.5) + '%', right: '-2px' });           // δεξιά
  positions.forEach((p, i) => {
    const b = document.createElement('div');
    b.className = 'bulb';
    Object.assign(b.style, p);
    b.style.animationDelay = (i * .37 % 4.5) + 's';
    bulbWrap.appendChild(b);
  });

  /* πλοήγηση βημάτων μέσα στον καθρέφτη */
  const mirror = document.querySelector('.mirror');
  function mGo(name) {
    document.querySelectorAll('.m-step').forEach(s => s.classList.toggle('on', s.dataset.m === name));
    if (name === 'done') launchDone();
  }
  document.querySelectorAll('[data-m-goto]').forEach(b => b.addEventListener('click', () => mGo(b.dataset.mGoto)));
  document.querySelectorAll('[data-mirror-book]').forEach(b => b.addEventListener('click', () => {
    mirror.scrollIntoView({ behavior: 'smooth', block: 'center' });
    mGo('service');
  }));

  /* βήμα 1: υπηρεσίες */
  const mSvc = document.getElementById('mSvc');
  SERVICES.forEach(s => {
    const el = document.createElement('button');
    el.className = 'm-opt';
    el.innerHTML = `<span><b>${s.name}</b><small>${s.dur} λεπτά</small></span><span class="tag">${s.price}€</span>`;
    el.addEventListener('click', () => { state.service = s; buildSty(); mGo('stylist'); });
    mSvc.appendChild(el);
  });

  /* βήμα 2: ομάδα */
  function buildSty() {
    const wrap = document.getElementById('mSty');
    wrap.innerHTML = '';
    STYLISTS.forEach(s => {
      const el = document.createElement('button');
      el.className = 'm-opt';
      el.innerHTML = `<span><b>${s.name}</b><small>${s.role}</small></span><span class="tag">${s.sig}</span>`;
      el.addEventListener('click', () => { state.stylist = s; buildDays(); mGo('when'); });
      wrap.appendChild(el);
    });
  }

  /* βήμα 3: μέρες/ώρες (ντετερμινιστικό mock) */
  function hashCode(str) { let h = 0; for (const c of str) h = (h * 31 + c.charCodeAt(0)) | 0; return Math.abs(h); }
  function slotsFor(key, sty) {
    const base = ['12:00','13:00','14:00','16:00','17:00','18:00','19:00','20:00','21:00','22:00'];
    const h = hashCode(key + sty);
    return base.map((t, i) => ({ t, free: ((h >> i) & 3) !== 0 }));
  }
  function buildDays() {
    const row = document.getElementById('mDays');
    row.innerHTML = '';
    const today = new Date();
    let first = null;
    for (let i = 1; i <= 12; i++) {
      const d = new Date(today); d.setDate(today.getDate() + i);
      if (d.getDay() === 0 || d.getDay() === 1) continue; // Κυρ & Δευ κλειστά
      const el = document.createElement('button');
      el.className = 'm-day';
      el.innerHTML = `<small>${DAY_NAMES[d.getDay()]}</small><b>${d.getDate()}</b><small>${MONTHS[d.getMonth()]}</small>`;
      el.addEventListener('click', () => pickDay(d, el));
      row.appendChild(el);
      if (!first) first = { d, el };
    }
    pickDay(first.d, first.el);
  }
  function pickDay(d, el) {
    state.day = d; state.time = null;
    document.getElementById('mToDetails').disabled = true;
    document.querySelectorAll('.m-day').forEach(x => x.classList.remove('sel'));
    el.classList.add('sel');
    const grid = document.getElementById('mSlots');
    grid.innerHTML = '';
    const slots = slotsFor(d.toISOString().slice(0, 10), state.stylist.id);
    let any = false;
    slots.forEach(s => {
      const b = document.createElement('button');
      b.className = 'm-slot'; b.textContent = s.t; b.disabled = !s.free;
      if (s.free) any = true;
      b.addEventListener('click', () => {
        state.time = s.t;
        grid.querySelectorAll('.m-slot').forEach(x => x.classList.remove('sel'));
        b.classList.add('sel');
        document.getElementById('mToDetails').disabled = false;
      });
      grid.appendChild(b);
    });
    if (!any) grid.innerHTML = '<p class="m-empty">Sold out η βραδιά — δοκίμασε άλλη μέρα.</p>';
  }
  function fmtDay(d) { return DAY_NAMES[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()]; }
  document.getElementById('mToDetails').addEventListener('click', () => {
    document.getElementById('mSum').innerHTML =
      `<b>${state.service.name}</b> με <b>${state.stylist.name}</b> — ${fmtDay(state.day)} στις <b>${state.time}</b> · ${state.service.dur}′ · ${state.service.price}€`;
    mGo('details');
  });

  /* βήμα 4: στοιχεία */
  const mName = document.getElementById('mName');
  const mPhone = document.getElementById('mPhone');
  function checkOk() {
    document.getElementById('mConfirm').disabled = !(mName.value.trim().length > 2 && mPhone.value.replace(/\D/g, '').length >= 10);
  }
  mName.addEventListener('input', checkOk);
  mPhone.addEventListener('input', checkOk);
  document.getElementById('mConfirm').addEventListener('click', () => mGo('done'));
  function launchDone() {
    const code = 'NYX-' + String(hashCode(mName.value + state.time) % 9000 + 1000);
    document.getElementById('mDoneTxt').textContent =
      `${mName.value.trim().split(' ')[0]}, ${fmtDay(state.day)} στις ${state.time} ο καθρέφτης σε περιμένει για ${state.service.name.toLowerCase()}. SMS υπενθύμιση θα έρθει το πρωί της ίδιας μέρας.`;
    document.getElementById('mDoneCode').textContent = code;
  }

  /* τιμοκατάλογος στη σελίδα */
  const menu = document.getElementById('menuList');
  SERVICES.forEach(s => {
    const row = document.createElement('button');
    row.className = 'menu-row';
    row.innerHTML = `
      <span class="m-name">${s.name}</span>
      <span class="m-dur">${s.dur}′</span>
      <span class="m-price">${s.price}€</span>
      <span class="m-desc">${s.desc}</span>`;
    row.addEventListener('click', () => {
      state.service = s; buildSty();
      mirror.scrollIntoView({ behavior: 'smooth', block: 'center' });
      mGo('stylist');
    });
    menu.appendChild(row);
  });

  /* ομάδα στη σελίδα */
  const crew = document.getElementById('crewGrid');
  STYLISTS.filter(s => s.id !== 'any').forEach(s => {
    const el = document.createElement('article');
    el.className = 'crew-card';
    el.innerHTML = `<div class="sig">${s.sig}</div><h3>${s.name}</h3><p>${s.role}</p>`;
    crew.appendChild(el);
  });
</script>
</body>
</html>
