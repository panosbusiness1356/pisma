        <span class="g-badge"><svg viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span>
        Αφήστε κριτική
      </button>
      <div class="steps"><i class="dot"></i><i class="dot"></i><i class="dot on"></i><i class="dot"></i></div>
      <button class="skip-link" id="skipBtn">Παράλειψη</button>
      <div class="powered">Εργαλείο κριτικών από <b>PISMA</b> · σελίδα επίδειξης</div>
    </section>

    <!-- Στάδιο 4 · Κουπόνι -->
    <section class="stage" id="s-coupon">
      <div class="brand">
        <div class="logo">🍕</div>
        <div class="name">La Nonna</div>
      </div>
      <h2>Το δώρο σας είναι <span class="accent">έτοιμο</span>!</h2>
      <div class="coupon">
        <div class="top">
          <div class="c-emoji" id="couponEmoji">🍰</div>
          <div class="c-name" id="couponName">Δωρεάν επιδόρπιο</div>
        </div>
        <div class="divider"></div>
        <div class="bottom">
          <div class="code" id="couponCode">NN-XXXXX</div>
          <div class="hint">Δείξτε την οθόνη <b class="mark">στο ταμείο</b> 👆</div>
          <div class="expiry" id="couponExpiry"></div>
        </div>
      </div>
      <p class="sub" style="margin-top:20px" id="thanksLine">Καλή απόλαυση! ❤️</p>
      <div class="steps"><i class="dot"></i><i class="dot"></i><i class="dot"></i><i class="dot on"></i></div>
      <div class="powered">Εργαλείο κριτικών από <b>PISMA</b> · σελίδα επίδειξης</div>
    </section>

    <!-- Mock φύλλο κριτικής Google (προσομοίωση για το demo) -->
    <div class="sheet-veil" id="sheetVeil">
      <div class="sheet">
        <div class="demo-note">Προσομοίωση · έτσι φαίνεται στο Google</div>
        <div class="place">Pizzeria La Nonna<small>Δημοσίευση κριτικής δημόσια</small></div>
        <div class="rate-stars" id="rateStars">
          <button data-v="1" aria-label="1 αστέρι">★</button><button data-v="2" aria-label="2 αστέρια">★</button><button data-v="3" aria-label="3 αστέρια">★</button><button data-v="4" aria-label="4 αστέρια">★</button><button data-v="5" aria-label="5 αστέρια">★</button>
        </div>
        <textarea id="reviewText" placeholder="Πείτε μας για την εμπειρία σας (προαιρετικό)…"></textarea>
        <button class="btn publish" id="publishBtn" disabled>Δημοσίευση</button>
      </div>
    </div>

    <!-- Ο Τζίνο — ο σερβιτόρος-μασκότ -->
    <div class="waiter" id="waiter" aria-hidden="true">
      <svg viewBox="0 0 130 175">
        <g id="wAll">
          <!-- πόδια -->
          <g id="wLegL"><rect x="54" y="132" width="9" height="28" rx="3" fill="#22181f"/><ellipse cx="56" cy="162" rx="8" ry="3.6" fill="#161616"/></g>
          <g id="wLegR"><rect x="67" y="132" width="9" height="28" rx="3" fill="#22181f"/><ellipse cx="74" cy="162" rx="8" ry="3.6" fill="#161616"/></g>
          <!-- κορμός: πουκάμισο, γιλέκο, ποδιά με ιταλική ρίγα -->
          <path d="M50 52 Q65 47 80 52 L84 98 L46 98 Z" fill="#fff" stroke="#e2d9cc" stroke-width="1.5"/>
          <path d="M50 52 L61 55 L58 98 L46 98 Z" fill="#22181f"/>
          <path d="M80 52 L69 55 L72 98 L84 98 Z" fill="#22181f"/>
          <rect x="46" y="96" width="38" height="7" rx="2" fill="#22181f"/>
          <path d="M49 103 L81 103 L77 142 Q65 147 53 142 Z" fill="#fdfaf4" stroke="#e2d9cc" stroke-width="1.5"/>
          <rect x="55" y="132" width="7" height="4" fill="#2e7d43"/>
          <rect x="62" y="132" width="7" height="4" fill="#fff" stroke="#e2d9cc" stroke-width=".6"/>
          <rect x="69" y="132" width="7" height="4" fill="#c8371f"/>
          <!-- παπιγιόν -->
          <path d="M65 55 L56 50 L56 60 Z" fill="#c8371f"/>
          <path d="M65 55 L74 50 L74 60 Z" fill="#c8371f"/>
          <circle cx="65" cy="55" r="2.6" fill="#a02a16"/>
          <!-- δεξί χέρι (χαιρετάει) -->
          <g id="wArmR">
            <path d="M80 58 Q97 66 101 82" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round"/>
            <circle cx="101" cy="84" r="5" fill="#f2c299"/>
          </g>
          <!-- κεφάλι -->
          <g id="wHead">
            <circle cx="65" cy="30" r="15.5" fill="#f2c299"/>
            <path d="M49 26 Q52 12 65 13 Q78 12 81 26 Q73 18 65 19 Q57 18 49 26 Z" fill="#2b1d14"/>
            <circle cx="59" cy="28" r="1.9" fill="#2b1d14"/>
            <circle cx="71" cy="28" r="1.9" fill="#2b1d14"/>
            <path d="M56 23.5 Q59 22 61.5 23.5" stroke="#2b1d14" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            <path d="M68.5 23.5 Q71 22 74 23.5" stroke="#2b1d14" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            <path d="M64 30 Q63 34 65.5 34.5" stroke="#d9a05a" stroke-width="1.4" fill="none" stroke-linecap="round"/>
            <g id="wMoustache"><path d="M65 38 Q59 33 53.5 37.5 Q55 43 61.5 40.5 Q64 39.5 65 38 Q66 39.5 68.5 40.5 Q75 43 76.5 37.5 Q71 33 65 38 Z" fill="#2b1d14"/></g>
            <path d="M60 45.5 Q65 49 70 45.5" stroke="#a3552e" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          </g>
          <!-- αριστερό χέρι με την πίτσα -->
          <path d="M50 58 Q36 60 31 47" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round"/>
          <circle cx="31" cy="46" r="5" fill="#f2c299"/>
          <g id="wPizzaGrp">
            <ellipse cx="30" cy="35" rx="21" ry="12.5" fill="#e0a44e"/>
            <ellipse cx="30" cy="34" rx="16.5" ry="9" fill="#f5d76e"/>
            <circle cx="23" cy="32" r="2.6" fill="#c8371f"/>
            <circle cx="31" cy="30.5" r="2.6" fill="#c8371f"/>
            <circle cx="37.5" cy="34" r="2.6" fill="#c8371f"/>
            <circle cx="26" cy="37.5" r="2.6" fill="#c8371f"/>
            <circle cx="34" cy="38" r="2.4" fill="#c8371f"/>
            <circle cx="29" cy="35.5" r="1.4" fill="#2e7d43"/>
            <circle cx="35" cy="30.5" r="1.4" fill="#2e7d43"/>
            <path class="steam s1" d="M22 18 q2 -3 0 -6 q-2 -3 0 -6" stroke="#b9a894" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <path class="steam s2" d="M30 16 q2 -3 0 -6 q-2 -3 0 -6" stroke="#b9a894" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <path class="steam s3" d="M38 18 q2 -3 0 -6 q-2 -3 0 -6" stroke="#b9a894" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          </g>
        </g>
      </svg>
    </div>
  </div>

  <script>
    // ---------- Δεδομένα τροχού ----------
    const PRIZES = [
      { name: 'Δωρεάν επιδόρπιο',   emoji: '🍰', color: '#c8371f', weight: 3 },
      { name: 'Δωρεάν αναψυκτικό',  emoji: '🥤', color: '#e8a13c', weight: 4 },
      { name: '-50% στη 2η πίτσα',  emoji: '🍕', color: '#2e7d43', weight: 2 },
      { name: 'Δωρεάν ορεκτικό',    emoji: '🥗', color: '#c8371f', weight: 3 },
      { name: '-10% στον λογ/σμό',  emoji: '💶', color: '#e8a13c', weight: 3 },
      { name: 'Έκπληξη της Nonna',  emoji: '🎉', color: '#2e7d43', weight: 1 },
    ];
    const N = PRIZES.length;
    const SEG = 360 / N;

    // ---------- Σχεδίαση τροχού (SVG) ----------
    const svg = document.getElementById('wheelSvg');
    const cx = 100, cy = 100, r = 98;
    function polar(angleDeg, radius) {
      const a = (angleDeg - 90) * Math.PI / 180;
      return [cx + radius * Math.cos(a), cy + radius * Math.sin(a)];
    }
    let paths = '';
    PRIZES.forEach((p, i) => {
      const a0 = i * SEG, a1 = (i + 1) * SEG;
      const [x0, y0] = polar(a0, r);
      const [x1, y1] = polar(a1, r);
      paths += `<path d="M${cx},${cy} L${x0.toFixed(2)},${y0.toFixed(2)} A${r},${r} 0 0 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z"
        fill="${p.color}" stroke="#fdf6ec" stroke-width="2"/>`;
      const mid = a0 + SEG / 2;
      const [tx, ty] = polar(mid, r * 0.62);
      paths += `<text x="${tx.toFixed(2)}" y="${ty.toFixed(2)}" font-size="17" text-anchor="middle"
        dominant-baseline="central" transform="rotate(${mid} ${tx.toFixed(2)} ${ty.toFixed(2)})">${p.emoji}</text>`;
    });
    // Στεφάνι σαν κόρα πίτσας, με «καψίματα» για υφή
    svg.innerHTML = paths +
      `<circle cx="${cx}" cy="${cy}" r="94" fill="none" stroke="#d9a05a" stroke-width="8"/>` +
      `<circle cx="${cx}" cy="${cy}" r="94" fill="none" stroke="#c98d3f" stroke-width="8" stroke-dasharray="2 11" opacity=".55"/>`;

    // ---------- Πλοήγηση σταδίων ----------
    function go(id) {
      document.querySelectorAll('.stage').forEach(s => s.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      window.scrollTo(0, 0);
      // Στην οθόνη κριτικής πρωταγωνιστεί ο μεγάλος Τζίνο — ο μικρός κρύβεται.
      waiter.style.display = (id === 's-review') ? 'none' : '';
      stroll();
    }
    document.querySelectorAll('[data-next]').forEach(b =>
      b.addEventListener('click', () => go(b.dataset.next)));

    // ---------- Περιστροφή ----------
    let prize = null;
    let spun = false;
    function pickPrize() {
      const total = PRIZES.reduce((s, p) => s + p.weight, 0);
      let roll = Math.random() * total;
      for (const p of PRIZES) { roll -= p.weight; if (roll <= 0) return p; }
      return PRIZES[0];
    }
    document.getElementById('spinBtn').addEventListener('click', () => {
      if (spun) return;
      spun = true;
      prize = pickPrize();
      const idx = PRIZES.indexOf(prize);
      // Το κέντρο του τμήματος idx να καταλήξει κάτω από τον δείκτη (0°),
      // με τυχαία απόκλιση ±10° για φυσικότητα.
      const jitter = (Math.random() - 0.5) * (SEG - 16);
      const target = 360 * 5 - (idx * SEG + SEG / 2) - jitter;
      svg.style.transform = `rotate(${target}deg)`;
      document.getElementById('spinBtn').disabled = true;
      cheer(4900);
      setTimeout(() => {
        confetti(36);
        go('s-review');
      }, 4900);
    });

    // ---------- Mock κριτική (προσομοίωση Google) ----------
    // Όταν μπει πραγματικό writereview link μαγαζιού, εδώ επανέρχεται ο soft
    // check (κώδικας στο commit d5cb7d1): άνοιγμα Google + ξεκλείδωμα στην
    // επιστροφή αν πέρασαν αρκετά δευτερόλεπτα.
    const veil = document.getElementById('sheetVeil');
    let rating = 0;
    document.getElementById('reviewBtn').addEventListener('click', () => veil.classList.add('open'));
    veil.addEventListener('click', e => { if (e.target === veil) veil.classList.remove('open'); });
    document.querySelectorAll('#rateStars button').forEach(btn =>
      btn.addEventListener('click', () => {
        rating = +btn.dataset.v;
        document.querySelectorAll('#rateStars button').forEach(b =>
          b.classList.toggle('lit', +b.dataset.v <= rating));
        document.getElementById('publishBtn').disabled = rating === 0;
      }));
    document.getElementById('publishBtn').addEventListener('click', () => {
      veil.classList.remove('open');
      document.getElementById('thanksLine').textContent = 'Grazie mille! ❤️';
      issueCoupon();
      go('s-coupon');
      confetti(60);
      cheer(2800);
    });
    document.getElementById('skipBtn').addEventListener('click', () => {
      issueCoupon();
      go('s-coupon');
      confetti(60);
      cheer(2800);
    });

    // ---------- Κουπόνι ----------
    function issueCoupon() {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let code = 'NN-';
      for (let i = 0; i < 5; i++) code += chars[Math.floor(Math.random() * chars.length)];
      document.getElementById('couponEmoji').textContent = prize.emoji;
      document.getElementById('couponName').textContent = prize.name;
      document.getElementById('couponCode').textContent = code;
      const exp = new Date(Date.now() + 7 * 24 * 3600 * 1000);
      document.getElementById('couponExpiry').textContent =
        'Ισχύει έως ' + exp.toLocaleDateString('el-GR', { day: 'numeric', month: 'long' });
    }

    // ---------- Ο Τζίνο (σερβιτόρος-μασκότ, χωρίς λόγια) ----------
    const waiter = document.getElementById('waiter');
    let walkTimer;
    function stroll(ms = 900) {
      waiter.classList.add('walk');
      clearTimeout(walkTimer);
      walkTimer = setTimeout(() => waiter.classList.remove('walk'), ms);
    }
    let cheerTimer;
    function cheer(ms) {
      waiter.classList.add('cheer');
      clearTimeout(cheerTimer);
      cheerTimer = setTimeout(() => waiter.classList.remove('cheer'), ms);
    }
    stroll(1700); // μπαίνει περπατώντας

    // Κάθε λίγο κάνει και κάτι: βόλτα στην οθόνη, σάλτο πίτσας, στροφή ή πανηγύρι.
    const ACTS = [
      { cls: 'patrol', ms: 5300 },
      { cls: 'toss',   ms: 1000 },
      { cls: 'twirl',  ms: 1200 },
      { cls: 'cheer',  ms: 1500 },
    ];
    let actBusy = false;
    setInterval(() => {
      if (actBusy || document.hidden) return;
      actBusy = true;
      const act = ACTS[Math.floor(Math.random() * ACTS.length)];
      if (act.cls === 'patrol') stroll(act.ms - 200);
      waiter.classList.add(act.cls);
      setTimeout(() => { waiter.classList.remove(act.cls); actBusy = false; }, act.ms);
    }, 5500);

    // ---------- Κομφετί ----------
    const COLORS = ['#c8371f', '#e8a13c', '#2e7d43', '#f3e3c9', '#1a73e8'];
    function confetti(n) {
      const host = document.getElementById('phone');
      for (let i = 0; i < n; i++) {
        const c = document.createElement('i');
        c.className = 'confetti';
        c.style.left = Math.random() * 100 + '%';
        c.style.background = COLORS[i % COLORS.length];
        c.style.animationDuration = (1.6 + Math.random() * 1.6) + 's';
        c.style.animationDelay = (Math.random() * 0.5) + 's';
        c.style.transform = `rotate(${Math.random() * 360}deg)`;
        host.appendChild(c);
        setTimeout(() => c.remove(), 4000);
      }
    }

    // Απευθείας επίσκεψη (όχι μέσα στο iframe των Κριτικών): δείξε το link επιστροφής.
    if (window.self === window.top) document.getElementById('backSite').hidden = false;
  </script>
</body>
</html>
