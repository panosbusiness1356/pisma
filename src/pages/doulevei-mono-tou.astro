---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Αυτοματοποίηση',
  serviceType: 'Αυτοματισμοί γραφείου για επιχειρήσεις',
  description:
    'Η ρουτίνα του γραφείου τρέχει μόνη της: ταίριασμα πληρωμών, εισπράξεις, οργανωμένο Excel, καθημερινή αναφορά.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  areaServed: SITE.region,
};

const faqItems = [
  {
    q: 'Θα αλλάξω πρόγραμμα;',
    a: 'Όχι. Χτίζουμε πάνω σε ό,τι ήδη χρησιμοποιείτε — το τιμολογιακό σας, το email σας, το κινητό σας.',
  },
  {
    q: 'Αν χαλάσει;',
    a: 'Ειδοποιούμαστε εμείς πρώτοι, συνήθως πριν το προσέξετε. Η αποκατάσταση καλύπτεται από τη μηνιαία συντήρηση.',
  },
  {
    q: 'Τα δεδομένα μου;',
    a: 'Μένουν σε δικούς σας λογαριασμούς, σε servers εντός ΕΕ, με πλήρη συμμόρφωση GDPR.',
  },
  {
    q: 'Θα χάσει τη δουλειά του ο υπάλληλός μου;',
    a: 'Όχι — θα σταματήσει να πληκτρολογεί. Ο χρόνος που ελευθερώνεται πάει σε πελάτες, όχι σε καταχωρήσεις.',
  },
];
---

<Base
  title="Αυτοματοποίηση — Το γραφείο δουλεύει μόνο του | PISMA"
  description="Ταίριασμα πληρωμών, εισπράξεις, οργανωμένο Excel και καθημερινή αναφορά τρέχουν μόνα τους — εσείς βλέπετε μόνο το αποτέλεσμα."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Πυλώνας Β'"
    sub="Η βαρετή δουλειά ρουτίνας τρέχει μόνη της. Εσείς βλέπετε μόνο την αναφορά."
  >
    Αυτοματο<span class="accent">ποίηση</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="services-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Τι τρέχει μόνο του</p>
        <h2 id="services-title">Εφτά δουλειές ρουτίνας που φεύγουν από το κεφάλι σας.</h2>
      </div>
      <div class="grid-3">
        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 2.5 4.5 13.5h6l-1 8L19.5 10.5h-6z" />
            </svg>
          </span>
          <h3>Αυτόματο ταίριασμα πληρωμών</h3>
          <p>Κάθε πληρωμή που μπαίνει βρίσκει μόνη της το τιμολόγιό της. Τέλος το ψάξιμο ένα-ένα με το χέρι.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 3h7.5L19 7.5V21H7z" /><path d="M14.5 3v4.5H19" /><path d="M10.2 12.2h5.6M10.2 15.7h5.6" />
            </svg>
          </span>
          <h3>Οργανωμένο Excel</h3>
          <p>Οι κινήσεις σας σε ένα καθαρό Excel που ενημερώνεται μόνο του — η εικόνα της επιχείρησης πάντα φρέσκια.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9.5a6 6 0 0 1 12 0c0 5.2 1.8 6.5 1.8 6.5H4.2S6 14.7 6 9.5" /><path d="M10 19.7a2.2 2.2 0 0 0 4 0" />
            </svg>
          </span>
          <h3>Αυτόματος Κυνηγός Οφειλών</h3>
          <p>Ευγενικές υπενθυμίσεις στέλνονται αυτόματα, τη σωστή στιγμή. Εσείς βλέπετε μόνο ποιος πλήρωσε.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.7a8.3 8.3 0 0 1-12.1 7.4L3.5 20.5l1.4-5.2A8.3 8.3 0 1 1 21 11.7z" /><path d="M8.5 10.3h7M8.5 13.7h4.5" />
            </svg>
          </span>
          <h3>Η Ημέρα σου σε Ένα Μήνυμα</h3>
          <p>Κάθε απόγευμα, ένα μήνυμα: τι μπήκε, τι βγήκε, τι εκκρεμεί. Η επιχείρηση σε μία ματιά.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" />
            </svg>
          </span>
          <h3>Ο Κατάσκοπός σου</h3>
          <p>Βλέπετε τι κάνει ο ανταγωνισμός — τιμές, προσφορές, παρουσία — σε μια τακτική αναφορά. Χωρίς να ψάχνετε.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            </svg>
          </span>
          <h3>Το Εργαλείο Κριτικών</h3>
          <p>Το εργαλείο μας που κάνει τις κριτικές Google να μαζεύονται μόνες τους, κάθε μέρα. Τον μηχανισμό του τον δείχνουμε μόνο ζωντανά.</p>
          <a class="card-arrow" href="/kritikes/">Μάθε τι κάνει →</a>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5.5" width="18" height="13.5" rx="2.5" /><path d="M12 9l1.1 2.2 2.4.4-1.7 1.7.4 2.4-2.2-1.1-2.2 1.1.4-2.4-1.7-1.7 2.4-.4z" />
            </svg>
          </span>
          <h3>Κάρτα Πιστότητας</h3>
          <p>QR στο ταμείο: ο πελάτης μαζεύει σφραγίδες σε κάθε επίσκεψη και κερδίζει δώρο. Οι καλοί πελάτες ξανάρχονται — μετρημένα.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 2β. «Το ταίριασμα, ζωντανά» — σκηνή σε loop όπως «Η άνοδος στη Google»
       στην αρχική: το HTML έχει το τελικό state (όλα ταιριασμένα) — χωρίς JS
       ή με reduced motion μένει στατικό· το JS το «ξαναπαίζει» όσο φαίνεται. -->
  <section class="section" aria-labelledby="match-title">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="kicker kicker--ok">Δείτε το ζωντανά</p>
        <h2 id="match-title">Κάθε πληρωμή βρίσκει το τιμολόγιό της</h2>
        <p>Τρεις πληρωμές μπαίνουν στην τράπεζα — και ταιριάζουν μόνες τους, μία-μία.</p>
      </div>

      <div class="mt-stage" id="mt-stage" aria-hidden="true">
        <div class="mt-fx" id="mt-fx"></div>
        <div class="mt-panel">
          <div class="mt-top">
            <span class="mt-title">Ταίριασμα πληρωμών</span>
            <span class="mt-left num" id="mt-left">Εκκρεμή: 0</span>
          </div>
          <div class="mt-grid">
            <div class="mt-col">
              <p class="mt-col-label">Τράπεζα</p>
              <div class="mt-pay is-done" id="mt-p1"><span>Πληρωμή <b class="num">240€</b></span><span class="mt-pay-check">✓</span></div>
              <div class="mt-pay is-done" id="mt-p2"><span>Πληρωμή <b class="num">85€</b></span><span class="mt-pay-check">✓</span></div>
              <div class="mt-pay is-done" id="mt-p3"><span>Πληρωμή <b class="num">1.020€</b></span><span class="mt-pay-check">✓</span></div>
            </div>
            <div class="mt-col">
              <p class="mt-col-label">Τιμολόγια</p>
              <div class="mt-inv is-hit" id="mt-i1">
                <span>ΤΙΜ-0412 <b class="num">240€</b></span>
                <span class="mt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg></span>
                <span class="mt-ring"></span>
              </div>
              <div class="mt-inv is-hit" id="mt-i2">
                <span>ΤΙΜ-0415 <b class="num">85€</b></span>
                <span class="mt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg></span>
                <span class="mt-ring"></span>
              </div>
              <div class="mt-inv is-hit" id="mt-i3">
                <span>ΤΙΜ-0418 <b class="num">1.020€</b></span>
                <span class="mt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg></span>
                <span class="mt-ring"></span>
              </div>
            </div>
          </div>
          <p class="mt-win" id="mt-win">Όλα ταιριασμένα — χωρίς ούτε ένα κλικ ✓</p>
        </div>
      </div>
      <p class="mt-note">Ενδεικτική απεικόνιση.</p>
    </div>
  </section>

  <!-- 3. Η μέρα σε αριθμούς — οι τελικοί αριθμοί υπάρχουν στο HTML (fallback
       χωρίς JS)· το JS τους μηδενίζει και τους «μετράει» μία φορά όταν το
       section φανεί. Ίδια νούμερα με το παλιό τερματικό (14/1.230€/3). -->
  <section class="section section--tight" aria-labelledby="live-title">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="kicker">Ενδεικτικό παράδειγμα</p>
        <h2 id="live-title">Μία ημέρα του συστήματος, σε αριθμούς.</h2>
        <p>Έτσι μοιάζει η δουλειά που δεν έκανε κανείς με το χέρι.</p>
      </div>

      <div class="pd reveal" id="pd">
        <p class="pd__eyebrow num" id="pd-date">μια τυπική ημέρα</p>
        <div class="pd__row">
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="14">14</span></p>
            <p class="pd__label">πληρωμές ταιριάστηκαν</p>
          </div>
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="1230" data-suffix="€">1.230€</span></p>
            <p class="pd__label">εισπράχθηκαν</p>
          </div>
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="3">3</span></p>
            <p class="pd__label">νέες κριτικές Google</p>
          </div>
          <div class="pd__cell pd__cell--accent">
            <p class="pd__value num"><span class="pd__num" data-from="47" data-to="0">0</span></p>
            <p class="pd__label">λεπτά δικά σας</p>
          </div>
        </div>
        <p class="pd__closing">Τίποτα από αυτά δεν χρειάστηκε άνθρωπο.</p>
      </div>
    </div>
  </section>

  <!-- 4. Δείκτης Αυτοματισμού -->
  <section class="section section--tight" aria-labelledby="deiktis-title">
    <div class="container">
      <div class="card deiktis reveal">
        <div class="deiktis-text">
          <p class="kicker">Δείκτης Αυτοματισμού</p>
          <h2 id="deiktis-title">Ένα νούμερο, από το <span class="num">0</span> έως το <span class="num">100</span>.</h2>
          <p>Μετράει πόσες ώρες τον μήνα φεύγουν σε χειροκίνητη δουλειά, σε τρεις τομείς. Όσο λιγότερες οι ώρες, τόσο ψηλότερα το σκορ — στο 100 η ρουτίνα τρέχει χωρίς εσάς.</p>
          <a class="card-arrow" href="/tablo/">Μέτρησέ τον στο Ταμπλό →</a>
        </div>
        <ul class="deiktis-areas" aria-label="Τομείς που μετράει ο Δείκτης">
          <li class="chip">Πληρωμές <span class="muted">ώρες/μήνα</span></li>
          <li class="chip">Εισπράξεις <span class="muted">ώρες/μήνα</span></li>
          <li class="chip">Οργάνωση <span class="muted">ώρες/μήνα</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Αυτά που ρωτάνε όλοι πριν ξεκινήσουν.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Πόσο «μόνο του» δουλεύει το δικό σας γραφείο;"
    sub="Απαντήστε σε 5 ερωτήσεις και δείτε τον Δείκτη Αυτοματισμού σας."
    ctaText="Μέτρησε τον Δείκτη σου"
    ctaHref="/tablo/"
    note="2 λεπτά · δωρεάν · χωρίς στοιχεία"
  />
</Base>

<script>
  // «Η μέρα σε αριθμούς»: οι τελικοί αριθμοί υπάρχουν στο HTML (fallback χωρίς
  // JS). Το JS τους μηδενίζει και, όταν το section μπει στην οθόνη, μετράει
  // προς τα πάνω ΜΙΑ φορά — κλιμακωτά ανά στήλη. Οι ταχύτητες διαβάζονται από
  // τα --pd-count-duration/--pd-stagger του CSS. Reduced motion: τελικοί
  // αριθμοί αμέσως, καμία κίνηση.
  const pd = document.getElementById('pd');
  if (pd) {
    const pdCells = Array.from(pd.querySelectorAll<HTMLElement>('.pd__cell'));
    const pdNums = Array.from(pd.querySelectorAll<HTMLElement>('.pd__num'));
    const pdReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const pdCss = getComputedStyle(pd);
    const cssMs = (name: string, fallback: number) => {
      const v = parseFloat(pdCss.getPropertyValue(name));
      return Number.isNaN(v) ? fallback : v;
    };
    const DURATION = cssMs('--pd-count-duration', 2600);
    const STAGGER = cssMs('--pd-stagger', 220);

    const fmt = (v: number, suffix?: string) => Math.round(v).toLocaleString('el-GR') + (suffix || '');
    const setFinal = () =>
      pdNums.forEach((n) => { n.textContent = fmt(Number(n.dataset.to), n.dataset.suffix); });

    if (!pdReduce) {
      pd.classList.add('pd--animate');
      pdNums.forEach((n) => { n.textContent = fmt(Number(n.dataset.from), n.dataset.suffix); });

      const count = () => {
        let start: number | null = null;
        const step = (ts: number) => {
          if (start === null) start = ts;
          const k = Math.min((ts - start) / DURATION, 1);
          const eased = 1 - Math.pow(1 - k, 3);
          pdNums.forEach((n, i) => {
            const p = Math.max(0, Math.min(1, eased * 1.42 - i * 0.14));
            const from = Number(n.dataset.from);
            const to = Number(n.dataset.to);
            n.textContent = fmt(from + (to - from) * p, n.dataset.suffix);
          });
          if (k < 1) requestAnimationFrame(step);
          else setFinal();
        };
        requestAnimationFrame(step);
      };

      const play = () => {
        pdCells.forEach((c, i) => { c.style.transitionDelay = `${i * STAGGER}ms`; });
        pd.classList.add('pd--in');
        window.setTimeout(count, STAGGER + 200);
      };

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              play();
            }
          },
          { threshold: 0.35 }
        );
        io.observe(pd);
      } else {
        play();
      }
    }
    // Με reduced motion: το HTML έχει ήδη τους τελικούς αριθμούς.
  }

  // «Το ταίριασμα, ζωντανά»: το HTML έχει το τελικό state (όλα ταιριασμένα).
  // Με JS + ορατότητα: επαναφορά σε «3 εκκρεμή» και ζωντανό ταίριασμα σε loop·
  // όταν βγει από την οθόνη, σταματά και γυρνά στο τελικό state. Τα ιπτάμενα
  // ποσά παίρνουν inline styles — τα scoped styles δεν πιάνουν JS elements.
  const mtStage = document.getElementById('mt-stage');
  const mtReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (mtStage && !mtReduce && 'IntersectionObserver' in window) {
    const mtFx = document.getElementById('mt-fx')!;
    const mtLeft = document.getElementById('mt-left')!;
    const mtWin = document.getElementById('mt-win')!;
    const pays = ['mt-p1', 'mt-p2', 'mt-p3'].map((id) => document.getElementById(id)!);
    const invs = ['mt-i1', 'mt-i2', 'mt-i3'].map((id) => document.getElementById(id)!);
    const amounts = ['240€', '85€', '1.020€'];
    let mtTimers: number[] = [];
    let mtPending = 0;
    let mtActive = false;

    const mtLater = (fn: () => void, ms: number) => mtTimers.push(window.setTimeout(fn, ms));
    const mtRaf2 = (fn: () => void) => requestAnimationFrame(() => requestAnimationFrame(fn));
    const mtPaint = () => { mtLeft.textContent = `Εκκρεμή: ${mtPending}`; };

    const mtHit = (k: number) => {
      pays[k].classList.add('is-done');
      invs[k].classList.add('is-hit');
      mtPending = Math.max(0, mtPending - 1);
      mtPaint();
      const ring = invs[k].querySelector<HTMLElement>('.mt-ring');
      if (ring) {
        ring.style.transition = 'none'; ring.style.opacity = '.9'; ring.style.transform = 'scale(1)';
        mtRaf2(() => {
          ring.style.transition = 'opacity .6s ease-out, transform .6s ease-out';
          ring.style.opacity = '0'; ring.style.transform = 'scale(1.12)';
        });
      }
    };

    const mtFly = (k: number) => {
      const sr = mtStage.getBoundingClientRect();
      const pr = pays[k].getBoundingClientRect();
      const ir = invs[k].getBoundingClientRect();
      const chip = document.createElement('span');
      chip.textContent = amounts[k];
      chip.style.cssText = `position:absolute;left:${Math.round(pr.right - sr.left - 30)}px;top:${Math.round(pr.top - sr.top + pr.height / 2 - 13)}px;z-index:3;background:#E1F5EE;color:#0F6E56;font-weight:700;font-size:.72rem;padding:4px 10px;border-radius:999px;border:1px solid #A5D6B8;box-shadow:0 8px 22px rgba(0,0,0,.35);white-space:nowrap;transition:all .8s cubic-bezier(.4,0,.55,1);opacity:0;line-height:1.3`;
      mtFx.appendChild(chip);
      mtRaf2(() => {
        chip.style.opacity = '1';
        chip.style.left = `${Math.round(ir.left - sr.left + 8)}px`;
        chip.style.top = `${Math.round(ir.top - sr.top + ir.height / 2 - 13)}px`;
        chip.style.transform = 'scale(.82)';
      });
      mtLater(() => { chip.remove(); mtHit(k); }, 820);
    };

    const mtFinal = () => {
      pays.forEach((p) => p.classList.add('is-done'));
      invs.forEach((i) => i.classList.add('is-hit'));
      mtPending = 0; mtPaint();
      mtWin.style.opacity = '1'; mtWin.style.transform = 'none';
    };

    const mtCycle = () => {
      mtTimers.forEach(clearTimeout); mtTimers = []; mtFx.innerHTML = '';
      pays.forEach((p) => p.classList.remove('is-done'));
      invs.forEach((i) => i.classList.remove('is-hit'));
      mtPending = 3; mtPaint();
      mtWin.style.opacity = '0'; mtWin.style.transform = 'translateY(6px)';
      for (let k = 0; k < 3; k++) mtLater(() => mtFly(k), 1000 + k * 1400);
      // Δίχτυ ασφαλείας: το φινάλε κλειδώνει στο στατικό state.
      mtLater(mtFinal, 5400);
      mtLater(mtCycle, 9200);
    };

    const mtIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !mtActive) { mtActive = true; mtCycle(); }
          else if (!e.isIntersecting && mtActive) {
            mtActive = false;
            mtTimers.forEach(clearTimeout); mtTimers = []; mtFx.innerHTML = '';
            mtFinal();
          }
        }
      },
      { threshold: 0.35 }
    );
    mtIo.observe(mtStage);
  }
