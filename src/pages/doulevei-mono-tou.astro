---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Αυτοματοποίηση',
  serviceType: 'Αυτοματισμοί για επιχειρήσεις',
  description:
    'Η ρουτίνα του γραφείου τρέχει μόνη της: ταίριασμα πληρωμών, εισπράξεις, οργανωμένο Excel και αυτοματισμοί κατά παραγγελία.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  areaServed: SITE.region,
};

// Σειρά για τέλειο bento 4 στηλών: [κατά παραγγελία(λωρίδα 4)] [match(2)+chase+excel] [menu+eye(λωρίδα 3)]
const services = [
  { t: 'Αυτοματισμοί κατά παραγγελία', d: 'Ό,τι κάνετε με τα ίδια βήματα κάθε φορά, μπορεί να τρέχει μόνο του, από μια απλή ροή μέχρι μια ολόκληρη εφαρμογή, πάνω στα προγράμματα που ήδη χρησιμοποιείτε.', icon: 'custom', size: 'strip4', href: '/epikoinonia/', cta: 'Πείτε μας τη ρουτίνα σας →' },
  { t: 'Αυτόματο ταίριασμα πληρωμών', d: 'Κάθε πληρωμή βρίσκει μόνη της το τιμολόγιό της.', icon: 'match', size: 'big' },
  { t: 'Αυτόματος Κυνηγός Οφειλών', d: 'Ευγενικές υπενθυμίσεις, αυτόματα, τη σωστή στιγμή.', icon: 'chase', logos: ['whatsapp-icon.svg', 'viber.svg'] },
  { t: 'Οργανωμένο Excel', d: 'Οι κινήσεις σας σε ένα Excel που ενημερώνεται μόνο του.', icon: 'excel', logos: ['excel.svg'] },
  { t: 'Ψηφιακό Μενού', d: 'QR στο τραπέζι, μενού στο κινητό. Αλλάζετε τιμές χωρίς επανεκτυπώσεις.', icon: 'menu', href: '/psifiako-menou/' },
  { t: 'Ο Κατάσκοπός σας', d: 'Τι κάνει ο ανταγωνισμός (τιμές, προσφορές) σε μια τακτική αναφορά.', icon: 'eye', size: 'strip3' },
];

const faqItems = [
  {
    q: 'Θα αλλάξω πρόγραμμα;',
    a: 'Όχι. Χτίζουμε πάνω σε ό,τι ήδη χρησιμοποιείτε: το τιμολογιακό σας, το email σας, το κινητό σας.',
  },
  {
    q: 'Αν χαλάσει;',
    a: 'Ειδοποιούμαστε εμείς πρώτοι, συνήθως πριν το προσέξετε. Η αποκατάσταση καλύπτεται από τη μηνιαία συντήρηση.',
  },
  {
    q: 'Τα δεδομένα μου;',
    a: 'Μένουν σε δικούς σας λογαριασμούς, σε servers εντός ΕΕ, με πλήρη συμμόρφωση GDPR.',
  },
  {
    q: 'Θα χάσει τη δουλειά του ο υπάλληλός μου;',
    a: 'Όχι. Θα σταματήσει να πληκτρολογεί, και ο χρόνος που ελευθερώνεται πάει στους πελάτες.',
  },
];
---

<Base
  title="Αυτοματισμοί: το γραφείο δουλεύει μόνο του | PISMA"
  description="Ταίριασμα πληρωμών, εισπράξεις και οργανωμένο Excel τρέχουν μόνα τους. Ό,τι άλλο χρειάζεται η ρουτίνα σας, κατά παραγγελία."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    sub="Χτίζουμε κάθε αυτοματισμό πάνω στον τρόπο που δουλεύει η επιχείρησή σας."
  >
    <span class="accent">Αυτοματισμοί</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="services-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Τι τρέχει μόνο του</p>
        <h2 id="services-title">Οι δουλειές ρουτίνας που φεύγουν από το κεφάλι σας.</h2>
      </div>
      <ServiceCards services={services} cta="Μάθετε τι κάνει →" />
    </div>
  </section>

  <!-- 2β. «Ροή αυτοματισμού», σκηνή σε loop όπως «Η άνοδος στη Google» στην
       αρχική: ένα γεγονός περνάει από τρία βήματα και βγαίνει αποτέλεσμα. Το
       HTML έχει το τελικό state (όλα αναμμένα, αποτέλεσμα ορατό)· χωρίς JS ή με
       reduced motion μένει στατικό, το JS το ξαναπαίζει με άλλα γεγονότα όσο
       φαίνεται. -->
  <section class="section" aria-labelledby="flow-title">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="kicker kicker--ok">Δείτε το ζωντανά</p>
        <h2 id="flow-title">Ό,τι συμβαίνει, το σύστημα το ολοκληρώνει.</h2>
        <p>Ένα γεγονός μπαίνει, περνάει από τρία βήματα και βγαίνει έτοιμο. Ξανά και ξανά, όλη μέρα.</p>
      </div>

      <div class="af" id="af" aria-hidden="true">
        <div class="af-top">
          <span class="af-title">Ροή αυτοματισμού</span>
          <span class="af-status"><i></i>Σε λειτουργία</span>
        </div>
        <div class="af-flow">
          <span class="af-line"></span>
          <span class="af-dot" id="af-dot"></span>
          <div class="af-ev" id="af-ev">
            <span class="af-cap">Γεγονός</span>
            <span class="af-ev-text" id="af-ev-text">Νέο αίτημα</span>
          </div>
          <div class="af-node is-on"><span class="af-ring"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/></svg><span class="af-node-label">Διαβάζει</span></div>
          <div class="af-node is-on"><span class="af-ring"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v6"/><path d="M12 10l-6 5v5M12 10l6 5v5"/><circle cx="12" cy="4" r="1.6"/><circle cx="6" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/></svg><span class="af-node-label">Αποφασίζει</span></div>
          <div class="af-node is-on"><span class="af-ring"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 3L5 14h6l-1 7 8-11h-6z"/></svg><span class="af-node-label">Ενεργεί</span></div>
          <div class="af-out is-in" id="af-out">
            <span class="af-cap">Αποτέλεσμα</span>
            <span class="af-out-row"><span class="af-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg></span><span class="af-out-text" id="af-out-text">Καταχωρήθηκε και απαντήθηκε</span></span>
          </div>
        </div>
        <div class="af-foot">
          <span class="af-count-wrap"><b class="num" id="af-count">38</b>ολοκληρώθηκαν σήμερα</span>
          <span class="af-chip num">Κλικ δικά σας: 0</span>
        </div>
      </div>
      <p class="af-note">Ενδεικτική απεικόνιση.</p>
    </div>
  </section>

  <!-- 4. Δείκτης Αυτοματισμού: κείμενο + κουμπί αριστερά, μετρητής 0 έως 100
       δεξιά. Ο μετρητής γεμίζει (CSS transition) όταν το global reveal βάλει
       is-in· χωρίς JS μένει στο 72 % από το HTML (inline style). -->
  <section class="section section--tight" aria-labelledby="deiktis-title">
    <div class="container">
      <div class="dk reveal">
        <div class="dk-text">
          <p class="kicker">Δείκτης Αυτοματισμού</p>
          <h2 id="deiktis-title">Το σκορ της ρουτίνας σας, από 0 έως 100.</h2>
          <p>Δέκα σύντομες ερωτήσεις για πληρωμές, εισπράξεις και οργάνωση. Όσο λιγότερες ώρες πάνε σε χειροκίνητη δουλειά, τόσο ψηλότερα το σκορ.</p>
          <a class="btn btn--orange btn--sm" href="/tablo/">Μετρήστε την επιχείρησή σας →</a>
        </div>
        <div class="dk-meter" aria-hidden="true">
          <div class="dk-scale">
            <span class="dk-fill"></span>
            <span class="dk-marker"><b class="num">72</b></span>
          </div>
          <div class="dk-ends num"><span>0</span><span>100</span></div>
          <p class="dk-cap">ενδεικτικό σκορ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Αυτά που ρωτάνε όλοι πριν ξεκινήσουν.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Πόσο «μόνο του» δουλεύει το δικό σας γραφείο;"
    sub="Απαντήστε σε 12 σύντομες ερωτήσεις και δείτε τον Δείκτη Αυτοματισμού σας."
    ctaText="Μετρήστε την επιχείρησή σας"
    ctaHref="/tablo/"
    note="2 λεπτά · δωρεάν · χωρίς στοιχεία"
  />
</Base>

<script>
  // «Ροή αυτοματισμού»: το HTML έχει το τελικό state (όλα αναμμένα, αποτέλεσμα
  // ορατό). Με JS + ορατότητα παίζει σε loop: νέο γεγονός αριστερά, ο παλμός
  // περνάει από τα τρία βήματα (καθένα ανάβει όταν φτάσει), το αποτέλεσμα
  // εμφανίζεται δεξιά και ο μετρητής ανεβαίνει. Όταν βγει από την οθόνη,
  // σταματά και γυρνά στο τελικό state. Ο παλμός τοποθετείται με px από τα
  // getBoundingClientRect, οπότε δουλεύει και στην κάθετη διάταξη του κινητού.
  const af = document.getElementById('af');
  const afReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (af && !afReduce && 'IntersectionObserver' in window) {
    const evEl = document.getElementById('af-ev')!;
    const evText = document.getElementById('af-ev-text')!;
    const outEl = document.getElementById('af-out')!;
    const outText = document.getElementById('af-out-text')!;
    const dot = document.getElementById('af-dot')!;
    const count = document.getElementById('af-count')!;
    const nodes = Array.from(af.querySelectorAll<HTMLElement>('.af-node'));
    const flow = dot.parentElement as HTMLElement; // ο παλμός είναι absolute μέσα στο .af-flow
    const EVENTS: [string, string][] = [
      ['Νέο αίτημα', 'Καταχωρήθηκε και απαντήθηκε'],
      ['Νέα εγγραφή', 'Ενημερώθηκαν όλα τα αρχεία'],
      ['Νέο μήνυμα', 'Απαντήθηκε αυτόματα'],
      ['Νέα πληρωμή', 'Ταιριάστηκε και αρχειοθετήθηκε'],
      ['Προθεσμία', 'Η ειδοποίηση στάλθηκε εγκαίρως'],
      ['Τέλος ημέρας', 'Η αναφορά είναι έτοιμη'],
    ];
    const HOP = 450;
    let timers: number[] = [];
    let idx = 0;
    let done = 37;
    let active = false;

    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const stop = () => { timers.forEach(clearTimeout); timers = []; };
    const center = (el: HTMLElement) => {
      const s = flow.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      return { x: r.left - s.left + r.width / 2, y: r.top - s.top + r.height / 2 };
    };
    const place = (el: HTMLElement, animate: boolean) => {
      const c = center(el);
      dot.style.transition = animate
        ? `left ${HOP}ms cubic-bezier(.4, 0, .6, 1), top ${HOP}ms cubic-bezier(.4, 0, .6, 1), opacity .3s`
        : 'opacity .3s';
      dot.style.left = `${Math.round(c.x)}px`;
      dot.style.top = `${Math.round(c.y)}px`;
    };

    const final = () => {
      stop();
      nodes.forEach((n) => n.classList.add('is-on'));
      outEl.classList.add('is-in');
      dot.style.opacity = '0';
    };

    const cycle = () => {
      stop();
      const [inT, outT] = EVENTS[idx % EVENTS.length];
      idx++;
      nodes.forEach((n) => n.classList.remove('is-on'));
      outEl.classList.remove('is-in');
      dot.style.opacity = '0';
      place(evEl, false);
      // Νέο γεγονός: αλλαγή κειμένου + ξαναπαίξιμο του pop (reflow ανάμεσα).
      evEl.classList.remove('is-new');
      void evEl.offsetWidth;
      evText.textContent = inT;
      evEl.classList.add('is-new');

      later(() => { dot.style.opacity = '1'; place(nodes[0], true); }, 650);
      nodes.forEach((n, k) => later(() => {
        n.classList.add('is-on');
        place(nodes[k + 1] || outEl, true);
      }, 650 + (k + 1) * HOP));
      later(() => {
        dot.style.opacity = '0';
        outText.textContent = outT;
        outEl.classList.add('is-in');
        done++;
        count.textContent = done.toLocaleString('el-GR');
      }, 650 + 4 * HOP);
      later(cycle, 5200);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !active) { active = true; cycle(); }
          else if (!e.isIntersecting && active) { active = false; final(); }
        }
      },
      { threshold: 0.35 }
    );
    io.observe(af);
  }
</script>

<style>
  /* Κάρτα με tag δίπλα στο εικονίδιο */
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .card-top .tag { margin-top: 4px; }

  /* ---- «Ροή αυτοματισμού» ---- */
  .af {
    position: relative; max-width: 900px; margin-inline: auto;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r);
    box-shadow: var(--shadow); overflow: hidden;
    padding: clamp(18px, 3vw, 28px) clamp(18px, 3.5vw, 36px);
  }
  .af::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(560px 260px at 50% 48%, rgba(var(--orange-rgb), .08), transparent 70%);
  }
  .af-top {
    position: relative; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    margin-bottom: clamp(28px, 4.5vw, 44px);
  }
  .af-title { font-size: .8rem; font-weight: 700; color: var(--navy); }
  .af-status {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: .7rem; color: var(--muted);
    border: 1px solid var(--line-strong); border-radius: 999px; padding: 3px 10px;
  }
  .af-status i {
    width: 7px; height: 7px; border-radius: 50%; background: var(--orange);
    animation: af-beat 1.8s ease-out infinite;
  }
  @keyframes af-beat {
    0% { box-shadow: 0 0 0 0 rgba(var(--orange-rgb), .55); }
    100% { box-shadow: 0 0 0 8px rgba(var(--orange-rgb), 0); }
  }

  .af-flow {
    position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .af-line { position: absolute; left: 24px; right: 24px; top: 50%; height: 1px; background: var(--line-strong); }
  .af-dot {
    position: absolute; left: 0; top: 0; z-index: 3; width: 12px; height: 12px; margin: -6px 0 0 -6px;
    border-radius: 50%; background: var(--orange); opacity: 0; pointer-events: none;
    box-shadow: 0 0 0 3px rgba(var(--orange-rgb), .25), 0 0 18px rgba(var(--orange-rgb), .85);
  }

  .af-ev, .af-out {
    position: relative; z-index: 1; flex: 0 0 auto;
    background: var(--bg); border: 1px solid var(--line-strong); border-radius: 12px;
    padding: 9px 12px; display: grid; gap: 4px;
  }
  .af-ev { width: clamp(126px, 19%, 176px); }
  .af-out { width: clamp(156px, 27%, 236px); }
  .af-cap {
    font-size: .62rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--muted);
  }
  .af-ev-text { font-size: .78rem; font-weight: 600; line-height: 1.3; color: var(--ink); }
  .af-ev.is-new { animation: af-pop .5s var(--ease); }
  @keyframes af-pop { from { opacity: .2; transform: translateY(8px); } }

  .af-node {
    position: relative; z-index: 1; flex: 0 0 auto; width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--card-2); border: 1.5px solid var(--line-strong); color: var(--muted);
    transition: border-color .35s, color .35s, background-color .35s;
  }
  .af-node > svg { width: 22px; height: 22px; }
  .af-node.is-on { border-color: #fff; color: #fff; background: rgba(255, 255, 255, .08); }
  .af-ring { position: absolute; inset: -2px; border-radius: 50%; border: 1.5px solid var(--orange); opacity: 0; }
  .af-node.is-on .af-ring { animation: af-ring .7s ease-out; }
  @keyframes af-ring { 0% { opacity: .9; transform: scale(.9); } 100% { opacity: 0; transform: scale(1.55); } }
  .af-node-label {
    position: absolute; top: calc(100% + 9px); left: 50%; transform: translateX(-50%);
    white-space: nowrap; font-size: .7rem; font-weight: 600; color: var(--muted);
    transition: color .35s;
  }
  .af-node.is-on .af-node-label { color: var(--ink); }

  .af-out {
    opacity: .35; transform: translateX(-6px);
    transition: opacity .45s, transform .45s var(--ease), border-color .45s;
  }
  .af-out.is-in { opacity: 1; transform: none; border-color: rgba(var(--orange-rgb), .55); }
  .af-out-row { display: flex; align-items: flex-start; gap: 7px; font-size: .76rem; line-height: 1.3; color: var(--ink); }
  .af-check {
    flex: none; width: 16px; height: 16px; margin-top: 1px; border-radius: 50%;
    background: var(--orange); color: #fff; display: inline-flex; align-items: center; justify-content: center;
    transform: scale(0); transition: transform .45s cubic-bezier(.3, 1.8, .4, 1);
  }
  .af-check svg { width: 10px; height: 10px; }
  .af-out.is-in .af-check { transform: scale(1); }

  .af-foot {
    position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    margin-top: clamp(44px, 5.5vw, 58px); padding-top: 16px; border-top: 1px solid var(--line);
    font-size: .78rem; color: var(--muted);
  }
  .af-count-wrap b { font-size: 1.45rem; font-weight: 500; color: var(--navy); margin-right: 9px; vertical-align: -2px; }
  .af-chip {
    font-size: .7rem; color: var(--orange-text);
    border: 1px solid rgba(var(--orange-rgb), .4); border-radius: 999px; padding: 3px 10px;
  }
  .af-note { text-align: center; color: var(--muted); font-size: .78rem; margin: 12px auto 0; }

  /* κινητό: κάθετη ροή, ετικέτες δεξιά από τους κύκλους */
  @media (max-width: 719px) {
    .af-flow { flex-direction: column; align-items: center; gap: 22px; }
    .af-line { left: 50%; right: auto; top: 12px; bottom: 12px; width: 1px; height: auto; }
    .af-ev, .af-out { width: min(100%, 260px); }
    .af-out { transform: translateY(-6px); }
    .af-node-label { top: 50%; left: calc(100% + 12px); transform: translateY(-50%); }
    .af-foot { margin-top: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .af-status i, .af-ev.is-new, .af-node.is-on .af-ring { animation: none; }
    .af-out, .af-check, .af-node { transition: none; }
  }

  /* ---- Δείκτης Αυτοματισμού ---- */
  .dk {
    display: grid; grid-template-columns: 1.1fr .9fr; align-items: center;
    gap: clamp(28px, 5vw, 64px);
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow);
    padding: clamp(26px, 4vw, 48px);
  }
  .dk-text .kicker { margin-bottom: 14px; }
  .dk-text h2 { margin-bottom: 12px; }
  .dk-text p { color: var(--muted); max-width: 46ch; }
  .dk-text .btn { margin-top: 22px; }
  .dk-meter { padding: 40px 12px 0; }
  .dk-scale {
    position: relative; height: 10px; border-radius: 999px;
    background: var(--bg); border: 1px solid var(--line-strong);
  }
  .dk-fill {
    position: absolute; left: 0; top: 0; bottom: 0; width: 72%; border-radius: 999px;
    background: var(--grad); transition: width 1.6s var(--ease) .3s;
  }
  .dk-marker {
    position: absolute; top: 50%; left: 72%; width: 22px; height: 22px; margin: -11px 0 0 -11px;
    border-radius: 50%; background: #fff;
    box-shadow: 0 0 0 4px rgba(var(--orange-rgb), .3), var(--shadow);
    transition: left 1.6s var(--ease) .3s;
  }
  .dk-marker b {
    position: absolute; bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%);
