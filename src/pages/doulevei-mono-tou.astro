---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Αυτοματοποίηση',
  serviceType: 'Αυτοματισμοί γραφείου για επιχειρήσεις',
  description:
    'Η ρουτίνα του γραφείου τρέχει μόνη της: ταίριασμα πληρωμών, εισπράξεις, οργανωμένο Excel, καθημερινή αναφορά.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  areaServed: SITE.region,
};

const faqItems = [
  {
    q: 'Θα αλλάξω πρόγραμμα;',
    a: 'Όχι. Χτίζουμε πάνω σε ό,τι ήδη χρησιμοποιείτε — το τιμολογιακό σας, το email σας, το κινητό σας.',
  },
  {
    q: 'Αν χαλάσει;',
    a: 'Ειδοποιούμαστε εμείς πρώτοι, συνήθως πριν το προσέξετε. Η αποκατάσταση καλύπτεται από τη μηνιαία συντήρηση.',
  },
  {
    q: 'Τα δεδομένα μου;',
    a: 'Μένουν σε δικούς σας λογαριασμούς, σε servers εντός ΕΕ, με πλήρη συμμόρφωση GDPR.',
  },
  {
    q: 'Θα χάσει τη δουλειά του ο υπάλληλός μου;',
    a: 'Όχι — θα σταματήσει να πληκτρολογεί. Ο χρόνος που ελευθερώνεται πάει σε πελάτες, όχι σε καταχωρήσεις.',
  },
];
---

<Base
  title="Αυτοματοποίηση — Το γραφείο δουλεύει μόνο του | PISMA"
  description="Ταίριασμα πληρωμών, εισπράξεις, οργανωμένο Excel και καθημερινή αναφορά τρέχουν μόνα τους — εσείς βλέπετε μόνο το αποτέλεσμα."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Πυλώνας Β'"
    sub="Η βαρετή δουλειά ρουτίνας τρέχει μόνη της. Εσείς βλέπετε μόνο την αναφορά."
  >
    Αυτοματο<span class="accent">ποίηση</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="services-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Τι τρέχει μόνο του</p>
        <h2 id="services-title">Εφτά δουλειές ρουτίνας που φεύγουν από το κεφάλι σας.</h2>
      </div>
      <div class="grid-3">
        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 2.5 4.5 13.5h6l-1 8L19.5 10.5h-6z" />
            </svg>
          </span>
          <h3>Αυτόματο ταίριασμα πληρωμών</h3>
          <p>Κάθε πληρωμή που μπαίνει βρίσκει μόνη της το τιμολόγιό της. Τέλος το ψάξιμο ένα-ένα με το χέρι.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 3h7.5L19 7.5V21H7z" /><path d="M14.5 3v4.5H19" /><path d="M10.2 12.2h5.6M10.2 15.7h5.6" />
            </svg>
          </span>
          <h3>Οργανωμένο Excel</h3>
          <p>Οι κινήσεις σας σε ένα καθαρό Excel που ενημερώνεται μόνο του — η εικόνα της επιχείρησης πάντα φρέσκια.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9.5a6 6 0 0 1 12 0c0 5.2 1.8 6.5 1.8 6.5H4.2S6 14.7 6 9.5" /><path d="M10 19.7a2.2 2.2 0 0 0 4 0" />
            </svg>
          </span>
          <h3>Αυτόματος Κυνηγός Οφειλών</h3>
          <p>Ευγενικές υπενθυμίσεις στέλνονται αυτόματα, τη σωστή στιγμή. Εσείς βλέπετε μόνο ποιος πλήρωσε.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.7a8.3 8.3 0 0 1-12.1 7.4L3.5 20.5l1.4-5.2A8.3 8.3 0 1 1 21 11.7z" /><path d="M8.5 10.3h7M8.5 13.7h4.5" />
            </svg>
          </span>
          <h3>Η Ημέρα σου σε Ένα Μήνυμα</h3>
          <p>Κάθε απόγευμα, ένα μήνυμα: τι μπήκε, τι βγήκε, τι εκκρεμεί. Η επιχείρηση σε μία ματιά.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" />
            </svg>
          </span>
          <h3>Ο Κατάσκοπός σου</h3>
          <p>Βλέπετε τι κάνει ο ανταγωνισμός — τιμές, προσφορές, παρουσία — σε μια τακτική αναφορά. Χωρίς να ψάχνετε.</p>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            </svg>
          </span>
          <h3>Ο Τροχός των Κριτικών</h3>
          <p>QR στο τραπέζι: ο πελάτης σκανάρει, κερδίζει δώρο και αφήνει κριτική στο Google. Οι κριτικές μαζεύονται μόνες τους, κάθε μέρα.</p>
          <a class="card-arrow" href="/kritikes/">Δες πώς δουλεύει →</a>
        </article>

        <article class="card reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5.5" width="18" height="13.5" rx="2.5" /><path d="M12 9l1.1 2.2 2.4.4-1.7 1.7.4 2.4-2.2-1.1-2.2 1.1.4-2.4-1.7-1.7 2.4-.4z" />
            </svg>
          </span>
          <h3>Κάρτα Πιστότητας</h3>
          <p>QR στο ταμείο: ο πελάτης μαζεύει σφραγίδες σε κάθε επίσκεψη και κερδίζει δώρο. Οι καλοί πελάτες ξανάρχονται — μετρημένα.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Η μέρα σε αριθμούς — οι τελικοί αριθμοί υπάρχουν στο HTML (fallback
       χωρίς JS)· το JS τους μηδενίζει και τους «μετράει» μία φορά όταν το
       section φανεί. Ίδια νούμερα με το παλιό τερματικό (14/1.230€/3). -->
  <section class="section" aria-labelledby="live-title">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="kicker">Δείτε το ζωντανά</p>
        <h2 id="live-title">Μία ημέρα του συστήματος, σε αριθμούς.</h2>
        <p>Έτσι μοιάζει η δουλειά που δεν έκανε κανείς με το χέρι.</p>
      </div>

      <div class="pd reveal" id="pd">
        <p class="pd__eyebrow num" id="pd-date">χθες</p>
        <div class="pd__row">
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="14">14</span></p>
            <p class="pd__label">πληρωμές ταιριάστηκαν</p>
          </div>
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="1230" data-suffix="€">1.230€</span></p>
            <p class="pd__label">εισπράχθηκαν</p>
          </div>
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="3">3</span></p>
            <p class="pd__label">νέες κριτικές Google</p>
          </div>
          <div class="pd__cell pd__cell--accent">
            <p class="pd__value num"><span class="pd__num" data-from="47" data-to="0">0</span></p>
            <p class="pd__label">λεπτά δικά σας</p>
          </div>
        </div>
        <p class="pd__closing">Τίποτα από αυτά δεν χρειάστηκε άνθρωπο.</p>
      </div>
    </div>
  </section>

  <!-- 4. Δείκτης Αυτοματισμού -->
  <section class="section section--tight" aria-labelledby="deiktis-title">
    <div class="container">
      <div class="card deiktis reveal">
        <div class="deiktis-text">
          <p class="kicker">Δείκτης Αυτοματισμού</p>
          <h2 id="deiktis-title">Ένα νούμερο, από το <span class="num">0</span> έως το <span class="num">100</span>.</h2>
          <p>Μετράει πόσες ώρες τον μήνα φεύγουν σε χειροκίνητη δουλειά, σε τρεις τομείς. Όσο λιγότερες οι ώρες, τόσο ψηλότερα το σκορ — στο 100 η ρουτίνα τρέχει χωρίς εσάς.</p>
          <a class="card-arrow" href="/tablo/">Μέτρησέ τον στο Ταμπλό →</a>
        </div>
        <ul class="deiktis-areas" aria-label="Τομείς που μετράει ο Δείκτης">
          <li class="chip">Πληρωμές <span class="muted">ώρες/μήνα</span></li>
          <li class="chip">Εισπράξεις <span class="muted">ώρες/μήνα</span></li>
          <li class="chip">Οργάνωση <span class="muted">ώρες/μήνα</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Αυτά που ρωτάνε όλοι πριν ξεκινήσουν.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Πόσο «μόνο του» δουλεύει το δικό σας γραφείο;"
    sub="Απαντήστε σε 5 ερωτήσεις και δείτε τον Δείκτη Αυτοματισμού σας."
    ctaText="Μέτρησε τον Δείκτη σου"
    ctaHref="/tablo/"
    note="2 λεπτά · δωρεάν · χωρίς στοιχεία"
  />
</Base>

<script>
  // «Η μέρα σε αριθμούς»: οι τελικοί αριθμοί υπάρχουν στο HTML (fallback χωρίς
  // JS). Το JS τους μηδενίζει και, όταν το section μπει στην οθόνη, μετράει
  // προς τα πάνω ΜΙΑ φορά — κλιμακωτά ανά στήλη. Οι ταχύτητες διαβάζονται από
  // τα --pd-count-duration/--pd-stagger του CSS. Reduced motion: τελικοί
  // αριθμοί αμέσως, καμία κίνηση.
  const pd = document.getElementById('pd');
  if (pd) {
    const pdCells = Array.from(pd.querySelectorAll<HTMLElement>('.pd__cell'));
    const pdNums = Array.from(pd.querySelectorAll<HTMLElement>('.pd__num'));
    const pdReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // «χθες · 28 Αυγούστου» — υπολογίζεται ζωντανά, δεν παγώνει στο build.
    const dateEl = document.getElementById('pd-date');
    if (dateEl) {
      const d = new Date();
      d.setDate(d.getDate() - 1);
      dateEl.textContent = 'χθες · ' + d.toLocaleDateString('el-GR', { day: 'numeric', month: 'long' });
    }

    const pdCss = getComputedStyle(pd);
    const cssMs = (name: string, fallback: number) => {
      const v = parseFloat(pdCss.getPropertyValue(name));
      return Number.isNaN(v) ? fallback : v;
    };
    const DURATION = cssMs('--pd-count-duration', 2600);
    const STAGGER = cssMs('--pd-stagger', 220);

    const fmt = (v: number, suffix?: string) => Math.round(v).toLocaleString('el-GR') + (suffix || '');
    const setFinal = () =>
      pdNums.forEach((n) => { n.textContent = fmt(Number(n.dataset.to), n.dataset.suffix); });

    if (!pdReduce) {
      pd.classList.add('pd--animate');
      pdNums.forEach((n) => { n.textContent = fmt(Number(n.dataset.from), n.dataset.suffix); });

      const count = () => {
        let start: number | null = null;
        const step = (ts: number) => {
          if (start === null) start = ts;
          const k = Math.min((ts - start) / DURATION, 1);
          const eased = 1 - Math.pow(1 - k, 3);
          pdNums.forEach((n, i) => {
            const p = Math.max(0, Math.min(1, eased * 1.42 - i * 0.14));
            const from = Number(n.dataset.from);
            const to = Number(n.dataset.to);
            n.textContent = fmt(from + (to - from) * p, n.dataset.suffix);
          });
          if (k < 1) requestAnimationFrame(step);
          else setFinal();
        };
        requestAnimationFrame(step);
      };

      const play = () => {
        pdCells.forEach((c, i) => { c.style.transitionDelay = `${i * STAGGER}ms`; });
        pd.classList.add('pd--in');
        window.setTimeout(count, STAGGER + 200);
      };

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              play();
            }
          },
          { threshold: 0.35 }
        );
        io.observe(pd);
      } else {
        play();
      }
    }
    // Με reduced motion: το HTML έχει ήδη τους τελικούς αριθμούς.
  }
</script>

<style>
  /* Κάρτα με tag δίπλα στο εικονίδιο */
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .card-top .tag { margin-top: 4px; }

  /* ---- «Η μέρα σε αριθμούς» ---- */
  .pd {
    /* timing — τα διαβάζει το JS */
    --pd-count-duration: 2600;
    --pd-stagger: 220;
    max-width: 860px;
    margin-inline: auto;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    padding: clamp(24px, 4vw, 44px);
  }
  .pd__eyebrow {
    margin: 0 0 clamp(20px, 3vw, 32px);
    font-size: .82rem;
    letter-spacing: .06em;
    color: var(--muted);
  }
  .pd__row { display: flex; align-items: flex-start; }
  .pd__cell { flex: 1; min-width: 0; padding: 0 clamp(14px, 2vw, 24px); }
  .pd__cell:first-child { padding-left: 0; }
  .pd__cell:last-child { padding-right: 0; }
  .pd__cell + .pd__cell { border-left: 1px solid var(--line-strong); }
  .pd__value {
    margin: 0;
    max-width: none;
    font-size: clamp(30px, 4.4vw, 46px);
    font-weight: 500;
    line-height: 1;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .pd__cell--accent .pd__value { color: var(--orange); }
  .pd__label {
    margin: 12px 0 0;
    font-size: clamp(.8rem, 1.2vw, .9rem);
    line-height: 1.4;
    color: var(--muted);
  }
  .pd__closing {
    margin: clamp(26px, 3.5vw, 36px) 0 0;
    padding-top: clamp(18px, 2.4vw, 26px);
    border-top: 1px solid var(--line);
    max-width: none;
    font-size: clamp(.9rem, 1.4vw, 1.05rem);
    color: var(--ink);
  }

  /* είσοδος: κάθε στήλη ανεβαίνει λίγο και εμφανίζεται (μόνο με JS) */
  .pd--animate .pd__cell {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .9s ease, transform .9s ease;
  }
  .pd--animate.pd--in .pd__cell { opacity: 1; transform: none; }

  /* mobile: 2x2 — οι κάθετες γραμμές φεύγουν */
  @media (max-width: 719px) {
    .pd__row { flex-wrap: wrap; }
    .pd__cell { flex: 0 0 50%; padding: 20px 0 0; }
    .pd__cell:nth-child(-n+2) { padding-top: 0; }
    .pd__cell:nth-child(odd) { padding-right: 16px; }
    .pd__cell + .pd__cell { border-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pd--animate .pd__cell { opacity: 1; transform: none; transition: none; }
  }

  /* ---- Δείκτης Αυτοματισμού ---- */
  .deiktis {
    display: flex; align-items: center; justify-content: space-between;
    gap: clamp(24px, 4vw, 48px); flex-wrap: wrap;
    padding: clamp(26px, 4vw, 44px);
  }
  .deiktis-text { max-width: 52ch; }
  .deiktis-text .kicker { margin-bottom: 14px; }
  .deiktis-text h2 { margin-bottom: 12px; }
  .deiktis-text p { color: var(--muted); }
  .deiktis-areas {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 10px;
  }
  .deiktis-areas .chip { justify-content: space-between; }
  .deiktis-areas .muted { font-weight: 400; font-size: .82rem; }
</style>
