---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base
  title="Η σελίδα δεν βρέθηκε — PISMA"
  description="Η διεύθυνση που ανοίξατε δεν υπάρχει ή έχει μετακινηθεί. Δείτε τις βασικές σελίδες της PISMA ή γράψτε μας."
  noindex
>
  <!-- Μία στατική 404 για όλο το site: το JS στο τέλος δείχνει την αγγλική
       εκδοχή όταν το λάθος URL ήταν κάτω από /en/ — χωρίς JS μένει η ελληνική. -->
  <div data-l10n="el">
    <PageHero
      kicker="404"
      sub="Η διεύθυνση που ανοίξατε δεν υπάρχει ή έχει μετακινηθεί — συμβαίνει και στις καλύτερες οικογένειες."
    >
      Εδώ δεν υπάρχει <span class="accent">τίποτα</span>.
    </PageHero>

    <section class="section--tight" aria-label="Χρήσιμες διαδρομές">
      <div class="container container--narrow nf-wrap">
        <div class="nf-links">
          <a class="btn btn--orange" href="/">Πίσω στην αρχική</a>
          <a class="btn btn--ghost" href="/odigoi/">Οι Οδηγοί</a>
          <a class="btn btn--ghost" href="/epikoinonia/">Επικοινωνία</a>
        </div>
        <p class="nf-note">
          Αν φτάσατε εδώ από link δικό μας, πείτε το μας στη
          <a href="/epikoinonia/">φόρμα επικοινωνίας</a> — θα το φτιάξουμε.
        </p>
      </div>
    </section>
  </div>

  <div data-l10n="en" hidden>
    <PageHero
      kicker="404"
      sub="The address you opened doesn't exist or has moved — it happens to the best of us."
    >
      There's <span class="accent">nothing</span> here.
    </PageHero>

    <section class="section--tight" aria-label="Useful links">
      <div class="container container--narrow nf-wrap">
        <div class="nf-links">
          <a class="btn btn--orange" href="/en/">Back to the homepage</a>
          <a class="btn btn--ghost" href="/en/guides/">The Guides</a>
          <a class="btn btn--ghost" href="/en/contact/">Contact</a>
        </div>
        <p class="nf-note">
          If one of our own links brought you here, tell us via the
          <a href="/en/contact/">contact form</a> — we'll fix it.
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  // Αν το λάθος URL ήταν αγγλικό (/en/…), δείξε τα αγγλικά.
  if (location.pathname === '/en' || location.pathname.startsWith('/en/')) {
    document.documentElement.lang = 'en';
    document.title = 'Page not found — PISMA';
    document.querySelector('[data-l10n="el"]')?.setAttribute('hidden', '');
    document.querySelector('[data-l10n="en"]')?.removeAttribute('hidden');
  }
</script>

<style>
  .nf-wrap { text-align: center; padding-bottom: clamp(60px, 10vw, 120px); }
  .nf-links { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .nf-note { margin: 26px auto 0; color: var(--muted); font-size: .95rem; max-width: 46ch; }
  .nf-note a { color: var(--orange-text); }
</style>
