---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, ELEGXOS, eur } from '../config';
import { optionById } from '../data/pricing';

// Μία πηγή αλήθειας για τις τιμές: pricing.ts (web-basic/standard/pro).
const basic = optionById('web-basic')!;
const standard = optionById('web-standard')!;
const pro = optionById('web-pro')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Site που πουλάει',
  serviceType: 'Κατασκευή ιστοσελίδων για επιχειρήσεις',
  areaServed: SITE.region,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: basic.price,
    priceCurrency: 'EUR',
    description: `Από ${eur(basic.price)} εφάπαξ.`,
  },
  description:
    'Γρήγορη, καθαρή ιστοσελίδα με ένα ξεκάθαρο επόμενο βήμα σε κάθε σελίδα — ο επισκέπτης δεν χαζεύει, σηκώνει το τηλέφωνο.',
};

const why = [
  {
    t: 'Γρήγορο — δεν φεύγει κανείς',
    d: 'Ανοίγει αμέσως, και στο πιο αργό κινητό. Κάθε δευτερόλεπτο καθυστέρησης είναι πελάτης που γύρισε πίσω στην Google.',
    icon: 'speed',
  },
  {
    t: 'Ένα ξεκάθαρο επόμενο βήμα',
    d: 'Κλήση, μήνυμα ή προσφορά — σε κάθε σελίδα, ο επισκέπτης ξέρει τι να πατήσει. Όχι λαβύρινθος, όχι «καλλιτεχνίες» που μπερδεύουν.',
    icon: 'target',
  },
  {
    t: 'Μετρήσιμο — ξέρεις τι απέδωσε',
    d: 'Πόσοι μπήκαν, πόσοι πάτησαν «Κάλεσε», από πού ήρθαν. Το site λογοδοτεί με νούμερα, κάθε μήνα.',
    icon: 'chart',
  },
];

const faqItems = [
  {
    q: 'Σε πόσο καιρό είναι έτοιμο;',
    a: 'Συνήθως σε 2–4 εβδομάδες από τη στιγμή που έχουμε τα υλικά (κείμενα, φωτογραφίες, λογότυπο). Αν λείπουν, βοηθάμε να φτιαχτούν.',
  },
  {
    q: 'Τι χρειάζεται να φέρω εγώ;',
    a: 'Ό,τι έχεις: λογότυπο, φωτογραφίες, τιμοκατάλογο, δυο λόγια για τη δουλειά σου. Τα υπόλοιπα — δομή, κείμενα, στήσιμο — τα αναλαμβάνουμε εμείς.',
  },
  {
    q: 'Το site θα είναι δικό μου;',
    a: 'Ναι, εξ ολοκλήρου. Domain, περιεχόμενο και αρχεία ανήκουν στην επιχείρησή σου — ό,τι κι αν γίνει με τη συνεργασία μας.',
  },
  {
    q: 'Πόσο κοστίζει;',
    a: `Τρεις καθαρές βαθμίδες, εφάπαξ: Basic ${eur(basic.price)}, Standard ${eur(standard.price)}, Pro ${eur(pro.price)}. Ό,τι μηνιαίο (π.χ. συντήρηση) είναι προαιρετικό και δημόσια τιμολογημένο στο /times/.`,
  },
  {
    q: 'Θα με βρίσκουν στη Google με αυτό;',
    a: 'Το site χτίζεται τεχνικά σωστό για τη Google από την πρώτη μέρα. Αν θες και ενεργή άνοδο θέσεων (SEO), είναι ξεχωριστή υπηρεσία — τη βλέπεις στη σελίδα της Ψηφιακής Προβολής.',
  },
];
---

<Base
  title="Site που πουλάει — όχι βιτρίνα, εργαλείο δουλειάς | PISMA"
  description="Γρήγορο, καθαρό site με ένα ξεκάθαρο επόμενο βήμα σε κάθε σελίδα. Δείτε το ζωντανά: ο επισκέπτης μπαίνει, βλέπει, και το επόμενο βήμα του είναι το τηλέφωνό σας."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Site που πουλάει"
    sub="Γρήγορο, καθαρό, με ένα ξεκάθαρο επόμενο βήμα σε κάθε σελίδα. Ο επισκέπτης δεν χαζεύει — σηκώνει το τηλέφωνο."
  >
    Όχι βιτρίνα — <span class="accent">εργαλείο δουλειάς</span>
  </PageHero>

  <!-- 2. «Δείτε το ζωντανά» — σκηνή laptop σε loop όπως οι άλλες σκηνές:
       μέσα στην οθόνη ένα premium site οινοποιείου τριών «οθονών», και η κίνηση
       είναι απλώς η περιήγηση: αργό scroll προς τα κάτω με παύσεις, και
       επιστροφή στην κορυφή. Χωρίς JS ή με reduced motion: στατικό hero. -->
  <section class="section section--tight" aria-labelledby="sp-title">
    <div class="container">
      <div class="sp-grid">
        <div class="sp-copy">
          <div class="sec-head">
            <p class="kicker">Δείτε το ζωντανά</p>
            <h2 id="sp-title">Ο επισκέπτης μπαίνει — το τηλέφωνο χτυπάει</h2>
          </div>
          <p class="sp-sub">
            Έτσι δουλεύει ένα site-εργαλείο: μία δυνατή εικόνα, η λίστα με
            τις τιμές, και το τηλέφωνο εκεί που σταματά το μάτι. Το «επόμενο
            βήμα» του επισκέπτη είναι το ταμείο σας.
          </p>
          <div class="sp-cta-row">
            <a class="btn btn--orange" href="/times/">Δείτε τιμές για site →</a>
          </div>
          <p class="sp-note">Ενδεικτική απεικόνιση — το δικό σας site στήνεται για τη δική σας δουλειά.</p>
        </div>

        <div class="sp-stage" id="sp-stage" aria-hidden="true">
          <div class="sp-laptop">
            <div class="sp-screen">
              <span class="sp-camdot"></span>
              <div class="sp-page" id="sp-page">
                <div class="sp-browser">
                  <span class="sp-dots"><i></i><i></i><i></i></span>
                  <span class="sp-url">lyra-wines.gr</span>
                </div>
                <div class="sp-view" id="sp-view">
                  <div class="sp-scroll" id="sp-scroll">
                    <!-- Οθόνη 1: full-bleed hero κτήματος — μεγάλα serif κεφαλαία
                         στο κέντρο, λογότυπο στη μέση της μπάρας (στυλ ιταλικού
                         wine estate) -->
                    <section class="sp-s sp-s1">
                      <img class="sp-photo" src="/site-demo/wine-estate.jpg" alt="" loading="lazy" width="720" height="460" />
                      <span class="sp-shade" aria-hidden="true"></span>
                      <span class="sp-frame" aria-hidden="true"></span>
                      <div class="sp-s1-body">
                        <div class="sp-top">
                          <span class="sp-top-side">Est. 2012</span>
                          <b class="sp-logo">ΛΥΡΑ</b>
                          <span class="sp-top-side sp-top-side--r num">210 555 0142</span>
                        </div>
                        <div class="sp-heroine">
                          <svg class="sp-vine" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 8.6V5.4" />
                            <path d="M12 5.4C9.9 5.2 8.4 4.1 7.8 2.4" />
                            <path d="M12 5.4c2.3-2.4 4.8-2.7 6.1-2.3-.4 2.3-2.5 3.9-6.1 2.3z" />
                            <circle cx="8.1" cy="11.2" r="2.1" /><circle cx="12" cy="10.6" r="2.1" /><circle cx="15.9" cy="11.2" r="2.1" />
                            <circle cx="10" cy="14.9" r="2.1" /><circle cx="14" cy="14.9" r="2.1" />
                            <circle cx="12" cy="18.6" r="2.1" />
                          </svg>
                          <p class="sp-big sp-big-1">ΑΥΘΕΝΤΙΚΗ</p>
                          <p class="sp-big sp-big-2">ΜΑΚΕΔΟΝΙΚΗ</p>
                          <p class="sp-big sp-big-3">ΨΥΧΗ</p>
                        </div>
                        <div class="sp-heroet">
                          <span class="sp-hersub">Οινοποιείο · Νάουσα</span>
                          <span class="sp-cue" aria-hidden="true"><i></i></span>
                        </div>
                      </div>
                    </section>
                    <!-- Οθόνη 2: κρεμ editorial ενότητα «ΤΑ ΚΤΗΜΑΤΑ ΜΑΣ» με τρεις
                         φωτογραφικές κάρτες (αμπελώνες / κτήμα / κελάρι) -->
                    <section class="sp-s sp-s2">
                      <p class="sp-kick2">Από το 2012 στη Νάουσα</p>
                      <p class="sp-big2">ΤΑ ΚΤΗΜΑΤΑ ΜΑΣ</p>
                      <div class="sp-cards">
                        <figure class="sp-card">
                          <img src="/site-demo/wine-rows.jpg" alt="" loading="lazy" width="320" height="400" />
                          <figcaption>Αμπελώνες</figcaption>
                        </figure>
                        <figure class="sp-card">
                          <img src="/site-demo/wine-hill.jpg" alt="" loading="lazy" width="320" height="400" />
                          <figcaption>Το κτήμα</figcaption>
                        </figure>
                        <figure class="sp-card">
                          <img src="/site-demo/wine-cellar.jpg" alt="" loading="lazy" width="720" height="460" />
                          <figcaption>Το κελάρι</figcaption>
                        </figure>
                      </div>
                      <p class="sp-vars">Ξινόμαυρο · Syrah · Μαλαγουζιά</p>
                    </section>
                    <!-- Οθόνη 3: dusty ροζ φινάλε — μεγάλη μπορντό τυπογραφία, η
                         φιάλη αιωρείται πάνω από απαλό κύκλο (και η ετικέτα της
                         γυρίζει), από κάτω το τηλέφωνο για γευσιγνωσία -->
                    <section class="sp-s sp-s3">
                      <div class="sp-s3-copy">
                        <p class="sp-kick3">Το οινοποιείο μας</p>
                        <p class="sp-big3">ΑΓΑΠΗ ΓΙΑ<br />ΤΟ ΚΡΑΣΙ</p>
                        <svg class="sp-div3" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 8.6V5.4" />
                          <path d="M12 5.4C9.9 5.2 8.4 4.1 7.8 2.4" />
                          <path d="M12 5.4c2.3-2.4 4.8-2.7 6.1-2.3-.4 2.3-2.5 3.9-6.1 2.3z" />
                          <circle cx="8.1" cy="11.2" r="2.1" /><circle cx="12" cy="10.6" r="2.1" /><circle cx="15.9" cy="11.2" r="2.1" />
                          <circle cx="10" cy="14.9" r="2.1" /><circle cx="14" cy="14.9" r="2.1" />
                          <circle cx="12" cy="18.6" r="2.1" />
                        </svg>
                      </div>
                      <span class="sp-corner sp-corner--l" aria-hidden="true">Νάουσα · 40.6°N</span>
                      <span class="sp-corner sp-corner--r" aria-hidden="true">Est. 2012</span>
                      <div class="sp-bl-wrap">
                        <span class="sp-bl-disc" aria-hidden="true"></span>
                        <span class="sp-bl-orbit" aria-hidden="true"></span>
                        <svg class="sp-bl" viewBox="0 0 140 260" aria-hidden="true">
                          <defs>
                            <linearGradient id="sp-glass" x1="0" y1="0" x2="1" y2="0">
                              <stop offset="0" stop-color="#1f1710" />
                              <stop offset=".2" stop-color="#31241a" />
                              <stop offset=".5" stop-color="#0b0806" />
                              <stop offset=".82" stop-color="#060404" />
                              <stop offset="1" stop-color="#191108" />
                            </linearGradient>
                            <linearGradient id="sp-foil" x1="0" y1="0" x2="1" y2="0">
                              <stop offset="0" stop-color="#3a1019" />
                              <stop offset=".45" stop-color="#6b1f2e" />
                              <stop offset="1" stop-color="#2c0c14" />
                            </linearGradient>
                            <filter id="sp-soft" x="-40%" y="-40%" width="180%" height="180%">
                              <feGaussianBlur stdDeviation=".8" />
                            </filter>
                            <clipPath id="sp-bl-clip">
                              <path d="M62 6 H78 V58 C78 65 100 70 100 94 V226 A8 8 0 0 1 92 234 H48 A8 8 0 0 1 40 226 V94 C40 70 62 65 62 58 Z" />
                            </clipPath>
                          </defs>
                          <!-- Σώμα φιάλης: σχεδόν μαύρο γυαλί -->
                          <path d="M62 6 H78 V58 C78 65 100 70 100 94 V226 A8 8 0 0 1 92 234 H48 A8 8 0 0 1 40 226 V94 C40 70 62 65 62 58 Z" fill="url(#sp-glass)" />
                          <g clip-path="url(#sp-bl-clip)">
                            <!-- Η ετικέτα που γυρίζει γύρω από τη φιάλη -->
                            <g class="sp-bl-label">
                              <rect x="44" y="130" width="52" height="62" rx="1" fill="#f2e9d7" />
                              <text x="70" y="151" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="11.5" letter-spacing="2.6" fill="#241a10">ΛΥΡΑ</text>
                              <line x1="55" y1="158" x2="85" y2="158" stroke="#b08d4f" stroke-width=".7" />
                              <text x="70" y="169" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="5.4" letter-spacing="1.5" fill="#4a3c2a">ΞΙΝΟΜΑΥΡΟ</text>
                              <text x="70" y="181" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="7" letter-spacing="1" fill="#8a6a33">2019</text>
                            </g>
                            <!-- Ανταύγεια που κινείται αντίθετα από την ετικέτα -->
                            <g class="sp-bl-sheen">
                              <rect x="64" y="6" width="6" height="228" fill="#fff" opacity=".07" filter="url(#sp-soft)" />
                            </g>
                            <!-- Σταθερά rim lights -->
                            <rect x="42.5" y="66" width="3.4" height="160" rx="1.7" fill="#fff" opacity=".15" filter="url(#sp-soft)" />
                            <rect x="63.5" y="8" width="2.6" height="48" rx="1.3" fill="#fff" opacity=".2" filter="url(#sp-soft)" />
                            <rect x="95.5" y="70" width="2.6" height="156" rx="1.3" fill="#d8b271" opacity=".3" filter="url(#sp-soft)" />
                            <!-- Σκιά στη βάση του γυαλιού -->
                            <ellipse cx="70" cy="231" rx="27" ry="5" fill="#000" opacity=".45" />
                          </g>
                          <!-- Καψύλιο σε βαθύ μπορντό -->
                          <rect x="60" y="2" width="20" height="30" rx="3" fill="url(#sp-foil)" />
                          <ellipse cx="70" cy="3.4" rx="9.6" ry="2.3" fill="#571a26" />
                          <rect x="60" y="27" width="20" height="1.6" fill="#1e0810" opacity=".85" />
                        </svg>
                      </div>
                      <div class="sp-cta">
                        <p class="sp-ctal">Γευσιγνωσία με ραντεβού</p>
                        <p class="sp-tel num">210 555 0142</p>
                      </div>
                    </section>
                  </div>
                </div>
              </div>
            </div>
            <div class="sp-base"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Τι κερδίζεις -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--blue">Τι κερδίζετε</p>
        <h2 id="why-title">Τρία πράγματα που ξεχωρίζουν το εργαλείο από τη βιτρίνα.</h2>
      </div>
      <div class="grid-3">
        {why.map((w) => (
          <article class="card reveal">
            <span class="icon-chip">
              {w.icon === 'speed' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13 2.5 4.5 13.5h6l-1 8L19.5 10.5h-6z" />
                </svg>
              )}
              {w.icon === 'target' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1" />
                </svg>
              )}
              {w.icon === 'chart' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 20V11" /><path d="M12 20V4" /><path d="M19 20v-6" />
                </svg>
              )}
            </span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Τιμή -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Τιμές — δημόσιες, ίδιες για όλους</p>
          <h2 id="price-title">
            Από <span class="price-num num">{eur(basic.price)}</span> εφάπαξ
          </h2>
          <p class="price-sub">
            Τρεις καθαρές βαθμίδες: <strong>Basic {eur(basic.price)}</strong> ({basic.detail?.toLowerCase()}),
            <strong>Standard {eur(standard.price)}</strong> ({standard.detail?.toLowerCase()}),
            <strong>Pro {eur(pro.price)}</strong> ({pro.detail?.toLowerCase()}).
            Ό,τι μηνιαίο είναι προαιρετικό — και δημόσια τιμολογημένο.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/times/">Φτιάξτε το πακέτο σας →</a>
          <a class="btn btn--ghost" href="/elegxos/">Δωρεάν αξιολόγηση {ELEGXOS.minutes}′</a>
          <span class="btn-note">Καμία πληρωμή online — το κλείνουμε στο τηλέφωνο.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Πριν ρωτήσεις, ρώτησαν άλλοι.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Ώρα το site σας να πιάσει δουλειά."
    sub={`Ξεκινάμε με μια δωρεάν αξιολόγηση ${ELEGXOS.minutes} λεπτών — βλέπουμε τι έχετε σήμερα και τι αφήνει στο τραπέζι.`}
    ctaText="Κλείστε τη δωρεάν αξιολόγηση"
    ctaHref="/elegxos/"
    note="Καμία πληρωμή online · χωρίς δέσμευση"
  />
</Base>

<script>
  // «Site που πουλάει» (laptop): μέσα στην οθόνη ένα premium site τριών
  // οθονών, και η κίνηση είναι απλώς η περιήγηση — αργό scroll προς τα κάτω
  // με παύσεις σε κάθε ενότητα, και επιστροφή στην κορυφή. Χωρίς JS ή με
  // reduced motion: στατικό hero.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const spStage = document.getElementById('sp-stage');
  if (spStage && !reduce && 'IntersectionObserver' in window) {
    const spView = document.getElementById('sp-view')!;
    const spScroll = document.getElementById('sp-scroll')!;
    const spPage = document.getElementById('sp-page')!;
    let spTimers: number[] = [];
    let spActive = false;
    const spLater = (fn: () => void, ms: number) => spTimers.push(window.setTimeout(fn, ms));

    // Χορογραφία εισόδου ανά οθόνη: το sp-anim «οπλίζει» τα κρυφά αρχικά
    // states (μόνο με JS — χωρίς JS όλα είναι ορατά), και το sp-at-N
    // αποκαλύπτει με σειρά τα στοιχεία της οθόνης N
    spPage.classList.add('sp-anim');
    const spAt = (n: number) => {
      spPage.classList.remove('sp-at-0', 'sp-at-1', 'sp-at-2', 'sp-spin');
      spPage.classList.add(`sp-at-${n}`);
    };

    // Κύλισμα στην ενότητα i (0-2), σαν ήρεμος επισκέπτης — αργή,
    // βελούδινη καμπύλη που «κάθεται» απαλά στην ενότητα
    const spGlide = (i: number, ms = 1800) => {
      const h = spView.clientHeight;
      spScroll.style.transition = `transform ${ms}ms cubic-bezier(.77, 0, .18, 1)`;
      spScroll.style.transform = `translateY(${-i * h}px)`;
    };

    const spTop = () => {
      spScroll.style.transition = 'none';
      spScroll.style.transform = 'translateY(0)';
    };

    const spCycle = () => {
      spTimers.forEach(clearTimeout); spTimers = [];
      spTop();
      spAt(0);
      spLater(() => { spGlide(1); spAt(1); }, 2400);
      spLater(() => { spGlide(2); spAt(2); }, 6000);
      // Η φιάλη δείχνει πρώτα την ετικέτα της· μετά αρχίζει να γυρνάει αργά
      spLater(() => spPage.classList.add('sp-spin'), 8900);
      spLater(() => { spGlide(0, 2200); spAt(0); }, 11600);
      spLater(spCycle, 15400);
    };

    const spIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !spActive) { spActive = true; spCycle(); }
          else if (!e.isIntersecting && spActive) {
            spActive = false;
            spTimers.forEach(clearTimeout); spTimers = [];
            spTop();
            spAt(0);
          }
        }
      },
      { threshold: 0.35 }
    );
    spIo.observe(spStage);
  }
</script>

<style>
  /* ---------- «Site που πουλάει» — laptop ---------- */
  /* Δίστηλη διάταξη σε desktop (κείμενο αριστερά, laptop δεξιά), στοίβαγμα
