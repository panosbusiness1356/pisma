---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NotClassicQr from '../../components/NotClassicQr.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, eurEn } from '../../config';
import { optionById } from '../../data/pricing';

// Το προϊόν κριτικών, μία πηγή αλήθειας: pricing.ts.
// Τιμές αυτοκόλλητων: πίνακας F στο /aftokollita/ (εφάπαξ, από 18 € το πακέτο).
// ΣΚΟΠΙΜΑ teaser: ο μηχανισμός του Εργαλείου Κριτικών δεν περιγράφεται πουθενά δημόσια, 
// ούτε βήματα, ούτε demo link. Παρουσιάζεται μόνο ζωντανά, σε ραντεβού.
const tool = optionById('auto-reviews')!;
const gbp = optionById('gbp-setup')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'The Reviews Tool',
  serviceType: 'Growing Google reviews for local businesses',
  areaServed: SITE.regionEn,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: tool.price,
    priceCurrency: 'EUR',
    description: `${eurEn(tool.price)} per month, no commitment, plus QR stickers as a one-off.`,
  },
  description:
    "PISMA's tool for more Google reviews, with a QR sticker inside the business and a live presentation only.",
};

const what = [
  {
    t: 'Simple for the customer',
    d: 'It starts with a QR sticker at the table, till or front desk.',
  },
  {
    t: 'Set up once',
    d: 'It works every day for every customer, without you asking for reviews.',
  },
  {
    t: "Within Google's rules",
    d: 'No bought reviews, no rewards in exchange, no review gating.',
  },
];

const faqItems = [
  {
    q: 'What is the Reviews Tool?',
    a: "PISMA's tool for Google reviews: it starts with a QR sticker at your premises. How it works is presented live only.",
  },
  {
    q: "Is this within Google's rules?",
    a: 'Yes. Google forbids bought reviews, rewards in exchange for reviews and review gating, and the tool does none of the three.',
  },
  {
    q: 'What do I need to get started?',
    a: `A Google profile (if you do not have one, we set it up: Setup ${eurEn(gbp.price)} one-off) and the QR stickers. We set up everything else.`,
  },
  {
    q: 'How much does it cost?',
    a: `${eurEn(tool.price)} per month for the platform, with no contract and no commitment. The QR stickers are a one-off payment, from €18 per pack.`,
  },
  {
    q: 'Does it work for delivery too?',
    a: 'Yes, with stickers for the bag and the receipt. It works the same from the customer’s home.',
  },
];
---

<Base
  title="The Reviews Tool: More Google reviews | PISMA"
  description="PISMA's tool for more Google reviews, presented live only, with no commitment."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="The Reviews Tool"
    sub="A tool for more Google reviews, presented live only."
  >
    Google <span class="accent">Reviews</span>
    <div slot="extra"><NotClassicQr lang="en" /></div>
  </PageHero>

  <!-- 2. What it does (outcome, not mechanism) -->
  <section class="section section--tight" aria-labelledby="what-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">What it does</p>
        <h2 id="what-title">Three key points.</h2>
      </div>
      <div class="grid-3">
        {what.map((w) => (
          <article class="card reveal">
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Price -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Price: public, the same for everyone</p>
          <h2 id="price-title">
            <span class="price-num num">{eurEn(tool.price)}</span> per month
          </h2>
          <p class="price-sub">
            Includes platform, setup and stats. No contract and no commitment.
          </p>
          <p class="price-sub">
            QR stickers as a one-off, <strong>from €18 per pack</strong>,
            in 16 designs for tables, tills, windows and delivery.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/en/qr-stickers/">Pick your stickers&nbsp;→</a>
          <a class="btn btn--ghost" href="/en/contact/">Book a meeting</a>
          <span class="btn-note">No online payment. We settle it over the phone.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section section--tight" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Questions</p>
        <h2 id="faq-title">Frequently asked questions.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="See the tool live."
    sub="A 15-minute video call or a visit to your premises."
    ctaText="Book the meeting"
    ctaHref="/en/contact/"
    note="No online payment · no commitment"
  />
</Base>

<style>
  /* ---- Price ---- */
  .price-card {
    display: grid;
    grid-template-columns: 1fr minmax(min(280px, 100%), .95fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(26px, 4vw, 48px);
  }
  @media (max-width: 720px) {
    .price-card { grid-template-columns: 1fr; }
  }
  .price-main .kicker { margin-bottom: 14px; }
  .price-num { font-size: clamp(2rem, 5vw, 2.8rem); color: var(--orange-text); }
  .price-sub { margin-top: 12px; color: var(--muted); }
  .price-sub strong { color: var(--ink); }
  .price-cta { display: flex; flex-direction: column; gap: 12px; }
  .price-cta .btn { text-align: center; white-space: normal; padding-inline: 16px; font-size: .95rem; }
  .price-cta .btn-note { text-align: center; }
</style>
