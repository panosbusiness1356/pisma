---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, ELEGXOS, eurEn } from '../../config';
import { optionById } from '../../data/pricing';

// Το προϊόν κριτικών — μία πηγή αλήθειας: pricing.ts.
// Τιμές αυτοκόλλητων: πίνακας F στο /aftokollita/ (εφάπαξ, από 18 € το πακέτο).
// ΣΚΟΠΙΜΑ teaser: ο μηχανισμός του Τροχού δεν περιγράφεται πουθενά δημόσια —
// ούτε βήματα, ούτε demo link. Παρουσιάζεται μόνο ζωντανά, σε ραντεβού.
const wheel = optionById('auto-reviews')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'The Review Wheel',
  serviceType: 'Growing Google reviews for local businesses',
  areaServed: SITE.regionEn,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: wheel.price,
    priceCurrency: 'EUR',
    description: `${eurEn(wheel.price)} per month, no commitment — plus QR stickers as a one-off.`,
  },
  description:
    "PISMA's tool that makes Google reviews pile up on their own. It starts with a QR sticker inside the business — and it is only ever shown live, at a meeting.",
};

const what = [
  {
    t: 'Your customers enjoy it',
    d: 'It is not another "please leave us a review" that gets walked past. It starts with a sticker on the table — and turns into something your customer does with a smile.',
  },
  {
    t: 'It works without you',
    d: 'No need to remember to ask. It is set up once and works every day, at every table — you just watch the reviews come in.',
  },
  {
    t: "Within Google's rules",
    d: 'No bought reviews, no staged ones, no reward in exchange. That was the very first requirement when we designed it — and at the meeting you will see exactly how it is respected.',
  },
];

const faqItems = [
  {
    q: 'What is the Review Wheel?',
    a: "PISMA's tool for Google reviews: it starts with a QR sticker in your shop and makes reviews pile up on their own — in a way your customers actually enjoy. Exactly how it works is not described publicly; you see it live.",
  },
  {
    q: "Why don't you show how it works?",
    a: 'Because whatever works gets copied. We only show the Wheel live — to you, for your own shop, with your colours and your prizes. A 15-minute video call is enough to know if it is right for you.',
  },
  {
    q: "Is this within Google's rules?",
    a: 'Yes, fully. Google forbids bought reviews, rewards in exchange for reviews and review gating — the Wheel does none of the three. At the live meeting you will see exactly how we achieve that.',
  },
  {
    q: 'What do I need to get started?',
    a: 'A Google profile (if you do not have one, we set it up) and the QR stickers. Everything else we set up for you — you just stick the stickers.',
  },
  {
    q: 'How much does it cost?',
    a: `${eurEn(wheel.price)} per month for the platform — with no contract and no commitment. The QR stickers are a one-off payment, from €18 per pack.`,
  },
  {
    q: 'Does it work for delivery too?',
    a: 'Yes — there are stickers for the bag and the receipt, and the Wheel works just as well from your customer’s home.',
  },
];
---

<Base
  title="The Review Wheel — More Google reviews | PISMA"
  description="PISMA's tool that makes Google reviews pile up on their own. We don't show it publicly — book a meeting to see it live. No commitment."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="The Review Wheel"
    sub="The tool that makes your customers want to leave a Google review — and enjoy doing it. How? That part we don't show publicly."
  >
    Reviews that pile up <span class="accent">on their own</span>
  </PageHero>

  <!-- 2. What it does (outcome, not mechanism) -->
  <section class="section section--tight" aria-labelledby="what-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">What it does</p>
        <h2 id="what-title">The result you can see. The mechanism, only in person.</h2>
      </div>
      <div class="grid-3">
        {what.map((w) => (
          <article class="card reveal">
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Why we keep it private -->
  <section class="section" aria-labelledby="secret-title">
    <div class="container container--narrow">
      <div class="card secret-card reveal">
        <p class="kicker">Why the secrecy?</p>
        <h2 id="secret-title">Whatever works gets copied.</h2>
        <p class="secret-sub">
          That is why the Wheel is not explained on any page — it is only shown live.
          On a 15-minute video call or in person at your shop, you see it the way your
          customer will: with your name, your colours and your own prizes.
        </p>
        <div class="secret-cta">
          <a class="btn btn--orange" href="/en/contact/">Book to see it live</a>
          <a class="btn btn--ghost" href="/en/free-assessment/">Free {ELEGXOS.minutes}′ assessment</a>
        </div>
        <p class="btn-note">15 minutes is enough to know if it is right for you.</p>
      </div>
    </div>
  </section>

  <!-- 4. Price -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Price — public, the same for everyone</p>
          <h2 id="price-title">
            <span class="price-num num">{eurEn(wheel.price)}</span> per month
          </h2>
          <p class="price-sub">
            Everything included — platform, setup, stats. No contract, no commitment:
            stop whenever you want.
          </p>
          <p class="price-sub">
            Plus the QR stickers, one-off — <strong>from €18 per pack</strong>,
            with 16 designs for tables, tills, windows and delivery.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/en/qr-stickers/">Pick your stickers →</a>
          <a class="btn btn--ghost" href="/en/contact/">Ask us anything</a>
          <span class="btn-note">No online payment — we settle it over the phone.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section section--tight" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">FAQ</p>
        <h2 id="faq-title">Before you ask, others asked.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="See the Wheel live."
    sub="A 15-minute video call or in person at your shop — and you will instantly understand why we don't show it publicly."
    ctaText="Book the meeting"
    ctaHref="/en/contact/"
    note="No online payment · no commitment"
  />
</Base>

<style>
  /* ---- Secret ---- */
  .secret-card {
    text-align: center;
    padding: clamp(28px, 4.5vw, 52px);
  }
  .secret-card .kicker { margin-bottom: 14px; }
  .secret-sub {
    color: var(--muted);
    max-width: 52ch;
    margin: 14px auto 22px;
  }
  .secret-cta {
    display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .secret-card .btn-note { margin: 0; }

  /* ---- Price ---- */
  .price-card {
    display: grid;
    grid-template-columns: 1.2fr minmax(min(240px, 100%), .8fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(26px, 4vw, 48px);
  }
  @media (max-width: 720px) {
    .price-card { grid-template-columns: 1fr; }
  }
  .price-main .kicker { margin-bottom: 14px; }
  .price-num { font-size: clamp(2rem, 5vw, 2.8rem); color: var(--orange-text); }
  .price-sub { margin-top: 12px; color: var(--muted); }
  .price-sub strong { color: var(--ink); }
  .price-cta { display: flex; flex-direction: column; gap: 12px; }
  .price-cta .btn { text-align: center; }
  .price-cta .btn-note { text-align: center; }
</style>
