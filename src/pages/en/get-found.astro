---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Digital Visibility — Get found on Google and AI',
  serviceType: 'Website development, Google Business Profile, SEO, GEO/AEO, Social media, Google Reviews',
  areaServed: SITE.regionEn,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'Attica',
      addressCountry: 'GR',
    },
  },
  description:
    'A website that sells, top spots on Google and recommendations from ChatGPT — with your visibility measured before and after.',
};

const services = [
  {
    t: 'A website that sells',
    d: 'Fast, clean, with one clear next step on every page. Not a shop window — a working tool. And with optional monthly care, it keeps running without you thinking about it.',
    icon: 'site',
  },
  {
    t: 'A website with online bookings',
    d: 'Your customers book an appointment or a table online and get an automatic reminder — no more no-shows.',
    icon: 'cal',
    href: '#bookings',
  },
  {
    t: 'Google Business Profile',
    d: 'Set-up and optimization of your profile on Google Maps and Search — correct details, categories, photos.',
    icon: 'pin',
    href: '/en/guides/google-maps-profile/',
  },
  {
    t: 'First on Google (SEO)',
    d: 'When people search for what you do in your area, you show up in the top results. With a monthly ranking report.',
    icon: 'seo',
  },
  {
    t: 'Get recommended by AI (GEO/AEO)',
    d: 'More and more people ask ChatGPT "where should I go?". We make sure the answer includes your name.',
    icon: 'ai',
  },
  {
    t: 'Social media',
    d: 'Profiles that look alive: a one-off clean-up and set-up, or monthly management with posts and stories — using your material or ours.',
    icon: 'social',
    href: '/en/guides/social-media-management/',
  },
  {
    t: 'The Reviews Tool',
    d: 'Our tool that makes Google reviews pile up on their own. How? That part we only show live.',
    icon: 'star',
    href: '/en/reviews/',
  },
  {
    t: 'Digital Menu with QR',
    d: 'A QR code on the table: customers scan and see your menu on their phone. Change prices and dishes anytime — no reprints.',
    icon: 'menu',
    href: '/en/digital-menu/',
  },
  {
    t: 'An eye on the competition',
    d: 'You see where the shop across the street ranks — and where you do. Every month, in the same report.',
    icon: 'eye',
  },
];

const faqItems = [
  {
    q: 'How long until SEO shows results?',
    a: 'First signs in 2–3 months, steady growth in 4–6. Every month you see the numbers — rankings, visits, calls — and judge the progress for yourself.',
  },
  {
    q: 'What is GEO?',
    a: "Generative Engine Optimization: getting ChatGPT, Gemini and Perplexity to recommend you when someone asks them about what you do. It's the SEO of the AI era — and it's measurable, just like the classic kind.",
  },
  {
    q: 'I already have a website — do we keep it?',
    a: "If it's technically sound, yes — we build on it and you don't pay for anything from scratch. If not, you see in writing what a fix costs versus a new one, and you decide.",
  },
  {
    q: 'Do I need ads to get found?',
    a: "Not necessarily. Organic visibility builds more slowly, but it stays — and you don't pay for every click. If ads are worth it anywhere, the numbers will show it — you'll never hear a \"you just have to\" from us.",
  },
];
---

<Base
  title="Digital Visibility — SEO, AI visibility & Reviews | PISMA"
  description="A website that sells, top spots on Google and recommendations from ChatGPT. We measure your visibility before and after — with numbers, not promises."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Pillar one"
    sub="When someone searches for what you do in your area — you show up. On Google and on ChatGPT."
  >
    Digital <span class="accent">Visibility</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="svc-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">What we set up</p>
        <h2 id="svc-title">Nine jobs. One goal: getting you found.</h2>
      </div>
      <div class="grid-3">
        {services.map((s) => (
          <article class="card reveal">
            <span class="icon-chip">
              {s.icon === 'site' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4.5" width="18" height="15" rx="2.5" /><path d="M3 9.5h18M6.4 7h.01M9.4 7h.01" />
                </svg>
              )}
              {s.icon === 'cal' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3.5" y="5" width="17" height="16" rx="2.5" /><path d="M3.5 9.8h17M8 2.8V6M16 2.8V6M8.5 14.5l2.3 2.3 4.4-4.6" />
                </svg>
              )}
              {s.icon === 'pin' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21.5s-7-6.2-7-11.3A7 7 0 0 1 19 10.2c0 5.1-7 11.3-7 11.3z" /><circle cx="12" cy="10" r="2.6" />
                </svg>
              )}
              {s.icon === 'social' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="6" cy="12" r="2.8" /><circle cx="17.5" cy="5.5" r="2.8" /><circle cx="17.5" cy="18.5" r="2.8" /><path d="M8.6 10.7l6.3-3.7M8.6 13.3l6.3 3.7" />
                </svg>
              )}
              {s.icon === 'seo' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /><path d="M7.4 12.4l2-2 1.7 1.5 2.5-2.8" />
                </svg>
              )}
              {s.icon === 'ai' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-2.9-.4-4.1-1L3 20l1-5.4A8.5 8.5 0 1 1 21 11.5z" /><path d="M12 8.5v5M9.5 11h5" />
                </svg>
              )}
              {s.icon === 'star' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
                </svg>
              )}
              {s.icon === 'menu' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="7" y="3" width="10" height="18" rx="2.5" /><path d="M10 7.5h4M10 11h4M10 14.5h2.5" />
                </svg>
              )}
              {s.icon === 'eye' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" />
                </svg>
              )}
            </span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            {s.href && <a class="card-arrow" href={s.href}>See what it does →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 2β. «Site που πουλάει» — laptop mockup σε loop όπως οι άλλες σκηνές:
       το HTML έχει το τελικό state (site πλήρες, κράτηση κλεισμένη) — χωρίς
       JS ή με reduced motion μένει στατικό· το JS το «ξαναπαίζει» όσο το
       section είναι ορατό. -->
  <section class="section section--tight" id="bookings" aria-labelledby="lp-title">
    <div class="container">
      <div class="lp-grid">
        <div class="lp-copy">
          <div class="sec-head">
            <p class="kicker kicker--blue">A website with online bookings</p>
            <h2 id="lp-title">Appointments that book themselves</h2>
          </div>
          <p class="lp-sub">
            Customers browse, pick a time and book — day or night, no phone
            calls. You just watch the calendar fill up.
          </p>
          <div class="lp-cta-row">
            <a class="btn btn--orange" href="/en/pricing/">See website pricing →</a>
          </div>
          <p class="lp-note">Illustrative — your own site is built for your own business.</p>
        </div>

        <div class="lp-stage" id="lp-stage" aria-hidden="true">
          <div class="lp-laptop">
            <div class="lp-screen">
              <span class="lp-camdot"></span>
              <div class="lp-page is-dim" id="lp-page">
                <div class="lp-browser">
                  <span class="lp-dots"><i></i><i></i><i></i></span>
                  <span class="lp-url">anna-hair.gr</span>
                </div>
                <div class="lp-body">
                  <div class="lp-part lp-nav is-in">
                    <b>ANNA<span>hair studio</span></b>
                    <span class="lp-links"><i>Services</i><i>Prices</i><i>Contact</i></span>
                  </div>
                  <div class="lp-hero">
                    <div class="lp-part lp-hcopy is-in">
                      <p class="lp-h1">Shine from the first look</p>
                      <p class="lp-hsub">Cuts, color, styling — book online in 30 seconds.</p>
                      <span class="lp-btn" id="lp-cta">Book an appointment</span>
                    </div>
                    <div class="lp-part lp-hart is-in">
                      <img src="/site-demo/salon.jpg" alt="" loading="lazy" width="360" height="290" />
                      <span class="lp-hart-chip">★ 4.9 · 234 reviews</span>
                    </div>
                  </div>
                  <div class="lp-cards">
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6.5" r="2.6"/><circle cx="6" cy="17.5" r="2.6"/><path d="M8.3 8.2 20 19.4M8.3 15.8 20 4.6"/></svg>Haircut <b class="num">€15</b></span>
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3.4 4.1 5.8 7.1 5.8 9.9a5.8 5.8 0 1 1-11.6 0c0-2.8 2.4-5.8 5.8-9.9z"/></svg>Color <b class="num">€45</b></span>
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l1.9 5.6 5.6 1.9-5.6 1.9L12 18.5l-1.9-5.6-5.6-1.9 5.6-1.9z"/><path d="M18.8 16.6l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>Styling <b class="num">€20</b></span>
                  </div>
                </div>
                <!-- Βήματα κράτησης: υπηρεσία → ώρα → επιβεβαίωση (μόνο με JS) -->
                <div class="lp-book" id="lp-book">
                  <p class="lp-book-t">Book an appointment</p>
                  <p class="lp-book-l">Service</p>
                  <div class="lp-chips">
                    <span class="lp-chip" id="lp-svc">Haircut</span>
                    <span class="lp-chip">Color</span>
                    <span class="lp-chip">Styling</span>
                  </div>
                  <p class="lp-book-l">Day</p>
                  <div class="lp-chips">
                    <span class="lp-chip">Thursday</span>
                    <span class="lp-chip" id="lp-day">Friday</span>
                    <span class="lp-chip">Saturday</span>
                    <span class="lp-chip lp-chip--more">Another day ›</span>
                  </div>
                  <p class="lp-book-l">Time</p>
                  <div class="lp-chips">
                    <span class="lp-chip">4:00</span>
                    <span class="lp-chip" id="lp-time">5:30</span>
                    <span class="lp-chip">7:00</span>
                  </div>
                  <span class="lp-confirm" id="lp-confirm">Confirm</span>
                </div>
                <div class="lp-done is-on" id="lp-done">
                  <span class="lp-done-check">✓</span>
                  <p class="lp-done-t">Appointment booked!</p>
                  <p class="lp-done-s">Friday 5:30 pm · Haircut</p>
                </div>
                <svg class="lp-cursor" id="lp-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 3.2 19 12.2l-6.6 1.1 3.4 6.4-2.7 1.4-3.4-6.4-4.2 4.6z" fill="#111" stroke="#fff" stroke-width="1.4"/></svg>
              </div>
            </div>
            <div class="lp-base"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Ρώτα το AI — demo -->
  <section class="section" aria-labelledby="chat-title">
    <div class="container container--narrow">
      <div class="sec-head sec-head--center">
        <p class="kicker">See it live</p>
        <h2 id="chat-title">Ask the AI</h2>
        <p>This is roughly what a customer's question looks like today — and the answer they get.</p>
      </div>

      <div class="chat card" id="ai-chat">
        <div class="chat-head">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="chat-title">Chat with AI</span>
          <span class="tag tag--demo">Demo</span>
        </div>
        <div class="chat-body">
          <p class="msg msg--user">good hair salon near me?</p>
          <p class="msg msg--ai msg-typing" aria-hidden="true"><span class="tdot"></span><span class="tdot"></span><span class="tdot"></span></p>
          <div class="msg msg--ai">
            <p class="ai-intro">Based on reviews and online presence, three stand out:</p>
            <ol class="ai-list">
              <li class="ai-item">
                <strong>Salon "N."</strong>
                <span class="ai-note">4.9 · 200+ reviews</span>
              </li>
              <li class="ai-item ai-item--you">
                <strong>Your business name</strong>
                <span class="you-flag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5M11 6l-6 6 6 6" />
                  </svg>
                  this is where you should be
                </span>
              </li>
              <li class="ai-item">
                <strong>Studio "M."</strong>
                <span class="ai-note">next to the square</span>
              </li>
            </ol>
          </div>
        </div>
      </div>

      <div class="chat-cta">
        <a class="btn btn--orange" href="/en/business-check/">Find out if it recommends you</a>
        <span class="btn-note">2 minutes · free · no details required</span>
      </div>
    </div>
  </section>

  <!-- 4. AI Visibility Index -->
  <section class="section section--tight" aria-labelledby="avi-title">
    <div class="container">
      <div class="card avi reveal">
        <div class="avi-intro">
          <p class="kicker">AI Visibility Index</p>
          <h2 id="avi-title">Your AI visibility, in one number.</h2>
          <p>We measure it before we start and every month after — so you see the change on paper.</p>
        </div>
        <ol class="avi-points">
          <li>
            <span class="avi-num num">1</span>
            <div>
              <h3>What it is</h3>
              <p>How many relevant questions — "hair salon near me", "good accountant" — get the AI to recommend you.</p>
            </div>
          </li>
          <li>
            <span class="avi-num num">2</span>
            <div>
              <h3>How it's calculated</h3>
              <p>We ask ChatGPT, Gemini and Perplexity real customer questions and record where you show up.</p>
            </div>
          </li>
          <li>
            <span class="avi-num num">3</span>
            <div>
              <h3>Why it matters</h3>
              <p>If the AI doesn't mention you, the customer goes elsewhere — and you never find out.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Frequently asked questions</p>
        <h2 id="faq-title">The questions everyone asks.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. Τελικό CTA -->
  <CtaBand
    title="See how findable you are — before your competition does."
    sub="The Dashboard gives you a visibility score in two minutes."
    ctaText="Measure your visibility"
    ctaHref="/en/business-check/"
    note="2 minutes · free · no details required"
  />
</Base>

<script>
  // «Ρώτα το AI»: τα μηνύματα υπάρχουν ήδη στο HTML — το JS μόνο τα κρύβει
  // (is-armed) και τα «ξαναπαίζει» σε loop όσο το chat είναι ορατό: ερώτηση →
  // «γράφει…» → απάντηση → παλμός στη δική σας θέση. Όταν βγει από την οθόνη,
  // σταματά και μένει στο τελικό state. Χωρίς JS, όλα ορατά από την αρχή.
  const chat = document.getElementById('ai-chat');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (chat) {
    if (!reduce && 'IntersectionObserver' in window) {
      chat.classList.add('is-armed'); // μόνο τώρα κρύβονται τα μηνύματα
      const youItem = chat.querySelector('.ai-item--you');
      let timers: number[] = [];
      let active = false;
      const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
      const stopAll = () => { timers.forEach(clearTimeout); timers = []; };
      const finalState = () => {
        chat.classList.add('is-play');
        chat.classList.remove('is-typing');
        youItem?.classList.remove('is-pulse');
      };
      const cycle = () => {
        stopAll();
        // Στιγμιαία επαναφορά στην αρχή, χωρίς transitions (is-snap)
        chat.classList.add('is-snap');
        chat.classList.remove('is-play', 'is-typing');
        youItem?.classList.remove('is-pulse');
        void (chat as HTMLElement).offsetWidth;
        chat.classList.remove('is-snap');
        later(() => chat.classList.add('is-play'), 60);
        later(() => chat.classList.add('is-typing'), 750);
        later(() => chat.classList.remove('is-typing'), 2050);
        later(() => youItem?.classList.add('is-pulse'), 3800);
        later(() => youItem?.classList.remove('is-pulse'), 6300);
        later(cycle, 8800);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && !active) { active = true; cycle(); }
            else if (!e.isIntersecting && active) { active = false; stopAll(); finalState(); }
          }
        },
        { threshold: 0.35 }
      );
      io.observe(chat);
    }
    // Με reduced-motion (ή χωρίς IO): καμία κλάση — τελικό state αμέσως.
  }

  // «A website with online bookings» (laptop): το HTML έχει το τελικό state
  // (site πλήρες, κράτηση επιβεβαιωμένη). Με JS + ορατότητα, σε loop: η
  // σελίδα χτίζεται κομμάτι-κομμάτι, ο κέρσορας πατά «Book» και περνάει τα
  // ΒΗΜΑΤΑ της κράτησης — υπηρεσία → ώρα → Confirm → «booked».
  // Εκτός οθόνης: τελικό state.
  const lpStage = document.getElementById('lp-stage');
  if (lpStage && !reduce && 'IntersectionObserver' in window) {
    const lpPage = document.getElementById('lp-page')!;
    const lpCta = document.getElementById('lp-cta')!;
    const lpBook = document.getElementById('lp-book')!;
    const lpSvc = document.getElementById('lp-svc')!;
    const lpDay = document.getElementById('lp-day')!;
    const lpTime = document.getElementById('lp-time')!;
    const lpConfirm = document.getElementById('lp-confirm')!;
    const lpDone = document.getElementById('lp-done')!;
    const lpCursor = document.getElementById('lp-cursor')!;
    const lpParts = Array.from(lpStage.querySelectorAll<HTMLElement>('.lp-part'));
    let lpTimers: number[] = [];
    let lpActive = false;
    const lpLater = (fn: () => void, ms: number) => lpTimers.push(window.setTimeout(fn, ms));

    // Ο κέρσορας ταξιδεύει ώστε η μύτη του βέλους να πέφτει πάνω στο στοιχείο
    const lpGo = (el: HTMLElement, ms: number) => {
      const pr = lpPage.getBoundingClientRect();
      const br = el.getBoundingClientRect();
      lpCursor.style.transition = `opacity .3s ease, left ${ms}ms cubic-bezier(.3, .7, .25, 1), top ${ms}ms cubic-bezier(.3, .7, .25, 1)`;
      lpCursor.style.opacity = '1';
      lpCursor.style.left = `${Math.round(br.left - pr.left + br.width * 0.55)}px`;
      lpCursor.style.top = `${Math.round(br.top - pr.top + br.height * 0.55)}px`;
    };

    const lpFinal = () => {
      lpParts.forEach((p) => p.classList.add('is-in'));
      lpCta.classList.remove('is-press');
      lpConfirm.classList.remove('is-press');
      lpBook.classList.remove('is-on');
      lpSvc.classList.add('is-sel');
      lpDay.classList.add('is-sel');
      lpTime.classList.add('is-sel');
      lpPage.classList.add('is-dim');
      lpDone.classList.add('is-on');
      lpCursor.style.opacity = '0';
    };

    const lpCycle = () => {
      lpTimers.forEach(clearTimeout); lpTimers = [];
      const pr = lpPage.getBoundingClientRect();
      // Επαναφορά: άδεια σελίδα, κέρσορας κάτω-δεξιά, τίποτα επιλεγμένο
      lpParts.forEach((p) => p.classList.remove('is-in'));
      lpCta.classList.remove('is-press');
      lpConfirm.classList.remove('is-press');
      lpBook.classList.remove('is-on');
      lpSvc.classList.remove('is-sel');
      lpDay.classList.remove('is-sel');
      lpTime.classList.remove('is-sel');
      lpPage.classList.remove('is-dim');
      lpDone.classList.remove('is-on');
      lpCursor.style.transition = 'none';
      lpCursor.style.opacity = '0';
      lpCursor.style.left = `${Math.round(pr.width - 34)}px`;
      lpCursor.style.top = `${Math.round(pr.height - 30)}px`;
      // Η σελίδα «χτίζεται» κομμάτι-κομμάτι
      lpLater(() => {
        lpParts.forEach((p, i) => lpLater(() => p.classList.add('is-in'), i * 220));
      }, 600);
      // 1) Κλικ στο «Book an appointment» → ανοίγει η φόρμα βημάτων
      lpLater(() => lpGo(lpCta, 1000), 3200);
      lpLater(() => lpCta.classList.add('is-press'), 4400);
      lpLater(() => lpCta.classList.remove('is-press'), 4700);
      lpLater(() => { lpPage.classList.add('is-dim'); lpBook.classList.add('is-on'); }, 5000);
      // 2) Επιλογή υπηρεσίας
      lpLater(() => lpGo(lpSvc, 850), 5800);
      lpLater(() => lpSvc.classList.add('is-sel'), 6900);
      // 3) Επιλογή ημέρας
      lpLater(() => lpGo(lpDay, 850), 7400);
      lpLater(() => lpDay.classList.add('is-sel'), 8500);
      // 4) Επιλογή ώρας
      lpLater(() => lpGo(lpTime, 850), 9000);
      lpLater(() => lpTime.classList.add('is-sel'), 10100);
      // 5) Confirm → «Appointment booked!»
      lpLater(() => lpGo(lpConfirm, 850), 10600);
      lpLater(() => lpConfirm.classList.add('is-press'), 11700);
      lpLater(() => lpConfirm.classList.remove('is-press'), 12000);
      lpLater(() => {
        lpBook.classList.remove('is-on');
        lpDone.classList.add('is-on');
        lpCursor.style.opacity = '0';
      }, 12400);
      // Δίχτυ ασφαλείας: κλείδωμα στο στατικό state
      lpLater(lpFinal, 16800);
      lpLater(lpCycle, 18600);
    };

    const lpIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !lpActive) { lpActive = true; lpCycle(); }
          else if (!e.isIntersecting && lpActive) {
            lpActive = false;
            lpTimers.forEach(clearTimeout); lpTimers = [];
            lpFinal();
          }
        }
      },
      { threshold: 0.35 }
    );
    lpIo.observe(lpStage);
  }
</script>

