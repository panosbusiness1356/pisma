---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Automations',
  serviceType: 'Automations for businesses',
  description:
    'Automations for businesses: payment matching, payment reminders, an organized Excel and custom automations.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  areaServed: SITE.regionEn,
};

// Same bento order as the Greek page: [custom(strip 4)] [match(2)+chase+excel] [menu+eye(strip 3)]
const services = [
  { t: 'Custom automations', d: 'Any repetitive task, on top of the software you already use.', icon: 'custom', size: 'strip4' as const, href: '/en/contact/', cta: 'Tell us your routine →' },
  { t: 'Automatic payment matching', d: 'Every payment is matched to its invoice automatically.', icon: 'match', size: 'big' as const },
  { t: 'Automatic Debt Chaser', d: 'Automatic payment reminders at the right moment.', icon: 'chase', logos: ['whatsapp-icon.svg', 'viber.svg'] },
  { t: 'Organized Excel', d: 'Your transactions in an Excel that updates automatically.', icon: 'excel', logos: ['excel.svg'] },
  { t: 'Digital Menu', d: 'The menu on the phone via QR, price changes with no reprints.', icon: 'menu', href: '/en/digital-menu/' },
  { t: 'Your Spy', d: 'Competitor prices and offers in a regular report.', icon: 'eye', size: 'strip3' as const },
];

const faqItems = [
  {
    q: 'Will I have to change software?',
    a: 'No. We build on top of what you already use: invoicing software, email, phone.',
  },
  {
    q: 'What if it breaks?',
    a: 'We are alerted first and we fix it. That is what the support of the monthly services covers.',
  },
  {
    q: 'What about my data?',
    a: 'It stays in your own accounts, on servers inside the EU, GDPR compliant.',
  },
  {
    q: 'Will my employee lose their job?',
    a: 'No. Manual data entry stops and the time goes to customers.',
  },
];
---

<Base
  title="Automations: your business runs by itself | PISMA"
  description="Payment matching, payment reminders and an organized Excel that run automatically, plus custom automations."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    sub="Automations for your business routine, on top of the software you already use."
  >
    <span class="accent">Automations</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="services-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Services</p>
        <h2 id="services-title">What we automate.</h2>
      </div>
      <ServiceCards services={services} cta="Learn more →" />
    </div>
  </section>

  <!-- 2β. «Σύγκλιση» (επιλογή 3 της χρήστριας από τη σελίδα δοκιμών, 11/09/2026):
       αφηρημένη σκηνή αυτοματισμού χωρίς κείμενα ή σενάρια. Έξι ροές μπαίνουν
       από αριστερά, ενώνονται σε έναν παλλόμενο πυρήνα και βγαίνει μία. Μόνο CSS
       (stroke-dashoffset), χωρίς JS· με reduced motion μένει στατική. -->
  <section class="section" aria-labelledby="flow-title">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="kicker kicker--ok">How it works</p>
        <h2 id="flow-title">The routine runs by itself.</h2>
        <p>Every task passes through the system and comes out done, without you.</p>
      </div>

      <div class="cv" aria-hidden="true">
        <svg viewBox="0 0 900 320" preserveAspectRatio="xMidYMid meet">
          <defs>
            <filter id="cv-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
          </defs>
          <path class="cv-in" style="animation-delay:0s" d="M 0 40 C 240 40, 300 160, 450 160" />
          <path class="cv-in" style="animation-delay:-0.23s" d="M 0 88 C 240 88, 300 160, 450 160" />
          <path class="cv-in" style="animation-delay:-0.46s" d="M 0 136 C 240 136, 300 160, 450 160" />
          <path class="cv-in" style="animation-delay:-0.69s" d="M 0 184 C 240 184, 300 160, 450 160" />
          <path class="cv-in" style="animation-delay:-0.92s" d="M 0 232 C 240 232, 300 160, 450 160" />
          <path class="cv-in" style="animation-delay:-1.15s" d="M 0 280 C 240 280, 300 160, 450 160" />
          <path class="cv-out" d="M 450 160 L 900 160" />
          <circle class="cv-ring" cx="450" cy="160" r="14" />
          <circle class="cv-core" cx="450" cy="160" r="9" filter="url(#cv-glow)" />
        </svg>
      </div>
    </div>
  </section>

  <!-- 4. Δείκτης Αυτοματισμού: κείμενο + κουμπί αριστερά, μετρητής 0 έως 100
       δεξιά. Ο μετρητής γεμίζει (CSS transition) όταν το global reveal βάλει
       is-in· χωρίς JS μένει στο 72 % από το HTML (inline style). -->
  <section class="section section--tight" aria-labelledby="deiktis-title">
    <div class="container">
      <div class="dk reveal">
        <div class="dk-text">
          <p class="kicker">Automation Score</p>
          <h2 id="deiktis-title">A score from 0 to 100.</h2>
          <p>Short questions about payments, collections and organization.</p>
          <a class="btn btn--orange btn--sm" href="/en/business-check/">Measure your business →</a>
        </div>
        <div class="dk-meter" aria-hidden="true">
          <div class="dk-scale">
            <span class="dk-fill"></span>
            <span class="dk-marker"><b class="num">72</b></span>
          </div>
          <div class="dk-ends num"><span>0</span><span>100</span></div>
          <p class="dk-cap">sample score</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Questions</p>
        <h2 id="faq-title">FAQ.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Measure your Automation Score."
    sub="12 short questions about your business."
    ctaText="Measure your Score"
    ctaHref="/en/business-check/"
    note="2 minutes · free · no personal details"
  />
</Base>

<style>
  /* Κάρτα με tag δίπλα στο εικονίδιο */
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .card-top .tag { margin-top: 4px; }

  /* ---- «Σύγκλιση» ---- */
  .cv {
    position: relative; max-width: 900px; margin-inline: auto; aspect-ratio: 900 / 320;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r);
    box-shadow: var(--shadow); overflow: hidden;
  }
  .cv::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(600px 240px at 50% 55%, rgba(var(--orange-rgb), .08), transparent 70%);
  }
  .cv svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cv-in {
    fill: none; stroke: rgba(255, 255, 255, .45); stroke-width: 1.4;
    stroke-dasharray: 7 11; animation: cv-dash 1.1s linear infinite;
  }
  .cv-out {
    fill: none; stroke: var(--orange); stroke-width: 2.2;
    stroke-dasharray: 12 8; animation: cv-dash .6s linear infinite;
  }
  @keyframes cv-dash { to { stroke-dashoffset: -18; } }
  .cv-core { fill: var(--orange); transform-origin: 450px 160px; animation: cv-breathe 2.4s ease-in-out infinite; }
  .cv-ring {
    fill: none; stroke: var(--orange); stroke-width: 1.2; opacity: 0;
    transform-origin: 450px 160px; animation: cv-ring 2.4s ease-out infinite;
  }
  @keyframes cv-breathe { 50% { transform: scale(1.18); } }
  @keyframes cv-ring { 0% { opacity: .8; transform: scale(.7); } 100% { opacity: 0; transform: scale(2.4); } }
  @media (max-width: 719px) { .cv { aspect-ratio: 900 / 460; } }
  @media (prefers-reduced-motion: reduce) {
    .cv-in, .cv-out, .cv-core, .cv-ring { animation: none; }
    .cv-ring { opacity: .5; }
  }

  /* ---- Δείκτης Αυτοματισμού ---- */
  .dk {
    display: grid; grid-template-columns: 1.1fr .9fr; align-items: center;
    gap: clamp(28px, 5vw, 64px);
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow);
    padding: clamp(26px, 4vw, 48px);
  }
  .dk-text .kicker { margin-bottom: 14px; }
  .dk-text h2 { margin-bottom: 12px; }
  .dk-text p { color: var(--muted); max-width: 46ch; }
  .dk-text .btn { margin-top: 22px; }
  .dk-meter { padding: 40px 12px 0; }
  .dk-scale {
    position: relative; height: 10px; border-radius: 999px;
    background: var(--bg); border: 1px solid var(--line-strong);
  }
  .dk-fill {
    position: absolute; left: 0; top: 0; bottom: 0; width: 72%; border-radius: 999px;
    background: var(--grad); transition: width 1.6s var(--ease) .3s;
  }
  .dk-marker {
    position: absolute; top: 50%; left: 72%; width: 22px; height: 22px; margin: -11px 0 0 -11px;
    border-radius: 50%; background: #fff;
    box-shadow: 0 0 0 4px rgba(var(--orange-rgb), .3), var(--shadow);
    transition: left 1.6s var(--ease) .3s;
  }
  .dk-marker b {
    position: absolute; bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%);
    font-size: 1.6rem; font-weight: 500; color: var(--navy);
  }
  /* με JS: ξεκινά από 0 και γεμίζει όταν το reveal βάλει is-in */
  .dk.reveal:not(.is-in) .dk-fill { width: 0; }
  .dk.reveal:not(.is-in) .dk-marker { left: 0; }
  .dk-ends { display: flex; justify-content: space-between; margin-top: 10px; font-size: .78rem; color: var(--muted); }
  .dk-cap { margin: 8px 0 0; max-width: none; text-align: center; font-size: .74rem; color: var(--muted); }
  @media (max-width: 719px) {
    .dk { grid-template-columns: 1fr; }
    .dk-meter { padding-top: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dk-fill, .dk-marker { transition: none; }
    .dk.reveal:not(.is-in) .dk-fill { width: 72%; }
    .dk.reveal:not(.is-in) .dk-marker { left: 72%; }
  }
</style>
