---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Automation',
  serviceType: 'Office automations for businesses',
  description:
    'Your office routine runs on its own: payment matching, collections, an organized Excel, a daily report.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  areaServed: SITE.regionEn,
};

// Same bento order as the Greek page: [match(2)+excel+chase] [day+star(2)+loyal] [menu+eye(strip 3)]
const services = [
  { t: 'Automatic payment matching', d: 'Every payment that comes in finds its own invoice. No more hunting them down one by one, by hand.', icon: 'match', size: 'big' },
  { t: 'An organized Excel', d: 'All your transactions in one clean Excel that updates itself — a picture of your business that is always fresh.', icon: 'excel', logos: ['excel.svg'] },
  { t: 'Automatic Debt Chaser', d: 'Polite reminders go out automatically, at just the right moment. All you see is who paid.', icon: 'chase', logos: ['whatsapp-icon.svg', 'viber.svg'] },
  { t: 'Your Day in One Message', d: "Every afternoon, one message: what came in, what went out, what's pending. Your business at a glance.", icon: 'day', logos: ['whatsapp-icon.svg'] },
  { t: 'The Reviews Tool', d: 'Our tool that makes Google reviews pile up on their own, every day. Its mechanism is something we only show live.', icon: 'star', href: '/en/reviews/' },
  { t: 'Loyalty Card', d: 'A QR code at the register: customers collect stamps on every visit and win a reward. Your best customers come back — measurably.', icon: 'loyal' },
  { t: 'Digital Menu', d: 'A QR code on the table: customers see your menu on their phone. Change prices and dishes anytime — no reprints.', icon: 'menu', href: '/en/digital-menu/' },
  { t: 'Your Spy', d: 'See what your competitors are up to — prices, offers, presence — in a regular report. Without ever searching.', icon: 'eye', size: 'strip3' },
];

const faqItems = [
  {
    q: 'Will I have to change software?',
    a: 'No. We build on top of what you already use — your invoicing software, your email, your phone.',
  },
  {
    q: 'What if it breaks?',
    a: 'We get alerted first, usually before you even notice. The fix is covered by your monthly maintenance.',
  },
  {
    q: 'What about my data?',
    a: 'It stays in your own accounts, on servers inside the EU, fully GDPR compliant.',
  },
  {
    q: 'Will my employee lose their job?',
    a: 'No — they will stop typing. The hours freed up go to customers, not data entry.',
  },
];
---

<Base
  title="Automation — The office runs by itself | PISMA"
  description="Payment matching, collections, an organized Excel and a daily report all run on their own — you only see the result."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Pillar two"
    sub="The boring routine work runs on its own. All you see is the report."
  >
    Auto<span class="accent">mation</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="services-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">What runs by itself</p>
        <h2 id="services-title">Eight routine chores, taken off your plate.</h2>
      </div>
      <ServiceCards services={services} cta="See what it does →" />
    </div>
  </section>

  <!-- 2β. «Το ταίριασμα, ζωντανά» — σκηνή σε loop όπως «Η άνοδος στη Google»
       στην αρχική: το HTML έχει το τελικό state (όλα ταιριασμένα) — χωρίς JS
       ή με reduced motion μένει στατικό· το JS το «ξαναπαίζει» όσο φαίνεται. -->
  <section class="section" aria-labelledby="match-title">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="kicker kicker--ok">See it live</p>
        <h2 id="match-title">Every payment finds its invoice</h2>
        <p>Three payments land in the bank — and match themselves, one by one.</p>
      </div>

      <div class="mt-stage" id="mt-stage" aria-hidden="true">
        <div class="mt-fx" id="mt-fx"></div>
        <div class="mt-panel">
          <div class="mt-top">
            <span class="mt-title">Payment matching</span>
            <span class="mt-left num" id="mt-left">Pending: 0</span>
          </div>
          <div class="mt-grid">
            <div class="mt-col">
              <p class="mt-col-label">Bank</p>
              <div class="mt-pay is-done" id="mt-p1"><span>Payment <b class="num">€240</b></span><span class="mt-pay-check">✓</span></div>
              <div class="mt-pay is-done" id="mt-p2"><span>Payment <b class="num">€85</b></span><span class="mt-pay-check">✓</span></div>
              <div class="mt-pay is-done" id="mt-p3"><span>Payment <b class="num">€1,020</b></span><span class="mt-pay-check">✓</span></div>
            </div>
            <div class="mt-col">
              <p class="mt-col-label">Invoices</p>
              <div class="mt-inv is-hit" id="mt-i1">
                <span>INV-0412 <b class="num">€240</b></span>
                <span class="mt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg></span>
                <span class="mt-ring"></span>
              </div>
              <div class="mt-inv is-hit" id="mt-i2">
                <span>INV-0415 <b class="num">€85</b></span>
                <span class="mt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg></span>
                <span class="mt-ring"></span>
              </div>
              <div class="mt-inv is-hit" id="mt-i3">
                <span>INV-0418 <b class="num">€1,020</b></span>
                <span class="mt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg></span>
                <span class="mt-ring"></span>
              </div>
            </div>
          </div>
          <p class="mt-win" id="mt-win">All matched — without a single click ✓</p>
        </div>
      </div>
      <p class="mt-note">Illustrative.</p>
    </div>
  </section>

  <!-- 3. Η μέρα σε αριθμούς — οι τελικοί αριθμοί υπάρχουν στο HTML (fallback
       χωρίς JS)· το JS τους μηδενίζει και τους «μετράει» μία φορά όταν το
       section φανεί. Ίδια νούμερα με το παλιό τερματικό (14/1.230€/3). -->
  <section class="section section--tight" aria-labelledby="live-title">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="kicker">A worked example</p>
        <h2 id="live-title">One day on the system, in numbers.</h2>
        <p>This is what the work nobody did by hand looks like.</p>
      </div>

      <div class="pd reveal" id="pd">
        <p class="pd__eyebrow num" id="pd-date">a typical day</p>
        <div class="pd__row">
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="14">14</span></p>
            <p class="pd__label">payments matched</p>
          </div>
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="1230" data-prefix="€">€1,230</span></p>
            <p class="pd__label">collected</p>
          </div>
          <div class="pd__cell">
            <p class="pd__value num"><span class="pd__num" data-from="0" data-to="3">3</span></p>
            <p class="pd__label">new Google reviews</p>
          </div>
          <div class="pd__cell pd__cell--accent">
            <p class="pd__value num"><span class="pd__num" data-from="47" data-to="0">0</span></p>
            <p class="pd__label">minutes of your time</p>
          </div>
        </div>
        <p class="pd__closing">None of it needed a human.</p>
      </div>
    </div>
  </section>

  <!-- 4. Δείκτης Αυτοματισμού -->
  <section class="section section--tight" aria-labelledby="deiktis-title">
    <div class="container">
      <div class="card deiktis reveal">
        <div class="deiktis-text">
          <p class="kicker">Automation Score</p>
          <h2 id="deiktis-title">One number, from <span class="num">0</span> to <span class="num">100</span>.</h2>
          <p>It measures how many hours a month go to manual work, across three areas. The fewer the hours, the higher the score — at 100, the routine runs without you.</p>
          <a class="card-arrow" href="/en/business-check/">Measure it on The Dashboard →</a>
        </div>
        <ul class="deiktis-areas" aria-label="Areas the Score measures">
          <li class="chip">Payments <span class="muted">hours/month</span></li>
          <li class="chip">Collections <span class="muted">hours/month</span></li>
          <li class="chip">Organization <span class="muted">hours/month</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">FAQ</p>
        <h2 id="faq-title">What everyone asks before getting started.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="How much does your office run by itself?"
    sub="Answer 5 questions and see your Automation Score."
    ctaText="Measure your Score"
    ctaHref="/en/business-check/"
    note="2 minutes · free · no personal details"
  />
</Base>

<script>
  // «Η μέρα σε αριθμούς»: οι τελικοί αριθμοί υπάρχουν στο HTML (fallback χωρίς
  // JS). Το JS τους μηδενίζει και, όταν το section μπει στην οθόνη, μετράει
  // προς τα πάνω ΜΙΑ φορά — κλιμακωτά ανά στήλη. Οι ταχύτητες διαβάζονται από
  // τα --pd-count-duration/--pd-stagger του CSS. Reduced motion: τελικοί
  // αριθμοί αμέσως, καμία κίνηση.
  // EN: το € μπαίνει ΜΠΡΟΣΤΑ (data-prefix) και οι αριθμοί μορφοποιούνται en-US.
  const pd = document.getElementById('pd');
  if (pd) {
    const pdCells = Array.from(pd.querySelectorAll<HTMLElement>('.pd__cell'));
    const pdNums = Array.from(pd.querySelectorAll<HTMLElement>('.pd__num'));
    const pdReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const pdCss = getComputedStyle(pd);
    const cssMs = (name: string, fallback: number) => {
      const v = parseFloat(pdCss.getPropertyValue(name));
      return Number.isNaN(v) ? fallback : v;
    };
    const DURATION = cssMs('--pd-count-duration', 2600);
    const STAGGER = cssMs('--pd-stagger', 220);

    const fmt = (v: number, prefix?: string) => (prefix || '') + Math.round(v).toLocaleString('en-US');
    const setFinal = () =>
      pdNums.forEach((n) => { n.textContent = fmt(Number(n.dataset.to), n.dataset.prefix); });

    if (!pdReduce) {
      pd.classList.add('pd--animate');
      pdNums.forEach((n) => { n.textContent = fmt(Number(n.dataset.from), n.dataset.prefix); });

      const count = () => {
        let start: number | null = null;
        const step = (ts: number) => {
          if (start === null) start = ts;
          const k = Math.min((ts - start) / DURATION, 1);
          const eased = 1 - Math.pow(1 - k, 3);
          pdNums.forEach((n, i) => {
            const p = Math.max(0, Math.min(1, eased * 1.42 - i * 0.14));
            const from = Number(n.dataset.from);
            const to = Number(n.dataset.to);
            n.textContent = fmt(from + (to - from) * p, n.dataset.prefix);
          });
          if (k < 1) requestAnimationFrame(step);
          else setFinal();
        };
        requestAnimationFrame(step);
      };

      const play = () => {
        pdCells.forEach((c, i) => { c.style.transitionDelay = `${i * STAGGER}ms`; });
        pd.classList.add('pd--in');
        window.setTimeout(count, STAGGER + 200);
      };

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              play();
            }
          },
          { threshold: 0.35 }
        );
        io.observe(pd);
      } else {
        play();
      }
    }
    // Με reduced motion: το HTML έχει ήδη τους τελικούς αριθμούς.
  }

  // «Το ταίριασμα, ζωντανά»: το HTML έχει το τελικό state (όλα ταιριασμένα).
  // Με JS + ορατότητα: επαναφορά σε «3 εκκρεμή» και ζωντανό ταίριασμα σε loop·
  // όταν βγει από την οθόνη, σταματά και γυρνά στο τελικό state. Τα ιπτάμενα
  // ποσά παίρνουν inline styles — τα scoped styles δεν πιάνουν JS elements.
  const mtStage = document.getElementById('mt-stage');
  const mtReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (mtStage && !mtReduce && 'IntersectionObserver' in window) {
    const mtFx = document.getElementById('mt-fx')!;
    const mtLeft = document.getElementById('mt-left')!;
    const mtWin = document.getElementById('mt-win')!;
    const pays = ['mt-p1', 'mt-p2', 'mt-p3'].map((id) => document.getElementById(id)!);
    const invs = ['mt-i1', 'mt-i2', 'mt-i3'].map((id) => document.getElementById(id)!);
    const amounts = ['€240', '€85', '€1,020'];
    let mtTimers: number[] = [];
    let mtPending = 0;
    let mtActive = false;

    const mtLater = (fn: () => void, ms: number) => mtTimers.push(window.setTimeout(fn, ms));
    const mtRaf2 = (fn: () => void) => requestAnimationFrame(() => requestAnimationFrame(fn));
    const mtPaint = () => { mtLeft.textContent = `Pending: ${mtPending}`; };

    const mtHit = (k: number) => {
      pays[k].classList.add('is-done');
      invs[k].classList.add('is-hit');
      mtPending = Math.max(0, mtPending - 1);
      mtPaint();
      const ring = invs[k].querySelector<HTMLElement>('.mt-ring');
      if (ring) {
        ring.style.transition = 'none'; ring.style.opacity = '.9'; ring.style.transform = 'scale(1)';
        mtRaf2(() => {
          ring.style.transition = 'opacity .6s ease-out, transform .6s ease-out';
          ring.style.opacity = '0'; ring.style.transform = 'scale(1.12)';
        });
      }
    };

    const mtFly = (k: number) => {
      const sr = mtStage.getBoundingClientRect();
      const pr = pays[k].getBoundingClientRect();
      const ir = invs[k].getBoundingClientRect();
      const chip = document.createElement('span');
      chip.textContent = amounts[k];
      chip.style.cssText = `position:absolute;left:${Math.round(pr.right - sr.left - 30)}px;top:${Math.round(pr.top - sr.top + pr.height / 2 - 13)}px;z-index:3;background:#E1F5EE;color:#0F6E56;font-weight:700;font-size:.72rem;padding:4px 10px;border-radius:999px;border:1px solid #A5D6B8;box-shadow:0 8px 22px rgba(0,0,0,.35);white-space:nowrap;transition:all .8s cubic-bezier(.4,0,.55,1);opacity:0;line-height:1.3`;
      mtFx.appendChild(chip);
      mtRaf2(() => {
        chip.style.opacity = '1';
        chip.style.left = `${Math.round(ir.left - sr.left + 8)}px`;
        chip.style.top = `${Math.round(ir.top - sr.top + ir.height / 2 - 13)}px`;
        chip.style.transform = 'scale(.82)';
      });
      mtLater(() => { chip.remove(); mtHit(k); }, 820);
    };

    const mtFinal = () => {
      pays.forEach((p) => p.classList.add('is-done'));
      invs.forEach((i) => i.classList.add('is-hit'));
      mtPending = 0; mtPaint();
      mtWin.style.opacity = '1'; mtWin.style.transform = 'none';
    };

    const mtCycle = () => {
      mtTimers.forEach(clearTimeout); mtTimers = []; mtFx.innerHTML = '';
      pays.forEach((p) => p.classList.remove('is-done'));
      invs.forEach((i) => i.classList.remove('is-hit'));
      mtPending = 3; mtPaint();
      mtWin.style.opacity = '0'; mtWin.style.transform = 'translateY(6px)';
      for (let k = 0; k < 3; k++) mtLater(() => mtFly(k), 1000 + k * 1400);
      // Δίχτυ ασφαλείας: το φινάλε κλειδώνει στο στατικό state.
      mtLater(mtFinal, 5400);
      mtLater(mtCycle, 9200);
    };

    const mtIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !mtActive) { mtActive = true; mtCycle(); }
          else if (!e.isIntersecting && mtActive) {
            mtActive = false;
            mtTimers.forEach(clearTimeout); mtTimers = []; mtFx.innerHTML = '';
            mtFinal();
          }
        }
      },
      { threshold: 0.35 }
    );
    mtIo.observe(mtStage);
  }
</script>

<style>
  /* Κάρτα με tag δίπλα στο εικονίδιο */
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .card-top .tag { margin-top: 4px; }

  /* ---- «Η μέρα σε αριθμούς» ---- */
  .pd {
    /* timing — τα διαβάζει το JS */
    --pd-count-duration: 2600;
    --pd-stagger: 220;
    max-width: 860px;
    margin-inline: auto;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    padding: clamp(24px, 4vw, 44px);
  }
  .pd__eyebrow {
    margin: 0 0 clamp(20px, 3vw, 32px);
    font-size: .82rem;
    letter-spacing: .06em;
    color: var(--muted);
  }
  .pd__row { display: flex; align-items: flex-start; }
  .pd__cell { flex: 1; min-width: 0; padding: 0 clamp(14px, 2vw, 24px); }
  .pd__cell:first-child { padding-left: 0; }
  .pd__cell:last-child { padding-right: 0; }
  .pd__cell + .pd__cell { border-left: 1px solid var(--line-strong); }
  .pd__value {
    margin: 0;
    max-width: none;
    font-size: clamp(30px, 4.4vw, 46px);
    font-weight: 500;
    line-height: 1;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .pd__cell--accent .pd__value { color: var(--orange); }
  .pd__label {
    margin: 12px 0 0;
    font-size: clamp(.8rem, 1.2vw, .9rem);
    line-height: 1.4;
    color: var(--muted);
  }
  .pd__closing {
    margin: clamp(26px, 3.5vw, 36px) 0 0;
    padding-top: clamp(18px, 2.4vw, 26px);
    border-top: 1px solid var(--line);
    max-width: none;
    font-size: clamp(.9rem, 1.4vw, 1.05rem);
    color: var(--ink);
  }

  /* είσοδος: κάθε στήλη ανεβαίνει λίγο και εμφανίζεται (μόνο με JS) */
  .pd--animate .pd__cell {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .9s ease, transform .9s ease;
  }
  .pd--animate.pd--in .pd__cell { opacity: 1; transform: none; }

  /* mobile: 2x2 — οι κάθετες γραμμές φεύγουν */
  @media (max-width: 719px) {
    .pd__row { flex-wrap: wrap; }
    .pd__cell { flex: 0 0 50%; padding: 20px 0 0; }
    .pd__cell:nth-child(-n+2) { padding-top: 0; }
    .pd__cell:nth-child(odd) { padding-right: 16px; }
    .pd__cell + .pd__cell { border-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pd--animate .pd__cell { opacity: 1; transform: none; transition: none; }
  }

  /* ---- «Το ταίριασμα, ζωντανά» ---- */
  .mt-stage {
    position: relative; max-width: 560px; margin-inline: auto;
    border-radius: var(--r); border: 1px solid var(--line); overflow: hidden;
    background: radial-gradient(420px 300px at 50% 30%, var(--ok-soft), transparent 70%) var(--bg-soft);
    padding: clamp(20px, 3.5vw, 34px);
  }
  .mt-fx { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .mt-panel {
    max-width: 430px; margin-inline: auto;
    background: var(--card); border: 1px solid var(--line-strong);
    border-radius: 18px; padding: 16px; box-shadow: var(--shadow);
  }
  .mt-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .mt-title { font-size: .8rem; font-weight: 700; color: var(--navy); }
  .mt-left {
    font-size: .7rem; color: var(--muted);
    border: 1px solid var(--line-strong); border-radius: 999px; padding: 3px 10px;
  }
  .mt-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 10px 14px; }
  .mt-col { display: grid; gap: 8px; align-content: start; }
  .mt-col-label {
    margin: 0 0 2px; max-width: none;
    font-size: .66rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
    color: var(--muted);
  }
  .mt-pay, .mt-inv {
    position: relative;
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: 8px 10px; font-size: .76rem; color: var(--ink); white-space: nowrap;
  }
  .mt-pay b, .mt-inv b { font-weight: 600; }
  .mt-pay { transition: opacity .5s ease; }
  .mt-pay-check { color: var(--ok-text); font-weight: 700; opacity: 0; transition: opacity .4s ease; }
  .mt-pay.is-done { opacity: .55; }
  .mt-pay.is-done .mt-pay-check { opacity: 1; }
  .mt-inv { border-width: 1.5px; transition: border-color .4s ease, background-color .4s ease; }
  .mt-inv.is-hit { border-color: var(--ok); background: var(--ok-soft); }
  .mt-check {
    display: inline-flex; width: 15px; height: 15px; flex: none;
    color: var(--ok-text);
    transform: scale(0);
    transition: transform .45s cubic-bezier(.3, 1.8, .4, 1);
  }
  .mt-check svg { width: 100%; height: 100%; }
  .mt-inv.is-hit .mt-check { transform: scale(1); }
  .mt-ring {
    position: absolute; inset: -3px; border: 2px solid var(--ok);
    border-radius: 12px; opacity: 0; pointer-events: none;
  }
