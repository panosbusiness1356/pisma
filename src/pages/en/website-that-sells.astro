---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, ELEGXOS, eurEn } from '../../config';
import { optionById } from '../../data/pricing';

// Μία πηγή αλήθειας για τις τιμές: pricing.ts (web-basic/standard/pro).
const basic = optionById('web-basic')!;
const standard = optionById('web-standard')!;
const pro = optionById('web-pro')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Website',
  serviceType: 'Business website development',
  areaServed: SITE.regionEn,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: basic.price,
    priceCurrency: 'EUR',
    description: `From ${eurEn(basic.price)} one-off.`,
  },
  description:
    'Business website development, fast and clean, with a clear next step on every page.',
};

const why = [
  {
    t: 'Fast on every device',
    d: 'Loads instantly on phone and desktop.',
    icon: 'speed',
  },
  {
    t: 'Ready for Google',
    d: 'Correct technical structure for searches in your area.',
    icon: 'search',
  },
  {
    t: 'Entirely yours',
    d: 'Domain, content and files belong to your business.',
    icon: 'key',
  },
];

const faqItems = [
  {
    q: 'How long until it is ready?',
    a: 'In 2 to 4 weeks from receiving the material: texts, photos, logo. If something is missing, we help create it.',
  },
  {
    q: 'What do I need to bring?',
    a: 'Logo, photos, a price list and a short description of the business. Structure, copy and set-up are handled by us.',
  },
  {
    q: 'Will the website be mine?',
    a: 'Yes. Domain, content and files belong to your business.',
  },
  {
    q: 'How much does it cost?',
    a: `One-off: Basic ${eurEn(basic.price)}, Standard ${eurEn(standard.price)}, Pro ${eurEn(pro.price)}, Enterprise for very large businesses with many products, priced after consultation. Monthly services such as maintenance are optional and publicly priced on the pricing page.`,
  },
  {
    q: 'Will Google find me with this?',
    a: 'The website is built technically correct for Google from the start. Active ranking improvement, SEO, is a separate service on the Digital Visibility page.',
  },
];
---

<Base
  title="Business website development | PISMA"
  description="Business website development with public prices, a live sample and delivery in 2 to 4 weeks."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Website"
    sub="A fast website for your business, with a clear next step on every page."
  >
    Website <span class="accent">development</span>
  </PageHero>

  <!-- 2. «Δείτε το ζωντανά», σκηνή laptop σε loop όπως οι άλλες σκηνές:
       το HTML έχει το τελικό state (site πλήρες, κλήση σε εξέλιξη), χωρίς
       JS ή με reduced motion μένει στατικό· το JS το «ξαναπαίζει» όσο το
       section είναι ορατό: η σελίδα χτίζεται, ο κέρσορας πατά «Κάλεσε τώρα»
       και το τηλέφωνο της επιχείρησης χτυπάει. -->
  <section class="section section--tight" aria-labelledby="sp-title">
    <div class="container">
      <div class="sp-grid">
        <div class="sp-copy">
          <div class="sec-head">
            <p class="kicker">Live sample</p>
            <h2 id="sp-title">A sample of our work.</h2>
          </div>
          <p class="sp-sub">
            On screen you see a sample of our websites, with clean structure and fast loading.
          </p>
          <div class="sp-cta-row">
            <a class="btn btn--orange" href="/en/pricing/">See website pricing →</a>
            <a class="btn btn--ghost" href="/site-demo/lyra/index.html" target="_blank" rel="noopener">Open the sample ↗</a>
          </div>
          <p class="sp-note">You can browse inside the screen.</p>
        </div>

        <div class="sp-stage" id="sp-stage">
          <div class="sp-laptop">
            <div class="sp-screen">
              <span class="sp-camdot"></span>
              <div class="sp-page" id="sp-page">
                <div class="sp-browser">
                  <span class="sp-dots"><i></i><i></i><i></i></span>
                  <span class="sp-url">lyra-wines.gr</span>
                </div>
                <div class="sp-view" id="sp-view">
                  <iframe class="sp-iframe" id="sp-iframe" src="/site-demo/lyra/index.html" title="Live sample: Lyra Winery" loading="lazy" tabindex="-1" sandbox="allow-scripts allow-same-origin"></iframe>
                </div>
              </div>
            </div>
            <div class="sp-base"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Τι κερδίζεις -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--blue">What is included</p>
        <h2 id="why-title">What every website includes.</h2>
      </div>
      <div class="grid-3">
        {why.map((w) => (
          <article class="card reveal">
            <span class="icon-chip">
              {w.icon === 'speed' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13 2.5 4.5 13.5h6l-1 8L19.5 10.5h-6z" />
                </svg>
              )}
              {w.icon === 'search' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" />
                </svg>
              )}
              {w.icon === 'key' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="8" cy="14" r="4.5" /><path d="M11.5 10.5 20 2" /><path d="M16 6l3 3" /><path d="M13.5 8.5 16 11" />
                </svg>
              )}
            </span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Τιμή -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Prices</p>
          <h2 id="price-title">
            From <span class="price-num num">{eurEn(basic.price)}</span> one-off
          </h2>
          <p class="price-sub">
            <strong>Basic {eurEn(basic.price)}</strong> · <strong>Standard {eurEn(standard.price)}</strong> · <strong>Pro {eurEn(pro.price)}</strong> · <strong>Enterprise</strong> on request.
            Public prices, the same for everyone. Monthly services are optional.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/en/pricing/">Build your package →</a>
          <a class="btn btn--ghost" href="/en/free-assessment/">Free {ELEGXOS.minutes}-minute PISMA Check</a>
          <span class="btn-note">No online payment. Agreements are made by phone.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Questions</p>
        <h2 id="faq-title">FAQ.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Start with a free check."
    sub={`Free ${ELEGXOS.minutes}-minute PISMA Check: what you have today and what is needed.`}
    ctaText="Book the free PISMA Check"
    ctaHref="/en/free-assessment/"
    note="No online payment · no commitment"
  />
</Base>

<script>
  // «Site» (laptop): μέσα στην οθόνη ένα premium site τριών
  // οθονών, και η κίνηση είναι απλώς η περιήγηση, αργό scroll προς τα κάτω
  // με παύσεις σε κάθε ενότητα, και επιστροφή στην κορυφή. Χωρίς JS ή με
  // reduced motion: στατικό hero.
  // Μέσα στην οθόνη παίζει το πραγματικό δείγμα site (Οινοποιείο «Λύρα») σε
  // desktop απόδοση 1180px με σμίκρυνση, ο επισκέπτης σκρολάρει μέσα του
  // όπως σε κανονικό υπολογιστή.
  const spView = document.getElementById('sp-view');
  const spFrame = document.getElementById('sp-iframe') as HTMLIFrameElement | null;
  if (spView && spFrame) {
    const DESK = 1180;
    const fit = () => {
      const s = spView.clientWidth / DESK;
      spFrame.style.width = `${DESK}px`;
      spFrame.style.height = `${Math.round(spView.clientHeight / s)}px`;
      spFrame.style.transform = `scale(${s})`;
    };
    fit();
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(spView);
    else window.addEventListener('resize', fit);

    // Αυτόματη περιήγηση (αίτημα χρήστριας): μόλις φορτώσει το δείγμα και το
    // laptop είναι ορατό, η οθόνη σκρολάρει μόνη της, μία «οθόνη» τη φορά,
    // με παύση σε κάθε ενότητα, και στο τέλος γυρνά ομαλά στην κορυφή και
    // ξαναρχίζει. Παύει μόλις ο επισκέπτης πιάσει την οθόνη (ρόδα, αφή, κλικ,
    // πληκτρολόγιο)· όταν η σκηνή βγει τελείως από την οθόνη, γυρνά στην κορυφή
    // και στην επόμενη είσοδο ξαναρχίζει από την αρχή (και στο κινητό, όπου το
    // άγγιγμα κατά το scroll της σελίδας την πιάνει εύκολα). Με reduced motion
    // δεν τρέχει.
    const spStage = document.getElementById('sp-stage');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (spStage && !reduce) {
      let visible = false, loaded = false, stopped = false, running = false;
      const STEP_MS = 1400, PAUSE_MS = 2000, HOME_MS = 1600, HOME_PAUSE_MS = 2600, HERO_PAUSE_MS = 3200;
      const ease = (t: number) => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const frameWin = () => spFrame.contentWindow;
      const scrollTo = (y: number) => {
        const w = frameWin(); if (!w) return;
        try { w.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior }); } catch { w.scrollTo(0, y); }
      };
      const maxY = () => {
        const w = frameWin(); const d = w?.document.documentElement;
        return w && d ? Math.max(0, d.scrollHeight - w.innerHeight) : 0;
      };
      const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
      // Το δείγμα έχει δική του κινηματογραφική εισαγωγή (#cine, περίπου 5 s) που
      // καλύπτει την αρχική του. Η περιήγηση περιμένει να φύγει πριν μετρήσει την
      // παύση στην αρχική, αλλιώς η αρχική δεν φαίνεται ποτέ και η οθόνη μοιάζει
      // να ξεκινά από τη δεύτερη ενότητα (χρήστρια 10/09/2026). Όριο 8 s.
      const introGone = async () => {
        const t0 = performance.now();
        while (!stopped && visible && performance.now() - t0 < 8000) {
          const d = frameWin()?.document;
          if (d && !d.getElementById('cine')) return;
          await wait(100);
        }
      };
      const glide = (from: number, to: number, ms: number) => new Promise<void>((res) => {
        const t0 = performance.now();
        const tick = (now: number) => {
          if (stopped || !visible) return res();
          const t = Math.min(1, (now - t0) / ms);
          scrollTo(from + (to - from) * ease(t));
          t < 1 ? requestAnimationFrame(tick) : res();
        };
        requestAnimationFrame(tick);
      });
      // Στάσεις = ΜΟΝΟ η κορυφή κάθε ενότητας του δείγματος (header / section /
      // footer), ακριβώς όπως προσγειώνουν τις ενότητες τα δικά του links
      // (block: start). Καμία ενδιάμεση στάση μέσα σε ψηλές ενότητες και καμία
      // στάση σε λεπτές λωρίδες (κάτω από 45 % της οθόνης, π.χ. στατιστικά):
      // και τα δύο έδειχναν την οθόνη «μισή-μισή» (χρήστρια 10/09/2026). Το
      // footer είναι πάντα στάση, όσο κοντό κι αν είναι.
      const stops = () => {
        const w = frameWin(); const d = w?.document; if (!w || !d) return [];
        const vh = w.innerHeight, max = maxY();
        const els = Array.from(d.querySelectorAll('header, section, footer'))
          .filter((el) => !el.parentElement?.closest('header, section, footer'));
        const out = new Set<number>([0]);
        for (const el of els) {
          const r = el.getBoundingClientRect();
          const top = Math.round(r.top + w.scrollY);
          if (top <= 0 || r.height <= 0) continue;
          if (el.tagName !== 'FOOTER' && r.height < vh * .45) continue;
          out.add(Math.min(top, max));
        }
        return Array.from(out).sort((a, b) => a - b);
      };
      const tour = async () => {
        if (running) return; running = true;
        // Κάθε φορά που η σκηνή μπαίνει (ξανά) στην οθόνη, η περιήγηση ξεκινά
        // από την κορυφή του δείγματος, όχι από εκεί που είχε μείνει όταν ο
        // επισκέπτης σκρόλαρε πιο κάτω στη σελίδα (χρήστρια 10/09/2026). Σε παύση
        // από άγγιγμα δεν πειράζουμε τη θέση που διάλεξε ο ίδιος.
        if (!stopped) scrollTo(0);
        while (!stopped && visible && loaded) {
          const w = frameWin(); if (!w) break;
          let y = 0; scrollTo(0);
          await introGone();
          await wait(HERO_PAUSE_MS);
          for (;;) {
            if (stopped || !visible) break;
            const next = stops().find((s) => s > y + 4);
            if (next === undefined) break;
            await glide(y, next, STEP_MS); y = next;
            await wait(PAUSE_MS);
          }
          if (stopped || !visible) break;
          await glide(y, 0, HOME_MS);
          await wait(HOME_PAUSE_MS);
        }
        running = false;
      };
      const stop = () => { stopped = true; };
      const armStop = () => {
        const w = frameWin(); if (!w) return;
        for (const ev of ['wheel', 'touchstart', 'pointerdown', 'keydown']) w.addEventListener(ev, stop, { passive: true });
      };
      // Δεν περιμένουμε το «load» της iframe (καθυστερεί όσο κατεβαίνουν τα
      // βίντεο του δείγματος), ξεκινάμε μόλις είναι έτοιμο το DOM του.
      const ready = () => {
        const w = frameWin(); const d = w?.document;
        return !!(w && d && w.location.href !== 'about:blank' && d.readyState !== 'loading' && d.body && maxY() > 0);
      };
      const poll = setInterval(() => {
        if (!ready()) return;
        clearInterval(poll); loaded = true; armStop(); tour();
      }, 250);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((es) => {
          const e = es[0];
          visible = e.isIntersecting && e.intersectionRatio >= .35;
          // Μόλις βγει ΤΕΛΕΙΩΣ από την οθόνη, γυρνά αμέσως στην κορυφή και
          // ξεκλειδώνει τυχόν παύση από άγγιγμα, ώστε να ξαναφανεί από την αρχή.
          // (Όχι σε μερική ορατότητα: εκεί ο επισκέπτης μπορεί να σκρολάρει.)
          if (visible) tour(); else if (!e.isIntersecting) { stopped = false; scrollTo(0); }
        }, { threshold: [0, .35] }).observe(spStage);
      } else { visible = true; tour(); }
      document.addEventListener('visibilitychange', () => { if (!document.hidden && visible) tour(); });
    }
  }
</script>

<style>
  /* ---------- «Site», laptop ---------- */
  /* Δίστηλη διάταξη σε desktop (κείμενο αριστερά, laptop δεξιά), στοίβαγμα
     σε στενές οθόνες, ίδιο μοτίβο με τις άλλες σκηνές. */
  .sp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
    max-width: 1020px; margin-inline: auto;
  }
  .sp-copy .sec-head { margin-bottom: 0; }
  .sp-sub { color: var(--muted); max-width: 44ch; margin: 16px 0 26px; }
  .sp-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .sp-note { color: var(--muted); font-size: .78rem; margin: 14px 0 0; max-width: 42ch; }
  @media (max-width: 960px) {
    .sp-grid { grid-template-columns: minmax(0, 1fr); }
    .sp-stage { margin-inline: auto; }
  }

  /* Ρεαλιστικό laptop: οθόνη 16:10 με λεπτό μπεζέλ και αλουμινένια βάση */
  .sp-stage { width: 520px; max-width: 100%; }
  .sp-laptop { position: relative; }
  .sp-screen {
    position: relative;
    background: #0f0f11; border: 1px solid #3c3c42;
    border-radius: 16px 16px 4px 4px;
    padding: 11px 11px 15px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, .55);
  }
  .sp-camdot {
    position: absolute; top: 5px; left: 50%; transform: translateX(-50%);
    width: 4px; height: 4px; border-radius: 50%;
    background: #2c2c31; box-shadow: inset 0 0 2px #000, 0 0 0 1px rgba(255, 255, 255, .05);
  }
  .sp-base {
    width: 118%; margin-left: -9%;
    height: 14px;
    background: linear-gradient(180deg, #eceef1 0%, #c3c5cb 50%, #9a9ca3 100%);
    border-radius: 2px 2px 14px 14px;
    position: relative;
  }
  .sp-base::before {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 84px; height: 5px;
    background: #a2a4ab; border-radius: 0 0 9px 9px;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, .18);
  }
  .sp-base::after {
    content: ''; position: absolute; top: 0; left: 2%; right: 2%;
    height: 1px; background: rgba(0, 0, 0, .18);
  }

  /* Η σελίδα μέσα στην οθόνη, φωτεινό editorial site κτήματος: ζεστή
     άμμος, βαθύ λαδί και τερακότα (συγγενική με τα ιταλικά estates παλέτα,
     όχι αντιγραφή), μεγάλα serif κεφαλαία με αραίωση. */
  .sp-page {
    position: relative;
    display: flex; flex-direction: column;
    aspect-ratio: 16 / 10;
    background: #150C11;
    border-radius: 6px; overflow: hidden;
  }
  .sp-view { position: relative; flex: 1; overflow: hidden; }
  /* Το πραγματικό δείγμα-site μέσα στην οθόνη: desktop απόδοση σε σμίκρυνση */
  .sp-iframe {
    border: 0; display: block;
    transform-origin: 0 0;
    background: #150C11;
  }
  .sp-browser {
    display: flex; align-items: center; gap: 8px;
    background: #1d1c21; padding: 6px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, .05);
  }
  .sp-dots { display: inline-flex; gap: 5px; }
  .sp-dots i { width: 8px; height: 8px; border-radius: 50%; }
  .sp-dots i:nth-child(1) { background: #ff5f57; }
  .sp-dots i:nth-child(2) { background: #febc2e; }
  .sp-dots i:nth-child(3) { background: #28c840; }
  .sp-url {
    flex: 1; text-align: center;
    background: rgba(255, 255, 255, .08); border-radius: 999px; padding: 3px 10px;
    color: #aeb6c2; font-size: .64rem; font-weight: 600;
  }

  @media (max-width: 560px) {
    /* Η προεξοχή της βάσης μαζεύει ώστε να μη δημιουργεί οριζόντιο scroll */
    .sp-base { width: 106%; margin-left: -3%; }
  }

  /* ---- Τιμή (ίδιο μοτίβο με τις άλλες σελίδες υπηρεσιών) ---- */
  .price-card {
    display: grid;
    grid-template-columns: 1.2fr minmax(min(240px, 100%), .8fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(26px, 4vw, 48px);
  }
  @media (max-width: 720px) {
    .price-card { grid-template-columns: 1fr; }
  }
  .price-main .kicker { margin-bottom: 14px; }
  .price-num { font-size: clamp(2rem, 5vw, 2.8rem); color: var(--orange-text); }
  .price-sub { margin-top: 12px; color: var(--muted); }
  .price-sub strong { color: var(--ink); }
  .price-cta { display: flex; flex-direction: column; gap: 12px; }
  .price-cta .btn { text-align: center; }
  .price-cta .btn-note { text-align: center; }
</style>
