---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, ELEGXOS, eurEn } from '../../config';
import { optionById } from '../../data/pricing';

// Μία πηγή αλήθειας για τις τιμές: pricing.ts (web-basic/standard/pro).
const basic = optionById('web-basic')!;
const standard = optionById('web-standard')!;
const pro = optionById('web-pro')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'A website that sells',
  serviceType: 'Business website development',
  areaServed: SITE.regionEn,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: basic.price,
    priceCurrency: 'EUR',
    description: `From ${eurEn(basic.price)} one-off.`,
  },
  description:
    "A fast, clean website with one clear next step on every page — visitors don't browse, they pick up the phone.",
};

const why = [
  {
    t: 'Fast — nobody leaves',
    d: 'It opens instantly, even on the slowest phone. Every second of delay is a customer heading back to Google.',
    icon: 'speed',
  },
  {
    t: 'One clear next step',
    d: "A call, a message or a quote — on every page, visitors know what to press. No maze, no artsy tricks that confuse.",
    icon: 'target',
  },
  {
    t: 'Measurable — you know what it earned',
    d: 'How many came in, how many pressed "Call", where they came from. The website answers with numbers, every month.',
    icon: 'chart',
  },
];

const faqItems = [
  {
    q: 'How long until it is ready?',
    a: "Usually 2–4 weeks from the moment we have the material (texts, photos, logo). If something's missing, we help create it.",
  },
  {
    q: 'What do I need to bring?',
    a: 'Whatever you have: logo, photos, a price list, a few words about your work. The rest — structure, copy, set-up — is on us.',
  },
  {
    q: 'Will the website be mine?',
    a: 'Yes, entirely. Domain, content and files belong to your business — whatever happens with our collaboration.',
  },
  {
    q: 'How much does it cost?',
    a: `Three clear tiers, one-off: Basic ${eurEn(basic.price)}, Standard ${eurEn(standard.price)}, Pro ${eurEn(pro.price)}. Anything monthly (like maintenance) is optional and publicly priced on our pricing page.`,
  },
  {
    q: 'Will Google find me with this?',
    a: 'The website is built technically right for Google from day one. If you also want active ranking growth (SEO), that is a separate service — you will find it on the Digital Visibility page.',
  },
];
---

<Base
  title="A website that sells — not a shop window, a working tool | PISMA"
  description="A fast, clean website with one clear next step on every page. See it live: a visitor lands, presses Call now — and your phone rings."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="A website that sells"
    sub="Fast, clean, with one clear next step on every page. Visitors don't browse — they pick up the phone."
  >
    Not a shop window — <span class="accent">a working tool</span>
  </PageHero>

  <!-- 2. «Δείτε το ζωντανά» — σκηνή laptop σε loop όπως οι άλλες σκηνές:
       το HTML έχει το τελικό state (site πλήρες, κλήση σε εξέλιξη) — χωρίς
       JS ή με reduced motion μένει στατικό· το JS το «ξαναπαίζει» όσο το
       section είναι ορατό: η σελίδα χτίζεται, ο κέρσορας πατά «Κάλεσε τώρα»
       και το τηλέφωνο της επιχείρησης χτυπάει. -->
  <section class="section section--tight" aria-labelledby="sp-title">
    <div class="container">
      <div class="sp-grid">
        <div class="sp-copy">
          <div class="sec-head">
            <p class="kicker">See it live</p>
            <h2 id="sp-title">A visitor lands — your phone rings</h2>
          </div>
          <p class="sp-sub">
            This is how a working-tool website behaves: a clear picture, prices
            up front, and a button you never have to hunt for. The visitor's
            "next step" is your till.
          </p>
          <div class="sp-cta-row">
            <a class="btn btn--orange" href="/en/pricing/">See website pricing →</a>
          </div>
          <p class="sp-note">Illustrative — your own site is built for your own business.</p>
        </div>

        <div class="sp-stage" id="sp-stage" aria-hidden="true">
          <div class="sp-laptop">
            <div class="sp-screen">
              <span class="sp-camdot"></span>
              <div class="sp-page is-dim" id="sp-page">
                <div class="sp-browser">
                  <span class="sp-dots"><i></i><i></i><i></i></span>
                  <span class="sp-url">nikos-service.gr</span>
                </div>
                <div class="sp-body">
                  <div class="sp-part sp-nav is-in">
                    <b>NIKOS<span>auto service</span></b>
                    <span class="sp-links"><i>Services</i><i>Prices</i><i>Booking</i></span>
                  </div>
                  <div class="sp-hero">
                    <div class="sp-part sp-hcopy is-in">
                      <p class="sp-h1">Your car, ready the same day</p>
                      <p class="sp-hsub">Servicing, tyres, diagnostics — by appointment, at fixed prices.</p>
                      <span class="sp-btn" id="sp-cta">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 3.5h4l1.7 4.3-2.2 1.8a13.5 13.5 0 0 0 5.4 5.4l1.8-2.2 4.3 1.7v4a1.8 1.8 0 0 1-2 1.8C10.7 19.6 4.4 13.3 3.7 5.5a1.8 1.8 0 0 1 1.8-2z" /></svg>
                        Call now
                      </span>
                    </div>
                    <div class="sp-part sp-hart is-in">
                      <svg class="sp-hart-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="4.2" />
                        <path d="M12 4.6V2.4M12 21.6v-2.2M19.4 12h2.2M2.4 12h2.2M17.2 6.8l1.6-1.6M5.2 18.8l1.6-1.6M17.2 17.2l1.6 1.6M5.2 5.2l1.6 1.6" />
                      </svg>
                      <span class="sp-hart-chip">★ 4.8 · 180 reviews</span>
                    </div>
                  </div>
                  <div class="sp-cards">
                    <span class="sp-part sp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3.4 4.1 5.8 7.1 5.8 9.9a5.8 5.8 0 1 1-11.6 0c0-2.8 2.4-5.8 5.8-9.9z"/></svg>Oil change <b class="num">€39</b></span>
                    <span class="sp-part sp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.4"/><path d="M12 5V2.8M12 21.2V19M19 12h2.2M2.8 12H5M16.9 7.1l1.6-1.6M5.5 18.5l1.6-1.6M16.9 16.9l1.6 1.6M5.5 5.5l1.6 1.6"/></svg>Full service <b class="num">€89</b></span>
                    <span class="sp-part sp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><circle cx="12" cy="12" r="3.2"/><path d="M12 3.4v3M12 17.6v3M3.4 12h3M17.6 12h3"/></svg>Tyres <b class="num">€45</b></span>
                  </div>
                </div>
                <!-- Το τηλέφωνο της επιχείρησης χτυπάει -->
                <div class="sp-call is-on" id="sp-call">
                  <span class="sp-call-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 3.5h4l1.7 4.3-2.2 1.8a13.5 13.5 0 0 0 5.4 5.4l1.8-2.2 4.3 1.7v4a1.8 1.8 0 0 1-2 1.8C10.7 19.6 4.4 13.3 3.7 5.5a1.8 1.8 0 0 1 1.8-2z" /></svg>
                  </span>
                  <p class="sp-call-t">Your phone is ringing</p>
                  <p class="sp-call-s">New customer · straight from the website</p>
                </div>
                <svg class="sp-cursor" id="sp-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 3.2 19 12.2l-6.6 1.1 3.4 6.4-2.7 1.4-3.4-6.4-4.2 4.6z" fill="#111" stroke="#fff" stroke-width="1.4"/></svg>
              </div>
            </div>
            <div class="sp-base"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Τι κερδίζεις -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--blue">What you get</p>
        <h2 id="why-title">Three things that separate a tool from a shop window.</h2>
      </div>
      <div class="grid-3">
        {why.map((w) => (
          <article class="card reveal">
            <span class="icon-chip">
              {w.icon === 'speed' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13 2.5 4.5 13.5h6l-1 8L19.5 10.5h-6z" />
                </svg>
              )}
              {w.icon === 'target' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1" />
                </svg>
              )}
              {w.icon === 'chart' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 20V11" /><path d="M12 20V4" /><path d="M19 20v-6" />
                </svg>
              )}
            </span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Τιμή -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Prices — public, the same for everyone</p>
          <h2 id="price-title">
            From <span class="price-num num">{eurEn(basic.price)}</span> one-off
          </h2>
          <p class="price-sub">
            Three clear tiers: <strong>Basic {eurEn(basic.price)}</strong>,
            <strong>Standard {eurEn(standard.price)}</strong> and
            <strong>Pro {eurEn(pro.price)}</strong> — from a clean presence to a
            bigger site with special features. Anything monthly is optional —
            and publicly priced.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/en/pricing/">Build your package →</a>
          <a class="btn btn--ghost" href="/en/free-assessment/">Free {ELEGXOS.minutes}-minute assessment</a>
          <span class="btn-note">No online payment — we close it over the phone.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">FAQ</p>
        <h2 id="faq-title">The questions everyone asks.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Put your website to work."
    sub={`We start with a free ${ELEGXOS.minutes}-minute assessment — we look at what you have today and what it leaves on the table.`}
    ctaText="Book the free assessment"
    ctaHref="/en/free-assessment/"
    note="No online payment · no commitment"
  />
</Base>

<script>
  // «Site που πουλάει» (laptop): το HTML έχει το τελικό state (site πλήρες,
  // κλήση σε εξέλιξη). Με JS + ορατότητα, σε loop: η σελίδα χτίζεται
  // κομμάτι-κομμάτι, ο κέρσορας πατά «Κάλεσε τώρα» και το τηλέφωνο της
  // επιχείρησης χτυπάει. Εκτός οθόνης: τελικό state. Χωρίς JS: στατικό.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const spStage = document.getElementById('sp-stage');
  if (spStage && !reduce && 'IntersectionObserver' in window) {
    const spPage = document.getElementById('sp-page')!;
    const spCta = document.getElementById('sp-cta')!;
    const spCall = document.getElementById('sp-call')!;
    const spCursor = document.getElementById('sp-cursor')!;
    const spParts = Array.from(spStage.querySelectorAll<HTMLElement>('.sp-part'));
    let spTimers: number[] = [];
    let spActive = false;
    const spLater = (fn: () => void, ms: number) => spTimers.push(window.setTimeout(fn, ms));

    // Ο κέρσορας ταξιδεύει ώστε η μύτη του βέλους να πέφτει πάνω στο στοιχείο
    const spGo = (el: HTMLElement, ms: number) => {
      const pr = spPage.getBoundingClientRect();
      const br = el.getBoundingClientRect();
      spCursor.style.transition = `opacity .3s ease, left ${ms}ms cubic-bezier(.3, .7, .25, 1), top ${ms}ms cubic-bezier(.3, .7, .25, 1)`;
      spCursor.style.opacity = '1';
      spCursor.style.left = `${Math.round(br.left - pr.left + br.width * 0.55)}px`;
      spCursor.style.top = `${Math.round(br.top - pr.top + br.height * 0.55)}px`;
    };

    const spFinal = () => {
      spParts.forEach((p) => p.classList.add('is-in'));
      spCta.classList.remove('is-press');
      spPage.classList.add('is-dim');
      spCall.classList.add('is-on');
      spCursor.style.opacity = '0';
    };

    const spCycle = () => {
      spTimers.forEach(clearTimeout); spTimers = [];
      const pr = spPage.getBoundingClientRect();
      // Επαναφορά: άδεια σελίδα, κέρσορας κάτω-δεξιά, καμία κλήση
      spParts.forEach((p) => p.classList.remove('is-in'));
      spCta.classList.remove('is-press');
      spPage.classList.remove('is-dim');
      spCall.classList.remove('is-on');
      spCursor.style.transition = 'none';
      spCursor.style.opacity = '0';
      spCursor.style.left = `${Math.round(pr.width - 34)}px`;
      spCursor.style.top = `${Math.round(pr.height - 30)}px`;
      // Η σελίδα «χτίζεται» κομμάτι-κομμάτι
      spLater(() => {
        spParts.forEach((p, i) => spLater(() => p.classList.add('is-in'), i * 220));
      }, 600);
      // Ο επισκέπτης πατά «Κάλεσε τώρα»
      spLater(() => spGo(spCta, 1000), 3200);
      spLater(() => spCta.classList.add('is-press'), 4400);
      spLater(() => spCta.classList.remove('is-press'), 4700);
      // …και το τηλέφωνο της επιχείρησης χτυπάει
      spLater(() => {
        spPage.classList.add('is-dim');
        spCall.classList.add('is-on');
        spCursor.style.opacity = '0';
      }, 5100);
      // Δίχτυ ασφαλείας: κλείδωμα στο στατικό state
      spLater(spFinal, 10200);
      spLater(spCycle, 12600);
    };

    const spIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !spActive) { spActive = true; spCycle(); }
          else if (!e.isIntersecting && spActive) {
            spActive = false;
            spTimers.forEach(clearTimeout); spTimers = [];
            spFinal();
          }
        }
      },
      { threshold: 0.35 }
    );
    spIo.observe(spStage);
  }
</script>

<style>
  /* ---------- «Site που πουλάει» — laptop ---------- */
  /* Δίστηλη διάταξη σε desktop (κείμενο αριστερά, laptop δεξιά), στοίβαγμα
     σε στενές οθόνες — ίδιο μοτίβο με τις άλλες σκηνές. */
  .sp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
    max-width: 1020px; margin-inline: auto;
  }
  .sp-copy .sec-head { margin-bottom: 0; }
  .sp-sub { color: var(--muted); max-width: 44ch; margin: 16px 0 26px; }
  .sp-cta-row { display: flex; }
  .sp-note { color: var(--muted); font-size: .78rem; margin: 14px 0 0; max-width: 42ch; }
  @media (max-width: 960px) {
    .sp-grid { grid-template-columns: 1fr; }
    .sp-stage { margin-inline: auto; }
  }

  /* Ρεαλιστικό laptop: οθόνη 16:10 με λεπτό μπεζέλ και αλουμινένια βάση */
  .sp-stage { width: 520px; max-width: 100%; }
  .sp-laptop { position: relative; }
  .sp-screen {
    position: relative;
    background: #0f0f11; border: 1px solid #3c3c42;
    border-radius: 16px 16px 4px 4px;
    padding: 11px 11px 15px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, .55);
  }
  .sp-camdot {
    position: absolute; top: 5px; left: 50%; transform: translateX(-50%);
    width: 4px; height: 4px; border-radius: 50%;
    background: #2c2c31; box-shadow: inset 0 0 2px #000, 0 0 0 1px rgba(255, 255, 255, .05);
  }
  .sp-base {
    width: 118%; margin-left: -9%;
    height: 14px;
    background: linear-gradient(180deg, #eceef1 0%, #c3c5cb 50%, #9a9ca3 100%);
    border-radius: 2px 2px 14px 14px;
    position: relative;
  }
  .sp-base::before {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 84px; height: 5px;
    background: #a2a4ab; border-radius: 0 0 9px 9px;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, .18);
  }
  .sp-base::after {
    content: ''; position: absolute; top: 0; left: 2%; right: 2%;
    height: 1px; background: rgba(0, 0, 0, .18);
  }

  /* Η σελίδα μέσα στην οθόνη — βιομηχανικό βαθύ μπλε με κεχριμπαρένιες πινελιές */
  .sp-page {
    position: relative;
    display: flex; flex-direction: column;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(95% 70% at 100% 0%, rgba(255, 176, 32, .16), transparent 55%),
      radial-gradient(70% 60% at 0% 105%, rgba(64, 120, 200, .18), transparent 60%),
      repeating-linear-gradient(115deg, rgba(255, 255, 255, .014) 0 2px, transparent 2px 7px),
      linear-gradient(165deg, #131a24 0%, #0b0f16 100%);
    border-radius: 6px; overflow: hidden;
  }
  /* Τεράστιο γρανάζι-υδατογράφημα στη γωνία */
  .sp-page::after {
    content: 'N';
    position: absolute; right: -22px; bottom: -58px;
    font-size: 175px; font-weight: 800; line-height: 1;
    color: rgba(255, 176, 32, .05);
    -webkit-text-stroke: 1px rgba(255, 176, 32, .1);
    transform: rotate(-8deg);
    pointer-events: none; z-index: 0;
  }
  .sp-browser {
    display: flex; align-items: center; gap: 8px;
    background: #1d1c21; padding: 6px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, .05);
  }
  .sp-dots { display: inline-flex; gap: 5px; }
  .sp-dots i { width: 8px; height: 8px; border-radius: 50%; }
  .sp-dots i:nth-child(1) { background: #ff5f57; }
  .sp-dots i:nth-child(2) { background: #febc2e; }
  .sp-dots i:nth-child(3) { background: #28c840; }
  .sp-url {
    flex: 1; text-align: center;
    background: rgba(255, 255, 255, .08); border-radius: 999px; padding: 3px 10px;
    color: #aeb6c2; font-size: .64rem; font-weight: 600;
  }
  .sp-body {
    flex: 1; display: flex; flex-direction: column;
    padding: 12px 16px 14px;
    transition: opacity .5s ease, filter .5s ease;
  }
  .sp-page.is-dim .sp-body { opacity: .3; filter: blur(1.5px); }

  .sp-part { opacity: 1; transform: none; transition: opacity .45s ease, transform .45s ease; }
  .sp-part:not(.is-in) { opacity: 0; transform: translateY(8px); }

  .sp-nav {
    position: relative;
    display: flex; align-items: baseline; justify-content: space-between;
    padding-bottom: 9px;
    border-bottom: 1px solid rgba(255, 255, 255, .07);
  }
  .sp-nav::after {
    content: ''; position: absolute; left: 0; bottom: -1px;
    width: 58px; height: 1px;
    background: linear-gradient(90deg, #FFB020, transparent);
  }
  .sp-nav b { color: #f2f4f7; font-size: .78rem; font-weight: 800; letter-spacing: .05em; }
  .sp-nav b span { color: #FFB020; font-weight: 600; font-size: .62rem; margin-left: 4px; letter-spacing: .08em; }
  .sp-links { display: inline-flex; gap: 11px; }
  .sp-links i {
    color: #8c94a1; font-size: .52rem; font-style: normal; font-weight: 700;
    text-transform: uppercase; letter-spacing: .14em;
  }

  .sp-hero {
    display: grid; grid-template-columns: 1.15fr .85fr; gap: 14px;
    align-items: center; margin-block: auto;
  }
  .sp-h1 { margin: 0; color: #f2f4f7; font-size: 1rem; font-weight: 800; line-height: 1.2; max-width: none; }
  .sp-h1::after {
    content: ''; display: block;
    width: 46px; height: 2.5px; margin-top: 7px;
    background: linear-gradient(90deg, #FFC65C, #E08900);
    border-radius: 999px;
  }
  .sp-hsub { margin: 7px 0 11px; color: #98a1ae; font-size: .64rem; line-height: 1.45; max-width: none; }
  /* Κεχριμπαρένιο κουμπί κλήσης που «αναπνέει» */
  .sp-btn {
    display: inline-flex; align-items: center; gap: 5px;
    background: linear-gradient(92deg, #FFC65C 0%, #FFB020 55%, #E08900 100%);
    color: #241800; border-radius: 9px; padding: 7px 13px;
    font-size: .66rem; font-weight: 800; letter-spacing: .01em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 6px 18px rgba(255, 176, 32, .3);
    transition: transform .16s ease, box-shadow .16s ease;
    animation: sp-glow 2.6s ease-in-out infinite;
  }
  .sp-btn svg {
    width: 12px; height: 12px; flex: none;
    fill: none; stroke: #241800; stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round;
  }
  @keyframes sp-glow {
    50% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 6px 28px rgba(255, 176, 32, .55); }
  }
