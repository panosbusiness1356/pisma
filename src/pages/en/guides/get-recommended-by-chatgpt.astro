---
import Guide from '../../../layouts/Guide.astro';
import Tiles from '../../../components/guide/Tiles.astro';
import { CATEGORIES_EN } from '../../../data/pricing.en';
import { eurEn, ELEGXOS } from '../../../config';

// Αναζήτηση option με βάση id μέσα στον αγγλικό τιμοκατάλογο (ίδια ids/τιμές με pricing.ts)
const optionByIdEn = (id: string) =>
  CATEGORIES_EN.flatMap((c) => c.options).find((o) => o.id === id);

const aiSetup = optionByIdEn('ai-setup')!;
const aiMonthly = optionByIdEn('ai-monthly')!;

const faq = [
  {
    q: 'Can I pay ChatGPT to recommend me?',
    a: 'Not the way you buy ads on Google. The way in is making sure everything that exists publicly about your business is clean, consistent and up to date.',
  },
  {
    q: 'Do I absolutely need a website for AI tools to find me?',
    a: 'It helps a lot, because it is the only source you fully control. Without a website, AI relies solely on what third parties say about you.',
  },
  {
    q: 'How soon will I see a difference?',
    a: `There is no guaranteed timeline, and anyone who promises one is overselling. That is why at PISMA we measure where you stand before you start, in the free ${ELEGXOS.minutes}-minute Check, and measure again at 3 months.`,
  },
  {
    q: 'Is the SEO I have already done wasted?',
    a: 'No. Whatever helps Google helps AI too. It is just that AI gives extra weight to clear answers and to details that match everywhere.',
  },
  {
    q: 'What are GEO and AEO, the terms I keep hearing?',
    a: 'They are the terms for optimizing so you appear in AI answers, the way SEO is for Google. In practice they stand on the same foundation: a clean website, correct details, good reviews.',
  },
];
---

<Guide
  lang="en"
  title="How do you get ChatGPT to recommend you? | PISMA"
  description="AI recommends businesses with a clean website, an up-to-date Google profile, reviews and the same details everywhere. See what you can do starting today."
  slug="get-recommended-by-chatgpt"
  question="How do you get ChatGPT to recommend you?"
  sub="For the business owner who wants to be found by people asking AI, not just Google."
  updated="2026-09-10"
  faq={faq}
>
  <h2>Do customers really ask ChatGPT?</h2>
  <Tiles cols={2} items={[
    { icon: 'message', t: 'Yes, and more every day', d: '"Where to eat near me", "a good plumber in my area".' },
    { icon: 'alert', t: 'There is no page two', d: 'Either you are among the names it suggests, or you do not exist.' },
  ]} />

  <h2>Where does it learn about you?</h2>
  <Tiles items={[
    { icon: 'globe', t: 'Your website', d: 'What you do, where, for whom.' },
    { icon: 'pin', t: 'Your Google profile', d: 'Map, hours, photos.' },
    { icon: 'star', t: 'Your reviews', d: 'What customers write about you.' },
  ]} />

  <h2>How does PISMA help?</h2>
  <p>
    Visibility on Google & AI: setup {eurEn(aiSetup.price)} one-off, management {eurEn(aiMonthly.price)} per month,
    with a monthly report and no commitment. See <a href="/en/get-found/">Get found</a>.
  </p>
</Guide>
