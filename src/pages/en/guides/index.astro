---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { SITE, ELEGXOS } from '../../../config';
import { GUIDES_EN as guides } from '../../../data/guides.en';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guides — PISMA',
  url: `${SITE.url}/en/guides/`,
  inLanguage: 'en',
  description:
    'Practical guides for business owners: Google, AI, reviews, websites — in plain words.',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.q,
      url: `${SITE.url}/en/guides/${g.slug}/`,
    })),
  },
};
---

<Base
  title="Guides for businesses — Google, AI, reviews, sites | PISMA"
  description="Practical guides in plain words: how customers find you on Google and AI, how to get reviews, what a website costs. Written for owners, not for techies."
  schema={schema}
>
  <PageHero
    kicker="Guides"
    sub="Everything business owners ask about Google, AI and their digital presence — answered in plain words. No technical jargon, no sales tricks."
  >
    Answers, not <span class="accent">jargon</span>.
  </PageHero>

  <section class="section--tight" aria-label="List of guides">
    <div class="container">
      <div class="grid-2 guides-grid">
        {guides.map((g) => (
          <a class="card card--link reveal" href={`/en/guides/${g.slug}/`}>
            <h2 class="guide-q">{g.q}</h2>
            <p>{g.blurb}</p>
            <span class="card-arrow">Read the guide →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Rather look at it together?"
    sub={`The PISMA Check: ${ELEGXOS.minutes} minutes to measure where you stand on Google, AI and day-to-day operations.`}
    ctaText="Book your free Check"
    ctaHref="/en/free-assessment/"
    note={`${ELEGXOS.priceEn} · no commitment whatsoever`}
  />
</Base>

<style>
  .guides-grid { align-items: stretch; }
  .guide-q { font-size: 1.25rem; margin-bottom: 8px; }
</style>
