---
import Guide from '../../../layouts/Guide.astro';
import Tiles from '../../../components/guide/Tiles.astro';
import { CATEGORIES_EN } from '../../../data/pricing.en';
import { eurEn as eur, ELEGXOS } from '../../../config';

// Ίδια ids με pricing.ts, labels/details από CATEGORIES_EN
const optionById = (id: string) =>
  CATEGORIES_EN.flatMap((c) => c.options).find((o) => o.id === id);

const gbpSetup = optionById('gbp-setup')!;

const faq = [
  {
    q: 'How much does the Google profile cost?',
    a: `The profile itself is free; you create it yourself at google.com/business. If you want PISMA to set it up, the Setup costs ${eur(gbpSetup.price)} one-off.`,
  },
  {
    q: 'Do I need a website to have a Google profile?',
    a: 'No, the profile stands on its own. Together with a simple website, though, they work much better, as each one builds trust in the other.',
  },
  {
    q: 'What do I do if a profile for my business already exists?',
    a: 'You claim it: find it on Maps, click “Claim this business” and go through Google’s verification. Don’t create a second one, as duplicate profiles cause confusion.',
  },
  {
    q: 'How soon will I show up on Maps?',
    a: 'As soon as Google’s verification is complete. Depending on the method (letter, phone or video) it can take from a few minutes to a few days.',
  },
  {
    q: 'How often should I update the profile?',
    a: 'Every time something changes (hours, phone, services), and ideally with a fresh photo every so often, to keep it looking alive.',
  },
];
---

<Guide
  title="How do you show up properly on Google and Maps? | PISMA"
  description="Your Google profile (Business Profile) is your first impression in Search and Maps. What it is, what a proper profile has, and what the setup costs."
  slug="google-maps-profile"
  lang="en"
  question="How do you show up properly on Google and Maps?"
  sub="For every business that wants to be found easily, with no technical knowledge needed."
  updated="2026-09-10"
  faq={faq}
>
  <h2>What is the Google profile?</h2>
  <Tiles items={[
    { icon: 'eye', t: 'Your first impression', d: 'Customers see it before they open your website.' },
    { icon: 'pin', t: 'Above the websites', d: 'For "near me" searches, Google shows profiles first.' },
    { icon: 'bot', t: 'AI reads it too', d: 'ChatGPT relies on the same details to recommend you.' },
  ]} />

  <h2>What does a proper profile have?</h2>
  <Tiles items={[
    { icon: 'shield', t: 'Verification', d: 'Google knows it is yours.' },
    { icon: 'tag', t: 'The right category', d: 'So you show up in the right searches.' },
    { icon: 'clock', t: 'Real hours', d: 'Updated for holidays.' },
    { icon: 'camera', t: 'Your own photos', d: 'Storefront, interior, products.' },
    { icon: 'list', t: 'Services', d: 'Exactly what you offer, one by one.' },
    { icon: 'star', t: 'Reviews with replies', d: 'To the good ones and the bad ones.' },
  ]} />

  <h2>How does PISMA help?</h2>
  <p>
    Google profile setup: {eur(gbpSetup.price)} one-off, with all of the above. On the <a href="/en/pricing/">pricing page</a>,
    or start with the free <a href="/en/free-assessment/">{ELEGXOS.minutes}-minute Check</a>.
  </p>
</Guide>
