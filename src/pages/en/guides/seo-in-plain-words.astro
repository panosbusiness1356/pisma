---
import Guide from '../../../layouts/Guide.astro';
import Tiles from '../../../components/guide/Tiles.astro';
import { CATEGORIES_EN } from '../../../data/pricing.en';
import { eurEn, ELEGXOS } from '../../../config';

// Αναζήτηση option με βάση id μέσα στον αγγλικό τιμοκατάλογο (ίδια ids/τιμές με pricing.ts)
const optionByIdEn = (id: string) =>
  CATEGORIES_EN.flatMap((c) => c.options).find((o) => o.id === id);

const aiSetup = optionByIdEn('ai-setup')!;
const aiMonthly = optionByIdEn('ai-monthly')!;

const faq = [
  {
    q: 'How long does SEO take to show results?',
    a: "SEO takes time, and we're talking months rather than days. That's why at PISMA we measure where you start and re-measure at 3 months, so you can see the difference in numbers.",
  },
  {
    q: 'Do I absolutely need a website to do SEO?',
    a: 'For local searches, a well-kept Google profile helps even on its own. A website, though, gives you room to answer your customers’ questions, and that’s where most of the game is decided.',
  },
  {
    q: 'Is SEO a one-and-done job?',
    a: 'No. There is an initial setup, but after that it needs care: Google changes, your competitors keep moving, and your customers’ questions evolve.',
  },
  {
    q: 'Is SEO the same as AEO and GEO?',
    a: 'The logic is the same: being found when people need you. AEO/GEO makes sure AI tools like ChatGPT recommend you too, not just Google.',
  },
  {
    q: 'How much does SEO cost at PISMA?',
    a: `The “Visibility on Google & AI” service has an initial setup of ${eurEn(aiSetup.price)} one-off and monthly management of ${eurEn(aiMonthly.price)} per month, with no commitment and no contract.`,
  },
];
---

<Guide
  lang="en"
  title="What is SEO? | PISMA"
  description="SEO means being found on Google by the people who need you, without paying for ads. See what matters for your business and what changes with AI."
  slug="seo-in-plain-words"
  question="What is SEO?"
  sub="For business owners who keep hearing “SEO” and finally want to understand what it is, without the tech talk."
  updated="2026-09-10"
  faq={faq}
>
  <h2>SEO or advertising?</h2>
  <Tiles cols={2} items={[
    { icon: 'euro', t: 'Advertising', d: 'You pay for every impression. Stop paying, and you disappear.' },
    { icon: 'chart', t: 'SEO', d: 'Built once, keeps bringing people in. It stays yours.' },
  ]} />

  <h2>What does Google look at?</h2>
  <Tiles items={[
    { icon: 'text', t: 'Pages that answer', d: 'What the customer is looking for.' },
    { icon: 'phone', t: 'Speed and mobile', d: 'If it is slow, the customer leaves.' },
    { icon: 'star', t: 'Google profile and reviews', d: 'The first thing the customer sees.' },
  ]} />

  <h2>What changes with AI?</h2>
  <Tiles cols={2} items={[
    { icon: 'bot', t: 'One answer, not a list', d: 'ChatGPT suggests a few names. There is no "page two".' },
    { icon: 'link', t: 'The same sources', d: 'What counts for Google counts for AI too.' },
  ]} />

  <h2>How does PISMA help?</h2>
  <p>
    Visibility on Google & AI: setup {eurEn(aiSetup.price)} one-off, management {eurEn(aiMonthly.price)} per month,
    with a monthly report and no commitment. Or start with the free <a href="/en/free-assessment/">{ELEGXOS.minutes}-minute Check</a>.
  </p>
</Guide>
