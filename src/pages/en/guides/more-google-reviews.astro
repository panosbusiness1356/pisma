---
import Guide from '../../../layouts/Guide.astro';
import Tiles from '../../../components/guide/Tiles.astro';
import { CATEGORIES_EN } from '../../../data/pricing.en';
import { eurEn as eur, ELEGXOS } from '../../../config';

// Ίδια ids με pricing.ts, labels/details από CATEGORIES_EN
const optionById = (id: string) =>
  CATEGORIES_EN.flatMap((c) => c.options).find((o) => o.id === id);

const autoReviews = optionById('auto-reviews')!;

const faq = [
  {
    q: 'Am I allowed to offer a discount or gift for a review?',
    a: 'No. Google’s rules forbid any reward in exchange for a review. Ask for it simply and politely, with no incentive.',
  },
  {
    q: 'Can I delete a negative review?',
    a: 'Not yourself. You can only ask Google to remove it, if it violates their rules (e.g. it’s abusive or fake). Otherwise, the best move is a calm, polite reply.',
  },
  {
    q: 'How many reviews do I need?',
    a: 'There’s no magic number. What matters more is that new ones keep coming in steadily: a regular flow counts for more than a big but old total.',
  },
  {
    q: 'Do AI tools like ChatGPT read my reviews?',
    a: 'Yes. When someone asks an AI to recommend a business, your reviews (how many, how recent and what they say) are among the key things it looks at.',
  },
  {
    q: 'Do I need anything technical to get started?',
    a: 'No. An up-to-date Google profile and its review link are enough; the rest is a matter of habit or automation.',
  },
];
---

<Guide
  title="How do you get more Google reviews? | PISMA"
  description="Ask for the review at the right moment, make it easy with a link or QR, and reply to every one. That’s how you rise on Google, Maps and AI tools like ChatGPT."
  slug="more-google-reviews"
  lang="en"
  question="How do you get more Google reviews?"
  sub="A practical guide for every business, with no tricks and nothing technical."
  updated="2026-09-10"
  faq={faq}
>
  <h2>Why do reviews matter?</h2>
  <Tiles items={[
    { icon: 'users', t: 'Count', d: 'How many customers have had their say.' },
    { icon: 'calendar', t: 'Freshness', d: 'Recent reviews mean "a business that is alive".' },
    { icon: 'message', t: 'Content', d: 'What they write. Google and AI read it.' },
  ]} />

  <h2>What you never do</h2>
  <Tiles cols={2} items={[
    { t: 'Buying reviews', d: 'Forbidden by Google.', tone: 'bad' },
    { t: 'Relatives and staff', d: 'Writing as if they were customers.', tone: 'bad' },
    { t: 'Gifts or discounts', d: 'Any reward for a review is forbidden.', tone: 'bad' },
    { t: 'Unanswered reviews', d: 'Everyone sees whether you reply.', tone: 'bad' },
  ]} />

  <h2>How does PISMA help?</h2>
  <p>
    <a href="/en/reviews/">The Reviews Tool</a>: a QR on the table or at the register, and reviews pile up on their own,
    within Google's rules. We only show it live. {eur(autoReviews.price)} per month with no commitment,
    plus the <a href="/en/qr-stickers/">QR stickers</a>.
  </p>
</Guide>
