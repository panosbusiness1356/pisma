---
import Guide from '../../../layouts/Guide.astro';
import Tiles from '../../../components/guide/Tiles.astro';
import { CATEGORIES_EN } from '../../../data/pricing.en';
import { eurEn as eur, ELEGXOS } from '../../../config';

// Ίδια ids με pricing.ts, labels/details από CATEGORIES_EN
const optionById = (id: string) =>
  CATEGORIES_EN.flatMap((c) => c.options).find((o) => o.id === id);

const basic = optionById('web-basic')!;
const standard = optionById('web-standard')!;
const pro = optionById('web-pro')!;
const enterprise = optionById('web-enterprise')!;
const bookings = optionById('web-bookings')!;
const care = optionById('care-web')!;
const gbp = optionById('gbp-setup')!;

const faq = [
  {
    q: 'How much does a simple website cost?',
    a: `At PISMA, a Basic site (home, services, contact) costs ${eur(basic.price)} one-off. Larger sites with more pages and features go up to ${eur(pro.price)}.`,
  },
  {
    q: 'Is there a monthly cost after the build?',
    a: `Only if you want it: ${care.label} costs ${eur(care.price)} per month, with no contract or commitment, and it includes hosting. The domain is in your name: we register it together at the start, with your details, and it renews every year with the provider.`,
  },
  {
    q: 'Who should the domain belong to?',
    a: 'You, always. If the domain is registered in the builder’s name, you don’t control your own website, and leaving is hard if something goes wrong.',
  },
  {
    q: 'Are there ready-made packages?',
    a: `No. You build your own: on the pricing page you pick only the services you need and pay their total. A common first step: a Basic site (${eur(basic.price)}) together with a Google profile setup (${eur(gbp.price)}).`,
  },
  {
    q: 'Do I need a website if I already have a Facebook page?',
    a: 'A Facebook page helps, but it isn’t yours: the rules change whenever the platform decides. Your website is the only space you fully control, and it’s what Google and AI tools read best.',
  },
];
---

<Guide
  title="How much does a business website cost? | PISMA"
  description={`What drives the price of a website, what a proper build must include, and PISMA’s prices, from ${eur(basic.price)} to ${eur(pro.price)} one-off.`}
  slug="website-cost"
  lang="en"
  question="How much does a business website cost?"
  sub="For business owners who want a straight answer on pricing, without technical confusion."
  updated="2026-09-10"
  faq={faq}
>
  <h2>What determines the price?</h2>
  <Tiles items={[
    { icon: 'list', t: 'Size', d: 'How many pages.' },
    { icon: 'bolt', t: 'Features', d: 'Contact form, bookings, menu, a second language.' },
    { icon: 'text', t: 'Copy and photos', d: 'Ready from you, or from us.' },
  ]} />

  <h2>PISMA's prices</h2>
  <table>
    <thead>
      <tr><th>Option</th><th>What it is</th><th>Price</th></tr>
    </thead>
    <tbody>
      <tr><td><strong>{basic.label}</strong></td><td>{basic.detail}</td><td>{eur(basic.price)} one-off</td></tr>
      <tr><td><strong>{standard.label}</strong></td><td>{standard.detail}</td><td>{eur(standard.price)} one-off</td></tr>
      <tr><td><strong>{pro.label}</strong></td><td>{pro.detail}</td><td>{eur(pro.price)} one-off</td></tr>
      <tr><td><strong>{enterprise.label}</strong></td><td>{enterprise.detail}</td><td>Price on request</td></tr>
      <tr><td><strong>{bookings.label}</strong></td><td>{bookings.detail}</td><td>{eur(bookings.price)} one-off</td></tr>
      <tr><td><strong>{care.label}</strong></td><td>{care.detail}</td><td>{eur(care.price)} per month</td></tr>
    </tbody>
  </table>

  <h2>What is yours</h2>
  <Tiles items={[
    { icon: 'globe', t: 'The domain', d: 'In your name.', tone: 'ok' },
    { icon: 'shield', t: 'The passwords', d: 'Domain, hosting, site admin.', tone: 'ok' },
    { icon: 'link', t: 'The website', d: 'Take it wherever you want, whenever you want.', tone: 'ok' },
  ]} />

  <h2>How does PISMA help?</h2>
  <p>
    Build your own combination on the <a href="/en/pricing/">pricing page</a>, or start with the free
    <a href="/en/free-assessment/">{ELEGXOS.minutes}-minute Check</a>.
  </p>
</Guide>
