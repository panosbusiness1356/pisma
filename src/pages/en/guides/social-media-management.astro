---
import Guide from '../../../layouts/Guide.astro';
import Tiles from '../../../components/guide/Tiles.astro';
import { CATEGORIES_EN } from '../../../data/pricing.en';
import { eurEn, ELEGXOS } from '../../../config';

// Αναζήτηση option με βάση id μέσα στον αγγλικό τιμοκατάλογο (ίδια ids/τιμές με pricing.ts)
const optionByIdEn = (id: string) =>
  CATEGORIES_EN.flatMap((c) => c.options).find((o) => o.id === id);

const setup = optionByIdEn('soc-setup')!;
const p1pisma = optionByIdEn('soc-1p-pisma')!;
const p23pisma = optionByIdEn('soc-23p-pisma')!;
const p1own = optionByIdEn('soc-1p-own')!;
const p23own = optionByIdEn('soc-23p-own')!;

const faq = [
  {
    q: 'Do I need social media if I already have a website?',
    a: "Your website is your foundation and social is your day-to-day presence; one doesn't replace the other. Google and AI tools read both to understand your business.",
  },
  {
    q: 'Who takes the photos and videos?',
    a: 'Whatever suits you: either you provide the material and we prepare it for publishing, or PISMA takes care of all the content. The price differs accordingly.',
  },
  {
    q: 'On which platforms?',
    a: 'On the ones that make sense for your business, usually Instagram and Facebook, plus wherever else your customers are. You choose 1 or 2–3 platforms.',
  },
  {
    q: 'Am I locked into a contract?',
    a: 'No. The monthly management stops whenever you decide. There is also a standalone clean-up and setup, one-off, with no subscription at all.',
  },
];
---

<Guide
  lang="en"
  title="What is social media management? | PISMA"
  description="Social media management means your Instagram and Facebook pages stay alive with regular posts, without any effort on your part. See the options."
  slug="social-media-management"
  question="What is social media management?"
  sub="What it includes, which options exist and what it costs."
  updated="2026-09-10"
  faq={faq}
>
  <h2>What does it include?</h2>
  <Tiles cols={2} items={[
    { icon: 'image', t: 'Preparing the posts', d: 'Copy, images, formatting.' },
    { icon: 'calendar', t: 'Publishing regularly', d: 'Your pages stay alive every week.' },
  ]} />

  <h2>PISMA's options</h2>
  <table>
    <thead>
      <tr><th>Option</th><th>What it includes</th><th>Price</th></tr>
    </thead>
    <tbody>
      <tr><td><strong>{setup.label}</strong></td><td>{setup.detail}</td><td>{eurEn(setup.price)} one-off</td></tr>
      <tr><td><strong>{p1pisma.label}</strong></td><td>{p1pisma.detail}</td><td>{eurEn(p1pisma.price)} per month</td></tr>
      <tr><td><strong>{p23pisma.label}</strong></td><td>{p23pisma.detail}</td><td>{eurEn(p23pisma.price)} per month</td></tr>
      <tr><td><strong>{p1own.label}</strong></td><td>{p1own.detail}</td><td>{eurEn(p1own.price)} per month</td></tr>
      <tr><td><strong>{p23own.label}</strong></td><td>{p23own.detail}</td><td>{eurEn(p23own.price)} per month</td></tr>
    </tbody>
  </table>

  <h2>How does PISMA help?</h2>
  <p>
    All prices on the <a href="/en/pricing/">pricing page</a>, no contract. Or start with the free
    <a href="/en/free-assessment/">{ELEGXOS.minutes}-minute Check</a>.
  </p>
</Guide>
