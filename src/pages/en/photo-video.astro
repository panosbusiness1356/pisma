---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gear from '../../components/Gear.astro';
import GearSky from '../../components/GearSky.astro';
import { SITE, eurEn } from '../../config';
import { CATEGORIES_EN } from '../../data/pricing.en';

// One source of truth for prices: pricing.ts (labels translated in pricing.en.ts).
const optEn = (id: string) => CATEGORIES_EN.flatMap((c) => c.options).find((o) => o.id === id)!;
const space = optEn('media-space');
const products = optEn('media-products');
const video = optEn('media-video');
const minPrice = Math.min(space.price, products.price, video.price);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Photography & Video for businesses',
  serviceType: 'Product, space and team photography, Video shooting for websites and social media',
  areaServed: SITE.regionEn,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: [space, products, video].map((o) => ({
    '@type': 'Offer',
    name: o.label,
    price: o.price,
    priceCurrency: 'EUR',
    description: `${eurEn(o.price)} one-off.`,
  })),
  description:
    'Photos and short videos shot at your business premises (products, dishes, space, team), ready for your website, online store, Google and social media.',
};

const why = [
  {
    t: 'Customers see you',
    s: 'Your own shop window, not stock from the internet.',
    d: 'A photo from the internet is one the customer has seen on ten other sites. Your shop window, your dish, your face: that builds trust before they even call.',
    icon: 'eye',
  },
  {
    t: 'One shoot, material for months',
    s: 'One visit covers website, Google and social.',
    d: 'In one visit we get everything the website, the Google profile and social media need. Dozens of photos and short videos, organised and ready to upload.',
    icon: 'stack',
  },
  {
    t: 'Ready for every channel',
    s: 'Vertical, horizontal, square: always the right size.',
    d: 'Vertical for reels and stories, horizontal for the website, square for Google. We deliver in the right sizes, so you never crop anything yourself.',
    icon: 'frames',
  },
];

const shoot = [
  { t: 'Space & shop window', s: 'As the customer sees it', d: 'The shop as a first-time customer sees it walking in: bright, clean, welcoming.' },
  { t: 'Products', s: 'For store and catalogue', d: 'For your store, catalogue and social: on a neutral background or inside your space, with the details that sell.' },
  { t: 'Dishes & drinks', s: 'For menu and Instagram', d: 'For the menu, Google and Instagram: the dish as it comes out of the kitchen, in its natural light.' },
  { t: 'You & the team', s: 'Portraits, no posing', d: 'People want to know who they are trusting. Portraits and working moments, no posing.' },
  { t: 'Short videos', s: 'Reels and stories', d: 'Reels and stories: the process, the before/after, a "hello" from you. Whatever catches attention.' },
  { t: 'Before / After', s: 'The most convincing shot', d: 'For any job that changes something (hair salon, garage, renovation). The most convincing photo there is.' },
];

const steps = [
  {
    t: 'We agree what you need',
    s: 'Website, store, Google or social.',
    d: 'Website, store, Google, social, or all of them. The shot list comes from that.',
  },
  {
    t: 'Appointment at your premises',
    s: 'Quiet hours, no closing.',
    d: 'During your quiet hours, without closing. We bring whatever equipment is needed.',
  },
  {
    t: 'Editing',
    s: 'Colour, light, editing, right sizes.',
    d: 'Colour, light, cropping to the right size for every channel. Editing for the videos.',
  },
  {
    t: 'Delivery and upload',
    s: 'Organised in a folder, or straight online.',
    d: 'You get everything organised in a folder. If we run your website or social media, it goes up as well.',
  },
];

const faqItems = [
  {
    q: 'Do I have to close the shop for the shoot?',
    a: 'No. We come during your quieter hours and work around you. For dishes and products we just need a spot with good light.',
  },
  {
    q: 'Who owns the photos and videos?',
    a: 'You do, entirely. Use them wherever you like (website, social, print, ads), with no conditions and no expiry.',
  },
  {
    q: 'Do I need to prepare anything?',
    a: 'A little: a tidy space, the products or dishes you want shown, and whoever on the team wants to be in it. We send a short checklist before the appointment.',
  },
  {
    q: 'Do you edit the videos too?',
    a: 'Yes. We deliver finished videos: cut, with music where it fits, in each channel’s dimensions. You never open an editing program.',
  },
  {
    q: 'I already have monthly social media management with you. Do I need anything extra?',
    a: 'If your management is "content by PISMA", the photos and videos for the posts come from us and are already included. A separate shoot is for bigger needs, e.g. every product of an online store, or a new website.',
  },
  {
    q: 'How much does it cost?',
    a: `Three clear options, one-off: ${space.label.toLowerCase()} ${eurEn(space.price)}, ${products.label.toLowerCase()} ${eurEn(products.price)}, ${video.label.toLowerCase()} ${eurEn(video.price)}. Combine them as you like on the pricing page, and you know the amount before we book the appointment.`,
  },
];
---

<Base
  title="Photography & Video for your business | PISMA"
  description={`Photos and short videos shot at your premises for your website, store, Google and social media: products, dishes, space, team. From ${eurEn(minPrice)} one-off, with no stock images.`}
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Photography & Video"
    sub="Photos and short videos shot at your premises for the website, the online store, the Google profile and social media, with no images from the internet."
  >
    Your business, <span class="accent">as it really is</span>
    <p class="hero-sub-m" slot="extra">Photos and video at your premises, for website, Google and social.</p>
  </PageHero>
  <GearSky />

  <!-- 2. What you gain -->
  <section class="section section--tight" aria-labelledby="why-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">What you gain</p>
        <h2 id="why-title"><span class="full">Three reasons your own material sells more.</span><span class="short">What you gain</span></h2>
      </div>
      <div class="grid-3">
        {why.map((w) => (
          <article class="card reveal why-card">
            <span class="icon-chip">
              {w.icon === 'eye' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" />
                </svg>
              )}
              {w.icon === 'stack' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="6" y="6" width="14" height="14" rx="2" /><path d="M3 15V5a2 2 0 0 1 2-2h10" /><path d="m9 16 3-3.5 2 2 3-4" />
                </svg>
              )}
              {w.icon === 'frames' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="8" height="16" rx="1.5" /><rect x="14" y="4" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="6" rx="1.5" />
                </svg>
              )}
            </span>
            <h3>{w.t}</h3>
            <p class="full">{w.d}</p>
            <p class="short">{w.s}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. What we shoot -->
  <section class="section" aria-labelledby="shoot-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--blue">What we shoot</p>
        <h2 id="shoot-title"><span class="full">Everything a customer needs to see before they come.</span><span class="short">What we shoot</span></h2>
      </div>
      <div class="grid-3 shoot-grid">
        {shoot.map((s, i) => (
          <article class="card shot reveal">
            <span class="shot-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p class="full">{s.d}</p>
            <p class="short">{s.s}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="section section--tight" aria-labelledby="flow-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">How it works</p>
        <h2 id="flow-title"><span class="full">Four steps, one appointment.</span><span class="short">How it works</span></h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-num num" aria-hidden="true">{i + 1}</span>
            <h3>{s.t}</h3>
            <p class="full">{s.d}</p>
            <p class="short">{s.s}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4b. Our gear -->
  <Gear lang="en" />

  <!-- 5. Price -->
  <section class="section" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker"><span class="full">Prices: public, the same for everyone</span><span class="short">Prices</span></p>
          <h2 id="price-title">
            From <span class="price-num num">{eurEn(minPrice)}</span> one-off
          </h2>
          <p class="price-sub">
            Three clear options, combine them as you like:
            <strong>{space.label} {eurEn(space.price)}</strong> ({space.detail}),
            <strong>{products.label} {eurEn(products.price)}</strong> ({products.detail}),
            <strong>{video.label} {eurEn(video.price)}</strong> ({video.detail}).
            With monthly social media management "content by PISMA", the material for the posts is already included.
          </p>
          <ul class="price-list">
            <li><span>{space.label}</span><strong>{eurEn(space.price)}</strong></li>
            <li><span>{products.label}</span><strong>{eurEn(products.price)}</strong></li>
            <li><span>{video.label}</span><strong>{eurEn(video.price)}</strong></li>
          </ul>
          <details class="price-more">
            <summary>What is included</summary>
            <ul>
              <li><strong>{space.label}:</strong> {space.detail}</li>
              <li><strong>{products.label}:</strong> {products.detail}</li>
              <li><strong>{video.label}:</strong> {video.detail}</li>
            </ul>
            <p>With monthly social media management "content by PISMA", the material for the posts is already included.</p>
          </details>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/en/pricing/">Build your package →</a>
          <a class="btn btn--ghost" href="/en/contact/">Tell us what you need</a>
          <span class="btn-note">No online payment. We close it over the phone.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">FAQ</p>
        <h2 id="faq-title"><span class="full">Before you ask, others did.</span><span class="short">FAQ</span></h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 7. CTA -->
  <CtaBand
    title="Time people saw you as you really are."
    sub="Tell us what you need (website, store, Google or social) and we book an appointment at your premises."
    ctaText="Tell us what you need"
    ctaHref="/en/contact/"
    note="Same-day reply · no lock-in"
  />
</Base>

<style>
  /* ---- What we shoot ---- */
  .shot { position: relative; padding-top: 26px; }
  .shot-num {
    position: absolute; top: 18px; right: 20px;
    font-size: .82rem; font-weight: 700; color: var(--orange-text);
    background: var(--orange-soft); padding: 3px 9px; border-radius: 999px;
  }
  .shot h3 { padding-right: 56px; }
  .shot p { color: var(--muted); font-size: .95rem; }

  /* ---- Price (same pattern as the other service pages) ---- */
  .price-card {
    display: grid;
    grid-template-columns: 1.2fr minmax(min(240px, 100%), .8fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(26px, 4vw, 48px);
  }
  @media (max-width: 720px) {
    .price-card { grid-template-columns: 1fr; }
  }
  .price-main .kicker { margin-bottom: 14px; }
  .price-num { font-size: clamp(2rem, 5vw, 2.8rem); color: var(--orange-text); }
  .price-sub { margin-top: 12px; color: var(--muted); }
  .price-sub strong { color: var(--ink); }
  .price-cta { display: flex; flex-direction: column; gap: 12px; }
  .price-cta .btn { text-align: center; }
  .price-cta .btn-note { text-align: center; }

  /* ---- Κινητό (≤ 640px): πολύ απλό, σχεδόν μόνο τίτλοι. Το πλήρες κείμενο μένει στο desktop ---- */
  .short, .price-list, .price-more, .hero-sub-m { display: none; }
  @media (min-width: 641px) {
    :global(.hero .hero-extra) { display: none; }
  }
  @media (max-width: 640px) {
    .full { display: none; }
    .short { display: inline; }
    /* Hero: μία γραμμή */
    :global(.hero .sub) { display: none; }
    :global(.hero .hero-extra) { margin-top: 12px; }
    .hero-sub-m { display: block; margin: 0 auto; max-width: 30ch; color: var(--muted); font-size: 1rem; line-height: 1.45; }
    /* Επικεφαλίδες: μόνο ο σύντομος τίτλος, χωρίς ετικέτα */
    .sec-head .kicker { display: none; }
    .sec-head { margin-bottom: 14px; }
    .sec-head h2 { font-size: 1.45rem; }
    /* Όπου η κάμερα στέκεται αριστερά (Nikon στο «Τι κερδίζετε», Canon στις FAQ), ο τίτλος πάει δεξιά */
    [aria-labelledby="why-title"] .sec-head, [aria-labelledby="faq-title"] .sec-head { text-align: right; margin-left: auto; }
    .grid-3 { gap: 8px; }
    /* Τι κερδίζετε: εικονίδιο + τίτλος */
    .why-card { display: flex; align-items: center; gap: 12px; padding: 11px 14px; }
    .why-card .icon-chip { width: 38px; height: 38px; margin: 0; flex: none; }
    .why-card h3 { margin: 0; font-size: .98rem; }
    .why-card .short { display: none; }
    /* Τι τραβάμε: αριθμός + τίτλος, δύο στήλες */
    .shoot-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .shot { padding: 11px 12px; display: flex; align-items: center; gap: 9px; }
    .shot-num { position: static; font-size: .68rem; padding: 2px 7px; flex: none; }
    .shot h3 { font-size: .93rem; padding: 0; margin: 0; line-height: 1.25; }
    .shot .short { display: none; }
    /* Βήματα: αριθμός + τίτλος */
    .step .short { display: none; }
    .step h3 { margin: 0; }
    :global(.steps) { gap: 10px; }
    /* Τιμές: τρεις γραμμές, λεπτομέρειες με ένα άγγιγμα */
    .price-sub { display: none; }
    .price-main .kicker { margin-bottom: 10px; }
    .price-list { display: grid; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
    .price-list li {
      display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
      padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: rgba(255, 255, 255, .03);
    }
    .price-list strong { color: var(--orange-text); white-space: nowrap; }
    .price-more { display: block; margin-top: 10px; color: var(--muted); font-size: .92rem; }
    .price-more summary { cursor: pointer; color: var(--ink); font-weight: 600; padding: 6px 0; list-style: none; }
    .price-more summary::before { content: '+ '; color: var(--orange-text); }
    .price-more[open] summary::before { content: '\2013  '; }
    .price-more ul { margin: 6px 0 0; padding-left: 18px; }
    .price-more li { margin: 4px 0; }
    .price-more li strong { color: var(--ink); }
    .price-more p { margin: 10px 0 0; }
    /* CTA: τίτλος και κουμπί */
    :global(.band-text p) { display: none; }
  }
</style>
