---
import Base from '../../layouts/Base.astro';
import Intro from '../../components/Intro.astro';
import { SITE, ELEGXOS, PROMISE, eurEn } from '../../config';
import { sumOf } from '../../data/pricing';
import { CATEGORIES_EN } from '../../data/pricing.en';

// Πλήρης «ταυτότητα» της PISMA για Google & AI — αναπληρώνει το (προσωρινά
// ανύπαρκτο) Google Business Profile. Ο τιμοκατάλογος βγαίνει από το pricing.en.ts.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  slogan: SITE.taglineEn,
  email: SITE.email,
  telephone: SITE.phone,
  url: SITE.url,
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Attica',
    addressCountry: 'GR',
  },
  areaServed: [
    'Southern suburbs of Athens',
    'Glyfada',
    'Voula',
    'Vari-Vouliagmeni',
    'Alimos',
    'Elliniko-Argyroupoli',
    'Palaio Faliro',
    'Nea Smyrni',
    'Greece (online)',
  ],
  knowsAbout: [
    'Website development',
    'Shopify store development',
    'Shopify management',
    'SEO',
    'Visibility in AI tools (GEO/AEO)',
    'Google Business Profile',
    'Google reviews',
    'Photography and video for businesses',
    'Digital menu with QR',
    'Office automation',
  ],
  description:
    'Digital presence and process automation for businesses. Website and Shopify store, visibility on Google and AI, reviews, photography and video, automations — measured before and after, with no lock-in.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'PISMA services & prices',
    itemListElement: CATEGORIES_EN.map((c) => ({
      '@type': 'OfferCatalog',
      name: c.title,
      itemListElement: c.options.map((o) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: o.label,
          ...(o.detail ? { description: o.detail } : {}),
        },
        price: o.price,
        priceCurrency: 'EUR',
        description: o.type === 'monthly' ? `${eurEn(o.price)} per month` : `${eurEn(o.price)} one-off`,
      })),
    })),
  },
};

const steps = [
  { t: 'Assessment', d: `${ELEGXOS.minutes} minutes, completely free. We map where you're losing customers and hours.` },
  { t: 'Proposal', d: `In writing, within ${ELEGXOS.reportHours} hours, at a fixed price.` },
  { t: 'Build', d: 'In 2–4 weeks, on the tools you already use.' },
  { t: 'Support', d: 'A monthly results report, in hours and euros.' },
];


/* Μίνι-preview του builder (section Τιμολόγηση) — πραγματικές υπηρεσίες και
   τιμές από το pricing.ts (labels από pricing.en.ts), ώστε το demo να μη δείχνει
   ποτέ ξεπερασμένα ποσά. Τα labels των generic βαθμίδων («Standard», «Setup»)
   παίρνουν το όνομα της κατηγορίας τους για να στέκουν μόνα τους. */
const optionByIdEn = (id: string) => {
  for (const c of CATEGORIES_EN) {
    const o = c.options.find((x) => x.id === id);
    if (o) return o;
  }
  return undefined;
};
const bdDefs: { id: string; label?: string }[] = [
  { id: 'web-standard', label: 'Standard Website' },
  { id: 'gbp-setup', label: 'Google Profile — Setup' },
  { id: 'auto-reviews' },
  { id: 'care-web' },
];
const bdItems = bdDefs.map(({ id, label }) => {
  const o = optionByIdEn(id)!;
  return { label: label ?? o.label, price: o.price, type: o.type };
});
const bdTotals = sumOf(bdDefs.map((d) => d.id));

/* Hero: τιμή-άγκυρα από τον τιμοκατάλογο + WhatsApp με προσυμπληρωμένο μήνυμα. */
const sitePriceFrom = optionByIdEn('web-basic')!.price;
const waHref = `${SITE.whatsapp}?text=${encodeURIComponent("Hello! I'd like the free PISMA Check for my business.")}`;
---

<Base
  title="PISMA — Digital presence & automation for businesses"
  description="PISMA builds your presence across your website, Shopify store, Google and AI tools, and automates your office routine. Fixed prices, measurable results."
  schema={schema}
>
  <!-- 1. Hero -->
  <section
    class="hero"
    aria-labelledby="hero-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-anchor="#hero-title"
    data-mascot-say="Welcome to PISMA. Keep scrolling — I'll show you the essentials."
  >
    <!-- «Σκηνή» (αίτημα χρήστριας 06/09/2026): καπνός WebGL που κινείται αργά (smoke.ts) πάνω από CSS ομίχλη,
         «PISMA.» μεγάλο στη ροή. Τα χρωματιστά αιωρούμενα λογότυπα αφαιρέθηκαν (δεν ταιριάζουν στο ασπρόμαυρο). -->
    <Intro />
    <div class="stg" aria-hidden="true">
      <span class="stg-fog stg-fog--1"></span><span class="stg-fog stg-fog--2"></span><span class="stg-fog stg-fog--3"></span>
      <canvas class="stg-smoke" data-strength=".65" data-scale="1.4" data-warp="2.2" data-lo=".4" data-hi=".98" data-bottom=".6" data-rise=".06" data-speed=".55" data-glow=".9" data-glowy=".5" data-glowr="2"></canvas>
      <span class="stg-floor"></span>
    </div>


    <div class="container hero-inner">
      <p class="hero-kicker blur-in" style="--d:.16s">Digital presence & automation</p>

      <h1 id="hero-title" class="blur-in" style="--d:.22s">
        Your business, <span class="hero-hl">visible to customers<svg class="hl-stroke" viewBox="0 0 320 30" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="hlGrad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="var(--cta-lite)" /><stop offset="1" stop-color="var(--cta-deep)" /></linearGradient></defs><path d="M6 15 C 60 9, 130 21, 200 14 C 245 10, 285 12, 314 13 C 260 18, 200 22, 120 21 C 90 20.5, 72 19, 58 18" fill="none" stroke="url(#hlGrad)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" opacity=".95" /></svg></span>.
      </h1>
      <script is:inline>
        // Κρύβει την υπογράμμιση πριν το πρώτο paint — θα τη «ζωγραφίσει» ο Ντοτ.
        (function () {
          var p = document.querySelector('.hl-stroke path');
          if (p && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var L = p.getTotalLength();
            p.style.strokeDasharray = String(L);
            p.style.strokeDashoffset = String(L);
          }
        })();
      </script>
      <!-- Το «PISMA.» ως δικό του στοιχείο στη ροή: τίτλος πάνω, κουμπιά/αριθμοί κάτω (αίτημα χρήστριας). -->
      <div class="hero-word" aria-hidden="true" data-text="PISMA."><span>P</span><span>I</span><span>S</span><span>M</span><span>A</span><span>.</span></div>

      <div class="hero-ctas blur-in" style="--d:.46s">
        <span class="btn-frame">
          <a class="btn btn--orange" href="/en/business-check/">Measure your business — 2 min</a>
        </span>
        <a class="btn btn--ghost" href="/en/free-assessment/">Free {ELEGXOS.minutes}-minute PISMA Check</a>
      </div>
      <p class="btn-note blur-in" style="--d:.54s">No email · no commitment · your score appears instantly</p>

      <!-- Άμεσα κανάλια: split-button WhatsApp | Viber (επιλογή 6 της χρήστριας) -->
      <div class="hero-chat blur-in" style="--d:.58s">
        <div class="split">
          <a class="split-half split--wa" href={waHref} target="_blank" rel="noopener"><img src="/logos/whatsapp-icon.svg" alt="" width="20" height="20" />WhatsApp</a>
          <a class="split-half split--vb" href={SITE.viber}><img src="/logos/viber.svg" alt="" width="20" height="20" />Viber</a>
        </div>
        <span class="split-note">same-day reply</span>
      </div>

      <!-- Αριθμοί-δεσμεύσεις: τιμή-άγκυρα από το pricing.ts, χρόνοι από το config. -->
      <ul class="hero-stats blur-in" style="--d:.64s">
        <li><strong>from {eurEn(sitePriceFrom)}</strong><span>website</span></li>
        <li><strong>{PROMISE.previewHours} hours</strong><span>first preview</span></li>
        <li><strong>{ELEGXOS.reportHours} hours</strong><span>written proposal</span></li>
        <li><strong>100%</strong><span>public pricing</span></li>
      </ul>
      <p class="sub blur-in" style="--d:.34s">
        At PISMA we design and build your business's presence across your website,
        Google and AI, and we automate your everyday processes.
        <span class="sub-more">With a fixed, agreed cost and measurable results.</span>
      </p>
    </div>
  </section>

  <!-- 1β. Πριν → Μετά — δική του ενότητα, ΕΞΩ από τη σκηνή του hero (αίτημα χρήστριας 06/09/2026) -->
  <section class="section section--tight ba-section">
    <div class="container">
    <div class="hero-ba">
      <div class="ba-head">
        <p class="kicker">Before → After</p>
        <h2>What changes when we work together</h2>
      </div>
      <div class="ba-grid">
        <div class="card ba-before">
          <p class="ba-label">Before</p>
          <ul class="ba-list">
            <li>Reviews <strong>trickling in</strong></li>
            <li><strong>Hard to find</strong> on Google</li>
            <li>The daily routine <strong>done by hand</strong></li>
            <li><strong>Invisible</strong> to AI</li>
          </ul>
        </div>
        <div class="card card--navy ba-after">
          <span class="ba-shine" aria-hidden="true"></span>
          <p class="ba-label ba-label--after">With PISMA</p>
          <ul class="ba-list ba-list--after">
            <li><strong>A steady flow</strong> of reviews</li>
            <li>A ranking <strong>that climbs</strong> on Google & Maps</li>
            <li>The routine <strong>runs on its own</strong></li>
            <li>AI <strong>finds you</strong></li>
          </ul>
        </div>
      </div>
      <p class="ba-note">We measure your own numbers before we start — and again at 3 months.</p>
    </div>
    </div>
  </section>

  <!-- 2. Υπηρεσίες -->
  <section
    class="section"
    aria-labelledby="svc-title"
    data-mascot-stop
    data-mascot-side="left"
    data-mascot-say="Two services: visibility that brings customers, and processes that run automatically."
  >
    <span class="flogo sflogo" aria-hidden="true" style="right:4%;top:60px;--w:26px;--dur:6.2s"><img src="/logos/google-gmail.svg" alt="" loading="lazy" /></span>
    <span class="flogo sflogo" aria-hidden="true" style="left:4%;bottom:8px;--w:28px;--dur:5.6s"><img src="/logos/whatsapp-icon.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Services</p>
        <h2 id="svc-title">What we take on</h2>
        <span class="fx-uline" aria-hidden="true"></span>
      </div>
      <div class="grid-2">
        <article class="card svc reveal">
          <!-- Οπτικό σε στυλ Ε6 (όπως οι σελίδες υπηρεσιών): αντικείμενο site + λογότυπα -->
          <span class="svc-viz" aria-hidden="true">
            <span class="svc-art">
              <svg viewBox="0 0 96 72">
                <rect x="8" y="8" width="80" height="56" rx="7" fill="#F4F4F4"/>
                <path d="M8 15a7 7 0 0 1 7-7h66a7 7 0 0 1 7 7v7H8z" style="fill:var(--orange)"/>
                <circle cx="17" cy="15" r="2.2" fill="#fff" opacity=".85"/><circle cx="24" cy="15" r="2.2" fill="#fff" opacity=".6"/><circle cx="31" cy="15" r="2.2" fill="#fff" opacity=".35"/>
                <rect x="16" y="30" width="32" height="5" rx="2.5" fill="#2B2B2B"/>
                <rect x="16" y="39" width="24" height="4" rx="2" fill="#BDBDBD"/>
                <rect x="16" y="49" width="27" height="10" rx="5" style="fill:var(--orange-cta)"/>
                <rect x="21" y="53" width="17" height="2.4" rx="1.2" fill="#fff" opacity=".9"/>
                <path d="M54 56l9-9 7 5 11-13" stroke="#2FA36B" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="81" cy="39" r="3.4" fill="#2FA36B"/>
              </svg>
            </span>
            <span class="svc-chip"><img src="/logos/google-icon.svg" alt="" width="30" height="30" loading="lazy" /></span>
            <span class="svc-chip"><img src="/logos/openai-icon.svg" alt="" width="30" height="30" loading="lazy" /></span>
            <span class="svc-chip"><img src="/logos/instagram-icon.svg" alt="" width="30" height="30" loading="lazy" /></span>
            <span class="svc-chip"><img src="/logos/shopify.svg" alt="" width="30" height="30" loading="lazy" /></span>
          </span>
          <h3>Digital Visibility</h3>
          <ul class="svc-list">
            <li>A website designed to turn visitors into customers</li>
            <li>A Shopify store — built for you, or managed month by month</li>
            <li>Rankings on Google Search and Google Maps in your area</li>
            <li>Recommendations from AI tools like ChatGPT</li>
            <li>Social media that stay alive — with photos and video shot at your premises</li>
          </ul>
          <a class="card-arrow" href="/en/get-found/">Learn more →</a>
        </article>
        <article class="card svc svc--blue reveal">
          <!-- Οπτικό σε στυλ Ε6: αντικείμενο «η ημέρα σε ένα μήνυμα» + λογότυπα εργαλείων -->
          <span class="svc-viz" aria-hidden="true">
            <span class="svc-art">
              <svg viewBox="0 0 96 72">
                <rect x="28" y="4" width="38" height="64" rx="9" fill="#2B2B2B"/>
                <rect x="32" y="10" width="30" height="52" rx="5" fill="#F4F4F4"/>
                <rect x="42" y="6.5" width="10" height="2.6" rx="1.3" fill="#161616"/>
                <rect x="22" y="22" width="52" height="26" rx="7" fill="#fff"/>
                <circle cx="31" cy="31" r="4" style="fill:var(--orange)"/>
                <rect x="39" y="27" width="22" height="3.6" rx="1.8" fill="#2B2B2B"/>
                <rect x="39" y="33" width="16" height="3" rx="1.5" fill="#BDBDBD"/>
                <rect x="39" y="40" width="4" height="5" rx="1" fill="#2FA36B"/>
                <rect x="45" y="38" width="4" height="7" rx="1" fill="#2FA36B"/>
                <rect x="51" y="35" width="4" height="10" rx="1" style="fill:var(--orange)"/>
                <rect x="57" y="39" width="4" height="6" rx="1" fill="#BDBDBD"/>
                <circle cx="68" cy="24" r="6.5" fill="#EE4F27"/>
                <rect x="66" y="22.6" width="4" height="2.8" rx="1.4" fill="#fff"/>
              </svg>
            </span>
            <span class="svc-chip"><img src="/logos/excel.svg" alt="" width="30" height="30" loading="lazy" /></span>
            <span class="svc-chip"><img src="/logos/google-gmail.svg" alt="" width="30" height="30" loading="lazy" /></span>
            <span class="svc-chip"><img src="/logos/viber.svg" alt="" width="30" height="30" loading="lazy" /></span>
          </span>
          <h3>Office automations</h3>
          <ul class="svc-list">
            <li>Payments matched to their invoices automatically</li>
            <li>Collections tracked and chased with automatic reminders</li>
            <li>A daily picture of your business in one message</li>
          </ul>
          <a class="card-arrow" href="/en/runs-by-itself/">Learn more →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- 2β. Κριτικές Google — «Η άνοδος στη Google»: όσο πέφτουν αστέρια-κριτικές,
       η επιχείρηση σκαρφαλώνει από την 3η στην 1η θέση των αποτελεσμάτων.
       Το HTML έχει το τελικό state (#1, κορώνα) — χωρίς JS ή με reduced motion
       μένει στατικό· το JS το «ξαναπαίζει» σε loop όσο το section είναι ορατό. -->
  <section
    class="section section--tight"
    aria-labelledby="rev-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-say="Every new review lifts the business higher in Google's results."
  >
    <div class="container">
      <div class="rev-grid">
      <div class="rev-copy">
        <div class="sec-head">
          <p class="kicker">Google reviews</p>
          <h2 id="rev-title">More reviews, higher on Google</h2>
        </div>
        <p class="rev-sub">
          Every new review counts: your rating rises and your business climbs
          the rankings — right where customers are searching.
        </p>
        <div class="rev-cta">
          <a class="btn btn--ghost" href="/en/reviews/">See what the Reviews Tool does</a>
        </div>
        <p class="rev-note">Illustrative example.</p>
      </div>

      <div class="rev-stage" id="rev-stage" aria-hidden="true">
        <div class="rev-fx" id="rev-fx"></div>
        <div class="rev-phone">
          <div class="rev-screen">
          <div class="rev-status">
            <span class="rev-time num">9:41</span>
            <span class="rev-island"></span>
            <span class="rev-sicons">
              <svg class="ri-signal" viewBox="0 0 18 12" aria-hidden="true"><rect x="0" y="7.5" width="3.2" height="4.5" rx="1"/><rect x="4.9" y="5.3" width="3.2" height="6.7" rx="1"/><rect x="9.8" y="2.8" width="3.2" height="9.2" rx="1"/><rect x="14.7" y="0" width="3.2" height="12" rx="1"/></svg>
              <svg class="ri-wifi" viewBox="0 0 16 12" aria-hidden="true"><path d="M2.5 5.5 A7.8 7.8 0 0 1 13.5 5.5" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><path d="M4.75 8.05 A4.6 4.6 0 0 1 11.25 8.05" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><circle cx="8" cy="10.6" r="1.5"/></svg>
              <svg class="ri-batt" viewBox="0 0 27 13" aria-hidden="true"><rect x="0.6" y="0.6" width="22.3" height="11.8" rx="3.8" fill="none" stroke="currentColor" stroke-width="1.1" opacity=".35"/><rect x="2.4" y="2.4" width="18.7" height="8.2" rx="2.2"/><path d="M24.8 4.4 v4.2 a2.15 2.15 0 0 0 0 -4.2 z" opacity=".4"/></svg>
            </span>
          </div>
          <div class="rev-search">
            <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.2-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C41.4 34.9 44 29.9 44 24c0-1.2-.1-2.4-.4-3.5z"/></svg>
            <span>coffee near me</span>
          </div>
          <div class="rev-list">
            <div class="rev-row" id="rev-a" style="transform:translateY(66px)" data-y="66">
              <p>The Corner Cafe</p>
              <p class="rev-meta"><b>4.6</b> <span class="rev-stars">★★★★★</span> (210)</p>
            </div>
            <div class="rev-row" id="rev-b" style="transform:translateY(132px)" data-y="132">
              <p>Cafe Next Door</p>
              <p class="rev-meta"><b>4.4</b> <span class="rev-stars">★★★★★</span> (98)</p>
            </div>
            <div class="rev-row rev-row--you" id="rev-y" style="transform:translateY(0px)" data-y="0">
              <p>Your business<span class="rev-crown" id="rev-crown"><svg viewBox="0 0 24 24" fill="#e37400" aria-hidden="true"><path d="M2.6 18.2 1 7.6l6 3.9L12 4l5 7.5 6-3.9-1.6 10.6z"/><path d="M3.5 19.6h17v1.9h-17z"/></svg></span></p>
              <p class="rev-meta"><b id="rev-rating">4.9</b> <span class="rev-stars">★★★★★</span> (<span id="rev-count" class="num">234</span>)</p>
              <span class="rev-ring" id="rev-ring"></span>
            </div>
          </div>
          <p class="rev-win" id="rev-win">The area's first choice ✓</p>
          <div class="rev-skel">
            <div class="rev-skel-row"><span style="width:62%"></span><span style="width:38%"></span></div>
            <div class="rev-skel-row"><span style="width:48%"></span><span style="width:55%"></span></div>
          </div>
          <span class="rev-homebar"></span>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- 3. Μεθοδολογία -->
  <section
    class="section section--tight"
    aria-labelledby="method-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-say={`Every project starts with the free ${ELEGXOS.minutes}-minute PISMA Check — you get the findings in writing.`}
  >
    <span class="flogo sflogo" aria-hidden="true" style="right:4%;top:40px;--w:24px;--dur:5.9s"><img src="/logos/google-maps.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--yellow">Methodology</p>
        <h2 id="method-title">How we work — in 4 steps</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-num num">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Τιμολόγηση — φτιάξτε το δικό σας πακέτο -->
  <section
    class="section section--tight"
    aria-labelledby="pricing-title"
    data-mascot-stop
    data-mascot-side="left"
    data-mascot-say="No ready-made packages — you pick what you need and watch the total update live."
  >
    <span class="flogo sflogo" aria-hidden="true" style="left:4%;top:2px;--w:22px;--dur:6.4s"><img src="/logos/linkedin-icon.svg" alt="" loading="lazy" /></span>
    <span class="flogo sflogo" aria-hidden="true" style="right:4%;top:42px;--w:26px;--dur:6.8s"><img src="/logos/facebook.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--blue">Pricing</p>
        <h2 id="pricing-title">No ready-made packages — you build your own</h2>
        <p>Every price is public. You pick only what you need — and know the cost before we ever speak.</p>
      </div>

      <div class="card bd reveal" id="builder-demo">
        <!-- Αριστερά: μίνι-preview του builder — δείγμα με πραγματικές τιμές -->
        <div class="bd-mock" aria-hidden="true">
          <p class="bd-mock-title">Your quote <span class="tag tag--demo">Sample</span></p>
          <ul class="bd-list">
            {bdItems.map((o) => (
              <li class="bd-item is-on" data-price={o.price} data-ptype={o.type}>
                <span class="bd-check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg>
                </span>
                <span class="bd-label">{o.label}</span>
                <span class="bd-price num">{eurEn(o.price)}{o.type === 'monthly' && <em>/mo</em>}</span>
              </li>
            ))}
          </ul>
          <div class="bd-totals">
            <span>One-off</span><b class="num" id="bd-once">{eurEn(bdTotals.once)}</b>
            <span>Monthly</span><b class="num bd-sm" id="bd-month">{eurEn(bdTotals.monthly)}</b>
          </div>
        </div>

        <!-- Δεξιά: πώς δουλεύει -->
        <div class="bd-text">
          <ol class="bd-steps">
            <li>
              <span class="bd-n num">1</span>
              <div>
                <h3>Pick your services</h3>
                <p>Website, Google, the Reviews Tool, automations — tick only what your business needs.</p>
              </div>
            </li>
            <li>
              <span class="bd-n num">2</span>
              <div>
                <h3>Watch the total update live</h3>
                <p>One-off and monthly, no fine print — the sum updates right in front of you.</p>
              </div>
            </li>
            <li>
              <span class="bd-n num">3</span>
              <div>
                <h3>Get it in writing</h3>
                <p>No online payment — you send the quote over and we talk.</p>
              </div>
            </li>
          </ol>
          <a class="btn btn--orange" href="/en/pricing/">Build your package →</a>
          <p class="btn-note">2 minutes · all prices public · no personal details</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Η εταιρία -->
  <section class="section section--tight" aria-labelledby="who-title">
    <span class="flogo sflogo" aria-hidden="true" style="right:5%;top:4px;--w:22px;--dur:6.6s"><img class="chip" src="/logos/tiktok-icon.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="card who reveal">
        <div>
          <p class="kicker">The company</p>
          <h2 id="who-title">You talk to the person doing the work</h2>
          <p>
            You work directly with the person who designs and builds your project — no
            sales department. Everything we build belongs to your business.
          </p>
          <div class="who-bridge" aria-hidden="true">
            <span class="wb-chip" id="bridge-you">You</span>
            <span class="wb-line" id="bridge-line"><span class="wb-fill"></span></span>
            <span class="wb-chip" id="bridge-pisma">PISMA<span class="wb-dot">.</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Τελικό κάλεσμα -->
  <section
    class="section final-cta"
    aria-labelledby="final-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-say={`Start with the free PISMA Check — ${ELEGXOS.minutes} minutes, no commitment.`}
  >
    <span class="flogo sflogo" aria-hidden="true" style="left:5%;top:12px;--w:24px;--dur:5.4s"><img src="/logos/viber.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <h2 id="final-title">Start with the free<br /><span class="grad-text">{ELEGXOS.minutes}-minute PISMA Check</span></h2>
      <p>
        We map where you're losing customers and time — and you get the findings in writing.
      </p>
      <a class="btn btn--orange" href="/en/free-assessment/">Book the free PISMA Check</a>
      <p class="btn-note">{ELEGXOS.minutes} minutes · completely free · no commitment</p>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/smoke';

  // Hover «Προβολέας» στο μεγάλο PISMA (εφέ 2, επιλογή χρήστριας): ένα φως
  // ακολουθεί το ποντίκι μέσα στα γράμματα. Ομαλό (rAF + lerp), ξεκινά από το
  // σημείο εισόδου, σβήνει με ξεθώριασμα, μόνο με πραγματικό ποντίκι, και όχι
  // πριν ολοκληρωθεί η είσοδος των γραμμάτων.
  const hw = document.querySelector<HTMLElement>('.hero-word');
  if (hw && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let tx = 50, ty = 50, cx = 50, cy = 50, raf = 0, over = false;
    setTimeout(() => hw.classList.add('ready'), 2300);
    const pos = (e: PointerEvent) => { const r = hw.getBoundingClientRect(); return [((e.clientX - r.left) / r.width) * 100, ((e.clientY - r.top) / r.height) * 100]; };
    const tick = () => {
      cx += (tx - cx) * .16; cy += (ty - cy) * .16;
      hw.style.setProperty('--mx', cx.toFixed(2) + '%'); hw.style.setProperty('--my', cy.toFixed(2) + '%');
      raf = (over || Math.abs(tx - cx) > .05 || Math.abs(ty - cy) > .05) ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
    hw.addEventListener('pointerenter', (e) => { [cx, cy] = pos(e); tx = cx; ty = cy; over = true; hw.classList.add('spot-on'); kick(); });
    hw.addEventListener('pointermove', (e) => { [tx, ty] = pos(e); kick(); });
    hw.addEventListener('pointerleave', () => { over = false; hw.classList.remove('spot-on'); });
  }
  // Parallax λογοτύπων στο scroll + μετρητής κριτικών — σέβονται το reduced motion.
  const reduceFx = window.matchMedia('(prefers-reduced-motion: reduce)').matches;


  // Τα σκόρπια λογότυπα αναδύονται όταν μπουν στην οθόνη
  const sflogos = Array.from(document.querySelectorAll('.sflogo'));
  if (sflogos.length) {
    if (reduceFx || !('IntersectionObserver' in window)) {
      sflogos.forEach((el) => el.classList.add('in'));
    } else {
      const sIo = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); sIo.unobserve(e.target); }
        }
      }, { rootMargin: '0px 0px -8% 0px' });
      sflogos.forEach((el) => sIo.observe(el));
    }
  }

  // Κινήσεις sections: οπλίζονται μόνο εδώ (.fx-armed) — χωρίς JS όλα ορατά.
  // Κάθε section πυροδοτεί (.fx-on) μία φορά, όταν μπει αρκετά στην οθόνη.
  const fxIds = ['svc-title', 'method-title', 'pricing-title', 'who-title', 'final-title'];
  const fxSections = fxIds
    .map((id) => document.getElementById(id)?.closest('section'))
    .filter((s): s is HTMLElement => !!s);
  if (!reduceFx && 'IntersectionObserver' in window && fxSections.length) {
    fxSections.forEach((s) => s.classList.add('fx-armed'));
    const fxIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('fx-on');
            fxIo.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 }
    );
    fxSections.forEach((s) => fxIo.observe(s));
  }

  // Μίνι-preview builder (Τιμολόγηση): οι υπηρεσίες «τικάρονται» μία-μία και το
  // σύνολο μεγαλώνει ζωντανά. Το HTML έχει το τελικό state — το JS απλώς το
  // ξανα-παίζει στο πρώτο scroll. Χωρίς JS ή με reduced motion: τελικό state.
  const bdDemo = document.getElementById('builder-demo');
  if (bdDemo && !reduceFx && 'IntersectionObserver' in window) {
    const items = Array.from(bdDemo.querySelectorAll<HTMLElement>('.bd-item'));
    const onceEl = document.getElementById('bd-once')!;
    const monthEl = document.getElementById('bd-month')!;
    const finalOnce = onceEl.textContent!;
    const finalMonth = monthEl.textContent!;
    const eurFmt = (n: number) => '€' + n.toLocaleString('en-US');

    const bdIo = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        bdIo.disconnect();
        // Μηδενισμός και σταδιακό «τικάρισμα»
        let once = 0;
        let month = 0;
        items.forEach((li) => li.classList.remove('is-on'));
        onceEl.textContent = eurFmt(0);
        monthEl.textContent = eurFmt(0);
        items.forEach((li, i) => {
          window.setTimeout(() => {
            li.classList.add('is-on');
            const price = Number(li.dataset.price || 0);
            if (li.dataset.ptype === 'once') once += price;
            else month += price;
            onceEl.textContent = eurFmt(once);
            monthEl.textContent = eurFmt(month);
            // Δίχτυ ασφαλείας: στο τέλος, τα ποσά που ήρθαν από το build.
            if (i === items.length - 1) {
              onceEl.textContent = finalOnce;
              monthEl.textContent = finalMonth;
            }
          }, 500 + i * 550);
        });
      },
      { threshold: 0.45 }
    );
    bdIo.observe(bdDemo);
  }

  // «Η άνοδος στη Google» (Κριτικές): το HTML έχει το τελικό state (#1, κορώνα,
  // 4.9/87). Με JS + ορατότητα: επαναφορά στην 3η θέση και ζωντανή άνοδος σε
  // loop· όταν βγει από την οθόνη, σταματά και γυρνά στο τελικό state.
  // Τα δυναμικά στοιχεία (αστέρια/κομφετί) παίρνουν inline styles — τα scoped
  // styles του Astro δεν πιάνουν JS-created elements.
  const revStage = document.getElementById('rev-stage');
  if (revStage && !reduceFx && 'IntersectionObserver' in window) {
    const fxL = document.getElementById('rev-fx')!;
    const rowA = document.getElementById('rev-a')!;
    const rowB = document.getElementById('rev-b')!;
    const rowY = document.getElementById('rev-y')!;
    const ratEl = document.getElementById('rev-rating')!;
    const cntEl = document.getElementById('rev-count')!;
    const crownEl = document.getElementById('rev-crown')!;
    const ringEl = document.getElementById('rev-ring')!;
    const winEl = document.getElementById('rev-win')!;
    let revTimers: number[] = [];
    let rv = 4.9;
    let cv = 234;
    let revStep = 2;
    let revActive = false;
    const later = (fn: () => void, ms: number) => revTimers.push(window.setTimeout(fn, ms));
    const raf2 = (fn: () => void) => requestAnimationFrame(() => requestAnimationFrame(fn));
    const setTops = (y: string, a: string, b: string) => {
      // transform αντί top: compositor-only (το top έκανε layout + paint σε κάθε καρέ της μετάβασης)
      for (const [el, v] of [[rowY, y], [rowA, a], [rowB, b]] as const) { el.style.transform = `translateY(${v})`; el.dataset.y = String(parseFloat(v)); }
    };
    const paint = () => {
      // Αγγλική σελίδα: δεκαδικό με τελεία (4.9), όχι κόμμα.
      ratEl.textContent = rv.toFixed(1);
      cntEl.textContent = String(cv);
    };

    // Αστέρια εν πτήσει: κρατιούνται σε set ώστε, όταν η σειρά αλλάζει θέση,
    // να ΞΑΝΑΣΤΟΧΕΥΟΥΝ εν κινήσει την καινούργια της θέση — αλλιώς όσα είχαν
    // ξεκινήσει πριν την άνοδο προσγειώνονταν εκεί που ήταν η σειρά πριν.
    const starFlight = new Set<HTMLElement>();
    const starTarget = (fx: number) => {
      const sr = revStage.getBoundingClientRect();
      const lr = rowY.parentElement!.getBoundingClientRect();
      return {
        x: Math.round(lr.left - sr.left + lr.width * fx),
        y: Math.round(lr.top - sr.top + parseFloat(rowY.dataset.y || '0') + rowY.offsetHeight / 2),
      };
    };
    const retargetStars = () => {
      for (const s of starFlight) {
        const p = starTarget(parseFloat(s.dataset.fx || '0.5'));
        s.style.transitionDuration = '.45s'; // γρήγορο «σβούριγμα» προς τη νέα θέση
        s.style.transform = `translate(${p.x}px,${p.y}px) scale(.4) rotate(${s.dataset.rot || 0}deg)`;
      }
    };

    const bump = () => {
      rv = Math.min(rv + 0.09, 4.9);
      // Ο μετρητής ξεπερνά στο φινάλε και τους 210 του πρώτου ανταγωνιστή
      cv += 17 + Math.round(Math.random() * 5);
      paint();
      ringEl.style.transition = 'none'; ringEl.style.opacity = '.9'; ringEl.style.transform = 'scale(1)';
      raf2(() => {
        ringEl.style.transition = 'opacity .6s ease-out, transform .6s ease-out';
        ringEl.style.opacity = '0'; ringEl.style.transform = 'scale(1.12)';
      });
      if (rv >= 4.45 && revStep < 1) { revStep = 1; setTops('66px', '0px', '132px'); retargetStars(); }
      if (rv >= 4.65 && revStep < 2) { revStep = 2; setTops('0px', '66px', '132px'); retargetStars(); }
    };

    const starTo = () => {
      // Στόχος: η θέση της σειράς «Your business» από το style.top (όχι το
      // rect μεσοδρομίς)· αν η σειρά ανέβει όσο το αστέρι πετάει, το
      // retargetStars() το στρέφει στη νέα θέση.
      const sr = revStage.getBoundingClientRect();
      const fx = 0.2 + Math.random() * 0.6;
      const t = starTarget(fx);
      const side = Math.random();
      let sx: number, sy: number;
      if (side < 0.35) { sx = -30; sy = Math.random() * sr.height * 0.8; }
      else if (side < 0.7) { sx = sr.width + 30; sy = Math.random() * sr.height * 0.8; }
      else { sx = Math.random() * sr.width; sy = -30; }
      const s = document.createElement('span');
      s.textContent = '★';
      s.dataset.fx = String(fx);
      const rot = Math.round(Math.random() * 260 - 130);
      s.dataset.rot = String(rot);
      // transform αντί left/top: η πτήση του αστεριού τρέχει στον compositor (το left/top έκανε layout σε κάθε καρέ)
      s.style.cssText = `position:absolute;left:0;top:0;transform:translate(${sx}px,${sy}px);font-size:${Math.round(14 + Math.random() * 8)}px;color:#FBBC04;text-shadow:0 0 10px rgba(251,188,4,.9),0 0 22px rgba(251,188,4,.5);transition:transform 1.1s cubic-bezier(.4,0,.6,1),opacity 1.1s cubic-bezier(.4,0,.6,1);will-change:transform;z-index:3;opacity:0;line-height:1`;
      fxL.appendChild(s);
      starFlight.add(s);
      raf2(() => {
        s.style.opacity = '1';
        s.style.transform = `translate(${t.x}px,${t.y}px) scale(.4) rotate(${rot}deg)`;
      });
      later(() => { starFlight.delete(s); s.remove(); bump(); }, 1120);
    };

    const burst = () => {
      const sr = revStage.getBoundingClientRect();
      const cols = ['#FF7A50', '#FBBC04', '#FFA284', '#55A874', '#4CAF50'];
      const cx = sr.width / 2;
      const cy = sr.height / 2 - 70;
      for (let i = 0; i < 28; i++) {
        const p = document.createElement('span');
        const a = Math.random() * Math.PI * 2;
        const d = 70 + Math.random() * 130;
        p.style.cssText = `position:absolute;left:${cx}px;top:${cy}px;width:7px;height:11px;border-radius:2px;background:${cols[i % 5]};transition:transform 1.2s cubic-bezier(.1,.8,.3,1),opacity 1.2s;z-index:4`;
        fxL.appendChild(p);
        raf2(() => {
          p.style.transform = `translate(${Math.round(Math.cos(a) * d)}px,${Math.round(Math.sin(a) * d + 80)}px) rotate(${Math.round(Math.random() * 540 - 270)}deg)`;
          p.style.opacity = '0';
        });
        later(() => p.remove(), 1400);
      }
    };

    const revFinal = () => {
      rv = 4.9; cv = 234; revStep = 2; paint();
      setTops('0px', '66px', '132px');
      crownEl.style.transform = 'scale(1)';
      winEl.style.opacity = '1'; winEl.style.transform = 'none';
    };

    const cycle = () => {
      revTimers.forEach(clearTimeout); revTimers = []; fxL.innerHTML = ''; starFlight.clear();
      rv = 3.9; cv = 24; revStep = 0; paint();
      setTops('132px', '0px', '66px');
      crownEl.style.transform = 'scale(0)';
      winEl.style.opacity = '0'; winEl.style.transform = 'translateY(6px)';
      for (let i = 0; i < 11; i++) later(starTo, 1100 + i * 430);
      later(() => {
        // Δίχτυ ασφαλείας: το φινάλε κλειδώνει στα ποσά του στατικού state.
        revFinal();
        burst();
      }, 7100);
      later(cycle, 10600);
    };

    const revIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !revActive) { revActive = true; cycle(); }
          else if (!e.isIntersecting && revActive) {
            revActive = false;
            revTimers.forEach(clearTimeout); revTimers = []; fxL.innerHTML = ''; starFlight.clear();
            revFinal();
          }
        }
      },
      { threshold: 0.35 }
    );
    revIo.observe(revStage);
  }
</script>

<style>
  /* ---------- Κριτικές: «Η άνοδος στη Google» ---------- */
  /* Δίστηλη διάταξη: κείμενο αριστερά, iPhone δεξιά — σε στενές οθόνες
     στοιβάζονται (κείμενο πάνω, κινητό από κάτω, κεντραρισμένο). */
  .rev-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    max-width: 900px; margin-inline: auto;
  }
  .rev-copy .sec-head { margin-bottom: 0; }
  .rev-sub {
    color: var(--muted);
    max-width: 46ch; margin: 16px 0 28px;
  }
  /* Χωρίς κουτί-φόντο: το iPhone «αιωρείται» πάνω στη σελίδα, σε πραγματικές
     αναλογίες σώματος iPhone (71,6×147,6mm ≈ 1:2.06) με μπεζέλ, dynamic
     island, status bar και home bar. Το .rev-stage μένει μόνο ως σκηνή για
     το JS (αγκύρωση αστεριών/κομφετί). */
  .rev-stage {
    position: relative; height: 660px; width: 400px;
  }
  .rev-fx { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .rev-phone {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 296px; background: #17171a; border-radius: 52px;
    padding: 10px; border: 1px solid #45454d;
    box-shadow: 0 24px 70px rgba(0, 0, 0, .6);
  }
  .rev-screen {
    display: flex; flex-direction: column;
    height: 590px;
    background: #fff; border-radius: 42px;
    padding: 0 12px 12px; overflow: hidden;
  }
  .rev-status {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 8px 6px;
  }
  .rev-time { width: 58px; font-size: .84rem; font-weight: 700; color: #111; }
  .rev-island { width: 92px; height: 27px; background: #0b0b0c; border-radius: 999px; }
  .rev-sicons { display: flex; align-items: center; gap: 6px; width: 58px; justify-content: flex-end; color: #111; }
  .rev-sicons svg { fill: currentColor; }
  .ri-signal { width: 17px; height: 11px; }
  .ri-wifi { width: 15px; height: 11px; }
  .ri-batt { width: 24px; height: 11px; }
  .rev-search {
    display: flex; align-items: center; gap: 8px;
    background: #f1f3f4; border-radius: 999px; padding: 10px 14px; margin: 12px 0 16px;
  }
  .rev-search svg { width: 16px; height: 16px; flex: none; }
  .rev-search span { color: #5f6368; font-size: .78rem; }
  .rev-list { position: relative; height: 196px; flex: none; }
  .rev-row {
    position: absolute; left: 0; right: 0;
    top: 0; transition: transform .9s cubic-bezier(.3, 1.3, .4, 1); will-change: transform;
    background: #fff; border: 1px solid #e8eaed; border-radius: 12px; padding: 9px 12px;
  }
  .rev-row p { margin: 0; color: #202124; font-size: .8rem; font-weight: 600; max-width: none; }
  .rev-row p.rev-meta { margin-top: 2px; color: #5f6368; font-size: .74rem; font-weight: 400; }
  .rev-meta b { color: #e37400; font-weight: 600; }
  .rev-meta .num { font-size: .72rem; color: #5f6368; }
  .rev-stars { color: #FBBC04; letter-spacing: 1px; }
  .rev-row--you { background: #FFF4EF; border: 1.5px solid var(--orange); z-index: 2; }
  .rev-crown {
    display: inline-flex; width: 15px; height: 15px;
    vertical-align: -2px; margin-left: 5px;
    transition: transform .5s cubic-bezier(.3, 1.8, .4, 1);
  }
  .rev-crown svg { width: 100%; height: 100%; }
  .rev-ring {
    position: absolute; inset: -3px; border: 2px solid var(--orange);
    border-radius: 14px; opacity: 0; pointer-events: none;
  }
  .rev-win {
    margin: 14px auto 0; width: max-content; max-width: 100%;
    color: #0F6E56; background: #E1F5EE; border-radius: 999px;
    padding: 5px 12px; font-size: .74rem; font-weight: 600;
    transition: opacity .5s, transform .5s;
  }
  /* Σκιώδη «επόμενα αποτελέσματα» — γεμίζουν φυσικά το κάτω μέρος της οθόνης */
  .rev-skel { flex: 1; display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
  .rev-skel-row {
    border: 1px solid #eceef0; border-radius: 12px; padding: 11px 12px;
    display: flex; flex-direction: column; gap: 7px;
  }
  .rev-skel-row span { display: block; height: 8px; border-radius: 999px; background: #f1f3f4; }
  .rev-homebar {
    display: block; flex: none;
    width: 118px; height: 5px; margin: 10px auto 2px;
    background: #d5d5da; border-radius: 999px;
  }
  .rev-note { color: var(--muted); font-size: .78rem; margin: 14px 0 0; }
  .rev-cta { display: flex; justify-content: flex-start; margin-top: 0; }
  @media (max-width: 880px) {
    .rev-grid { grid-template-columns: 1fr; }
    .rev-stage { margin-inline: auto; width: min(400px, 100%); }
  }
  @media (max-width: 480px) {
    .rev-stage { height: 570px; }
    .rev-phone { width: 262px; border-radius: 46px; padding: 9px; }
    .rev-screen { height: 522px; border-radius: 38px; }
    .rev-island { width: 80px; height: 24px; }
    .rev-search { margin: 8px 0 12px; }
    .rev-skel { margin-top: 12px; }
  }

  /* ---------- Hero ---------- */
  /* overflow-x μόνο: το κάθετο clip έκοβε τις δέσμες (beams) στο όριο του main
     και άφηνε ορατή οριζόντια «γραμμή» κάτω από το μενού — τώρα η λάμψη
     συνεχίζει ενιαία ως την κορυφή, πίσω από το sticky nav. */
  /* Η σκηνή απλώνεται και πίσω από το sticky μενού (72px) — μενού και hero «ένα» (αίτημα χρήστριας). */
  .hero { margin-top: -72px; min-height: min(100svh, 940px); display: flex; flex-direction: column; justify-content: center; padding-top: calc(clamp(32px, 5vw, 64px) + 72px); padding-bottom: clamp(48px, 7vw, 80px); position: relative; overflow-x: clip; }
  /* ΟΛΑ στο κέντρο (αίτημα χρήστριας): τίτλος, «PISMA.», κουμπιά, αριθμοί, παράγραφος. */
  .hero-inner { text-align: center; position: relative; z-index: 1; width: 100%; display: flex; flex-direction: column; align-items: center; }
  .hero-kicker {
    margin-inline: auto;
    margin-bottom: clamp(18px, 3vw, 28px);
    font-size: .76rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--orange-text);
    text-wrap: balance;
  }
  /* Desktop: μία πρόταση σε ΜΙΑ γραμμή (αίτημα χρήστριας) — το μέγεθος ακολουθεί το πλάτος. */
  .hero h1 { max-width: none; margin-inline: auto; white-space: nowrap; font-size: clamp(2rem, 3.6vw, 3.4rem); line-height: 1.05; letter-spacing: -.03em; text-shadow: 0 10px 60px rgba(0, 0, 0, .6); }
  @media (max-width: 860px) { .hero h1 { white-space: normal; max-width: 18ch; } }
  .hero-hl { position: relative; white-space: nowrap; }
  .hl-stroke {
    position: absolute; left: -.06em; bottom: -.16em;
    width: calc(100% + .12em); height: .34em;
    overflow: visible; pointer-events: none;
  }
  .hero .sub { margin: 30px auto 0; font-size: 1.1rem; color: var(--muted); max-width: 62ch; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 36px; }
  .hero .btn-note { margin-top: 14px; margin-inline: auto; }

  /* WhatsApp & Viber — γυαλιστερά brand pills με λευκό δίσκο για το εικονίδιο */
  .hero-chat {
    display: flex; flex-direction: column; align-items: center;
    gap: 8px; margin-top: 20px;
  }
  /* Split-button (επιλογή 6): ένα pill χωρισμένο στη μέση — WhatsApp | Viber */
  .split {
    display: inline-flex; border-radius: 999px;
    background: var(--card); border: 1px solid var(--line);
    box-shadow: 0 2px 8px rgba(0, 0, 0, .3); overflow: hidden;
  }
  .split-half {
    display: inline-flex; align-items: center; gap: 9px; padding: 11px 20px;
    font-weight: 700; font-size: .92rem; color: var(--navy); text-decoration: none;
    transition: background-color .25s ease;
  }
  .split-half img { width: 20px; height: 20px; display: block; }
  .split-half + .split-half { border-left: 1px solid var(--line-strong); }
  .split--wa:hover { background: rgba(37, 211, 102, .14); }
  .split--vb:hover { background: rgba(115, 96, 242, .16); }
  .split-note { font-size: .8rem; color: var(--muted); }

  /* Αριθμοί-δεσμεύσεις κάτω από τα CTAs */
  .hero-stats {
    list-style: none; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 10px 34px; margin: 26px auto 0;
  }
  .hero-stats li { display: grid; gap: 2px; text-align: center; }
  .hero-stats strong {
    font-family: var(--font-display); font-weight: 800;
    font-size: 1.18rem; color: var(--navy); letter-spacing: .01em;
  }
  .hero-stats span {
    font-size: .78rem; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--muted);
  }

  .btn-frame {
    display: inline-flex; padding: 3px; border-radius: 14px;
    background: rgba(255, 255, 255, .08); border: 1px solid var(--line);
  }

  /* Announcement pill */
  .announce {
    display: inline-flex; align-items: center; gap: 12px;
    background: var(--card-2); border: 1px solid var(--line-strong);
    border-radius: 999px; padding: 5px 5px 5px 16px;
    font-size: .85rem; color: var(--ink); text-decoration: none;
    box-shadow: var(--shadow);
    transition: border-color .25s ease, background-color .25s ease;
    margin-bottom: clamp(22px, 3.5vw, 36px);
    max-width: min(94%, 560px);
  }
  .announce-text {
    min-width: 0; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap;
  }
  .announce:hover { border-color: rgba(255, 255, 255, .28); background: var(--bg-soft); }
  .announce-sep { width: 1px; height: 16px; background: var(--line-strong); flex: none; }
  .announce-arrow {
    width: 26px; height: 26px; border-radius: 50%; overflow: hidden; flex: none;
    background: var(--bg); display: block;
  }
  .announce-arrow-track {
    display: flex; width: 52px; height: 26px;
    transform: translateX(-50%);
    transition: transform .5s ease;
  }
  .announce:hover .announce-arrow-track { transform: translateX(0); }
  .announce-arrow-track svg { width: 12px; height: 26px; margin-inline: auto; color: var(--orange-text); flex: none; padding-block: 7px; box-sizing: content-box; padding-inline: 7px; }

  section { position: relative; }
  .sflogo { display: none; pointer-events: none; z-index: 2; }

  /* Είσοδος: απαλή ανάδυση με ξεθόλωμα (επιλογή χρήστη).
     Παίζει στο span — το λίκνισμα (translate/rotate στο img) και το parallax
     (inline transform από JS) δεν συγκρούονται μαζί της. */
  @keyframes flogoIn {
    from { opacity: 0; translate: 0 22px; filter: blur(8px); }
    to { opacity: 1; translate: 0 0; filter: blur(0); }
  }
  /* Τα σκόρπια στα sections: αναδύονται όταν πρωτοφανούν στην οθόνη */
  .sflogo { opacity: 0; }
  .sflogo.in { animation: flogoIn .8s cubic-bezier(.22, 1, .36, 1) both; }
  @media (prefers-reduced-motion: reduce) {
    .sflogo { opacity: 1; }
    .sflogo.in { animation: none; }
  }
  .flogo { position: absolute; }
  .flogo img {
    display: block; width: var(--w, 40px); height: auto;
    animation: flogoFloat var(--dur, 6s) ease-in-out infinite alternate;
    filter: drop-shadow(0 8px 22px rgba(0, 0, 0, .5));
    opacity: .92;
  }
  .flogo img.inv { filter: invert(1) drop-shadow(0 8px 22px rgba(0, 0, 0, .5)); opacity: .8; }
  .flogo img.chip { background: #fff; border-radius: 9px; padding: 4px; }
  @keyframes flogoFloat {
    from { translate: 0 -9px; rotate: -2.5deg; }
    to { translate: 0 9px; rotate: 2.5deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flogo img { animation: none; }
  }

  /* Beams */
  /* ---------- «Σκηνή» στο hero: καπνός, προβολείς, ghost «PISMA», κόκκος ---------- */
  .stg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .stg-fog { position: absolute; border-radius: 50%; filter: blur(70px); animation: stgDrift 20s ease-in-out infinite alternate; }
  .stg-fog--1 { width: 70vw; height: 40vw; left: -10vw; top: 14%; background: radial-gradient(closest-side, rgba(255,255,255,.17), transparent); }
  .stg-fog--2 { width: 60vw; height: 36vw; right: -12vw; top: 26%; background: radial-gradient(closest-side, rgba(255,255,255,.13), transparent); animation-delay: -7s; animation-duration: 24s; }
  .stg-fog--3 { width: 90vw; height: 30vw; left: 5vw; bottom: -6vw; background: radial-gradient(closest-side, rgba(255,255,255,.2), transparent); animation-delay: -12s; animation-duration: 28s; }
  @keyframes stgDrift { to { transform: translate(6vw, -3vw) scale(1.12); } }
  .hero-word {
    display: block; margin: clamp(4px, 1.5vw, 16px) auto clamp(10px, 2.5vw, 26px);
    font-family: var(--font-display, 'Unbounded', 'Inter', sans-serif); font-weight: 800;
    font-size: clamp(4.6rem, 16vw, 15rem); line-height: .95; letter-spacing: .01em;
    white-space: nowrap; user-select: none; cursor: default;
    /* Συμπαγή γράμματα, όπως το logo — ο καπνός φαίνεται μέσα από αυτά */
    color: rgba(255,255,255,.17); text-shadow: 0 0 80px rgba(255,255,255,.22);
  }
  /* Εφέ 2+3 (επιλογή χρήστριας): τα γράμματα μπαίνουν ένα-ένα μέσα από θόλωμα με μια
     στιγμιαία λάμψη, και μετά περνάει από πάνω τους λωρίδα φωτός κάθε λίγα δευτερόλεπτα. */
  .hero-word { position: relative; }
  .hero-word span {
    display: inline-block; opacity: 0; filter: blur(16px); transform: translateY(26px) scale(1.06);
    animation: hwIn 1.1s cubic-bezier(.22, 1, .36, 1) forwards;
  }
  .hero-word span:nth-child(1) { animation-delay: .35s; }
  .hero-word span:nth-child(2) { animation-delay: .48s; }
  .hero-word span:nth-child(3) { animation-delay: .61s; }
  .hero-word span:nth-child(4) { animation-delay: .74s; }
  .hero-word span:nth-child(5) { animation-delay: .87s; }
  .hero-word span:nth-child(6) { animation-delay: 1.02s; }
  @keyframes hwIn {
    0% { opacity: 0; filter: blur(16px); transform: translateY(26px) scale(1.06); }
    55% { opacity: 1; filter: blur(0); color: rgba(255,255,255,.5); text-shadow: 0 0 70px rgba(255,255,255,.7), 0 0 20px rgba(255,255,255,.5); }
    100% { opacity: 1; filter: blur(0); transform: none; }
  }
  .hero-word::after {
    content: attr(data-text); position: absolute; left: 0; right: 0; top: 0;
    color: transparent; pointer-events: none; opacity: 0;
    background: linear-gradient(105deg, transparent 0 38%, rgba(255,255,255,.55) 46%, rgba(255,255,255,.95) 50%, rgba(255,255,255,.55) 54%, transparent 62% 100%);
    background-size: 260% 100%; background-position: 130% 0;
    -webkit-background-clip: text; background-clip: text;
    animation: hwShine 6s ease-in-out 1.9s infinite;
  }
  @keyframes hwShine {
    0% { background-position: 130% 0; opacity: 1; }
    40% { background-position: -130% 0; opacity: 1; }
    41%, 100% { background-position: -130% 0; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-word span { animation: none; opacity: 1; filter: none; transform: none; }
    .hero-word::after { animation: none; }
  }
  /* Hover «Προβολέας»: στρώμα ::before με το ίδιο κείμενο, φως στο σημείο του ποντικιού
     (--mx/--my από το JS), background-clip: text — ευθυγραμμισμένο ακριβώς με τα γράμματα. */
  @media (hover: hover) and (pointer: fine) {
    .hero-word::before {
      content: attr(data-text); position: absolute; left: 0; right: 0; top: 0;
      color: transparent; pointer-events: none; opacity: 0; transition: opacity .45s ease;
      background: radial-gradient(clamp(170px, 24vw, 320px) circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.98) 0%, rgba(255,255,255,.6) 32%, rgba(255,255,255,.18) 58%, rgba(255,255,255,0) 74%);
      -webkit-background-clip: text; background-clip: text;
    }
    .hero-word.ready.spot-on::before { opacity: 1; }
  }
  .stg-smoke { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.2s ease; }
  .stg-smoke.is-on { opacity: .95; }
  .stg:has(.stg-smoke.is-on) .stg-fog { opacity: .35; }
  /* Οθόνες αφής: ομίχλη χωρίς filter: blur και χωρίς κίνηση (blur(70px) σε 3 στοιχεία 70-90vw που κινούνται
     συνεχώς = το ακριβότερο πράγμα για GPU κινητού)· τα γράμματα «PISMA.» μπαίνουν με ξεθώριασμα + ανάδυση
     χωρίς blur/λάμψη (color/text-shadow/blur = main thread, repaint 6 μεγάλων γραμμάτων σε κάθε καρέ). */
  @media (pointer: coarse) {
    .stg-fog { filter: none; animation: none; }
    .stg-fog--1 { background: radial-gradient(closest-side, rgba(255,255,255,.12), transparent); }
    .stg-fog--2 { background: radial-gradient(closest-side, rgba(255,255,255,.09), transparent); }
    .stg-fog--3 { background: radial-gradient(closest-side, rgba(255,255,255,.13), transparent); }
    .hero-word span { filter: none; animation-name: hwInLite; }
    @keyframes hwInLite { 0% { opacity: 0; transform: translateY(26px) scale(1.06); } 100% { opacity: 1; transform: none; } }
  }
  .stg-floor { position: absolute; left: 0; right: 0; bottom: 0; height: 30%; background: linear-gradient(180deg, transparent, rgba(255,255,255,.08) 60%, rgba(255,255,255,.13)); }
  .stg::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 140px; background: linear-gradient(transparent, var(--bg)); }

  /* Πριν → Μετά (στη θέση του mockup) */
  .ba-section { padding-top: clamp(40px, 6vw, 72px); }
  .hero-ba { max-width: 880px; margin: 0 auto; }
  .ba-head { text-align: center; margin-bottom: clamp(18px, 3vw, 26px); }
  .ba-head h2 {
    font-size: clamp(1.35rem, 2.8vw, 1.8rem);
    margin-top: 14px;
    letter-spacing: -.01em;
  }

  /* ---------- Υπηρεσίες ---------- */
  .svc { display: flex; flex-direction: column; }
  .svc-list { list-style: none; padding: 0; margin: 4px 0 8px; display: grid; gap: 10px; }
  .svc-list li {
    position: relative; padding-left: 22px;
    font-size: .97rem; color: var(--muted); line-height: 1.55;
  }
  .svc-list li::before {
    content: ''; position: absolute; left: 2px; top: .52em;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--orange);
  }
  .svc .card-arrow { margin-top: auto; padding-top: 12px; }
  .svc--blue .svc-list li::before { background: var(--blue); }
  .svc--blue .card-arrow { color: var(--blue-text); }


  /* Μεθοδολογία: κλιμάκωση αποχρώσεων πορτοκαλί, από ανοιχτό στο βαθύ (1→4) */
  .steps li:nth-child(1) .step-num { background: #FFB27A; color: #4A1B0C; }
  .steps li:nth-child(2) .step-num { background: var(--gt-1); color: #3A1408; }
  .steps li:nth-child(3) .step-num { background: var(--orange-cta); color: #fff; }
  .steps li:nth-child(4) .step-num { background: #C13A20; color: #fff; }

  /* ---------- Πορτοκαλί panel ---------- */
  .einv {
    border-radius: calc(var(--r) + 6px); overflow: hidden;
    background:
      radial-gradient(120% 160% at 90% 110%, rgba(255, 210, 150, .35), transparent 55%),
      linear-gradient(115deg, var(--cta-deep) 0%, var(--orange-cta) 45%, var(--cta-lite) 100%);
    padding: clamp(28px, 5vw, 56px);
    display: grid; gap: clamp(26px, 5vw, 56px);
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    box-shadow: var(--shadow), var(--glow-orange);
  }
  .einv h2, .einv p, .einv li { color: #fff; }
  .einv p { opacity: .93; margin-top: 12px; max-width: 56ch; }
  .einv-checks { list-style: none; padding: 0; margin: 20px 0 26px; display: grid; gap: 10px; font-weight: 600; font-size: .97rem; }
  .einv-checks span { margin-right: 8px; font-weight: 800; }
  .btn--light { background: #fff; color: #C13A20; }
  .btn--light:hover { background: #FFF3E9; }
  .einv-panel {
    background: rgba(23, 21, 20, .85); border: 1px solid rgba(255, 255, 255, .18);
    border-radius: var(--r); padding: clamp(22px, 3vw, 34px);
    display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;
    backdrop-filter: blur(4px);
  }
  .einv-node {
    background: var(--card-2); border: 1px solid var(--line-strong); border-radius: 12px;
    padding: 12px 18px; font-weight: 700; font-size: .92rem; color: var(--navy);
  }
  .einv-node--ok { border-color: rgba(62, 207, 142, .5); color: var(--ok-text); }
  .einv-arrow { color: rgba(255, 255, 255, .8); font-weight: 700; }
  @media (max-width: 780px) { .einv { grid-template-columns: 1fr; } }

  /* ---------- Αποτελέσματα: συμπαγείς σειρές πριν→μετά ---------- */
  .case-rows { display: grid; gap: 14px; max-width: 860px; margin-inline: auto; }
  .case-row {
    display: flex; align-items: center; gap: clamp(14px, 3vw, 28px); flex-wrap: wrap;
    padding: clamp(16px, 2.5vw, 22px) clamp(18px, 3vw, 28px);
    border-left: 3px solid var(--ok); border-radius: 0 var(--r) var(--r) 0;
  }
  .case-row-info { flex: 1 1 240px; min-width: 0; }
  .case-row-info h3 { margin: 0 0 4px; font-size: 1.05rem; }
  .case-row-info p { font-size: .9rem; }
  .case-nums { display: flex; align-items: baseline; gap: 10px; margin: 0; flex-wrap: wrap; }
  .case-arrow { color: var(--ok); font-weight: 700; font-size: 1.1rem; }
  .after-num { font-size: clamp(1.4rem, 3vw, 1.8rem); line-height: 1; }
  .case-delta { flex: none; }
  .cases-note { text-align: center; margin-top: 14px; font-size: .8rem; color: var(--muted); }
  .cases-cta { text-align: center; margin-top: clamp(20px, 3vw, 32px); }

  /* ---------- Τιμολόγηση: μίνι-preview του builder ---------- */
  .bd {
    display: grid;
    grid-template-columns: minmax(min(300px, 100%), .95fr) minmax(min(300px, 100%), 1.05fr);
    gap: clamp(26px, 5vw, 60px);
    align-items: center;
    padding: clamp(24px, 4vw, 48px);
  }
  @media (max-width: 760px) {
    .bd { grid-template-columns: 1fr; }
  }
  .bd-mock {
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    padding: 18px 20px 16px;
  }
  .bd-mock-title {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    font-size: .82rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 6px;
  }
  .bd-list { list-style: none; padding: 0; margin: 0; }
  .bd-item {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .bd-item:last-child { border-bottom: 0; }
  .bd-check {
    flex: none; width: 22px; height: 22px; border-radius: 6px;
    border: 1.5px solid var(--line-strong);
    display: grid; place-items: center;
    color: #fff;
    transition: background .25s ease, border-color .25s ease;
  }
  .bd-check svg { width: 14px; height: 14px; opacity: 0; transform: scale(.6); transition: opacity .25s ease, transform .25s ease; }
  .bd-item.is-on .bd-check { background: var(--orange-cta); border-color: var(--orange-cta); }
  .bd-item.is-on .bd-check svg { opacity: 1; transform: none; }
  .bd-label { flex: 1; font-size: .93rem; font-weight: 600; color: var(--muted); transition: color .25s ease; }
  .bd-item.is-on .bd-label { color: var(--ink); }
  .bd-price { font-size: .93rem; color: var(--muted); white-space: nowrap; transition: color .25s ease; }
  .bd-price em { font-style: normal; font-size: .8em; }
  .bd-item.is-on .bd-price { color: var(--navy); font-weight: 700; }
  .bd-totals {
    display: grid; grid-template-columns: 1fr auto; gap: 2px 14px; align-items: baseline;
    border-top: 1px solid var(--line-strong);
    margin-top: 12px; padding-top: 12px;
  }
  .bd-totals span { font-size: .88rem; color: var(--muted); font-weight: 600; }
  .bd-totals b { font-size: 1.35rem; color: var(--navy); text-align: right; }
  .bd-totals b.bd-sm { font-size: 1rem; color: var(--orange-text); }
  .bd-steps { list-style: none; padding: 0; display: grid; gap: 16px; margin-bottom: 22px; }
  .bd-steps li { display: flex; gap: 14px; align-items: flex-start; }
  .bd-n {
    flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 10px;
    background: var(--orange-soft); color: var(--orange-text);
    font-weight: 700;
  }
  .bd-steps h3 { font-size: 1rem; margin-bottom: 2px; }
