---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE, ELEGXOS } from '../../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'The Dashboard — Measure your business',
  url: `${SITE.url}/en/business-check/`,
  inLanguage: 'en',
  description:
    'Interactive 10-question test — one for each tool: a visibility score and an automation score out of 100.',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};

/*
 * Μία ερώτηση για κάθε εργαλείο του τιμοκαταλόγου (pricing.ts) — σειρά: Προβολή → Αυτοματοποίηση.
 * Μεθοδολογία: κάθε ερώτηση ρωτά ένα ΓΕΓΟΝΟΣ που ο ιδιοκτήτης αναγνωρίζει (όχι αυτοβαθμολόγηση),
 * με ενιαία σκάλα 4 επιλογών: τίποτα (0) → σποραδικά (0.5) → με το χέρι, τακτικά (1) → συστηματικά/αυτόματα (2).
 * Οι διατυπώσεις είναι ουδέτερες — καμία επιλογή δεν ντροπιάζει, για να απαντιέται με ειλικρίνεια.
 */
const questions = [
  /* — Προβολή: πώς σε βρίσκουν — */
  {
    key: 'site',
    /* Εργαλείο: Ιστοσελίδα (web-basic/standard/pro) */
    q: 'What does someone find when they Google you?',
    opts: [
      { label: 'Nothing of my own', v: '0' },
      { label: 'Only Facebook or Instagram', v: '0.5' },
      { label: 'A website that has aged', v: '1' },
      { label: 'An up-to-date site, great on mobile too', v: '2' },
    ],
  },
  {
    key: 'gbp',
    /* Εργαλείο: Google Business Profile (gbp-setup) */
    q: 'Your Google (Maps) profile?',
    opts: [
      { label: "It doesn't exist", v: '0' },
      { label: "It exists — haven't opened it in months", v: '0.5' },
      { label: 'Filled in, I check it now and then', v: '1' },
      { label: 'Complete: hours, photos, services', v: '2' },
    ],
  },
  {
    key: 'reviews',
    /* Εργαλείο: Ο Τροχός των Κριτικών (auto-reviews) */
    q: 'How many reviews did you get last month?',
    opts: [
      { label: 'None', v: '0' },
      { label: 'One or two, at random', v: '0.5' },
      { label: 'A few — when I ask', v: '1' },
      { label: 'They come in steadily, every week', v: '2' },
    ],
  },
  {
    key: 'social',
    /* Εργαλείο: Social media (soc-*) */
    q: 'When did you last post on social media?',
    opts: [
      { label: "I don't have accounts", v: '0' },
      { label: "It's been months", v: '0.5' },
      { label: 'Sometime this month', v: '1' },
      { label: 'This week, on a schedule', v: '2' },
    ],
  },
  {
    key: 'ai',
    /* Εργαλείο: Ορατότητα σε Google & AI (ai-setup/ai-monthly) */
    q: 'Does ChatGPT recommend you?',
    opts: [
      { label: 'No idea', v: '0' },
      { label: 'I tried it — nothing', v: '0.5' },
      { label: 'It finds me, with mistakes', v: '1' },
      { label: 'It recommends me, correctly', v: '2' },
    ],
  },
  /* — Αυτοματοποίηση: πώς δουλεύει το γραφείο — */
  {
    key: 'pay',
    /* Εργαλείο: Αυτόματο ταίριασμα πληρωμών (auto-match) */
    q: 'Which payment settles which invoice — who figures that out?',
    opts: [
      { label: "No one — I don't track it", v: '0' },
      { label: 'Me, whenever I find the time', v: '0.5' },
      { label: 'Me, regularly', v: '1' },
      { label: 'They match on their own', v: '2' },
    ],
  },
  {
    key: 'excel',
    /* Εργαλείο: Οργανωμένο Excel (auto-excel) */
    q: "Last month's revenue — how easily can you find it?",
    opts: [
      { label: 'Not easily — it takes digging', v: '0' },
      { label: 'From scattered files and papers', v: '0.5' },
      { label: 'From a file I keep by hand', v: '1' },
      { label: 'Instantly — it updates itself', v: '2' },
    ],
  },
  {
    key: 'coll',
    /* Εργαλείο: Αυτόματος Κυνηγός Οφειλών (auto-debt) */
    q: 'Who chases the people who owe you money?',
    opts: [
      { label: 'No one — I usually let it go', v: '0' },
      { label: 'Me, whenever I remember', v: '0.5' },
      { label: 'Me, with a list', v: '1' },
      { label: 'A system — I just see who paid', v: '2' },
    ],
  },
  {
    key: 'report',
    /* Εργαλείο: Η Ημέρα σου σε Ένα Μήνυμα (auto-day) */
    q: 'Tonight, do you know what came in, what went out, what’s pending?',
    opts: [
      { label: 'No', v: '0' },
      { label: 'Roughly', v: '0.5' },
      { label: 'Yes — I go through it myself every night', v: '1' },
      { label: 'Yes — a ready-made picture comes to me', v: '2' },
    ],
  },
  {
    key: 'spy',
    /* Εργαλείο: Ο Κατάσκοπός σου (auto-spy) */
    q: 'A competitor launches an offer. When do you find out?',
    opts: [
      { label: 'Probably never', v: '0' },
      { label: 'By chance, from other people', v: '0.5' },
      { label: 'Whenever I go look myself', v: '1' },
      { label: 'Right away — I get an update', v: '2' },
    ],
  },
];
---

<Base
  title="The Dashboard — Measure visibility and automation | PISMA"
  description="10 quick questions, no email: see how easily customers find you and how much your office runs on its own — with scores out of 100."
  schema={schema}
>
  <PageHero
    kicker="The Dashboard"
    sub="10 quick questions — one for each tool. No email, no details: your score appears right in front of you."
  >
    See your <span class="accent">score</span>
  </PageHero>

  <section class="section--tight quiz-section" aria-label="The Dashboard test">
    <div class="container">
      <div class="card quiz reveal" id="tablo-quiz">
        <!-- Πάνω μπάρα: πίσω + πρόοδος -->
        <div class="quiz-top">
          <button class="quiz-back" type="button" id="quiz-back" hidden>← Previous</button>
          <div class="dots" id="quiz-dots" aria-hidden="true">
            {questions.map(() => <span class="dot"></span>)}
          </div>
          <span class="quiz-count num" id="quiz-count">Question 1 of 10</span>
        </div>

        <!-- Βήματα: όλα στο HTML, εναλλαγή με hidden -->
        <div class="quiz-steps" aria-live="polite">
          {questions.map((q, i) => (
            <section class="quiz-step" data-key={q.key} hidden={i !== 0}>
              <h2 class="quiz-q" tabindex="-1">{q.q}</h2>
              <div class="quiz-opts">
                {q.opts.map((o) => (
                  <button type="button" class="opt" data-val={o.v} aria-pressed="false">
                    {o.label}
                  </button>
                ))}
              </div>
            </section>
          ))}

          <!-- Οθόνη αποτελεσμάτων -->
          <section class="quiz-step quiz-result" id="quiz-result" hidden>
            <h2 class="quiz-q" tabindex="-1">Your score</h2>

            <div class="rings">
              <div class="ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ring-bg" cx="60" cy="60" r="52"></circle>
                  <circle class="ring-val" id="ring-vis" cx="60" cy="60" r="52"></circle>
                </svg>
                <span class="ring-num num" id="num-vis" aria-hidden="true">0</span>
                <span class="ring-label">Visibility</span>
              </div>
              <div class="ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ring-bg" cx="60" cy="60" r="52"></circle>
                  <circle class="ring-val" id="ring-auto" cx="60" cy="60" r="52"></circle>
                </svg>
                <span class="ring-num num" id="num-auto" aria-hidden="true">0</span>
                <span class="ring-label">Automation</span>
              </div>
            </div>

            <p class="quiz-verdict" id="quiz-verdict"></p>


            <p class="visually-hidden" id="result-sr"></p>

            <p class="result-next">The next step, whichever way you prefer:</p>
            <div class="result-cta result-cta--two">
              <a class="btn btn--orange" href="/en/pricing/">
                Build your package →
              </a>
              <a class="btn btn--ghost" href="/en/free-assessment/">
                Free {ELEGXOS.minutes}′ assessment with us
              </a>
            </div>
            <p class="btn-note result-note">In the assessment we judge together what you really need — no commitment.</p>
            <div class="result-actions">
              <button type="button" class="btn btn--ghost btn--sm" id="quiz-copy" aria-live="polite">
                Copy your results
              </button>
              <button type="button" class="btn btn--ghost btn--sm" id="quiz-restart">
                ↺ Retake the test
              </button>
            </div>
            <!-- TODO: μελλοντικό email opt-in («στείλε μου το σκορ») — μπαίνει εδώ, με ρητή συγκατάθεση. -->
          </section>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CIRC = 2 * Math.PI * 52;

  const quiz = document.getElementById('tablo-quiz');
  const steps = Array.from(quiz.querySelectorAll('.quiz-step'));
  const qSteps = steps.filter((s) => s.dataset.key);
  const RESULT = qSteps.length; // index της οθόνης αποτελεσμάτων

  const backBtn = document.getElementById('quiz-back');
  const dotsWrap = document.getElementById('quiz-dots');
  const dots = Array.from(dotsWrap.children);
  const countEl = document.getElementById('quiz-count');

  const ringVis = document.getElementById('ring-vis');
  const ringAuto = document.getElementById('ring-auto');
  const numVis = document.getElementById('num-vis');
  const numAuto = document.getElementById('num-auto');
  const resultSr = document.getElementById('result-sr');
  const copyBtn = document.getElementById('quiz-copy');
  const copyLabel = copyBtn.textContent.trim();
  const restartBtn = document.getElementById('quiz-restart');

  let cur = 0;
  const answers = {};
  let last = null; // τελευταία υπολογισμένα αποτελέσματα (για το copy)

  function show(i, moveFocus = true) {
    cur = i;
    steps.forEach((s, idx) => { s.hidden = idx !== i; });
    if (moveFocus) steps[i].querySelector('.quiz-q')?.focus({ preventScroll: true });
    backBtn.hidden = i === 0;
    const isResult = i === RESULT;
    dotsWrap.hidden = isResult;
    countEl.hidden = isResult;
    if (isResult) {
      showResults();
      return;
    }
    dots.forEach((d, di) => {
      d.classList.toggle('dot--now', di === i);
      d.classList.toggle('dot--done', di < i);
    });
    countEl.textContent = 'Question ' + (i + 1) + ' of ' + RESULT;
  }

  qSteps.forEach((s, i) => {
    s.querySelectorAll('.opt').forEach((btn) => {
      btn.addEventListener('click', () => {
        answers[s.dataset.key] = parseFloat(btn.dataset.val);
        s.querySelectorAll('.opt').forEach((b) =>
          b.setAttribute('aria-pressed', String(b === btn))
        );
        window.setTimeout(() => show(i + 1), reduce ? 0 : 180);
      });
    });
  });

  backBtn.addEventListener('click', () => { if (cur > 0) show(cur - 1); });

  function band(v) {
    return v < 40 ? 'c-red' : v < 70 ? 'c-orange' : 'c-ok';
  }

  function countUp(el, target, fmt) {
    if (reduce) { el.textContent = fmt(target); return; }
    const t0 = performance.now();
    const dur = 1000;
    // Δίχτυ ασφαλείας: αν το rAF δεν τρέξει (throttled webviews), η τελική τιμή γράφεται ούτως ή άλλως.
    const failSafe = window.setTimeout(() => { el.textContent = fmt(target); }, dur + 200);
    function tick(t) {
      const p = Math.min((t - t0) / dur, 1);
      const e = 1 - Math.pow(1 - p, 3); // ease-out
      el.textContent = fmt(target * e);
      if (p < 1) requestAnimationFrame(tick);
      else window.clearTimeout(failSafe);
    }
    requestAnimationFrame(tick);
  }

  function setRing(circle, numEl, v) {
    circle.classList.remove('c-red', 'c-orange', 'c-ok');
    circle.classList.add(band(v));
    const off = CIRC * (1 - v / 100);
    if (reduce) {
      circle.style.strokeDashoffset = off;
      numEl.textContent = String(v);
      return;
    }
    circle.style.strokeDashoffset = CIRC;
    requestAnimationFrame(() =>
      requestAnimationFrame(() => { circle.style.strokeDashoffset = off; })
    );
    countUp(numEl, v, (x) => String(Math.round(x)));
  }

  function showResults() {
    const visibility = Math.round(
      ((answers.site + answers.gbp + answers.reviews + answers.social + answers.ai) / 10) * 100
    );
    const automation = Math.round(
      ((answers.excel + answers.pay + answers.coll + answers.report + answers.spy) / 10) * 100
    );
    last = { visibility, automation };

    setRing(ringVis, numVis, visibility);
    setRing(ringAuto, numAuto, automation);
    // Ετυμηγορία: γενική εικόνα + πού είναι το μεγαλύτερο περιθώριο (αν υπάρχει σαφής διαφορά)
    const avg = (visibility + automation) / 2;
    const verdictEl = document.getElementById('quiz-verdict');
    const base =
      avg < 40
        ? 'Most things are still done by hand — or not done at all. Good news: everything you just measured can be fixed.'
        : avg < 70
          ? 'Some things already work — but plenty is still held together by hand and by memory.'
          : 'Good numbers. The steps you are missing are few and specific.';
    const gap = visibility - automation;
    const focus =
      Math.abs(gap) < 15
        ? ''
        : gap < 0
          ? ' Your biggest opportunity: visibility — customers are searching for you there and not finding you.'
          : ' Your biggest opportunity: automation — that is where your hours go every week.';
    verdictEl.textContent = base + focus;
    resultSr.textContent =
      'Visibility ' + visibility + ' out of 100, Automation ' + automation + ' out of 100.';
  }

  copyBtn.addEventListener('click', async () => {
    if (!last) return;
    const text =
      'The PISMA Dashboard — Visibility: ' + last.visibility + '/100 · Automation: ' + last.automation + '/100';
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.textContent = 'Copied ✓';
      window.setTimeout(() => { copyBtn.textContent = copyLabel; }, 2000);
    } catch {
      copyBtn.textContent = 'Copying was not allowed';
      window.setTimeout(() => { copyBtn.textContent = copyLabel; }, 2000);
    }
  });

  restartBtn.addEventListener('click', () => {
    Object.keys(answers).forEach((k) => delete answers[k]);
    last = null;
    quiz.querySelectorAll('.opt').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    [ringVis, ringAuto].forEach((c) => {
      c.classList.remove('c-red', 'c-orange', 'c-ok');
      c.style.strokeDashoffset = CIRC;
    });
    numVis.textContent = '0';
    numAuto.textContent = '0';
    resultSr.textContent = '';
    show(0);
  });

  show(0, false);
</script>

<style>
  .quiz-section { padding-bottom: clamp(64px, 10vw, 120px); }

  /* Μόνο για screen readers */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .quiz {
    max-width: 720px;
    margin-inline: auto;
    padding: clamp(24px, 4vw, 44px);
  }

  /* Πάνω μπάρα */
  .quiz-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    margin-bottom: clamp(20px, 4vw, 32px);
  }
  .quiz-back {
    justify-self: start;
    background: none;
    border: 0;
    cursor: pointer;
    font-weight: 700;
    color: var(--navy);
    padding: 8px 14px;
    border-radius: 999px;
    transition: background-color .15s ease;
  }
  .quiz-back:hover { background: var(--orange-soft); }

  .dots { display: flex; gap: 10px; justify-self: center; }
  .dots[hidden] { display: none; } /* το author display:flex αλλιώς νικάει το hidden */
  .dot {
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--line);
    transition: background-color .25s ease, transform .25s ease;
  }
  .dot--done { background: var(--navy); }
  .dot--now { background: var(--orange); transform: scale(1.3); }

  .quiz-count { justify-self: end; font-size: .82rem; color: var(--muted); }

  /* Ερωτήσεις */
  .quiz-q {
    font-size: clamp(1.25rem, 2.8vw, 1.6rem);
    text-align: center;
    margin-bottom: clamp(20px, 3.5vw, 30px);
  }
  .quiz-opts { display: grid; gap: 12px; }
  .opt {
    text-align: left;
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 16px 20px;
    font-weight: 600;
    font-size: 1.02rem;
    cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease, transform .15s ease;
  }
  .opt:hover { border-color: var(--orange); transform: translateY(-2px); }
  .opt[aria-pressed='true'] {
    border-color: var(--orange);
    background: var(--orange-soft);
    color: var(--navy);
  }

  /* Αποτελέσματα — δαχτυλίδια */
  .rings {
    display: flex;
    justify-content: center;
    gap: clamp(24px, 6vw, 56px);
    flex-wrap: wrap;
    margin-bottom: clamp(24px, 4vw, 36px);
  }
  .ring { position: relative; width: clamp(120px, 18vw, 156px); text-align: center; }
  .ring svg { transform: rotate(-90deg); }
  .ring-bg, .ring-val { fill: none; stroke-width: 10; }
  .ring-bg { stroke: var(--line); }
  .ring-val {
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-dasharray: 326.726;
    stroke-dashoffset: 326.726;
    transition: stroke-dashoffset 1s ease;
  }
  .ring-val.c-red { stroke: var(--red); }
  .ring-val.c-orange { stroke: var(--orange); }
  .ring-val.c-ok { stroke: var(--ok); }
  .ring-num {
    position: absolute;
    top: 33%; left: 0; right: 0;
    font-size: 1.85rem; font-weight: 700; color: var(--navy);
  }
  .ring-label { display: block; margin-top: 10px; font-size: .88rem; color: var(--muted); }

  /* Navy κάρτα κόστους */

  /* CTA αποτελεσμάτων */
  .result-cta { text-align: center; margin-top: 14px; }
  .result-cta--two { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .quiz-verdict {
    text-align: center; max-width: 46ch; margin: 18px auto 0;
    font-weight: 600; color: var(--navy); text-wrap: balance;
  }
  .result-next { text-align: center; margin-top: clamp(22px, 4vw, 30px); color: var(--muted); font-size: .95rem; }
  .result-note { text-align: center; }
  .result-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }
</style>
