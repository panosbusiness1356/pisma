---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, ELEGXOS, eur } from '../config';
import { optionById } from '../data/pricing';

// Μία πηγή αλήθειας για την τιμή: pricing.ts (web-bookings).
const bookings = optionById('web-bookings')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Site με online κρατήσεις',
  serviceType: 'Ιστοσελίδα με σύστημα online κρατήσεων',
  areaServed: SITE.region,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: bookings.price,
    priceCurrency: 'EUR',
    description: `${eur(bookings.price)} εφάπαξ.`,
  },
  description:
    'Ιστοσελίδα όπου οι πελάτες σας κλείνουν ραντεβού ή τραπέζι online και παίρνουν αυτόματη υπενθύμιση — τέλος τα «μου έστησε».',
};

const why = [
  {
    t: 'Κρατήσεις 24 ώρες το 24ωρο',
    d: 'Ο πελάτης κλείνει όποτε τον βολεύει — και τις ώρες που το μαγαζί είναι κλειστό. Εσείς δεν σηκώνετε ούτε τηλέφωνο.',
    icon: 'clock',
  },
  {
    t: 'Αυτόματη υπενθύμιση',
    d: 'Πριν το ραντεβού, ο πελάτης παίρνει υπενθύμιση μόνος του. Τα «ξέχασα» και τα «μου έστησε» λιγοστεύουν αισθητά.',
    icon: 'bell',
  },
  {
    t: 'Το ημερολόγιό σας, πάντα ενήμερο',
    d: 'Κάθε κράτηση μπαίνει μόνη της στο πρόγραμμα. Ανοίγετε το ημερολόγιο και βλέπετε τη μέρα σας — τίποτα με το χέρι.',
    icon: 'cal',
  },
];

const faqItems = [
  {
    q: 'Τι μπορεί να κλείσει ο πελάτης;',
    a: 'Ό,τι έχει ώρα και διάρκεια: ραντεβού για υπηρεσία, τραπέζι, συνεδρία, επίσκεψη. Ορίζουμε μαζί υπηρεσίες, διάρκειες και ωράρια — και το σύστημα δείχνει μόνο τις ώρες που πραγματικά είστε διαθέσιμοι.',
  },
  {
    q: 'Χρειάζεται ο πελάτης εφαρμογή ή λογαριασμό;',
    a: 'Όχι. Κλείνει μέσα από το site σας, από κινητό ή υπολογιστή, σε μισό λεπτό.',
  },
  {
    q: 'Πώς μαθαίνω εγώ την κράτηση;',
    a: 'Έρχεται αμέσως ειδοποίηση και η κράτηση γράφεται στο ημερολόγιό σας. Μπορείτε να την επιβεβαιώσετε, να τη μετακινήσετε ή να την ακυρώσετε — και ο πελάτης ενημερώνεται αυτόματα.',
  },
  {
    q: 'Πόσο κοστίζει;',
    a: `${eur(bookings.price)} εφάπαξ για το site με το σύστημα κρατήσεων. Χωρίς συνδρομές κρυμμένες στη διαδρομή — ό,τι μηνιαίο (π.χ. συντήρηση) είναι προαιρετικό και δημόσια τιμολογημένο στη σελίδα τιμών.`,
  },
  {
    q: 'Έχω ήδη site — μπαίνουν κρατήσεις πάνω του;',
    a: 'Αν στέκει τεχνικά, ναι — προσθέτουμε το σύστημα κρατήσεων πάνω στο υπάρχον. Αλλιώς βλέπετε γραπτά τι κοστίζει το καθένα και αποφασίζετε εσείς.',
  },
];
---

<Base
  title="Site με online κρατήσεις — τέλος τα «μου έστησε» | PISMA"
  description="Ιστοσελίδα όπου οι πελάτες κλείνουν ραντεβού ή τραπέζι online, με αυτόματη υπενθύμιση. Δείτε το ζωντανά — βήμα-βήμα η κράτηση, όπως τη ζει ο πελάτης."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Site με online κρατήσεις"
    sub="Ο πελάτης διαλέγει υπηρεσία, μέρα και ώρα μέσα από το site σας — μέρα ή νύχτα. Εσείς απλώς βλέπετε το ημερολόγιο να γεμίζει."
  >
    Ραντεβού που κλείνονται <span class="accent">μόνα τους</span>
  </PageHero>

  <!-- 2. «Δείτε το ζωντανά» — η σκηνή του laptop (ίδιο pattern με τις άλλες
       σκηνές: τελικό state στο HTML, IO replay, στατικό χωρίς JS). -->
  <section class="section section--tight" aria-labelledby="lp-title">
    <div class="container">
      <div class="lp-grid">
        <div class="lp-copy">
          <div class="sec-head">
            <p class="kicker">Δείτε το ζωντανά</p>
            <h2 id="lp-title">Έτσι το ζει ο πελάτης σας</h2>
          </div>
          <p class="lp-sub">
            Ο πελάτης βλέπει, διαλέγει ώρα και κλείνει — μέρα ή νύχτα, χωρίς
            τηλεφωνήματα. Εσείς απλώς βλέπετε το ημερολόγιο να γεμίζει.
          </p>
          <div class="lp-cta-row">
            <a class="btn btn--orange" href="/times/">Δείτε τιμές για site →</a>
          </div>
          <p class="lp-note">Ενδεικτική απεικόνιση — το δικό σας site στήνεται για τη δική σας δουλειά.</p>
        </div>

        <div class="lp-stage" id="lp-stage" aria-hidden="true">
          <div class="lp-laptop">
            <div class="lp-screen">
              <span class="lp-camdot"></span>
              <div class="lp-page is-dim" id="lp-page">
                <div class="lp-browser">
                  <span class="lp-dots"><i></i><i></i><i></i></span>
                  <span class="lp-url">anna-hair.gr</span>
                </div>
                <div class="lp-body">
                  <div class="lp-part lp-nav is-in">
                    <b>ANNA<span>hair studio</span></b>
                    <span class="lp-links"><i>Υπηρεσίες</i><i>Τιμές</i><i>Επικοινωνία</i></span>
                  </div>
                  <div class="lp-hero">
                    <div class="lp-part lp-hcopy is-in">
                      <p class="lp-h1">Λάμψε από την πρώτη ματιά</p>
                      <p class="lp-hsub">Κούρεμα, βαφή, styling — online κράτηση σε 30 δευτερόλεπτα.</p>
                      <span class="lp-btn" id="lp-cta">Κλείστε ραντεβού</span>
                    </div>
                    <div class="lp-part lp-hart is-in">
                      <img src="/site-demo/salon.jpg" alt="" loading="lazy" width="360" height="290" />
                      <span class="lp-hart-chip">★ 4,9 · 234 κριτικές</span>
                    </div>
                  </div>
                  <div class="lp-cards">
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6.5" r="2.6"/><circle cx="6" cy="17.5" r="2.6"/><path d="M8.3 8.2 20 19.4M8.3 15.8 20 4.6"/></svg>Κούρεμα <b class="num">15€</b></span>
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3.4 4.1 5.8 7.1 5.8 9.9a5.8 5.8 0 1 1-11.6 0c0-2.8 2.4-5.8 5.8-9.9z"/></svg>Βαφή <b class="num">45€</b></span>
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l1.9 5.6 5.6 1.9-5.6 1.9L12 18.5l-1.9-5.6-5.6-1.9 5.6-1.9z"/><path d="M18.8 16.6l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>Styling <b class="num">20€</b></span>
                  </div>
                </div>
                <!-- Βήματα κράτησης: υπηρεσία → ώρα → επιβεβαίωση (μόνο με JS) -->
                <div class="lp-book" id="lp-book">
                  <p class="lp-book-t">Κλείστε ραντεβού</p>
                  <p class="lp-book-l">Υπηρεσία</p>
                  <div class="lp-chips">
                    <span class="lp-chip" id="lp-svc">Κούρεμα</span>
                    <span class="lp-chip">Βαφή</span>
                    <span class="lp-chip">Styling</span>
                  </div>
                  <p class="lp-book-l">Ημέρα</p>
                  <div class="lp-chips">
                    <span class="lp-chip">Πέμπτη</span>
                    <span class="lp-chip" id="lp-day">Παρασκευή</span>
                    <span class="lp-chip">Σάββατο</span>
                    <span class="lp-chip lp-chip--more">Άλλη μέρα ›</span>
                  </div>
                  <p class="lp-book-l">Ώρα</p>
                  <div class="lp-chips">
                    <span class="lp-chip">16:00</span>
                    <span class="lp-chip" id="lp-time">17:30</span>
                    <span class="lp-chip">19:00</span>
                  </div>
                  <span class="lp-confirm" id="lp-confirm">Επιβεβαίωση</span>
                </div>
                <div class="lp-done is-on" id="lp-done">
                  <span class="lp-done-check">✓</span>
                  <p class="lp-done-t">Το ραντεβού κλείστηκε!</p>
                  <p class="lp-done-s">Παρασκευή 17:30 · Κούρεμα</p>
                </div>
                <svg class="lp-cursor" id="lp-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 3.2 19 12.2l-6.6 1.1 3.4 6.4-2.7 1.4-3.4-6.4-4.2 4.6z" fill="#111" stroke="#fff" stroke-width="1.4"/></svg>
              </div>
            </div>
            <div class="lp-base"></div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- 3. Τι κερδίζεις -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--blue">Τι κερδίζετε</p>
        <h2 id="why-title">Λιγότερα τηλέφωνα, λιγότερα «μου έστησε».</h2>
      </div>
      <div class="grid-3">
        {why.map((w) => (
          <article class="card reveal">
            <span class="icon-chip">
              {w.icon === 'clock' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.2 2" />
                </svg>
              )}
              {w.icon === 'bell' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 9.5a6 6 0 0 1 12 0c0 5.2 1.8 6.5 1.8 6.5H4.2S6 14.7 6 9.5" /><path d="M10 19.7a2.2 2.2 0 0 0 4 0" />
                </svg>
              )}
              {w.icon === 'cal' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3.5" y="5" width="17" height="16" rx="2.5" /><path d="M3.5 9.8h17M8 2.8V6M16 2.8V6M8.5 14.5l2.3 2.3 4.4-4.6" />
                </svg>
              )}
            </span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Τιμή -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Τιμή — δημόσια, ίδια για όλους</p>
          <h2 id="price-title">
            <span class="price-num num">{eur(bookings.price)}</span> εφάπαξ
          </h2>
          <p class="price-sub">
            Site και σύστημα κρατήσεων μαζί: υπηρεσίες, ωράρια, αυτόματες
            υπενθυμίσεις, ημερολόγιο. Ό,τι μηνιαίο (π.χ. συντήρηση) είναι
            προαιρετικό — και δημόσια τιμολογημένο.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/times/">Φτιάξτε το πακέτο σας →</a>
          <a class="btn btn--ghost" href="/elegxos/">Δωρεάν Έλεγχος {ELEGXOS.minutes}′</a>
          <span class="btn-note">Καμία πληρωμή online — το κλείνουμε στο τηλέφωνο.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Πριν ρωτήσετε, ρώτησαν άλλοι.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Το επόμενο ραντεβού, ας κλειστεί μόνο του."
    sub={`Ξεκινάμε με τον δωρεάν Έλεγχο PISMA (${ELEGXOS.minutes} λεπτά) — βλέπουμε πώς δουλεύετε και σας δείχνουμε πώς θα δουλέψουν οι κρατήσεις για εσάς.`}
    ctaText="Κλείστε τον δωρεάν Έλεγχο"
    ctaHref="/elegxos/"
    note="Καμία πληρωμή online · χωρίς δέσμευση"
  />
</Base>

<script>
  // Η σκηνή του laptop — μεταφέρθηκε αυτούσια από το /se-vriskoun/.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Στενές οθόνες: η σελίδα μέσα στο laptop αποδίδεται στο πλάτος desktop
  // (496px = 520 − μπεζέλ) και σμικρύνεται με transform — ίδια 16:10 μορφή
  // όπως στον υπολογιστή, αντί να στοιβάζεται καθ' ύψος (ίδιο μοτίβο με το
  // iframe του «Site που πουλάει»).
  const lpFitPage = document.getElementById('lp-page');
  const lpScreen = lpFitPage?.parentElement;
  if (lpFitPage && lpScreen) {
    const DESK = 496;
    const fit = () => {
      const cs = getComputedStyle(lpScreen);
      const inner = lpScreen.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const s = inner / DESK;
      if (s >= 1) {
        lpFitPage.classList.remove('is-fit');
        lpFitPage.style.width = ''; lpFitPage.style.transform = ''; lpFitPage.style.marginBottom = '';
        return;
      }
      lpFitPage.classList.add('is-fit');
      lpFitPage.style.width = `${DESK}px`;
      lpFitPage.style.transform = `scale(${s})`;
      // Το transform δεν αλλάζει το layout — μαζεύουμε το κενό που μένει κάτω
      lpFitPage.style.marginBottom = `${-(lpFitPage.offsetHeight * (1 - s))}px`;
    };
    fit();
    if ('ResizeObserver' in window) new ResizeObserver(fit).observe(lpScreen);
    else window.addEventListener('resize', fit);
  }

  // «Site με online κρατήσεις» (laptop): το HTML έχει το τελικό state (site
  // πλήρες, κράτηση επιβεβαιωμένη). Με JS + ορατότητα, σε loop: η σελίδα
  // χτίζεται κομμάτι-κομμάτι, ο κέρσορας πατά «Κλείσε ραντεβού» και περνάει
  // τα ΒΗΜΑΤΑ της κράτησης — υπηρεσία → ώρα → Επιβεβαίωση → «κλείστηκε».
  // Εκτός οθόνης: τελικό state.
  const lpStage = document.getElementById('lp-stage');
  if (lpStage && !reduce && 'IntersectionObserver' in window) {
    const lpPage = document.getElementById('lp-page')!;
    const lpCta = document.getElementById('lp-cta')!;
    const lpBook = document.getElementById('lp-book')!;
    const lpSvc = document.getElementById('lp-svc')!;
    const lpDay = document.getElementById('lp-day')!;
    const lpTime = document.getElementById('lp-time')!;
    const lpConfirm = document.getElementById('lp-confirm')!;
    const lpDone = document.getElementById('lp-done')!;
    const lpCursor = document.getElementById('lp-cursor')!;
    const lpParts = Array.from(lpStage.querySelectorAll<HTMLElement>('.lp-part'));
    let lpTimers: number[] = [];
    let lpActive = false;
    const lpLater = (fn: () => void, ms: number) => lpTimers.push(window.setTimeout(fn, ms));

    // Ο κέρσορας ταξιδεύει ώστε η μύτη του βέλους να πέφτει πάνω στο στοιχείο
    const lpGo = (el: HTMLElement, ms: number) => {
      const pr = lpPage.getBoundingClientRect();
      const br = el.getBoundingClientRect();
      // Σε σμίκρυνση (.is-fit) τα rects είναι scaled — γυρνάμε σε συντεταγμένες σελίδας
      const k = pr.width / lpPage.offsetWidth || 1;
      lpCursor.style.transition = `opacity .3s ease, left ${ms}ms cubic-bezier(.3, .7, .25, 1), top ${ms}ms cubic-bezier(.3, .7, .25, 1)`;
      lpCursor.style.opacity = '1';
      lpCursor.style.left = `${Math.round((br.left - pr.left + br.width * 0.55) / k)}px`;
      lpCursor.style.top = `${Math.round((br.top - pr.top + br.height * 0.55) / k)}px`;
    };

    const lpFinal = () => {
      lpParts.forEach((p) => p.classList.add('is-in'));
      lpCta.classList.remove('is-press');
      lpConfirm.classList.remove('is-press');
      lpBook.classList.remove('is-on');
      lpSvc.classList.add('is-sel');
      lpDay.classList.add('is-sel');
      lpTime.classList.add('is-sel');
      lpPage.classList.add('is-dim');
      lpDone.classList.add('is-on');
      lpCursor.style.opacity = '0';
    };

    const lpCycle = () => {
      lpTimers.forEach(clearTimeout); lpTimers = [];
      // Επαναφορά: άδεια σελίδα, κέρσορας κάτω-δεξιά, τίποτα επιλεγμένο
      lpParts.forEach((p) => p.classList.remove('is-in'));
      lpCta.classList.remove('is-press');
      lpConfirm.classList.remove('is-press');
      lpBook.classList.remove('is-on');
      lpSvc.classList.remove('is-sel');
      lpDay.classList.remove('is-sel');
      lpTime.classList.remove('is-sel');
      lpPage.classList.remove('is-dim');
      lpDone.classList.remove('is-on');
      lpCursor.style.transition = 'none';
      lpCursor.style.opacity = '0';
      lpCursor.style.left = `${Math.round(lpPage.offsetWidth - 34)}px`;
      lpCursor.style.top = `${Math.round(lpPage.offsetHeight - 30)}px`;
      // Η σελίδα «χτίζεται» κομμάτι-κομμάτι
      lpLater(() => {
        lpParts.forEach((p, i) => lpLater(() => p.classList.add('is-in'), i * 220));
      }, 600);
      // 1) Κλικ στο «Κλείσε ραντεβού» → ανοίγει η φόρμα βημάτων
      lpLater(() => lpGo(lpCta, 1000), 3200);
      lpLater(() => lpCta.classList.add('is-press'), 4400);
      lpLater(() => lpCta.classList.remove('is-press'), 4700);
      lpLater(() => { lpPage.classList.add('is-dim'); lpBook.classList.add('is-on'); }, 5000);
      // 2) Επιλογή υπηρεσίας
      lpLater(() => lpGo(lpSvc, 850), 5800);
      lpLater(() => lpSvc.classList.add('is-sel'), 6900);
      // 3) Επιλογή ημέρας
      lpLater(() => lpGo(lpDay, 850), 7400);
      lpLater(() => lpDay.classList.add('is-sel'), 8500);
      // 4) Επιλογή ώρας
      lpLater(() => lpGo(lpTime, 850), 9000);
      lpLater(() => lpTime.classList.add('is-sel'), 10100);
      // 5) Επιβεβαίωση → «Το ραντεβού κλείστηκε!»
      lpLater(() => lpGo(lpConfirm, 850), 10600);
      lpLater(() => lpConfirm.classList.add('is-press'), 11700);
      lpLater(() => lpConfirm.classList.remove('is-press'), 12000);
      lpLater(() => {
        lpBook.classList.remove('is-on');
        lpDone.classList.add('is-on');
        lpCursor.style.opacity = '0';
      }, 12400);
      // Δίχτυ ασφαλείας: κλείδωμα στο στατικό state
      lpLater(lpFinal, 16800);
      lpLater(lpCycle, 18600);
    };

    const lpIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !lpActive) { lpActive = true; lpCycle(); }
          else if (!e.isIntersecting && lpActive) {
            lpActive = false;
            lpTimers.forEach(clearTimeout); lpTimers = [];
            lpFinal();
          }
        }
      },
      { threshold: 0.35 }
    );
    lpIo.observe(lpStage);
  }
</script>

<style>
  /* ---------- «Site με online κρατήσεις» — laptop ---------- */
  /* Δίστηλη διάταξη σε desktop (κείμενο αριστερά, laptop δεξιά), στοίβαγμα
     σε στενές οθόνες — ίδιο μοτίβο με την ενότητα κριτικών της αρχικής. */
  .lp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
    max-width: 1020px; margin-inline: auto;
  }
  .lp-copy .sec-head { margin-bottom: 0; }
  .lp-sub { color: var(--muted); max-width: 44ch; margin: 16px 0 26px; }
  .lp-cta-row { display: flex; }
  .lp-note { color: var(--muted); font-size: .78rem; margin: 14px 0 0; max-width: 42ch; }
  @media (max-width: 960px) {
    /* minmax(0,1fr): το σμικρυμένο .lp-page (496px layout box) δεν πρέπει
       να μετρήσει ως min-content και να ανοίξει το mobile viewport. */
    .lp-grid { grid-template-columns: minmax(0, 1fr); }
    /* width:100% (όχι το σταθερό 520px): μέσα σε 1fr track το fixed πλάτος
