---
import Guide from '../../layouts/Guide.astro';
import Tiles from '../../components/guide/Tiles.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const aiSetup = optionById('ai-setup')!;
const aiMonthly = optionById('ai-monthly')!;

const faq = [
  {
    q: 'Μπορώ να πληρώσω το ChatGPT για να με προτείνει;',
    a: 'Όχι με τον τρόπο που αγοράζετε διαφήμιση στη Google. Ο δρόμος είναι να είναι καθαρά, συνεπή και ενημερωμένα όσα υπάρχουν δημόσια για την επιχείρησή σας.',
  },
  {
    q: 'Χρειάζομαι οπωσδήποτε site για να με βρίσκουν τα AI;',
    a: 'Βοηθάει πολύ, γιατί είναι η μόνη πηγή που ελέγχετε πλήρως εσείς. Χωρίς site, τα AI βασίζονται μόνο σε ό,τι λένε τρίτοι για εσάς.',
  },
  {
    q: 'Σε πόσο καιρό θα δω διαφορά;',
    a: `Δεν υπάρχει εγγυημένο χρονοδιάγραμμα, και όποιος το υπόσχεται υπερβάλλει. Γι’ αυτό στην PISMA μετράμε πού στέκεστε πριν ξεκινήσετε, στον δωρεάν Έλεγχο των ${ELEGXOS.minutes} λεπτών, και ξαναμετράμε στους 3 μήνες.`,
  },
  {
    q: 'Το SEO που έχω ήδη κάνει πάει χαμένο;',
    a: 'Όχι. Ό,τι βοηθάει τη Google βοηθάει και τα AI. Απλώς τα AI δίνουν παραπάνω βάρος σε καθαρές απαντήσεις και σε στοιχεία που συμφωνούν παντού.',
  },
  {
    q: 'Τι είναι το GEO και το AEO που ακούω;',
    a: 'Είναι οι όροι για τη βελτιστοποίηση ώστε να εμφανίζεστε στις απαντήσεις των AI, όπως το SEO είναι για τη Google. Στην πράξη πατάνε στην ίδια βάση: καθαρό site, σωστά στοιχεία, καλές κριτικές.',
  },
];
---

<Guide
  title="Πώς θα σας προτείνει το ChatGPT; | PISMA"
  description="Τα AI προτείνουν επιχειρήσεις με καθαρό site, ενημερωμένο προφίλ Google, κριτικές και ίδια στοιχεία παντού. Δείτε τι μπορείτε να κάνετε από σήμερα."
  slug="na-se-proteinei-to-chatgpt"
  question="Πώς θα σας προτείνει το ChatGPT;"
  sub="Για τον ιδιοκτήτη επιχείρησης που θέλει να τον βρίσκουν και όσοι ρωτάνε AI, όχι μόνο η Google."
  updated="2026-09-10"
  faq={faq}
>
  <h2>Ρωτάνε όντως οι πελάτες το ChatGPT;</h2>
  <Tiles cols={2} items={[
    { icon: 'message', t: 'Ναι, και όλο περισσότερο', d: '«Πού να φάω κοντά μου», «καλός υδραυλικός στη γειτονιά».' },
    { icon: 'alert', t: 'Δεν υπάρχει δεύτερη σελίδα', d: 'Ή είστε στα ονόματα που προτείνει, ή δεν υπάρχετε.' },
  ]} />

  <h2>Από πού μαθαίνει για εσάς;</h2>
  <Tiles items={[
    { icon: 'globe', t: 'Το site σας', d: 'Τι κάνετε, πού, για ποιον.' },
    { icon: 'pin', t: 'Το προφίλ Google', d: 'Χάρτης, ώρες, φωτογραφίες.' },
    { icon: 'star', t: 'Οι κριτικές', d: 'Τι γράφουν οι πελάτες για εσάς.' },
  ]} />

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Ορατότητα σε Google & AI: setup {eur(aiSetup.price)} εφάπαξ, διαχείριση {eur(aiMonthly.price)} τον μήνα,
    με μηνιαίο report και χωρίς δέσμευση. Δείτε τη <a href="/se-vriskoun/">Ψηφιακή Προβολή</a>.
  </p>
</Guide>
