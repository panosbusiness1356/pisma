---
import Guide from '../../layouts/Guide.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const match = optionById('auto-match')!;
const excel = optionById('auto-excel')!;
const day = optionById('auto-day')!;
const debt = optionById('auto-debt')!;
const spy = optionById('auto-spy')!;
const reviews = optionById('auto-reviews')!;
const care = optionById('care-web')!;

const faq = [
  {
    q: 'Χρειάζεται να μάθω κάποιο νέο πρόγραμμα;',
    a: 'Όχι. Οι αυτοματισμοί δουλεύουν με τα εργαλεία που ήδη χρησιμοποιείς — εσύ βλέπεις μόνο το αποτέλεσμα, συνήθως ως μήνυμα ή αρχείο.',
  },
  {
    q: 'Μπορώ να πάρω μόνο έναν αυτοματισμό;',
    a: 'Ναι. Κάθε αυτοματισμός είναι ξεχωριστός — διαλέγεις όσους σου χρειάζονται, έναν ή περισσότερους.',
  },
  {
    q: 'Δεσμεύομαι με συμβόλαιο;',
    a: 'Όχι. Οι μηνιαίοι αυτοματισμοί δεν έχουν δέσμευση — τους σταματάς όποτε θέλεις.',
  },
  {
    q: 'Τι γίνεται αν κάτι σταματήσει να δουλεύει;',
    a: 'Το φτιάχνουμε εμείς. Αυτό καλύπτει η υποστήριξη των μηνιαίων υπηρεσιών.',
  },
  {
    q: 'Πόσο κοστίζει ένας αυτοματισμός;',
    a: `Οι μικρότεροι μηνιαίοι ξεκινούν από ${eur(day.price)} τον μήνα. Οι εφάπαξ, όπως το Οργανωμένο Excel, από ${eur(excel.price)}.`,
  },
];
---

<Guide
  title="Τι είναι οι αυτοματισμοί γραφείου; | PISMA"
  description="Αυτοματισμός σημαίνει ότι μια δουλειά ρουτίνας του γραφείου γίνεται μόνη της — ταίριασμα πληρωμών, υπενθυμίσεις οφειλών, αναφορές. Δες τι κάνει ο καθένας."
  slug="ti-einai-oi-aftomatismoi"
  question="Τι είναι οι αυτοματισμοί γραφείου;"
  sub="Τι κάνει ο καθένας, με απλά λόγια — για ιδιοκτήτες επιχειρήσεων, όχι για τεχνικούς."
  answer="Αυτοματισμός είναι ένα μικρό σύστημα που αναλαμβάνει μια δουλειά ρουτίνας του γραφείου και την κάνει μόνο του, κάθε φορά, χωρίς να το σκέφτεσαι: ταιριάζει πληρωμές με τιμολόγια, στέλνει υπενθυμίσεις σε όσους χρωστάνε, ενημερώνει το Excel, σου στέλνει αναφορά. Εσύ βλέπεις μόνο το αποτέλεσμα."
  updated="2026-07-28"
  faq={faq}
>
  <h2>Τι σημαίνει «αυτοματισμός» στην πράξη;</h2>
  <p>
    Σημαίνει ότι μια δουλειά που σήμερα κάνεις εσύ με το χέρι — ξανά και ξανά, κάθε μέρα ή κάθε
    εβδομάδα — γίνεται πλέον από ένα σύστημα, πάντα με τον ίδιο τρόπο και πάντα στην ώρα της.
  </p>
  <p>
    Δεν χρειάζεται να μάθεις κάτι καινούργιο και δεν αλλάζεις τον τρόπο που δουλεύεις.
    Ο αυτοματισμός στήνεται μία φορά, δουλεύει με τα εργαλεία που ήδη έχεις, και εσύ βλέπεις
    μόνο το αποτέλεσμα: ένα μήνυμα, ένα ενημερωμένο αρχείο, μια αναφορά.
  </p>

  <h2>Ποιους αυτοματισμούς φτιάχνει η PISMA;</h2>
  <p>Έξι, ο καθένας για μια συγκεκριμένη δουλειά. Με μία πρόταση ο καθένας:</p>
  <ul>
    <li>
      <strong>{match.label}</strong> — κάθε πληρωμή που μπαίνει στον λογαριασμό βρίσκει μόνη της
      το τιμολόγιό της. ({eur(match.price)} εφάπαξ)
    </li>
    <li>
      <strong>{excel.label}</strong> — οι κινήσεις σου μαζεύονται σε ένα καθαρό Excel που
      ενημερώνεται μόνο του. ({eur(excel.price)} εφάπαξ)
    </li>
    <li>
      <strong>{day.label}</strong> — κάθε απόγευμα λαμβάνεις ένα μήνυμα: τι μπήκε, τι βγήκε,
      τι εκκρεμεί. ({eur(day.price)} τον μήνα)
    </li>
    <li>
      <strong>{debt.label}</strong> — όσοι σου χρωστάνε παίρνουν ευγενική υπενθύμιση αυτόματα,
      τη σωστή στιγμή. Εσύ βλέπεις μόνο ποιος πλήρωσε. ({eur(debt.price)} τον μήνα)
    </li>
    <li>
      <strong>{spy.label}</strong> — λαμβάνεις τακτική αναφορά με το τι κάνει ο ανταγωνισμός:
      τιμές, προσφορές, παρουσία. ({eur(spy.price)} τον μήνα)
    </li>
    <li>
      <strong>{reviews.label}</strong> — κάθε ευχαριστημένος πελάτης παίρνει το link για κριτική
      στο Google τη σωστή στιγμή. ({eur(reviews.price)} τον μήνα)
    </li>
  </ul>
  <p>
    Περισσότερα για το πώς δένουν όλα μαζί θα δεις στη σελίδα
    <a href="/doulevei-mono-tou/">Αυτοματοποίηση</a>. Για τις κριτικές ειδικά, υπάρχει και
    ξεχωριστός οδηγός: <a href="/odigoi/perissoteres-kritikes-google/">πώς θα πάρεις περισσότερες κριτικές</a>.
  </p>

  <h2>Πληρώνεις μία φορά ή κάθε μήνα;</h2>
  <p>
    Εξαρτάται από τον αυτοματισμό. Όσοι στήνονται μία φορά και μετά απλώς υπάρχουν
    (όπως το {excel.label}) πληρώνονται εφάπαξ. Όσοι δουλεύουν συνέχεια για σένα
    (υπενθυμίσεις, αναφορές, κριτικές) έχουν μικρή μηνιαία τιμή — και τους σταματάς όποτε θέλεις,
    χωρίς συμβόλαιο.
  </p>
  <p>
    Όλες οι τιμές είναι δημόσιες, στη <a href="/times/">σελίδα τιμών</a> — εκεί διαλέγεις
    όσους θέλεις και βλέπεις το σύνολο.
  </p>

  <h2>Πού ταιριάζουν οι αυτοματισμοί στη δική σου δουλειά;</h2>
  <p>
    Ένας απλός τρόπος να το σκεφτείς: ποια δουλειά κάνεις κάθε εβδομάδα που είναι ίδια και
    βαρετή; Το ψάξιμο ποιας πληρωμής είναι ποιο τιμολόγιο; Τα τηλέφωνα σε όσους καθυστερούν;
    Το πέρασμα κινήσεων σε Excel; Αν κάτι από αυτά σου τρώει ώρες, υπάρχει αυτοματισμός γι' αυτό.
  </p>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Αν δεν ξέρεις από πού να ξεκινήσεις, ο <a href="/elegxos/">δωρεάν Έλεγχος</a> είναι το πρώτο
    βήμα: σε {ELEGXOS.minutes} λεπτά καταγράφουμε μαζί ποιες δουλειές ρουτίνας σου τρώνε χρόνο
    και ποιοι αυτοματισμοί έχουν νόημα για σένα — γραπτά, με προτεραιότητες, χωρίς καμία δέσμευση.
  </p>
</Guide>
