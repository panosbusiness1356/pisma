---
import Guide from '../../layouts/Guide.astro';
import Tiles from '../../components/guide/Tiles.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const match = optionById('auto-match')!;
const excel = optionById('auto-excel')!;
const day = optionById('auto-day')!;
const debt = optionById('auto-debt')!;
const spy = optionById('auto-spy')!;
const reviews = optionById('auto-reviews')!;
const loyalty = optionById('auto-loyalty')!;
const menu = optionById('auto-menu')!;

const faq = [
  {
    q: 'Χρειάζεται να μάθω κάποιο νέο πρόγραμμα;',
    a: 'Όχι. Οι αυτοματισμοί δουλεύουν με τα εργαλεία που ήδη χρησιμοποιείτε. Εσείς βλέπετε μόνο το αποτέλεσμα, συνήθως ως μήνυμα ή αρχείο.',
  },
  {
    q: 'Μπορώ να πάρω μόνο έναν αυτοματισμό;',
    a: 'Ναι. Κάθε αυτοματισμός είναι ξεχωριστός: διαλέγετε όσους σας χρειάζονται, έναν ή περισσότερους.',
  },
  {
    q: 'Δεσμεύομαι με συμβόλαιο;',
    a: 'Όχι. Οι μηνιαίοι αυτοματισμοί δεν έχουν δέσμευση και τους σταματάτε όποτε θέλετε.',
  },
  {
    q: 'Τι γίνεται αν κάτι σταματήσει να δουλεύει;',
    a: 'Το φτιάχνουμε εμείς. Αυτό καλύπτει η υποστήριξη των μηνιαίων υπηρεσιών.',
  },
  {
    q: 'Πόσο κοστίζει ένας αυτοματισμός;',
    a: `Οι μικρότεροι μηνιαίοι ξεκινούν από ${eur(day.price)} τον μήνα. Οι εφάπαξ, όπως το Οργανωμένο Excel, από ${eur(excel.price)}.`,
  },
];
---

<Guide
  title="Τι είναι οι αυτοματισμοί γραφείου; | PISMA"
  description="Αυτοματισμός σημαίνει ότι μια δουλειά ρουτίνας του γραφείου γίνεται μόνη της: ταίριασμα πληρωμών, υπενθυμίσεις οφειλών, αναφορές. Δείτε τι κάνει ο καθένας."
  slug="ti-einai-oi-aftomatismoi"
  question="Τι είναι οι αυτοματισμοί γραφείου;"
  sub="Τι κάνει ο καθένας, εξηγημένο για ιδιοκτήτες επιχειρήσεων, χωρίς τεχνικούς όρους."
  updated="2026-09-10"
  faq={faq}
>
  <h2>Τι σημαίνει;</h2>
  <Tiles items={[
    { icon: 'clock', t: 'Η ίδια δουλειά, μόνη της', d: 'Ό,τι κάνετε με το χέρι ξανά και ξανά.' },
    { icon: 'link', t: 'Με τα προγράμματα που έχετε', d: 'Δεν αλλάζετε τίποτα.' },
    { icon: 'message', t: 'Βλέπετε μόνο το αποτέλεσμα', d: 'Ένα μήνυμα, ένα αρχείο, μια αναφορά.' },
  ]} />

  <h2>Τι φτιάχνει η PISMA;</h2>
  <Tiles cols={2} items={[
    { icon: 'bolt', t: 'Αυτοματισμοί κατά παραγγελία', d: 'Ό,τι χρειάζεται η δική σας ρουτίνα.' },
    { icon: 'check', t: match.label, d: `Κάθε πληρωμή βρίσκει μόνη της το τιμολόγιό της. ${eur(match.price)} εφάπαξ.` },
    { icon: 'list', t: excel.label, d: `Οι κινήσεις σας σε ένα Excel που ενημερώνεται μόνο του. ${eur(excel.price)} εφάπαξ.` },
    { icon: 'message', t: debt.label, d: `Ευγενικές υπενθυμίσεις, αυτόματα. ${eur(debt.price)} τον μήνα.` },
    { icon: 'eye', t: spy.label, d: `Τι κάνει ο ανταγωνισμός, σε τακτική αναφορά. ${eur(spy.price)} τον μήνα.` },
    { icon: 'tag', t: menu.label, d: `QR στο τραπέζι, μενού στο κινητό. ${eur(menu.price)} τον μήνα.` },
  ]} />

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Τιμές στη <a href="/times/">σελίδα τιμών</a>, χωρίς συμβόλαιο. Ή ξεκινήστε από τον
    <a href="/elegxos/">δωρεάν Έλεγχο</a> των {ELEGXOS.minutes} λεπτών.
  </p>
</Guide>
