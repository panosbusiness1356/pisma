---
import Guide from '../../layouts/Guide.astro';
import Tiles from '../../components/guide/Tiles.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const aiSetup = optionById('ai-setup')!;
const aiMonthly = optionById('ai-monthly')!;

const faq = [
  {
    q: 'Σε πόσο καιρό φαίνονται τα αποτελέσματα του SEO;',
    a: 'Το SEO θέλει χρόνο: μιλάμε για μήνες, όχι για μέρες. Γι’ αυτό στην PISMA μετράμε πού ξεκινάτε και επαναμετράμε στους 3 μήνες, για να δείτε τη διαφορά με νούμερα.',
  },
  {
    q: 'Χρειάζομαι οπωσδήποτε site για να κάνω SEO;',
    a: 'Για τοπικές αναζητήσεις, ένα σωστό προφίλ Google βοηθάει και μόνο του. Ένα site όμως σάς δίνει χώρο να απαντάτε τις ερωτήσεις των πελατών, και εκεί κρίνονται τα περισσότερα.',
  },
  {
    q: 'Το SEO γίνεται μία φορά και τελείωσε;',
    a: 'Όχι. Υπάρχει ένα αρχικό στήσιμο, αλλά μετά θέλει φροντίδα: η Google αλλάζει, ο ανταγωνισμός κινείται και οι ερωτήσεις των πελατών εξελίσσονται.',
  },
  {
    q: 'Το SEO είναι το ίδιο με το AEO και το GEO;',
    a: 'Η λογική είναι ίδια: να σας βρίσκουν όταν σας χρειάζονται. Το AEO/GEO φροντίζει να σας προτείνουν και τα εργαλεία AI, όπως το ChatGPT, όχι μόνο η Google.',
  },
  {
    q: 'Πόσο κοστίζει το SEO στην PISMA;',
    a: `Η υπηρεσία «Ορατότητα σε Google & AI» έχει αρχικό setup ${eur(aiSetup.price)} εφάπαξ και μηνιαία διαχείριση ${eur(aiMonthly.price)} τον μήνα, χωρίς δέσμευση ή συμβόλαιο.`,
  },
];
---

<Guide
  title="Τι είναι το SEO; | PISMA"
  description="SEO σημαίνει να σας βρίσκουν στη Google όσοι σας χρειάζονται, χωρίς να πληρώνετε διαφήμιση. Δείτε τι μετράει για την επιχείρησή σας και τι αλλάζει με το AI."
  slug="seo-me-apla-logia"
  question="Τι είναι το SEO;"
  sub="Για ιδιοκτήτες επιχειρήσεων που ακούνε συνέχεια «SEO» και θέλουν επιτέλους να καταλάβουν τι είναι, χωρίς τεχνικά."
  updated="2026-09-10"
  faq={faq}
>
  <h2>SEO ή διαφήμιση;</h2>
  <Tiles cols={2} items={[
    { icon: 'euro', t: 'Διαφήμιση', d: 'Πληρώνετε για κάθε εμφάνιση. Σταματάτε, εξαφανίζεστε.' },
    { icon: 'chart', t: 'SEO', d: 'Χτίζεται μία φορά και συνεχίζει να φέρνει κόσμο. Μένει δικό σας.' },
  ]} />

  <h2>Τι κοιτάει η Google;</h2>
  <Tiles items={[
    { icon: 'text', t: 'Σελίδες που απαντούν', d: 'Σε αυτό που ψάχνει ο πελάτης.' },
    { icon: 'phone', t: 'Ταχύτητα και κινητό', d: 'Αν αργεί, ο πελάτης φεύγει.' },
    { icon: 'star', t: 'Προφίλ Google και κριτικές', d: 'Το πρώτο που βλέπει ο πελάτης.' },
  ]} />

  <h2>Τι αλλάζει με το AI;</h2>
  <Tiles cols={2} items={[
    { icon: 'bot', t: 'Μία απάντηση, όχι λίστα', d: 'Το ChatGPT προτείνει λίγα ονόματα. Δεν υπάρχει «δεύτερη σελίδα».' },
    { icon: 'link', t: 'Ίδιες πηγές', d: 'Ό,τι μετράει για τη Google μετράει και για το AI.' },
  ]} />

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Ορατότητα σε Google & AI: setup {eur(aiSetup.price)} εφάπαξ, διαχείριση {eur(aiMonthly.price)} τον μήνα,
    με μηνιαίο report και χωρίς δέσμευση. Ή ξεκινήστε από τον <a href="/elegxos/">δωρεάν Έλεγχο</a> των {ELEGXOS.minutes} λεπτών.
  </p>
</Guide>
