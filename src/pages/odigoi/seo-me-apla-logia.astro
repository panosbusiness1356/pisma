---
import Guide from '../../layouts/Guide.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const aiSetup = optionById('ai-setup')!;
const aiMonthly = optionById('ai-monthly')!;

const faq = [
  {
    q: 'Σε πόσο καιρό φαίνονται τα αποτελέσματα του SEO;',
    a: 'Το SEO θέλει χρόνο — μιλάμε για μήνες, όχι για μέρες. Γι’ αυτό στην PISMA μετράμε πού ξεκινάς και επαναμετράμε στους 3 μήνες, για να δεις τη διαφορά με νούμερα.',
  },
  {
    q: 'Χρειάζομαι οπωσδήποτε site για να κάνω SEO;',
    a: 'Για τοπικές αναζητήσεις, ένα σωστό προφίλ Google βοηθάει και μόνο του. Ένα site όμως σού δίνει χώρο να απαντάς τις ερωτήσεις των πελατών — και εκεί κρίνονται τα περισσότερα.',
  },
  {
    q: 'Το SEO γίνεται μία φορά και τελείωσε;',
    a: 'Όχι. Υπάρχει ένα αρχικό στήσιμο, αλλά μετά θέλει φροντίδα: η Google αλλάζει, ο ανταγωνισμός κινείται και οι ερωτήσεις των πελατών εξελίσσονται.',
  },
  {
    q: 'Το SEO είναι το ίδιο με το AEO και το GEO;',
    a: 'Η λογική είναι ίδια — να σε βρίσκουν όταν σε χρειάζονται. Το AEO/GEO φροντίζει να σε προτείνουν και τα εργαλεία AI, όπως το ChatGPT, όχι μόνο η Google.',
  },
  {
    q: 'Πόσο κοστίζει το SEO στην PISMA;',
    a: `Η υπηρεσία «Ορατότητα σε Google & AI» έχει αρχικό setup ${eur(aiSetup.price)} εφάπαξ και μηνιαία διαχείριση ${eur(aiMonthly.price)} τον μήνα — χωρίς δέσμευση ή συμβόλαιο.`,
  },
];
---

<Guide
  title="Τι είναι το SEO — με απλά λόγια; | PISMA"
  description="SEO σημαίνει να σε βρίσκουν στο Google όσοι σε χρειάζονται, χωρίς να πληρώνεις διαφήμιση. Δες τι μετράει για μια μικρή επιχείρηση και τι αλλάζει με το AI."
  slug="seo-me-apla-logia"
  question="Τι είναι το SEO — με απλά λόγια;"
  sub="Για ιδιοκτήτες μικρών επιχειρήσεων που ακούνε συνέχεια «SEO» και θέλουν επιτέλους να καταλάβουν τι είναι — χωρίς τεχνικά."
  answer="SEO (Search Engine Optimization) σημαίνει να φτιάχνεις το site και το προφίλ σου έτσι, ώστε η Google να σε δείχνει όταν κάποιος ψάχνει αυτό που προσφέρεις — χωρίς να πληρώνεις για διαφήμιση. Η Google προτείνει τις σελίδες που απαντούν πιο καλά και πιο αξιόπιστα στην ερώτηση του χρήστη· η δουλειά του SEO είναι να γίνεις εσύ αυτή η απάντηση. Το ίδιο πλέον ισχύει και για τα εργαλεία AI, όπως το ChatGPT, που προτείνουν επιχειρήσεις με παρόμοια λογική."
  updated="2026-07-28"
  faq={faq}
>
  <h2>Τι σημαίνει SEO και σε τι διαφέρει από τη διαφήμιση;</h2>
  <p>
    SEO σημαίνει Search Engine Optimization — στα ελληνικά, «βελτιστοποίηση για τις μηχανές
    αναζήτησης». Με απλά λόγια: να στήσεις την παρουσία σου στο internet έτσι, ώστε όταν κάποιος
    ψάχνει «ηλεκτρολόγος κοντά μου» ή «πού να φάω πίτσα», να εμφανίζεσαι εσύ.
  </p>
  <p>
    Η διαφορά από τη διαφήμιση είναι απλή: στη διαφήμιση πληρώνεις για κάθε εμφάνιση, και μόλις
    σταματήσεις να πληρώνεις, εξαφανίζεσαι. Το SEO είναι δουλειά που χτίζεται — σελίδες, προφίλ,
    κριτικές — και συνεχίζει να φέρνει κόσμο χωρίς να «τρέχει» κάποιο μετρητή. Θέλει περισσότερο
    χρόνο από τη διαφήμιση, αλλά ό,τι χτίζεις μένει δικό σου.
  </p>

  <h2>Πώς «σκέφτεται» η Google;</h2>
  <p>
    Η Google είναι, στην ουσία, μια μηχανή που απαντά ερωτήσεις. Κάθε αναζήτηση είναι μια ερώτηση —
    ακόμα κι όταν δεν έχει ερωτηματικό — και η Google θέλει να δείξει πρώτη τη σελίδα που δίνει την
    πιο χρήσιμη και αξιόπιστη απάντηση.
  </p>
  <p>Για να το αποφασίσει, κοιτάζει πράγματα όπως:</p>
  <ul>
    <li><strong>Τι απαντά η σελίδα σου</strong> — μιλάει καθαρά για αυτό που ψάχνει ο χρήστης, ή είναι γενικόλογη;</li>
    <li><strong>Πόσο εύκολα διαβάζεται</strong> — φορτώνει γρήγορα, δουλεύει σωστά στο κινητό;</li>
    <li><strong>Αν σε εμπιστεύονται άλλοι</strong> — κριτικές, αναφορές, ένα ενημερωμένο προφίλ.</li>
  </ul>
  <p>
    Δεν χρειάζεται να «ξεγελάσεις» τη Google — αυτό άλλωστε δεν δουλεύει πια. Χρειάζεται να είσαι
    πραγματικά η καλύτερη απάντηση για τους πελάτες της περιοχής σου.
  </p>

  <h2>Τι μετράει πραγματικά για μια μικρή επιχείρηση;</h2>
  <p>
    Δεν χρειάζεσαι όλα όσα κάνουν οι μεγάλες εταιρείες. Για μια μικρή επιχείρηση, τα βασικά είναι
    τέσσερα:
  </p>
  <ul>
    <li>
      <strong>Σελίδες που απαντούν ερωτήσεις.</strong> Μία σελίδα για κάθε βασική ερώτηση που κάνουν
      οι πελάτες σου — τι προσφέρεις, πού, πώς δουλεύεις. Όχι ένα site-βιτρίνα που λέει μόνο
      «καλώς ήρθατε».
    </li>
    <li>
      <strong>Ταχύτητα και κινητό.</strong> Οι περισσότεροι πελάτες σε ψάχνουν από το κινητό. Αν το
      site αργεί ή δεν διαβάζεται εκεί, φεύγουν πριν καν δουν τι κάνεις.
    </li>
    <li>
      <strong>Προφίλ Google και κριτικές.</strong> Για τοπικές αναζητήσεις, το
      <a href="/odigoi/profil-google-maps/">προφίλ σου στο Google και τους Χάρτες</a> είναι συχνά το
      πρώτο πράγμα που βλέπει ο πελάτης — πριν καν το site.
    </li>
    <li>
      <strong>Συνέπεια στοιχείων.</strong> Ίδιο όνομα, ίδια διεύθυνση, ίδιο τηλέφωνο παντού — στο
      site, στο προφίλ Google, στα social. Οι μηχανές μπερδεύονται με τις ασυμφωνίες, και οι
      πελάτες ακόμα περισσότερο.
    </li>
  </ul>

  <h2>Τι αλλάζει με το AI — τι είναι το AEO και το GEO;</h2>
  <p>
    Το νέο κεφάλαιο είναι ότι οι πελάτες δεν ψάχνουν πια μόνο στο Google — ρωτούν και εργαλεία AI,
    όπως το ChatGPT: «πού να πάω για φρένα στη Γλυφάδα;». Και το AI δεν δίνει μια μεγάλη λίστα με
    links — δίνει μία απάντηση, με λίγες συγκεκριμένες προτάσεις επιχειρήσεων.
  </p>
  <p>
    Εδώ μπαίνουν δύο νέοι όροι: AEO (Answer Engine Optimization) και GEO (Generative Engine
    Optimization) — δηλαδή, να είσαι μέσα στις απαντήσεις που δίνουν τα AI. Τα καλά νέα: ό,τι κάνεις
    σωστά για το SEO βοηθάει και εδώ, γιατί τα AI μαθαίνουν από τις ίδιες πηγές — το site σου, το
    προφίλ σου, τις κριτικές σου. Γράψαμε ξεχωριστό οδηγό για το
    <a href="/odigoi/na-se-proteinei-to-chatgpt/">πώς να σε προτείνει το ChatGPT</a>.
  </p>

  <h2>Τι μπορείς να κάνεις μόνος σου σήμερα;</h2>
  <p>Πριν πληρώσεις οτιδήποτε, κάνε αυτά — είναι δωρεάν και θέλουν μόνο λίγο χρόνο:</p>
  <ol>
    <li>Ψάξε στο Google την υπηρεσία σου και την περιοχή σου, όπως θα το έγραφε πελάτης. Βγαίνεις; Πού;</li>
    <li>Ρώτα και το ChatGPT το ίδιο πράγμα. Σε αναφέρει; Ποιους προτείνει;</li>
    <li>Συμπλήρωσε πλήρως το προφίλ σου στο Google: ωράριο, φωτογραφίες, υπηρεσίες, περιγραφή.</li>
    <li>Έλεγξε ότι όνομα, διεύθυνση και τηλέφωνο είναι ολόιδια σε site, Google και social.</li>
    <li>Άνοιξε το site σου από κινητό. Διαβάζεται άνετα; Βρίσκεις το τηλέφωνο με μία κίνηση;</li>
    <li>Γράψε μία σελίδα ή ανάρτηση που απαντά την πιο συχνή ερώτηση των πελατών σου.</li>
  </ol>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Η υπηρεσία <strong>Ορατότητα σε Google & AI</strong> καλύπτει ακριβώς αυτά: SEO, AEO και GEO
    μαζί. Το αρχικό setup κοστίζει {eur(aiSetup.price)} εφάπαξ και η μηνιαία διαχείριση
    {eur(aiMonthly.price)} τον μήνα, με μηνιαίο report για το τι έγινε και τι μετρήθηκε — χωρίς
    δέσμευση ή συμβόλαιο. Μετράμε πού στέκεσαι πριν ξεκινήσουμε και επαναμετράμε στους 3 μήνες, για
    να κρίνεις με νούμερα, όχι με υποσχέσεις. Αν θες πρώτα απλώς να δεις πού βρίσκεσαι, κλείσε τον
    <a href="/elegxos/">δωρεάν Έλεγχο</a>: {ELEGXOS.minutes} λεπτά, και φεύγεις με γραπτή εικόνα για
    Google, AI και καθημερινή λειτουργία.
  </p>
</Guide>
