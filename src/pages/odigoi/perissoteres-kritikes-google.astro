---
import Guide from '../../layouts/Guide.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const autoReviews = optionById('auto-reviews')!;

const faq = [
  {
    q: 'Επιτρέπεται να δώσω έκπτωση ή δώρο για μια κριτική;',
    a: 'Όχι — οι κανόνες της Google απαγορεύουν κάθε αντάλλαγμα για κριτική. Ζητήστε την απλά και ευγενικά, χωρίς κίνητρο.',
  },
  {
    q: 'Μπορώ να σβήσω μια αρνητική κριτική;',
    a: 'Όχι εσείς οι ίδιοι — μπορείτε μόνο να ζητήσετε από την Google να την αφαιρέσει, αν παραβιάζει τους κανόνες της (π.χ. είναι υβριστική ή ψεύτικη). Αλλιώς, η καλύτερη κίνηση είναι μια ψύχραιμη, ευγενική απάντηση.',
  },
  {
    q: 'Πόσες κριτικές χρειάζομαι;',
    a: 'Δεν υπάρχει μαγικός αριθμός. Πιο σημαντικό είναι να έρχονται σταθερά καινούριες — μια ζωντανή ροή μετράει περισσότερο από ένα μεγάλο αλλά παλιό σύνολο.',
  },
  {
    q: 'Διαβάζουν τα AI όπως το ChatGPT τις κριτικές μου;',
    a: 'Ναι. Όταν κάποιος ζητάει από ένα AI να του προτείνει επιχείρηση, οι κριτικές σας — πόσες είναι, πόσο πρόσφατες και τι λένε — είναι από τα βασικά στοιχεία που κοιτάζει.',
  },
  {
    q: 'Χρειάζομαι κάτι τεχνικό για να ξεκινήσω;',
    a: 'Όχι. Ένα ενημερωμένο προφίλ στη Google και το link κριτικής του φτάνουν — τα υπόλοιπα είναι θέμα συνήθειας ή αυτοματισμού.',
  },
];
---

<Guide
  title="Πώς θα πάρετε περισσότερες κριτικές στη Google; | PISMA"
  description="Ζητήστε την κριτική τη σωστή στιγμή, κάντε το εύκολο με link ή QR και απαντήστε σε όλες — έτσι ανεβαίνετε σε Google, Χάρτες και AI όπως το ChatGPT."
  slug="perissoteres-kritikes-google"
  question="Πώς θα πάρετε περισσότερες κριτικές στη Google;"
  sub="Πρακτικός οδηγός για κάθε επιχείρηση — χωρίς κόλπα και χωρίς τεχνικά."
  answer="Ζητήστε την κριτική από κάθε ευχαριστημένο πελάτη τη στιγμή που σας ευχαριστεί, και κάντε του τη ζωή εύκολη: ένα link ή ένα QR που ανοίγει κατευθείαν τη φόρμα της Google. Απαντήστε σε όλες τις κριτικές — και στις αρνητικές — και φροντίστε να έρχονται σταθερά, λίγες κάθε μήνα, αντί για πολλές μαζεμένες μία φορά. Και ποτέ μην αγοράσετε ή σκηνοθετήσετε κριτικές: απαγορεύεται από την Google και μπορεί να σας κοστίσει το προφίλ."
  updated="2026-07-28"
  faq={faq}
>
  <h2>Γιατί μετράνε τόσο οι κριτικές;</h2>
  <p>
    Οι κριτικές είναι από τα πρώτα πράγματα που κοιτάζει η Google για να αποφασίσει
    ποιες επιχειρήσεις θα δείξει ψηλά στους Χάρτες και στην αναζήτηση. Και πλέον δεν
    τις διαβάζει μόνο η Google: τα εργαλεία AI, όπως το ChatGPT, τις διαβάζουν κι αυτά
    όταν κάποιος ρωτάει «ποιο συνεργείο να εμπιστευτώ;» ή «πού να φάω καλή πίτσα εδώ κοντά;».
  </p>
  <p>Τρία πράγματα κοιτάζουν, και τα τρία τα επηρεάζετε εσείς:</p>
  <ul>
    <li><strong>Πλήθος</strong> — πόσοι πελάτες έχουν πει τη γνώμη τους.</li>
    <li><strong>Φρεσκάδα</strong> — πότε γράφτηκε η τελευταία κριτική. Πρόσφατες κριτικές σημαίνουν «ζωντανό μαγαζί».</li>
    <li><strong>Περιεχόμενο</strong> — τι γράφουν οι πελάτες. Όταν κάποιος γράφει «γρήγορη εξυπηρέτηση» ή «καθαρός χώρος», η Google και τα AI καταλαβαίνουν τι προσφέρετε — με λόγια πελάτη, όχι δικά σας.</li>
  </ul>
  <p>
    Γι’ αυτό οι κριτικές είναι και ένα από τα πιο δυνατά βήματα αν θέλετε
    <a href="/odigoi/na-se-proteinei-to-chatgpt/">να σας προτείνει το ChatGPT</a>.
  </p>

  <h2>Μετράει πιο πολύ το σύνολο ή η ροή;</h2>
  <p>
    Η ροή. Μια επιχείρηση με λιγότερες αλλά πρόσφατες κριτικές δείχνει ζωντανή, ενώ
    μια άλλη με πολλές που όμως είναι όλες παλιές μοιάζει σαν να άλλαξε κάτι — και ο
    πελάτης διστάζει.
  </p>
  <p>
    Το ίδιο «σκέφτονται» η Google και τα AI: η σταθερή ροή νέων κριτικών είναι σημάδι
    ότι το μαγαζί λειτουργεί και οι πελάτες μένουν ευχαριστημένοι σήμερα, όχι πέρυσι.
    Γι’ αυτό μην το βλέπετε σαν εκστρατεία που κάνετε μία φορά — κάντε το κομμάτι της
    καθημερινής δουλειάς, όπως το ταμείο.
  </p>

  <h2>Πώς ζητάτε μια κριτική σωστά;</h2>
  <p>
    Τη σωστή στιγμή και με τον εύκολο τρόπο. Οι περισσότεροι πελάτες δεν αρνούνται να
    γράψουν δυο λόγια — απλώς δεν το σκέφτονται μόνοι τους, ή βαριούνται να ψάξουν πού.
  </p>
  <ul>
    <li><strong>Η σωστή στιγμή:</strong> όταν ο πελάτης σας ευχαριστεί — μόλις παραλάβει το αμάξι, μόλις δει το χτένισμα, μόλις τελειώσει το φαγητό. Τότε το «θα μας γράψετε δυο λόγια;» έρχεται φυσικά.</li>
    <li><strong>Εύκολο link:</strong> το προφίλ σας στην Google σάς δίνει έναν σύνδεσμο που ανοίγει κατευθείαν τη φόρμα κριτικής. Αν δεν έχετε στήσει το προφίλ, ξεκινήστε από τον οδηγό για το <a href="/odigoi/profil-google-maps/">προφίλ στο Google Maps</a>.</li>
    <li><strong>QR στον χώρο:</strong> ένα QR στο ταμείο, στο τραπέζι ή στην απόδειξη κάνει το link σκαναρίσιμο σε δευτερόλεπτα, χωρίς πληκτρολόγηση. Ένα βήμα παραπέρα το πηγαίνει <a href="/kritikes/">το Εργαλείο Κριτικών</a> — το εργαλείο της PISMA.</li>
    <li><strong>Προσωπική κουβέντα:</strong> το «θα μας βοηθούσε πολύ μια κριτική» από εσάς πιάνει καλύτερα από ένα απρόσωπο μήνυμα.</li>
    <li><strong>Ίδια μέρα:</strong> αν στέλνετε το link με μήνυμα, στείλτε το όσο η εμπειρία είναι φρέσκια — όχι μετά από μια εβδομάδα.</li>
  </ul>

  <h2>Πρέπει να απαντάτε σε όλες τις κριτικές;</h2>
  <p>
    Ναι, σε όλες. Η απάντηση δείχνει — στους μελλοντικούς πελάτες, στην Google και στα
    AI — ότι πίσω από το προφίλ υπάρχει άνθρωπος που ακούει.
  </p>
  <p>
    Στις θετικές φτάνει ένα σύντομο, δικό σας ευχαριστώ — όχι το ίδιο τυποποιημένο
    μήνυμα παντού. Στις αρνητικές, κρατήστε αυτή τη σειρά:
  </p>
  <ol>
    <li>Μην απαντήσετε θυμωμένοι. Αφήστε να περάσουν λίγες ώρες, αλλά απαντήστε μέσα σε 1–2 μέρες.</li>
    <li>Ευχαριστήστε για τον χρόνο και παραδεχτείτε ό,τι πραγματικά ισχύει.</li>
    <li>Γράψτε τι θα κάνετε διαφορετικά — μία πρόταση φτάνει.</li>
    <li>Καλέστε τη συζήτηση εκτός δημόσιας θέας: «πάρτε μας ένα τηλέφωνο να το φτιάξουμε».</li>
  </ol>
  <p>
    Μια ψύχραιμη απάντηση σε αρνητική κριτική συχνά λέει στους επόμενους πελάτες
    περισσότερα κι από πολλά πεντάστερα μαζί.
  </p>

  <h2>Τι δεν κάνετε ποτέ με τις κριτικές;</h2>
  <p>
    Ό,τι δεν είναι αληθινό. Οι κανόνες της Google είναι ξεκάθαροι, και η παράβασή τους
    μπορεί να σας κοστίσει κριτικές που σβήνονται μαζικά ή προφίλ που περιορίζεται.
  </p>
  <ul>
    <li><strong>Μην αγοράζετε κριτικές</strong> — από «υπηρεσίες» που τις πουλάνε πακέτο.</li>
    <li><strong>Μη βάζετε συγγενείς και υπαλλήλους</strong> να γράφουν σαν δήθεν πελάτες.</li>
    <li><strong>Μη δίνετε δώρο ή έκπτωση με αντάλλαγμα κριτική</strong> — κάθε ανταμοιβή απαγορεύεται.</li>
    <li><strong>Μη «φιλτράρετε»:</strong> δηλαδή να στέλνετε στην Google μόνο όσους ξέρετε ότι θα γράψουν καλά λόγια, και τους δυσαρεστημένους σε κρυφή φόρμα. Κι αυτό απαγορεύεται.</li>
  </ul>
  <p>
    Πέρα από τους κανόνες, οι ψεύτικες κριτικές φαίνονται — και από τους αλγόριθμους
    και από τους ανθρώπους. Οι λίγες αληθινές αξίζουν περισσότερο από τις πολλές στημένες.
  </p>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Το δύσκολο στις κριτικές δεν είναι η θεωρία — είναι να ζητάτε σταθερά, κάθε μέρα,
    χωρίς να το ξεχνάτε. Γι’ αυτό φτιάξαμε <a href="/kritikes/">το Εργαλείο Κριτικών</a>:
    το εργαλείο της PISMA που ξεκινά από ένα αυτοκόλλητο QR στο τραπέζι ή στο ταμείο
    και κάνει τις κριτικές να μαζεύονται μόνες τους — με έναν τρόπο που οι πελάτες
    τον χαίρονται. Το πώς ακριβώς δουλεύει δεν το περιγράφουμε δημόσια· το δείχνουμε
    μόνο ζωντανά, σε ένα σύντομο ραντεβού.
  </p>
  <p>
    Και οι κανόνες που είδατε πιο πάνω; Τηρούνται στο ακέραιο — καμία αγορασμένη ή
    στημένη κριτική, κανένα αντάλλαγμα για κριτική, κανένα φιλτράρισμα. Ήταν η πρώτη
    προδιαγραφή όταν το σχεδιάζαμε.
  </p>
  <p>
    Κοστίζει {eur(autoReviews.price)} τον μήνα, χωρίς καμία δέσμευση — συν τα
    <a href="/aftokollita/">αυτοκόλλητα QR</a> εφάπαξ. Ή ξεκινήστε από τον
    <a href="/elegxos/">δωρεάν Έλεγχο {ELEGXOS.minutes} λεπτών</a> για να δείτε πρώτα
    πού στέκεστε σε Google και AI.
  </p>
</Guide>
