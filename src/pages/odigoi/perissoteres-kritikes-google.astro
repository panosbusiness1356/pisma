---
import Guide from '../../layouts/Guide.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const autoReviews = optionById('auto-reviews')!;

const faq = [
  {
    q: 'Επιτρέπεται να δώσω έκπτωση ή δώρο για μια κριτική;',
    a: 'Όχι — οι κανόνες της Google απαγορεύουν κάθε αντάλλαγμα για κριτική. Ζήτα την απλά και ευγενικά, χωρίς κίνητρο.',
  },
  {
    q: 'Μπορώ να σβήσω μια αρνητική κριτική;',
    a: 'Όχι ο ίδιος — μπορείς μόνο να ζητήσεις από την Google να την αφαιρέσει, αν παραβιάζει τους κανόνες της (π.χ. είναι υβριστική ή ψεύτικη). Αλλιώς, η καλύτερη κίνηση είναι μια ψύχραιμη, ευγενική απάντηση.',
  },
  {
    q: 'Πόσες κριτικές χρειάζομαι;',
    a: 'Δεν υπάρχει μαγικός αριθμός. Πιο σημαντικό είναι να έρχονται σταθερά καινούριες — μια ζωντανή ροή μετράει περισσότερο από ένα μεγάλο αλλά παλιό σύνολο.',
  },
  {
    q: 'Διαβάζουν τα AI όπως το ChatGPT τις κριτικές μου;',
    a: 'Ναι. Όταν κάποιος ζητάει από ένα AI να του προτείνει επιχείρηση, οι κριτικές σου — πόσες είναι, πόσο πρόσφατες και τι λένε — είναι από τα βασικά στοιχεία που κοιτάζει.',
  },
  {
    q: 'Χρειάζομαι κάτι τεχνικό για να ξεκινήσω;',
    a: 'Όχι. Ένα ενημερωμένο προφίλ στο Google και το link κριτικής του φτάνουν — τα υπόλοιπα είναι θέμα συνήθειας ή αυτοματισμού.',
  },
];
---

<Guide
  title="Πώς θα πάρεις περισσότερες κριτικές στο Google; | PISMA"
  description="Ζήτα την κριτική τη σωστή στιγμή, κάνε το εύκολο με link ή QR και απάντα σε όλες — έτσι ανεβαίνεις σε Google, Χάρτες και AI όπως το ChatGPT."
  slug="perissoteres-kritikes-google"
  question="Πώς θα πάρεις περισσότερες κριτικές στο Google;"
  sub="Πρακτικός οδηγός για μικρές επιχειρήσεις — χωρίς κόλπα και χωρίς τεχνικά."
  answer="Ζήτα την κριτική από κάθε ευχαριστημένο πελάτη τη στιγμή που σε ευχαριστεί, και κάνε του τη ζωή εύκολη: ένα link ή ένα QR που ανοίγει κατευθείαν τη φόρμα της Google. Απάντα σε όλες τις κριτικές — και στις αρνητικές — και φρόντισε να έρχονται σταθερά, λίγες κάθε μήνα, αντί για πολλές μαζεμένες μία φορά. Και ποτέ μην αγοράσεις ή σκηνοθετήσεις κριτικές: απαγορεύεται από την Google και μπορεί να σου κοστίσει το προφίλ."
  updated="2026-07-28"
  faq={faq}
>
  <h2>Γιατί μετράνε τόσο οι κριτικές;</h2>
  <p>
    Οι κριτικές είναι από τα πρώτα πράγματα που κοιτάζει η Google για να αποφασίσει
    ποιες επιχειρήσεις θα δείξει ψηλά στους Χάρτες και στην αναζήτηση. Και πλέον δεν
    τις διαβάζει μόνο η Google: τα εργαλεία AI, όπως το ChatGPT, τις διαβάζουν κι αυτά
    όταν κάποιος ρωτάει «ποιο συνεργείο να εμπιστευτώ;» ή «πού να φάω καλή πίτσα εδώ κοντά;».
  </p>
  <p>Τρία πράγματα κοιτάζουν, και τα τρία τα επηρεάζεις εσύ:</p>
  <ul>
    <li><strong>Πλήθος</strong> — πόσοι πελάτες έχουν πει τη γνώμη τους.</li>
    <li><strong>Φρεσκάδα</strong> — πότε γράφτηκε η τελευταία κριτική. Πρόσφατες κριτικές σημαίνουν «ζωντανό μαγαζί».</li>
    <li><strong>Περιεχόμενο</strong> — τι γράφουν οι πελάτες. Όταν κάποιος γράφει «γρήγορη εξυπηρέτηση» ή «καθαρός χώρος», η Google και τα AI καταλαβαίνουν τι προσφέρεις — με λόγια πελάτη, όχι δικά σου.</li>
  </ul>
  <p>
    Γι' αυτό οι κριτικές είναι και ένα από τα πιο δυνατά βήματα αν θέλεις
    <a href="/odigoi/na-se-proteinei-to-chatgpt/">να σε προτείνει το ChatGPT</a>.
  </p>

  <h2>Μετράει πιο πολύ το σύνολο ή η ροή;</h2>
  <p>
    Η ροή. Μια επιχείρηση με λιγότερες αλλά πρόσφατες κριτικές δείχνει ζωντανή, ενώ
    μια άλλη με πολλές που όμως είναι όλες παλιές μοιάζει σαν να άλλαξε κάτι — και ο
    πελάτης διστάζει.
  </p>
  <p>
    Το ίδιο «σκέφτονται» η Google και τα AI: η σταθερή ροή νέων κριτικών είναι σημάδι
    ότι το μαγαζί λειτουργεί και οι πελάτες μένουν ευχαριστημένοι σήμερα, όχι πέρυσι.
    Γι' αυτό μην το βλέπεις σαν εκστρατεία που κάνεις μία φορά — κάνε το κομμάτι της
    καθημερινής δουλειάς, όπως το ταμείο.
  </p>

  <h2>Πώς ζητάς μια κριτική σωστά;</h2>
  <p>
    Τη σωστή στιγμή και με τον εύκολο τρόπο. Οι περισσότεροι πελάτες δεν αρνούνται να
    γράψουν δυο λόγια — απλώς δεν το σκέφτονται μόνοι τους, ή βαριούνται να ψάξουν πού.
  </p>
  <ul>
    <li><strong>Η σωστή στιγμή:</strong> όταν ο πελάτης σε ευχαριστεί — μόλις παραλάβει το αμάξι, μόλις δει το χτένισμα, μόλις τελειώσει το φαγητό. Τότε το «θα μας γράψετε δυο λόγια;» έρχεται φυσικά.</li>
    <li><strong>Εύκολο link:</strong> το προφίλ σου στην Google σού δίνει έναν σύνδεσμο που ανοίγει κατευθείαν τη φόρμα κριτικής. Αν δεν έχεις στήσει το προφίλ, ξεκίνα από τον οδηγό για το <a href="/odigoi/profil-google-maps/">προφίλ στο Google Maps</a>.</li>
    <li><strong>QR στον χώρο:</strong> ένα QR στο ταμείο, στο τραπέζι ή στην απόδειξη κάνει το link σκαναρίσιμο σε δευτερόλεπτα, χωρίς πληκτρολόγηση.</li>
    <li><strong>Προσωπική κουβέντα:</strong> το «θα μας βοηθούσε πολύ μια κριτική» από εσένα πιάνει καλύτερα από ένα απρόσωπο μήνυμα.</li>
    <li><strong>Ίδια μέρα:</strong> αν στέλνεις το link με μήνυμα, στείλ' το όσο η εμπειρία είναι φρέσκια — όχι μετά από μια εβδομάδα.</li>
  </ul>

  <h2>Πρέπει να απαντάς σε όλες τις κριτικές;</h2>
  <p>
    Ναι, σε όλες. Η απάντηση δείχνει — στους μελλοντικούς πελάτες, στην Google και στα
    AI — ότι πίσω από το προφίλ υπάρχει άνθρωπος που ακούει.
  </p>
  <p>
    Στις θετικές φτάνει ένα σύντομο, δικό σου ευχαριστώ — όχι το ίδιο τυποποιημένο
    μήνυμα παντού. Στις αρνητικές, κράτα αυτή τη σειρά:
  </p>
  <ol>
    <li>Μην απαντήσεις θυμωμένος. Άσε να περάσουν λίγες ώρες, αλλά απάντα μέσα σε 1–2 μέρες.</li>
    <li>Ευχαρίστησε για τον χρόνο και παραδέξου ό,τι πραγματικά ισχύει.</li>
    <li>Γράψε τι θα κάνεις διαφορετικά — μία πρόταση φτάνει.</li>
    <li>Κάλεσε τη συζήτηση εκτός δημόσιας θέας: «πάρε μας ένα τηλέφωνο να το φτιάξουμε».</li>
  </ol>
  <p>
    Μια ψύχραιμη απάντηση σε αρνητική κριτική συχνά λέει στους επόμενους πελάτες
    περισσότερα κι από πολλά πεντάστερα μαζί.
  </p>

  <h2>Τι δεν κάνεις ποτέ με τις κριτικές;</h2>
  <p>
    Ό,τι δεν είναι αληθινό. Οι κανόνες της Google είναι ξεκάθαροι, και η παράβασή τους
    μπορεί να σου κοστίσει κριτικές που σβήνονται μαζικά ή προφίλ που περιορίζεται.
  </p>
  <ul>
    <li><strong>Μην αγοράζεις κριτικές</strong> — από «υπηρεσίες» που τις πουλάνε πακέτο.</li>
    <li><strong>Μη βάζεις συγγενείς και υπαλλήλους</strong> να γράφουν σαν δήθεν πελάτες.</li>
    <li><strong>Μη δίνεις δώρο ή έκπτωση με αντάλλαγμα κριτική</strong> — κάθε ανταμοιβή απαγορεύεται.</li>
    <li><strong>Μη «φιλτράρεις»:</strong> δηλαδή να στέλνεις στην Google μόνο όσους ξέρεις ότι θα γράψουν καλά λόγια, και τους δυσαρεστημένους σε κρυφή φόρμα. Κι αυτό απαγορεύεται.</li>
  </ul>
  <p>
    Πέρα από τους κανόνες, οι ψεύτικες κριτικές φαίνονται — και από τους αλγόριθμους
    και από τους ανθρώπους. Οι λίγες αληθινές αξίζουν περισσότερο από τις πολλές στημένες.
  </p>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Το δύσκολο στις κριτικές δεν είναι η θεωρία — είναι να ζητάς σταθερά, κάθε μέρα,
    χωρίς να το ξεχνάς. Η υπηρεσία «{autoReviews.label}» της PISMA αναλαμβάνει ακριβώς
    αυτό: το αίτημα κριτικής φτάνει στον πελάτη σου αυτόματα, με τον σωστό τρόπο,
    χωρίς να χρειάζεται να το θυμάσαι εσύ — με {eur(autoReviews.price)} τον μήνα,
    χωρίς καμία δέσμευση. Δες πώς δουλεύουν οι <a href="/doulevei-mono-tou/">αυτοματισμοί της PISMA</a>,
    ή ξεκίνα από τον <a href="/elegxos/">δωρεάν Έλεγχο {ELEGXOS.minutes} λεπτών</a> για
    να δεις πρώτα πού στέκεσαι σε Google και AI.
  </p>
</Guide>
