---
import Guide from '../../layouts/Guide.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const basic = optionById('web-basic')!;
const standard = optionById('web-standard')!;
const pro = optionById('web-pro')!;
const care = optionById('care-web')!;
const gbp = optionById('gbp-setup')!;

const faq = [
  {
    q: 'Πόσο κοστίζει ένα απλό site;',
    a: `Στην PISMA το Basic site (αρχική, υπηρεσίες, επικοινωνία) κοστίζει ${eur(basic.price)} εφάπαξ. Μεγαλύτερα sites με περισσότερες σελίδες και λειτουργίες φτάνουν έως ${eur(pro.price)}.`,
  },
  {
    q: 'Υπάρχει μηνιαίο κόστος μετά την κατασκευή;',
    a: `Μόνο αν το θέλεις: η συντήρηση Website care κοστίζει ${eur(care.price)} τον μήνα, χωρίς συμβόλαιο ή δέσμευση. Ξεχωριστά υπάρχει ένα μικρό ετήσιο πάγιο για το domain και τη φιλοξενία.`,
  },
  {
    q: 'Σε ποιον πρέπει να ανήκει το domain;',
    a: 'Σε εσένα — πάντα. Αν το domain γραφτεί στο όνομα του κατασκευαστή, δεν ελέγχεις το ίδιο σου το site και δύσκολα φεύγεις αν κάτι πάει στραβά.',
  },
  {
    q: 'Υπάρχουν έτοιμα πακέτα;',
    a: `Όχι — φτιάχνεις το δικό σου: διαλέγεις μόνο τις υπηρεσίες που χρειάζεσαι στη σελίδα τιμών και πληρώνεις το άθροισμά τους. Συνηθισμένο πρώτο βήμα: Basic site (${eur(basic.price)}) μαζί με στήσιμο του προφίλ Google (${eur(gbp.price)}).`,
  },
  {
    q: 'Χρειάζομαι site αν έχω ήδη σελίδα στο Facebook;',
    a: 'Η σελίδα στο Facebook βοηθάει, αλλά δεν είναι δική σου — οι κανόνες αλλάζουν όποτε το αποφασίσει η πλατφόρμα. Το site είναι ο μόνος χώρος που ελέγχεις πλήρως, και αυτόν διαβάζουν καλύτερα το Google και τα εργαλεία AI.',
  },
];
---

<Guide
  title="Πόσο κοστίζει ένα site για μια επιχείρηση; | PISMA"
  description={`Τι καθορίζει την τιμή ενός site, τι περιλαμβάνει μια σωστή κατασκευή και οι τιμές της PISMA — από ${eur(basic.price)} έως ${eur(pro.price)} εφάπαξ, με απλά λόγια.`}
  slug="poso-kostizei-ena-site"
  question="Πόσο κοστίζει ένα site για μια επιχείρηση;"
  sub="Για ιδιοκτήτες επιχειρήσεων που θέλουν καθαρή απάντηση για τις τιμές, χωρίς τεχνικά μπερδέματα."
  answer={`Στην PISMA ένα site για την επιχείρησή σου κοστίζει από ${eur(basic.price)} έως ${eur(pro.price)} εφάπαξ, ανάλογα με το πόσες σελίδες και ποιες λειτουργίες χρειάζεσαι. Αν θέλεις να το φροντίζουμε εμείς μετά, η συντήρηση κοστίζει ${eur(care.price)} τον μήνα — χωρίς συμβόλαιο και χωρίς δέσμευση. Την τελική τιμή την καθορίζουν κυρίως το μέγεθος, οι λειτουργίες και το ποιος γράφει τα κείμενα.`}
  updated="2026-07-28"
  faq={faq}
>
  <h2>Τι καθορίζει πόσο θα κοστίσει ένα site;</h2>
  <p>
    Τρία πράγματα κυρίως: το μέγεθος, οι λειτουργίες και το ποιος ετοιμάζει τα κείμενα.
    Όσο περισσότερα χρειάζεσαι από τα τρία, τόσο περισσότερη δουλειά — και τόσο ανεβαίνει η τιμή.
  </p>
  <ul>
    <li>
      <strong>Μέγεθος.</strong> Άλλο κόστος έχει ένα site με 3–4 σελίδες (αρχική, υπηρεσίες,
      επικοινωνία) και άλλο ένα με πολλές σελίδες, κατάλογο ή ξεχωριστή σελίδα για κάθε υπηρεσία.
    </li>
    <li>
      <strong>Λειτουργίες.</strong> Φόρμα επικοινωνίας, κρατήσεις, μενού ή τιμοκατάλογος,
      δεύτερη γλώσσα — κάθε έξτρα λειτουργία θέλει στήσιμο και δοκιμές.
    </li>
    <li>
      <strong>Κείμενα και φωτογραφίες.</strong> Αν τα δώσεις έτοιμα, το κόστος μένει χαμηλά.
      Αν πρέπει να γραφτούν και να οργανωθούν από την αρχή, προστίθεται δουλειά.
    </li>
  </ul>
  <p>
    Γι' αυτό δύο προσφορές για «ένα site» μπορεί να απέχουν πολύ μεταξύ τους: συχνά δεν
    περιγράφουν την ίδια δουλειά. Πριν συγκρίνεις τιμές, σιγουρέψου ότι συγκρίνεις τα ίδια πράγματα.
  </p>

  <h2>Τι πρέπει να περιλαμβάνει μια σωστή κατασκευή;</h2>
  <p>
    Ό,τι κι αν πληρώσεις, το site πρέπει να δουλεύει άψογα στο κινητό, να ανοίγει γρήγορα και
    να είναι φτιαγμένο έτσι ώστε να το καταλαβαίνουν το Google και τα εργαλεία AI, όπως το ChatGPT.
    Αυτά δεν είναι «έξτρα» — είναι τα βασικά.
  </p>
  <ul>
    <li><strong>Κινητό.</strong> Οι πελάτες σου το ανοίγουν κυρίως από το τηλέφωνο — εκεί πρέπει να δείχνει και να δουλεύει τέλεια.</li>
    <li><strong>Ταχύτητα.</strong> Ένα αργό site κουράζει· όποιος περιμένει, φεύγει.</li>
    <li>
      <strong>Βασικό SEO</strong> — δηλαδή, να είναι γραμμένο έτσι ώστε να σε βρίσκει το Google.
      Το εξηγούμε αναλυτικά στον οδηγό <a href="/odigoi/seo-me-apla-logia/">«SEO με απλά λόγια»</a>.
    </li>
    <li>
      <strong>Έτοιμο για AI.</strong> Οι πελάτες πλέον ψάχνουν και ρωτώντας το ChatGPT. Το site
      χρειάζεται καθαρές, πλήρεις πληροφορίες (τι κάνεις, πού, πώς σε βρίσκουν), ώστε τα εργαλεία AI
      να μπορούν να σε προτείνουν — δες τον οδηγό
      <a href="/odigoi/na-se-proteinei-to-chatgpt/">για το ChatGPT</a>.
    </li>
    <li><strong>Εύκολη επικοινωνία.</strong> Κουμπί τηλεφώνου και φόρμα, ώστε ο πελάτης να σε βρίσκει με ένα πάτημα.</li>
  </ul>
  <p>Αν μια προσφορά δεν αναφέρει τίποτα από αυτά, ρώτα πριν πληρώσεις — μη θεωρήσεις ότι εννοούνται.</p>

  <h2>Πληρώνεις μία φορά ή κάθε μήνα;</h2>
  <p>
    Η κατασκευή πληρώνεται μία φορά — εφάπαξ. Μετά μένουν δύο πράγματα: ένα μικρό ετήσιο πάγιο
    για το domain (το όνομα του site, π.χ. toonomasou.gr) και τη φιλοξενία (τον «χώρο» όπου ζει
    το site), και προαιρετικά η συντήρηση.
  </p>
  <p>
    Συντήρηση σημαίνει ενημερώσεις, ασφάλεια και μικροαλλαγές — να τρέχουν όλα χωρίς να το
    σκέφτεσαι. Στην PISMA λέγεται Website care και κοστίζει {eur(care.price)} τον μήνα,
    χωρίς συμβόλαιο: τη σταματάς όποτε θέλεις.
  </p>
  <p>
    Πρόσεξε το μοντέλο «δωρεάν site με υποχρεωτική μηνιαία συνδρομή»: φαίνεται φθηνό στην αρχή,
    αλλά συχνά σε δένει με δέσμευση — και το site μπορεί να μη σου ανήκει καν.
  </p>

  <h2>Πόσο κοστίζει ένα site στην PISMA;</h2>
  <p>
    Από {eur(basic.price)} έως {eur(pro.price)}, εφάπαξ — ανάλογα με το μέγεθος και τις
    λειτουργίες. Οι τιμές είναι δημόσιες και ίδιες για όλους:
  </p>
  <table>
    <thead>
      <tr>
        <th>Επιλογή</th>
        <th>Τι είναι</th>
        <th>Τιμή</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>{basic.label}</strong></td>
        <td>{basic.detail}</td>
        <td>{eur(basic.price)} εφάπαξ</td>
      </tr>
      <tr>
        <td><strong>{standard.label}</strong></td>
        <td>{standard.detail}</td>
        <td>{eur(standard.price)} εφάπαξ</td>
      </tr>
      <tr>
        <td><strong>{pro.label}</strong></td>
        <td>{pro.detail}</td>
        <td>{eur(pro.price)} εφάπαξ</td>
      </tr>
    </tbody>
  </table>
  <p>
    Η προαιρετική συντήρηση ({care.label}) κοστίζει {eur(care.price)} τον μήνα. Συχνά το site
    συνδυάζεται με στήσιμο του προφίλ σου στο Google — Χάρτες και αναζήτηση ({eur(gbp.price)}
    εφάπαξ), ώστε να σε βρίσκουν από την πρώτη μέρα.
  </p>
  <p>
    Στη <a href="/times/">σελίδα τιμών</a> φτιάχνεις τον δικό σου συνδυασμό και βλέπεις το
    σύνολο επί τόπου — πριν καν μιλήσουμε.
  </p>

  <h2>Τι να προσέξεις πριν πληρώσεις — οπουδήποτε;</h2>
  <p>
    Δύο πράγματα πάνω απ' όλα: το domain να γραφτεί στο δικό σου όνομα, και να ξέρεις γραπτά
    τι ακριβώς παραδίδεται. Πριν κλείσεις με οποιονδήποτε — και με εμάς — ζήτα τα εξής:
  </p>
  <ol>
    <li>
      <strong>Domain σε εσένα.</strong> Το όνομα του site να αγοραστεί στο δικό σου όνομα ή στην
      επιχείρησή σου. Αλλιώς, αν χαλάσει η συνεργασία, χάνεις τη διεύθυνσή σου.
    </li>
    <li>
      <strong>Κωδικοί και πρόσβαση.</strong> Να παραλάβεις τους κωδικούς για το domain, τη
      φιλοξενία και τη διαχείριση του site — είναι δικά σου.
    </li>
    <li>
      <strong>Γραπτή ανάλυση.</strong> Ποιες σελίδες, ποιες λειτουργίες, ποιος γράφει τα κείμενα,
      πόσοι γύροι διορθώσεων περιλαμβάνονται.
    </li>
    <li>
      <strong>Τι καλύπτει το μηνιαίο.</strong> Αν υπάρχει συνδρομή, τι ακριβώς περιλαμβάνει και
      αν έχει δέσμευση χρόνου.
    </li>
    <li>
      <strong>Τι γίνεται αν φύγεις.</strong> Μπορείς να πάρεις το site σου και να συνεχίσεις
      αλλού; Η σωστή απάντηση είναι «ναι».
    </li>
  </ol>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Αν δεν είσαι σίγουρος τι site χρειάζεσαι — ή αν αυτό που έχεις σε καλύπτει — ξεκίνα από τον
    <a href="/elegxos/">δωρεάν Έλεγχο</a>: ένα ραντεβού {ELEGXOS.minutes} λεπτών όπου μετράμε
    μαζί πού στέκεσαι σε Google, AI και καθημερινή λειτουργία, και φεύγεις με γραπτή εικόνα.
    Μετά αποφασίζεις με το χαρτί μπροστά σου — χωρίς καμία δέσμευση.
  </p>
</Guide>
