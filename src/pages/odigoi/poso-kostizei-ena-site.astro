---
import Guide from '../../layouts/Guide.astro';
import Tiles from '../../components/guide/Tiles.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const basic = optionById('web-basic')!;
const standard = optionById('web-standard')!;
const pro = optionById('web-pro')!;
const enterprise = optionById('web-enterprise')!;
const bookings = optionById('web-bookings')!;
const care = optionById('care-web')!;
const gbp = optionById('gbp-setup')!;

const faq = [
  {
    q: 'Πόσο κοστίζει ένα απλό site;',
    a: `Στην PISMA το Basic site (αρχική, υπηρεσίες, επικοινωνία) κοστίζει ${eur(basic.price)} εφάπαξ. Μεγαλύτερα sites με περισσότερες σελίδες και λειτουργίες φτάνουν έως ${eur(pro.price)}.`,
  },
  {
    q: 'Υπάρχει μηνιαίο κόστος μετά την κατασκευή;',
    a: `Μόνο αν το θέλετε: η συντήρηση Website care κοστίζει ${eur(care.price)} τον μήνα, χωρίς συμβόλαιο ή δέσμευση. Ξεχωριστά υπάρχει ένα μικρό ετήσιο πάγιο για το domain και τη φιλοξενία.`,
  },
  {
    q: 'Σε ποιον πρέπει να ανήκει το domain;',
    a: 'Σε εσάς, πάντα. Αν το domain γραφτεί στο όνομα του κατασκευαστή, δεν ελέγχετε το ίδιο σας το site και δύσκολα φεύγετε αν κάτι πάει στραβά.',
  },
  {
    q: 'Υπάρχουν έτοιμα πακέτα;',
    a: `Όχι. Φτιάχνετε το δικό σας: διαλέγετε μόνο τις υπηρεσίες που χρειάζεστε στη σελίδα τιμών και πληρώνετε το άθροισμά τους. Συνηθισμένο πρώτο βήμα: Basic site (${eur(basic.price)}) μαζί με στήσιμο του προφίλ Google (${eur(gbp.price)}).`,
  },
  {
    q: 'Χρειάζομαι site αν έχω ήδη σελίδα στο Facebook;',
    a: 'Η σελίδα στο Facebook βοηθάει, αλλά δεν είναι δική σας: οι κανόνες αλλάζουν όποτε το αποφασίσει η πλατφόρμα. Το site είναι ο μόνος χώρος που ελέγχετε πλήρως, και αυτόν διαβάζουν καλύτερα η Google και τα εργαλεία AI.',
  },
];
---

<Guide
  title="Πόσο κοστίζει ένα site για μια επιχείρηση; | PISMA"
  description={`Τι καθορίζει την τιμή ενός site, τι περιλαμβάνει μια σωστή κατασκευή και οι τιμές της PISMA, από ${eur(basic.price)} έως ${eur(pro.price)} εφάπαξ.`}
  slug="poso-kostizei-ena-site"
  question="Πόσο κοστίζει ένα site για μια επιχείρηση;"
  sub="Για ιδιοκτήτες επιχειρήσεων που θέλουν καθαρή απάντηση για τις τιμές, χωρίς τεχνικά μπερδέματα."
  updated="2026-09-10"
  faq={faq}
>
  <h2>Τι καθορίζει την τιμή;</h2>
  <Tiles items={[
    { icon: 'list', t: 'Μέγεθος', d: 'Πόσες σελίδες.' },
    { icon: 'bolt', t: 'Λειτουργίες', d: 'Φόρμα, κρατήσεις, μενού, δεύτερη γλώσσα.' },
    { icon: 'text', t: 'Κείμενα και φωτογραφίες', d: 'Έτοιμα από εσάς, ή από εμάς.' },
  ]} />

  <h2>Οι τιμές της PISMA</h2>
  <table>
    <thead>
      <tr><th>Επιλογή</th><th>Τι είναι</th><th>Τιμή</th></tr>
    </thead>
    <tbody>
      <tr><td><strong>{basic.label}</strong></td><td>{basic.detail}</td><td>{eur(basic.price)} εφάπαξ</td></tr>
      <tr><td><strong>{standard.label}</strong></td><td>{standard.detail}</td><td>{eur(standard.price)} εφάπαξ</td></tr>
      <tr><td><strong>{pro.label}</strong></td><td>{pro.detail}</td><td>{eur(pro.price)} εφάπαξ</td></tr>
      <tr><td><strong>{enterprise.label}</strong></td><td>{enterprise.detail}</td><td>Κατόπιν συνεννόησης</td></tr>
      <tr><td><strong>{bookings.label}</strong></td><td>{bookings.detail}</td><td>{eur(bookings.price)} εφάπαξ</td></tr>
      <tr><td><strong>{care.label}</strong></td><td>{care.detail}</td><td>{eur(care.price)} τον μήνα</td></tr>
    </tbody>
  </table>

  <h2>Τι είναι δικό σας</h2>
  <Tiles items={[
    { icon: 'globe', t: 'Το domain', d: 'Στο δικό σας όνομα.', tone: 'ok' },
    { icon: 'shield', t: 'Οι κωδικοί', d: 'Domain, φιλοξενία, διαχείριση.', tone: 'ok' },
    { icon: 'link', t: 'Το site', d: 'Το παίρνετε όπου θέλετε, όποτε θέλετε.', tone: 'ok' },
  ]} />

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Φτιάξτε τον συνδυασμό σας στη <a href="/times/">σελίδα τιμών</a>, ή ξεκινήστε από τον
    <a href="/elegxos/">δωρεάν Έλεγχο</a> των {ELEGXOS.minutes} λεπτών.
  </p>
</Guide>
