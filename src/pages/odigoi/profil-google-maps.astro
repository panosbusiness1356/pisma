---
import Guide from '../../layouts/Guide.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const gbpSetup = optionById('gbp-setup')!;

const faq = [
  {
    q: 'Πόσο κοστίζει το προφίλ Google;',
    a: `Το ίδιο το προφίλ είναι δωρεάν — το φτιάχνετε μόνοι σας στο google.com/business. Αν θέλετε να το στήσει η PISMA, το Setup κοστίζει ${eur(gbpSetup.price)} εφάπαξ.`,
  },
  {
    q: 'Χρειάζομαι site για να έχω προφίλ Google;',
    a: 'Όχι, το προφίλ στέκεται και μόνο του. Μαζί με ένα απλό site όμως δουλεύουν πολύ καλύτερα — το ένα δίνει εμπιστοσύνη στο άλλο.',
  },
  {
    q: 'Τι κάνω αν υπάρχει ήδη προφίλ για την επιχείρησή μου;',
    a: 'Το διεκδικείτε: το βρίσκετε στους Χάρτες, πατάτε «Διεκδίκηση αυτής της επιχείρησης» και περνάτε την επαλήθευση της Google. Μην φτιάξετε δεύτερο — τα διπλά προφίλ μπερδεύουν.',
  },
  {
    q: 'Σε πόσο καιρό θα φαίνομαι στους Χάρτες;',
    a: 'Μόλις ολοκληρωθεί η επαλήθευση της Google. Ανάλογα με τη μέθοδο (γράμμα, τηλέφωνο ή βίντεο) μπορεί να πάρει από λίγα λεπτά μέχρι μερικές εβδομάδες — η επαλήθευση με γράμμα είναι η πιο αργή.',
  },
  {
    q: 'Πόσο συχνά να ενημερώνω το προφίλ;',
    a: 'Κάθε φορά που αλλάζει κάτι — ώρες, τηλέφωνο, υπηρεσίες — και ιδανικά με μια φρέσκια φωτογραφία κάθε τόσο, για να φαίνεται ζωντανό.',
  },
];
---

<Guide
  title="Πώς θα φαίνεστε σωστά στη Google και στους Χάρτες; | PISMA"
  description="Το προφίλ Google (Business Profile) είναι η πρώτη εικόνα σας σε αναζήτηση και Χάρτες. Βήμα-βήμα: επαλήθευση, κατηγορία, ώρες, φωτογραφίες, κριτικές."
  slug="profil-google-maps"
  question="Πώς θα φαίνεστε σωστά στη Google και στους Χάρτες;"
  sub="Για κάθε μαγαζί που θέλει να το βρίσκουν εύκολα — χωρίς τεχνικές γνώσεις."
  answer="Φτιάχνετε (ή διεκδικείτε) δωρεάν το προφίλ σας στο Google Business Profile, το επαληθεύετε και το συμπληρώνετε: σωστή κατηγορία, πραγματικές ώρες, φρέσκες φωτογραφίες, υπηρεσίες και περιγραφή. Μετά φροντίζετε όνομα, διεύθυνση και τηλέφωνο να είναι ίδια παντού — στο site, στους καταλόγους, στα social — και απαντάτε στις κριτικές. Έτσι σας βρίσκουν σωστά και η Google και τα εργαλεία AI, όπως το ChatGPT."
  updated="2026-07-28"
  faq={faq}
>
  <h2>Τι είναι το προφίλ Google και γιατί σας νοιάζει;</h2>
  <p>
    Το προφίλ Google (Google Business Profile) είναι η κάρτα της επιχείρησής σας μέσα στην
    αναζήτηση Google και στους Χάρτες: όνομα, ώρες, τηλέφωνο, φωτογραφίες, κριτικές και το
    κουμπί «Οδηγίες» για να έρθουν να σας βρουν. Για τους περισσότερους πελάτες είναι η πρώτη
    εικόνα σας — τη βλέπουν πριν καν ανοίξουν το site σας.
  </p>
  <p>
    Όταν κάποιος ψάχνει «συνεργείο κοντά μου» ή «πιτσαρία στα νότια προάστια», η Google δείχνει πρώτα
    προφίλ επιχειρήσεων, όχι ιστοσελίδες. Και τα εργαλεία AI, όπως το ChatGPT, πατάνε στα ίδια
    στοιχεία όταν τους ζητάτε να προτείνουν ένα μαγαζί. Το προφίλ είναι δωρεάν — το μόνο που
    χρειάζεται είναι να το στήσετε σωστά και να το κρατάτε ζωντανό.
  </p>

  <h2>Πώς το φτιάχνετε, βήμα-βήμα;</h2>
  <p>
    Πηγαίνετε στο google.com/business, συνδέεστε με έναν λογαριασμό Google και ακολουθείτε τα
    βήματα. Δεν χρειάζεστε τεχνικές γνώσεις — χρειάζεστε λίγη υπομονή και σωστά στοιχεία.
  </p>
  <ol>
    <li>
      <strong>Διεκδίκηση ή δημιουργία.</strong> Ψάξτε πρώτα το όνομά σας στους Χάρτες. Αν το
      προφίλ υπάρχει ήδη (η Google συχνά το φτιάχνει μόνο του), πατήστε «Διεκδίκηση αυτής της
      επιχείρησης». Αν δεν υπάρχει, φτιάξτε το από την αρχή.
    </li>
    <li>
      <strong>Επαλήθευση.</strong> Η Google θέλει απόδειξη ότι η επιχείρηση είναι δική σας —
      με κωδικό σε γράμμα, με τηλέφωνο ή με βίντεο. Μέχρι να γίνει, το προφίλ δεν φαίνεται
      κανονικά.
    </li>
    <li>
      <strong>Κατηγορία.</strong> Διαλέξτε την πιο συγκεκριμένη που σας ταιριάζει: «Πιτσαρία»,
      όχι «Εστιατόριο». Από αυτήν καταλαβαίνει η Google σε ποιες αναζητήσεις να σας δείχνει.
    </li>
    <li>
      <strong>Ώρες.</strong> Βάλτε το πραγματικό σας ωράριο — και θυμηθείτε να το ενημερώνετε
      στις αργίες και στις διακοπές.
    </li>
    <li>
      <strong>Φωτογραφίες.</strong> Ανεβάστε τουλάχιστον 5 δικές σας, πρόσφατες: πρόσοψη,
      εσωτερικό, προϊόντα ή δουλειές σας. Όχι μόνο λογότυπο, όχι φωτογραφίες από το internet.
    </li>
    <li>
      <strong>Υπηρεσίες και προϊόντα.</strong> Γράψτε τι ακριβώς προσφέρετε, ένα-ένα. Έτσι
      εμφανίζεστε και σε πιο συγκεκριμένες αναζητήσεις.
    </li>
    <li>
      <strong>Περιγραφή.</strong> Δυο-τρεις απλές προτάσεις: τι κάνετε, πού και τι σας
      ξεχωρίζει. Γράψτε όπως μιλάτε — όχι διαφημιστικά συνθήματα.
    </li>
  </ol>

  <h2>Γιατί πρέπει τα στοιχεία σας να είναι ίδια παντού;</h2>
  <p>
    Γιατί η Google και τα εργαλεία AI διασταυρώνουν ό,τι βρίσκουν: το προφίλ σας, το site
    σας, τους καταλόγους, τα social. Όταν το όνομα, η διεύθυνση και το τηλέφωνο ταιριάζουν
    παντού, σας εμπιστεύονται· όταν κάθε πηγή λέει άλλα, μπερδεύονται — και μαζί τους
    μπερδεύεται και ο πελάτης.
  </p>
  <p>
    Κάντε ένα γρήγορο τσεκ: ίδιο όνομα (γραμμένο με τον ίδιο τρόπο), ίδια διεύθυνση, ίδιο
    τηλέφωνο στο site, στο προφίλ Google, στο Facebook και στο Instagram, και σε όποιον
    κατάλογο είστε γραμμένοι. Είναι από τα πιο απλά πράγματα που μετράνε στο SEO (το πώς σας
    κατατάσσει η αναζήτηση) — το γενικότερο πλαίσιο το εξηγούμε στον οδηγό
    <a href="/odigoi/seo-me-apla-logia/">SEO με απλά λόγια</a>.
  </p>

  <h2>Ποια είναι τα πιο συχνά λάθη;</h2>
  <p>
    Τα περισσότερα προφίλ δεν πάσχουν από κάτι περίπλοκο — πάσχουν από εγκατάλειψη. Αυτά
    είναι όσα συναντάτε πιο συχνά:
  </p>
  <ul>
    <li>
      <strong>Λάθος ωράριο.</strong> Το προφίλ λέει «Κλειστό» ενώ είστε ανοιχτά — ή το
      αντίθετο. Ο πελάτης που ήρθε και βρήκε κλειστά, δύσκολα ξανάρχεται.
    </li>
    <li>
      <strong>Παλιές ή καθόλου φωτογραφίες.</strong> Σκοτεινές λήψεις από άλλη εποχή, ή μόνο
      ό,τι ανέβασαν τυχαία οι πελάτες.
    </li>
    <li>
      <strong>Αναπάντητες κριτικές.</strong> Όποιος διαβάζει τις κριτικές βλέπει και το αν
      απαντάτε — στις καλές και στις κακές.
    </li>
    <li>
      <strong>Λάθος ή πολύ γενική κατηγορία.</strong> Η Google δεν ξέρει πού να σας δείξει,
      οπότε συχνά δεν σας δείχνει καθόλου εκεί που θα ’πρεπε.
    </li>
    <li>
      <strong>Διπλά προφίλ.</strong> Δύο μισοσυμπληρωμένα προφίλ μοιράζονται τις κριτικές και
      μπερδεύουν τους Χάρτες. Καλύτερα ένα, σωστό.
    </li>
  </ul>

  <h2>Πώς δένει το προφίλ με τις κριτικές;</h2>
  <p>
    Το αστεράκι δίπλα στο όνομά σας στους Χάρτες βγαίνει από τις κριτικές Google — και είναι
    από τα πρώτα πράγματα που κοιτάει ο πελάτης πριν διαλέξει. Ένα καλοστημένο προφίλ χωρίς
    κριτικές μένει μισό.
  </p>
  <p>
    Δύο συνήθειες αρκούν για αρχή: ζητήστε από τον ευχαριστημένο πελάτη να αφήσει δυο λόγια όσο
    η εμπειρία είναι φρέσκια, και απαντήστε σε κάθε κριτική μέσα σε 1–2 μέρες — ευγενικά, ακόμα
    κι όταν είναι άδικη. Το πώς το στήνετε πιο συστηματικά το εξηγούμε στον οδηγό
    <a href="/odigoi/perissoteres-kritikes-google/">για περισσότερες κριτικές στη Google</a>.
  </p>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Αν δεν θέλετε να παιδευτείτε, το αναλαμβάνουμε: το Setup του Google Business Profile κοστίζει
    {eur(gbpSetup.price)} εφάπαξ — διεκδίκηση ή δημιουργία, επαλήθευση, κατηγορία, ώρες,
    φωτογραφίες, υπηρεσίες, περιγραφή και ίδια στοιχεία με το site σας. Θα το βρείτε στη
    <a href="/times/">σελίδα τιμών</a>, μόνο του ή μαζί με ό,τι άλλο χρειάζεστε. Κι αν δεν
    ξέρετε από πού να ξεκινήσετε, στον δωρεάν <a href="/elegxos/">Έλεγχο των
    {ELEGXOS.minutes} λεπτών</a> βλέπουμε μαζί πώς στέκεται σήμερα το προφίλ σας — και τι
    αξίζει να φτιάξετε πρώτο.
  </p>
</Guide>
