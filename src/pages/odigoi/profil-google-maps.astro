---
import Guide from '../../layouts/Guide.astro';
import Tiles from '../../components/guide/Tiles.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const gbpSetup = optionById('gbp-setup')!;

const faq = [
  {
    q: 'Πόσο κοστίζει το προφίλ Google;',
    a: `Το ίδιο το προφίλ είναι δωρεάν: το φτιάχνετε μόνοι σας στο google.com/business. Αν θέλετε να το στήσει η PISMA, το Setup κοστίζει ${eur(gbpSetup.price)} εφάπαξ.`,
  },
  {
    q: 'Χρειάζομαι site για να έχω προφίλ Google;',
    a: 'Όχι, το προφίλ στέκεται και μόνο του. Μαζί με ένα απλό site όμως δουλεύουν πολύ καλύτερα, γιατί το ένα δίνει εμπιστοσύνη στο άλλο.',
  },
  {
    q: 'Τι κάνω αν υπάρχει ήδη προφίλ για την επιχείρησή μου;',
    a: 'Το διεκδικείτε: το βρίσκετε στους Χάρτες, πατάτε «Διεκδίκηση αυτής της επιχείρησης» και περνάτε την επαλήθευση της Google. Μην φτιάξετε δεύτερο, γιατί τα διπλά προφίλ μπερδεύουν.',
  },
  {
    q: 'Σε πόσο καιρό θα φαίνομαι στους Χάρτες;',
    a: 'Μόλις ολοκληρωθεί η επαλήθευση της Google. Ανάλογα με τη μέθοδο (γράμμα, τηλέφωνο ή βίντεο) μπορεί να πάρει από λίγα λεπτά μέχρι μερικές εβδομάδες. Η επαλήθευση με γράμμα είναι η πιο αργή.',
  },
  {
    q: 'Πόσο συχνά να ενημερώνω το προφίλ;',
    a: 'Κάθε φορά που αλλάζει κάτι (ώρες, τηλέφωνο, υπηρεσίες) και ιδανικά με μια φρέσκια φωτογραφία κάθε τόσο, για να φαίνεται ζωντανό.',
  },
];

// Λιτή δομή (10/09/2026): κάθε ενότητα = τίτλος + πλακίδια/βήματα με εικονίδιο και ΜΙΑ γραμμή.
const why = [
  { icon: 'eye', t: 'Η πρώτη σας εικόνα', d: 'Ο πελάτης το βλέπει πριν ανοίξει το site σας.' },
  { icon: 'pin', t: 'Πάνω από τα site', d: 'Στο «κοντά μου» η Google δείχνει πρώτα προφίλ.' },
  { icon: 'bot', t: 'Το διαβάζει και το AI', d: 'Το ChatGPT πατάει στα ίδια στοιχεία για να σας προτείνει.' },
];

const steps = [
  { icon: 'search', t: 'Διεκδίκηση ή δημιουργία', d: 'Ψάξτε το όνομά σας στους Χάρτες. Αν υπάρχει, διεκδικήστε το· αλλιώς φτιάξτε το.' },
  { icon: 'shield', t: 'Επαλήθευση', d: 'Με γράμμα, τηλέφωνο ή βίντεο. Μέχρι τότε το προφίλ δεν φαίνεται κανονικά.' },
  { icon: 'tag', t: 'Κατηγορία', d: 'Η πιο συγκεκριμένη: «Πιτσαρία», όχι «Εστιατόριο».' },
  { icon: 'clock', t: 'Ώρες', d: 'Το πραγματικό ωράριο, ενημερωμένο σε αργίες και διακοπές.' },
  { icon: 'camera', t: 'Φωτογραφίες', d: 'Τουλάχιστον 5 δικές σας: πρόσοψη, εσωτερικό, προϊόντα.' },
  { icon: 'list', t: 'Υπηρεσίες & προϊόντα', d: 'Ένα-ένα, για να βγαίνετε και σε πιο συγκεκριμένες αναζητήσεις.' },
  { icon: 'text', t: 'Περιγραφή', d: 'Δυο-τρεις προτάσεις, όπως μιλάτε, χωρίς συνθήματα.' },
];

const same = [
  { icon: 'home', t: 'Όνομα', d: 'Γραμμένο με τον ίδιο τρόπο σε site, Google και social.', tone: 'ok' },
  { icon: 'pin', t: 'Διεύθυνση', d: 'Ίδια σε κάθε κατάλογο που είστε γραμμένοι.', tone: 'ok' },
  { icon: 'phone', t: 'Τηλέφωνο', d: 'Ένα νούμερο, παντού το ίδιο.', tone: 'ok' },
];

const mistakes = [
  { icon: 'clock', t: 'Λάθος ωράριο', d: '«Κλειστό» ενώ είστε ανοιχτά. Ο πελάτης δεν ξανάρχεται.', tone: 'bad' },
  { icon: 'image', t: 'Παλιές φωτογραφίες', d: 'Σκοτεινές λήψεις, ή μόνο ό,τι ανέβασαν τυχαία πελάτες.', tone: 'bad' },
  { icon: 'message', t: 'Αναπάντητες κριτικές', d: 'Όλοι βλέπουν αν απαντάτε, στις καλές και στις κακές.', tone: 'bad' },
  { icon: 'tag', t: 'Γενική κατηγορία', d: 'Η Google δεν ξέρει πού να σας δείξει.', tone: 'bad' },
  { icon: 'copy', t: 'Διπλά προφίλ', d: 'Μοιράζονται τις κριτικές και μπερδεύουν τους Χάρτες.', tone: 'bad' },
];

---

<Guide
  title="Πώς θα φαίνεστε σωστά στη Google και στους Χάρτες; | PISMA"
  description="Το προφίλ Google (Business Profile) είναι η πρώτη εικόνα σας σε αναζήτηση και Χάρτες. Τι είναι, τι έχει ένα σωστό προφίλ και πόσο κοστίζει το στήσιμο."
  slug="profil-google-maps"
  question="Πώς θα φαίνεστε σωστά στη Google και στους Χάρτες;"
  sub="Για κάθε μαγαζί που θέλει να το βρίσκουν εύκολα, χωρίς τεχνικές γνώσεις."
  updated="2026-09-10"
  faq={faq}
>
  <h2>Τι είναι το προφίλ Google;</h2>
  <Tiles items={[
    { icon: 'eye', t: 'Η πρώτη σας εικόνα', d: 'Ο πελάτης το βλέπει πριν ανοίξει το site σας.' },
    { icon: 'pin', t: 'Πάνω από τα site', d: 'Στο «κοντά μου» η Google δείχνει πρώτα προφίλ.' },
    { icon: 'bot', t: 'Το διαβάζει και το AI', d: 'Το ChatGPT πατάει στα ίδια στοιχεία για να σας προτείνει.' },
  ]} />

  <h2>Τι έχει ένα σωστό προφίλ;</h2>
  <Tiles items={[
    { icon: 'shield', t: 'Επαλήθευση', d: 'Η Google ξέρει ότι είναι δικό σας.' },
    { icon: 'tag', t: 'Σωστή κατηγορία', d: 'Για να βγαίνετε στις σωστές αναζητήσεις.' },
    { icon: 'clock', t: 'Πραγματικές ώρες', d: 'Ενημερωμένες σε αργίες και διακοπές.' },
    { icon: 'camera', t: 'Δικές σας φωτογραφίες', d: 'Πρόσοψη, εσωτερικό, προϊόντα.' },
    { icon: 'list', t: 'Υπηρεσίες', d: 'Τι ακριβώς προσφέρετε, ένα-ένα.' },
    { icon: 'star', t: 'Κριτικές με απάντηση', d: 'Στις καλές και στις κακές.' },
  ]} />

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Στήσιμο του προφίλ Google: {eur(gbpSetup.price)} εφάπαξ, με όλα τα παραπάνω. Στη <a href="/times/">σελίδα τιμών</a>,
    ή ξεκινήστε από τον δωρεάν <a href="/elegxos/">Έλεγχο των {ELEGXOS.minutes} λεπτών</a>.
  </p>
</Guide>
