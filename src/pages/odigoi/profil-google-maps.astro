---
import Guide from '../../layouts/Guide.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const gbpSetup = optionById('gbp-setup')!;

const faq = [
  {
    q: 'Πόσο κοστίζει το προφίλ Google;',
    a: `Το ίδιο το προφίλ είναι δωρεάν — το φτιάχνεις μόνος σου στο google.com/business. Αν θες να το στήσει η PISMA, το Setup κοστίζει ${eur(gbpSetup.price)} εφάπαξ.`,
  },
  {
    q: 'Χρειάζομαι site για να έχω προφίλ Google;',
    a: 'Όχι, το προφίλ στέκεται και μόνο του. Μαζί με ένα απλό site όμως δουλεύουν πολύ καλύτερα — το ένα δίνει εμπιστοσύνη στο άλλο.',
  },
  {
    q: 'Τι κάνω αν υπάρχει ήδη προφίλ για την επιχείρησή μου;',
    a: 'Το διεκδικείς: το βρίσκεις στους Χάρτες, πατάς «Διεκδίκηση αυτής της επιχείρησης» και περνάς την επαλήθευση του Google. Μη φτιάξεις δεύτερο — τα διπλά προφίλ μπερδεύουν.',
  },
  {
    q: 'Σε πόσο καιρό θα φαίνομαι στους Χάρτες;',
    a: 'Μόλις ολοκληρωθεί η επαλήθευση του Google. Ανάλογα με τη μέθοδο (γράμμα, τηλέφωνο ή βίντεο) μπορεί να πάρει από λίγα λεπτά μέχρι μερικές μέρες.',
  },
  {
    q: 'Πόσο συχνά να ενημερώνω το προφίλ;',
    a: 'Κάθε φορά που αλλάζει κάτι — ώρες, τηλέφωνο, υπηρεσίες — και ιδανικά με μια φρέσκια φωτογραφία κάθε τόσο, για να φαίνεται ζωντανό.',
  },
];
---

<Guide
  title="Πώς θα φαίνεσαι σωστά στο Google και στους Χάρτες; | PISMA"
  description="Το προφίλ Google (Business Profile) είναι η πρώτη εικόνα σου σε αναζήτηση και Χάρτες. Βήμα-βήμα: επαλήθευση, κατηγορία, ώρες, φωτογραφίες, κριτικές."
  slug="profil-google-maps"
  question="Πώς θα φαίνεσαι σωστά στο Google και στους Χάρτες;"
  sub="Για κάθε μαγαζί που θέλει να το βρίσκουν εύκολα — χωρίς τεχνικές γνώσεις."
  answer="Φτιάχνεις (ή διεκδικείς) δωρεάν το προφίλ σου στο Google Business Profile, το επαληθεύεις και το συμπληρώνεις: σωστή κατηγορία, πραγματικές ώρες, φρέσκες φωτογραφίες, υπηρεσίες και περιγραφή. Μετά φροντίζεις όνομα, διεύθυνση και τηλέφωνο να είναι ίδια παντού — στο site, στους καταλόγους, στα social — και απαντάς στις κριτικές. Έτσι σε βρίσκουν σωστά και το Google και τα εργαλεία AI, όπως το ChatGPT."
  updated="2026-07-28"
  faq={faq}
>
  <h2>Τι είναι το προφίλ Google και γιατί σε νοιάζει;</h2>
  <p>
    Το προφίλ Google (Google Business Profile) είναι η κάρτα της επιχείρησής σου μέσα στην
    αναζήτηση Google και στους Χάρτες: όνομα, ώρες, τηλέφωνο, φωτογραφίες, κριτικές και το
    κουμπί «Οδηγίες» για να έρθουν να σε βρουν. Για τους περισσότερους πελάτες είναι η πρώτη
    εικόνα σου — τη βλέπουν πριν καν ανοίξουν το site σου.
  </p>
  <p>
    Όταν κάποιος ψάχνει «συνεργείο κοντά μου» ή «πιτσαρία Γλυφάδα», το Google δείχνει πρώτα
    προφίλ επιχειρήσεων, όχι ιστοσελίδες. Και τα εργαλεία AI, όπως το ChatGPT, πατάνε στα ίδια
    στοιχεία όταν τους ζητάς να προτείνουν ένα μαγαζί. Το προφίλ είναι δωρεάν — το μόνο που
    χρειάζεται είναι να το στήσεις σωστά και να το κρατάς ζωντανό.
  </p>

  <h2>Πώς το φτιάχνεις, βήμα-βήμα;</h2>
  <p>
    Πηγαίνεις στο google.com/business, συνδέεσαι με έναν λογαριασμό Google και ακολουθείς τα
    βήματα. Δεν χρειάζεσαι τεχνικές γνώσεις — χρειάζεσαι λίγη υπομονή και σωστά στοιχεία.
  </p>
  <ol>
    <li>
      <strong>Διεκδίκηση ή δημιουργία.</strong> Ψάξε πρώτα το όνομά σου στους Χάρτες. Αν το
      προφίλ υπάρχει ήδη (το Google συχνά το φτιάχνει μόνο του), πάτα «Διεκδίκηση αυτής της
      επιχείρησης». Αν δεν υπάρχει, φτιάξ' το από την αρχή.
    </li>
    <li>
      <strong>Επαλήθευση.</strong> Το Google θέλει απόδειξη ότι η επιχείρηση είναι δική σου —
      με κωδικό σε γράμμα, με τηλέφωνο ή με βίντεο. Μέχρι να γίνει, το προφίλ δεν φαίνεται
      κανονικά.
    </li>
    <li>
      <strong>Κατηγορία.</strong> Διάλεξε την πιο συγκεκριμένη που σου ταιριάζει: «Πιτσαρία»,
      όχι «Εστιατόριο». Από αυτήν καταλαβαίνει το Google σε ποιες αναζητήσεις να σε δείχνει.
    </li>
    <li>
      <strong>Ώρες.</strong> Βάλε το πραγματικό σου ωράριο — και θυμήσου να το ενημερώνεις
      στις αργίες και στις διακοπές.
    </li>
    <li>
      <strong>Φωτογραφίες.</strong> Ανέβασε τουλάχιστον 5 δικές σου, πρόσφατες: πρόσοψη,
      εσωτερικό, προϊόντα ή δουλειές σου. Όχι μόνο λογότυπο, όχι φωτογραφίες από το internet.
    </li>
    <li>
      <strong>Υπηρεσίες και προϊόντα.</strong> Γράψε τι ακριβώς προσφέρεις, ένα-ένα. Έτσι
      εμφανίζεσαι και σε πιο συγκεκριμένες αναζητήσεις.
    </li>
    <li>
      <strong>Περιγραφή.</strong> Δυο-τρεις απλές προτάσεις: τι κάνεις, πού και τι σε
      ξεχωρίζει. Γράψε όπως μιλάς — όχι διαφημιστικά συνθήματα.
    </li>
  </ol>

  <h2>Γιατί πρέπει τα στοιχεία σου να είναι ίδια παντού;</h2>
  <p>
    Γιατί το Google και τα εργαλεία AI διασταυρώνουν ό,τι βρίσκουν: το προφίλ σου, το site
    σου, τους καταλόγους, τα social. Όταν το όνομα, η διεύθυνση και το τηλέφωνο ταιριάζουν
    παντού, σε εμπιστεύονται· όταν κάθε πηγή λέει άλλα, μπερδεύονται — και μαζί τους
    μπερδεύεται και ο πελάτης.
  </p>
  <p>
    Κάνε ένα γρήγορο τσεκ: ίδιο όνομα (γραμμένο με τον ίδιο τρόπο), ίδια διεύθυνση, ίδιο
    τηλέφωνο στο site, στο προφίλ Google, στο Facebook και στο Instagram, και σε όποιον
    κατάλογο είσαι γραμμένος. Είναι από τα πιο απλά πράγματα που μετράνε στο SEO (το πώς σε
    κατατάσσει η αναζήτηση) — το γενικότερο πλαίσιο το εξηγούμε στον οδηγό
    <a href="/odigoi/seo-me-apla-logia/">SEO με απλά λόγια</a>.
  </p>

  <h2>Ποια είναι τα πιο συχνά λάθη;</h2>
  <p>
    Τα περισσότερα προφίλ δεν πάσχουν από κάτι περίπλοκο — πάσχουν από εγκατάλειψη. Αυτά
    είναι όσα συναντάς πιο συχνά:
  </p>
  <ul>
    <li>
      <strong>Λάθος ωράριο.</strong> Το προφίλ λέει «Κλειστό» ενώ είσαι ανοιχτά — ή το
      αντίθετο. Ο πελάτης που ήρθε και βρήκε κλειστά, δύσκολα ξανάρχεται.
    </li>
    <li>
      <strong>Παλιές ή καθόλου φωτογραφίες.</strong> Σκοτεινές λήψεις από άλλη εποχή, ή μόνο
      ό,τι ανέβασαν τυχαία οι πελάτες.
    </li>
    <li>
      <strong>Αναπάντητες κριτικές.</strong> Όποιος διαβάζει τις κριτικές βλέπει και το αν
      απαντάς — στις καλές και στις κακές.
    </li>
    <li>
      <strong>Λάθος ή πολύ γενική κατηγορία.</strong> Το Google δεν ξέρει πού να σε δείξει,
      οπότε συχνά δεν σε δείχνει καθόλου εκεί που θα 'πρεπε.
    </li>
    <li>
      <strong>Διπλά προφίλ.</strong> Δύο μισοσυμπληρωμένα προφίλ μοιράζονται τις κριτικές και
      μπερδεύουν τους Χάρτες. Καλύτερα ένα, σωστό.
    </li>
  </ul>

  <h2>Πώς δένει το προφίλ με τις κριτικές;</h2>
  <p>
    Το αστεράκι δίπλα στο όνομά σου στους Χάρτες βγαίνει από τις κριτικές Google — και είναι
    από τα πρώτα πράγματα που κοιτάει ο πελάτης πριν διαλέξει. Ένα καλοστημένο προφίλ χωρίς
    κριτικές μένει μισό.
  </p>
  <p>
    Δύο συνήθειες αρκούν για αρχή: ζήτα από τον ευχαριστημένο πελάτη να αφήσει δυο λόγια όσο
    η εμπειρία είναι φρέσκια, και απάντα σε κάθε κριτική μέσα σε 1–2 μέρες — ευγενικά, ακόμα
    κι όταν είναι άδικη. Το πώς το στήνεις πιο συστηματικά το εξηγούμε στον οδηγό
    <a href="/odigoi/perissoteres-kritikes-google/">για περισσότερες κριτικές στο Google</a>.
  </p>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Αν δεν θες να παιδευτείς, το αναλαμβάνουμε: το Setup του Google Business Profile κοστίζει
    {eur(gbpSetup.price)} εφάπαξ — διεκδίκηση ή δημιουργία, επαλήθευση, κατηγορία, ώρες,
    φωτογραφίες, υπηρεσίες, περιγραφή και ίδια στοιχεία με το site σου. Θα το βρεις στη
    <a href="/times/">σελίδα τιμών</a>, μόνο του ή μαζί με ό,τι άλλο χρειάζεσαι. Κι αν δεν
    ξέρεις από πού να ξεκινήσεις, στον δωρεάν <a href="/elegxos/">Έλεγχο των
    {ELEGXOS.minutes} λεπτών</a> βλέπουμε μαζί πώς στέκεται σήμερα το προφίλ σου — και τι
    αξίζει να φτιάξεις πρώτο.
  </p>
</Guide>
