---
import Guide from '../../layouts/Guide.astro';
import Tiles from '../../components/guide/Tiles.astro';
import { optionById } from '../../data/pricing';
import { eur, ELEGXOS } from '../../config';

const setup = optionById('soc-setup')!;
const p1pisma = optionById('soc-1p-pisma')!;
const p23pisma = optionById('soc-23p-pisma')!;
const p1own = optionById('soc-1p-own')!;
const p23own = optionById('soc-23p-own')!;

const faq = [
  {
    q: 'Χρειάζομαι social media αν έχω ήδη site;',
    a: 'Το site είναι η βάση σας και τα social η καθημερινή σας παρουσία. Το ένα δεν αντικαθιστά το άλλο. Και τα δύο τα διαβάζουν η Google και τα εργαλεία AI για να καταλάβουν την επιχείρησή σας.',
  },
  {
    q: 'Ποιος βγάζει τις φωτογραφίες και τα βίντεο;',
    a: 'Ό,τι σας βολεύει: είτε δίνετε εσείς το υλικό και το ετοιμάζουμε εμείς για δημοσίευση, είτε αναλαμβάνει όλο το υλικό η PISMA. Η τιμή διαφέρει ανάλογα.',
  },
  {
    q: 'Σε ποιες πλατφόρμες;',
    a: 'Σε όσες έχει νόημα για τη δική σας δουλειά, συνήθως Instagram και Facebook, και όπου αλλού βρίσκονται οι πελάτες σας. Επιλέγετε 1 ή 2–3 πλατφόρμες.',
  },
  {
    q: 'Δεσμεύομαι με συμβόλαιο;',
    a: 'Όχι. Η μηνιαία διαχείριση σταματά όποτε το αποφασίσετε. Υπάρχει και σκέτο ξεκαθάρισμα-στήσιμο, εφάπαξ, χωρίς καμία συνδρομή.',
  },
];
---

<Guide
  title="Τι είναι η διαχείριση social media; | PISMA"
  description="Διαχείριση social media σημαίνει ότι οι σελίδες σας σε Instagram και Facebook μένουν ζωντανές με τακτικές δημοσιεύσεις, χωρίς να ασχολείστε εσείς."
  slug="diaxeirisi-social-media"
  question="Τι είναι η διαχείριση social media;"
  sub="Τι περιλαμβάνει, ποιες επιλογές υπάρχουν και τι κοστίζει."
  updated="2026-09-10"
  faq={faq}
>
  <h2>Τι περιλαμβάνει;</h2>
  <Tiles cols={2} items={[
    { icon: 'image', t: 'Ετοιμασία δημοσιεύσεων', d: 'Κείμενα, εικόνες, μορφοποίηση.' },
    { icon: 'calendar', t: 'Τακτικό ανέβασμα', d: 'Οι σελίδες μένουν ζωντανές κάθε εβδομάδα.' },
  ]} />

  <h2>Οι επιλογές της PISMA</h2>
  <table>
    <thead>
      <tr><th>Επιλογή</th><th>Τι περιλαμβάνει</th><th>Τιμή</th></tr>
    </thead>
    <tbody>
      <tr><td><strong>{setup.label}</strong></td><td>{setup.detail}</td><td>{eur(setup.price)} εφάπαξ</td></tr>
      <tr><td><strong>{p1pisma.label}</strong></td><td>{p1pisma.detail}</td><td>{eur(p1pisma.price)} τον μήνα</td></tr>
      <tr><td><strong>{p23pisma.label}</strong></td><td>{p23pisma.detail}</td><td>{eur(p23pisma.price)} τον μήνα</td></tr>
      <tr><td><strong>{p1own.label}</strong></td><td>{p1own.detail}</td><td>{eur(p1own.price)} τον μήνα</td></tr>
      <tr><td><strong>{p23own.label}</strong></td><td>{p23own.detail}</td><td>{eur(p23own.price)} τον μήνα</td></tr>
    </tbody>
  </table>

  <h2>Πώς βοηθάει η PISMA;</h2>
  <p>
    Όλες οι τιμές στη <a href="/times/">σελίδα τιμών</a>, χωρίς συμβόλαιο. Ή ξεκινήστε από τον
    <a href="/elegxos/">δωρεάν Έλεγχο</a> των {ELEGXOS.minutes} λεπτών.
  </p>
</Guide>
