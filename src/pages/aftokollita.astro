---
// Showroom αυτοκόλλητων QR — ο φυσικός «διακόπτης» του Τροχού των Κριτικών.
// Σκόπιμα σκούρο και αυτόνομο (δεν χρησιμοποιεί το Base): λειτουργεί ως
// showroom προϊόντος, τύπου car configurator. Η τιμή της πλατφόρμας έρχεται
// από το pricing.ts (auto-reviews) — μία πηγή αλήθειας.
// Οι τιμές των αυτοκόλλητων (πίνακας F στο script) είναι ο επίσημος
// τιμοκατάλογός τους — ό,τι αλλάζει, αλλάζει εδώ.
import { SITE } from '../config';
import '../styles/fonts.css'; // self-hosted Inter/Unbounded/JetBrains Mono — ίδιες με το υπόλοιπο site

const title = 'Αυτοκόλλητα QR — Ο Τροχός των Κριτικών | PISMA';
const description =
  'Διάλεξε από 16 αυτοκόλλητα QR για τραπέζι, ταμείο, βιτρίνα και delivery — με τα χρώματα και το όνομα του μαγαζιού σου. Στέλνεις το καλάθι, σε παίρνουμε τηλέφωνο.';
const canonical = `${SITE.url}/aftokollita/`;
---

<!doctype html>
<html lang="el">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="el" href={`${SITE.url}/aftokollita/`}>
<link rel="alternate" hreflang="en" href={`${SITE.url}/en/qr-stickers/`}>
<link rel="alternate" hreflang="x-default" href={`${SITE.url}/aftokollita/`}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:locale" content="el_GR">
<meta property="og:image" content={`${SITE.url}/og.png`}>
<!-- Google Fonts μόνο για τη Noto Sans Display: είναι η γραμματοσειρά ΤΟΥ ΠΡΟΪΟΝΤΟΣ
     (τα SVG των αυτοκόλλητων, ίδια και στην εκτύπωση) — το UI χρησιμοποιεί τις
     self-hosted γραμματοσειρές του site. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Display:wght@700;800;900&display=swap" rel="stylesheet">
<style is:global>
/* Tokens του site (src/styles/global.css) — το showroom μιλά την ίδια γλώσσα. */
:root{
  --bg0:#0D0A14;--bg1:#14101E;--card:#171221;--card2:#1E1830;--line:rgba(255,255,255,.09);--line2:rgba(255,255,255,.16);
  --txt:#E6E1F0;--head:#F5F2FB;--dim:#A79DBB;
  --acc:#FF7A50;--acc-text:#FFA284;--acc-soft:rgba(255,122,80,.13);
  --grad:linear-gradient(92deg,#CC431C 0%,#BE3A17 55%,#AC3213 100%);
  --ok:#55A874;--ok-text:#A5D6B8;--err:#FF5C41;
  --disp:'Inter',system-ui,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:
  radial-gradient(70% 60% at 88% 0%,rgba(139,92,246,.08),transparent 70%),
  radial-gradient(130% 90% at 50% 0%,var(--bg1),var(--bg0) 62%);color:var(--txt);
  font-family:'Inter',system-ui,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;min-height:100svh}
button{font-family:inherit;color:inherit}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px;border-radius:6px}
input{font-family:inherit}

.app{min-height:100svh;display:flex;flex-direction:column;overflow-x:clip}
/* ^ το clip κόβει το glow (.spot::before) που ξεχείλωνε οριζόντια σε κινητό —
   η λωρίδα .strip σκρολάρει εσωτερικά, δεν επηρεάζεται */

/* ================= top ================= */
.top{display:flex;align-items:center;gap:18px;padding:16px 26px;border-bottom:1px solid var(--line)}
.logo{display:flex;align-items:baseline;gap:8px;font-family:'Unbounded','Inter',sans-serif;font-weight:800;font-size:17px;letter-spacing:.01em;
  color:var(--head);text-decoration:none}
.logo b{font-weight:inherit;white-space:nowrap}
.logo b i{color:var(--acc);font-style:normal}
.logo em{font-style:normal;color:var(--dim);font-weight:600;font-size:11px;letter-spacing:.22em;margin-left:2px;font-family:var(--disp)}
.whatlink{color:var(--dim);font-size:12px;font-weight:700;text-decoration:none;letter-spacing:.03em;white-space:nowrap}
.whatlink:hover{color:var(--acc-text)}
.bizwrap{flex:1;display:flex;justify-content:center}
.biz{background:none;border:0;border-bottom:1.5px solid var(--line2);color:var(--head);
  font:700 15px var(--disp);letter-spacing:.06em;text-align:center;padding:6px 10px;width:min(240px,46vw);transition:border-color .15s;text-transform:uppercase}
.biz:hover,.biz:focus{border-color:var(--acc)}
.biz::placeholder{color:var(--dim)}
.cartbtn{position:relative;background:none;border:1.5px solid var(--line2);border-radius:100px;
  padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer;display:flex;gap:9px;align-items:center;transition:.15s}
.cartbtn:hover{border-color:var(--acc);color:var(--acc-text)}
.cartbtn i{font-style:normal;background:var(--grad);color:#fff;border-radius:100px;min-width:21px;height:21px;
  font-size:11.5px;font-weight:800;display:grid;place-items:center;padding:0 6px;font-family:var(--mono)}

/* ================= stage ================= */
.stage{flex:1;display:grid;grid-template-columns:74px 1fr 74px;align-items:center;min-height:0;padding:8px 12px 0}
.nav{width:52px;height:52px;border-radius:50%;border:1.5px solid var(--line2);background:rgba(255,255,255,.03);
  cursor:pointer;display:grid;place-items:center;justify-self:center;transition:.15s;font-size:0}
.nav:hover{border-color:var(--acc);background:var(--acc-soft)}
.nav svg{stroke:var(--txt)}
.nav:hover svg{stroke:var(--acc)}
.artwrap{display:flex;flex-direction:column;align-items:center;min-width:0}
.spot{position:relative;display:grid;place-items:center;width:100%}
.spot::before{content:"";position:absolute;width:min(64vh,560px);height:min(64vh,560px);border-radius:50%;
  background:radial-gradient(circle,rgba(238,79,39,.16),transparent 62%);pointer-events:none}
.art{position:relative;display:flex;flex-direction:column;align-items:center}
.art svg{max-height:min(44vh,430px);max-width:min(86vw,620px);width:auto;height:auto;
  filter:drop-shadow(0 30px 50px rgba(0,0,0,.6))}
.art.in{animation:swap .34s cubic-bezier(.25,.9,.3,1)}
@keyframes swap{from{opacity:0;transform:translateX(22px) scale(.97)}to{opacity:1;transform:none}}
.art.in.rev{animation-name:swapR}
@keyframes swapR{from{opacity:0;transform:translateX(-22px) scale(.97)}to{opacity:1;transform:none}}

/* ================= info row ================= */
.info{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:6px 30px 14px;flex-wrap:wrap}
.info .l .idx{font-size:11px;letter-spacing:.24em;color:var(--dim);font-weight:700;margin-bottom:4px;font-family:var(--mono)}
.info .l h1{font-family:var(--disp);font-weight:700;color:var(--head);font-size:clamp(21px,2.6vw,30px);margin:0;letter-spacing:-.022em;line-height:1.12}
.info .l .sz{color:var(--dim);font-size:13px;font-weight:500;margin-top:3px}
.info .r{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.price{font-family:var(--mono);font-weight:700;letter-spacing:-.02em;color:var(--head);font-size:24px}
.price small{font-size:12px;color:var(--dim);font-weight:600;font-family:var(--disp);letter-spacing:0;margin-left:5px}
.badd{background:var(--grad);color:#fff;border:0;border-radius:10px;padding:14px 27px;
  font-size:14px;font-weight:700;cursor:pointer;transition:filter .15s,box-shadow .15s,transform .15s;letter-spacing:.01em;
  box-shadow:0 6px 24px rgba(238,79,39,.35)}
.badd:hover{filter:brightness(1.08);box-shadow:0 10px 32px rgba(238,79,39,.45);transform:translateY(-2px)}
.badd:active{transform:none}
.stq{display:inline-flex;align-items:center;border:1.5px solid var(--acc);border-radius:10px;overflow:hidden}
.stq button{width:42px;height:44px;border:0;background:none;font-size:19px;cursor:pointer;transition:.12s}
.stq button:hover{background:var(--acc-soft)}
.stq span{width:40px;text-align:center;font-size:15px;font-weight:700;font-family:var(--mono)}
.inbag{font-size:11px;color:var(--ok-text);font-weight:700;letter-spacing:.06em;text-transform:uppercase;display:block;text-align:center;margin-top:5px}

/* ================= style bar ================= */
.style{display:flex;align-items:center;justify-content:center;gap:22px;padding:4px 20px 12px;flex-wrap:wrap}
.style .grp{display:flex;align-items:center;gap:9px}
.style label{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);font-weight:700}
.dots{display:flex;gap:7px}
.dot{width:26px;height:26px;border-radius:50%;border:2px solid transparent;box-shadow:0 0 0 1.5px var(--line2);
  cursor:pointer;padding:0;overflow:hidden;display:flex;transition:transform .14s}
.dot:hover{transform:scale(1.14)}
.dot i{flex:1}
.dot[aria-pressed="true"]{box-shadow:0 0 0 2px var(--acc)}
.wchips{display:flex;gap:6px;flex-wrap:wrap}
.wchips button{border:1px solid var(--line2);background:var(--card);border-radius:999px;padding:6px 13px;
  font-size:11.5px;font-weight:700;cursor:pointer;letter-spacing:.04em;color:var(--dim);transition:.14s}
.wchips button:hover{color:var(--txt);border-color:rgba(255,255,255,.3)}
.wchips button[aria-pressed="true"]{background:var(--acc-soft);border-color:rgba(255,122,80,.5);color:var(--acc-text)}

/* ================= filmstrip ================= */
.deck{border-top:1px solid var(--line);padding:12px 0 16px;background:rgba(0,0,0,.22)}
.cats{display:flex;gap:6px;justify-content:center;margin-bottom:11px;flex-wrap:wrap}
.cats button{border:0;background:none;color:var(--dim);font-size:11.5px;font-weight:700;cursor:pointer;
  padding:6px 13px;border-radius:999px;letter-spacing:.05em;transition:.13s}
.cats button:hover{color:var(--txt)}
.cats button[aria-pressed="true"]{background:var(--acc-soft);color:var(--acc-text)}
.strip{display:flex;gap:11px;overflow-x:auto;padding:4px 26px 8px;scrollbar-width:thin;scroll-behavior:smooth}
.strip::-webkit-scrollbar{height:6px}
.strip::-webkit-scrollbar-thumb{background:var(--line2);border-radius:10px}
.th{flex:0 0 auto;width:96px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,0) 60%),var(--card);border:1px solid var(--line);border-radius:13px;
  padding:8px;cursor:pointer;transition:.15s;position:relative;text-align:center}
.th:hover{border-color:var(--line2);transform:translateY(-3px)}
.th[aria-pressed="true"]{border-color:var(--acc);box-shadow:0 0 0 1px var(--acc)}
.th .im{height:58px;display:grid;place-items:center;margin-bottom:6px}
.th .im svg{max-height:56px;max-width:100%;height:auto;filter:drop-shadow(0 4px 8px rgba(0,0,0,.5))}
.th b{font-size:9.8px;font-weight:700;display:block;line-height:1.25;color:var(--dim)}
.th[aria-pressed="true"] b{color:var(--txt)}
.th .n{position:absolute;top:-6px;right:-6px;background:var(--grad);color:#fff;border-radius:100px;
  min-width:19px;height:19px;font-size:10.5px;font-weight:800;display:grid;place-items:center;padding:0 5px;font-family:var(--mono)}

/* ================= cart panel ================= */
.ovl{position:fixed;inset:0;background:rgba(4,10,15,.6);opacity:0;pointer-events:none;transition:.2s;z-index:50}
.ovl.on{opacity:1;pointer-events:auto}
.cart{position:fixed;top:0;right:0;bottom:0;width:392px;max-width:96vw;background:linear-gradient(180deg,var(--card2),var(--bg1));
  border-left:1px solid var(--line);z-index:51;transform:translateX(103%);transition:transform .28s cubic-bezier(.3,.9,.3,1);
  display:flex;flex-direction:column;box-shadow:-24px 0 60px rgba(0,0,0,.5)}
.cart.on{transform:none}
.chead{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--line)}
.chead h2{margin:0;font-family:var(--disp);font-size:18px;font-weight:700;color:var(--head);letter-spacing:-.022em}
.chead button{background:none;border:0;font-size:22px;cursor:pointer;color:var(--dim);line-height:1;padding:2px 6px}
.chead button:hover{color:var(--txt)}
.cbody{flex:1;overflow-y:auto;padding:6px 22px}
.csec{padding:14px 0;border-bottom:1px solid var(--line)}
.csec:last-child{border-bottom:0}
.csec h3{margin:0 0 10px;font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
.empty{color:var(--dim);font-size:13px;text-align:center;padding:22px 8px;line-height:1.7}
.li{display:flex;gap:11px;align-items:center;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.li:last-child{border-bottom:0}
.li .im{width:44px;height:44px;border-radius:9px;background:rgba(255,255,255,.05);display:grid;place-items:center;flex:0 0 auto;padding:4px}
.li .im svg{max-width:100%;max-height:36px;height:auto}
.li .tx{flex:1;min-width:0}
.li .tx b{display:block;font-size:12.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.li .tx span{font-size:11px;color:var(--dim)}
.miniq{display:inline-flex;align-items:center;border:1px solid var(--line2);border-radius:8px;overflow:hidden}
.miniq button{width:25px;height:25px;border:0;background:none;font-size:14px;cursor:pointer}
.miniq button:hover{background:rgba(255,255,255,.07)}
.miniq span{width:23px;text-align:center;font-size:12px;font-weight:800}
.li .amt{font-size:12.5px;font-weight:800;width:44px;text-align:right;flex:0 0 auto}
.x{background:none;border:0;color:var(--dim);cursor:pointer;font-size:16px;line-height:1;padding:0 1px}
.x:hover{color:var(--err)}
.xr{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.xr:last-child{border-bottom:0}
.xr .tx{flex:1;min-width:0}
.xr .tx b{display:block;font-size:12.5px;font-weight:700}
.xr .tx span{font-size:11px;color:var(--dim);line-height:1.4;display:block}
.xr .pr{font-size:11.5px;font-weight:800;white-space:nowrap;color:var(--txt)}
.tgl{width:37px;height:21px;border-radius:100px;border:1.5px solid var(--line2);background:rgba(255,255,255,.06);
  position:relative;cursor:pointer;flex:0 0 auto;transition:.16s}
.tgl::after{content:"";position:absolute;top:1.5px;left:2px;width:15px;height:15px;border-radius:50%;background:var(--dim);transition:.16s}
.tgl[aria-pressed="true"]{background:var(--ok);border-color:var(--ok)}
.tgl[aria-pressed="true"]::after{left:17px;background:#fff}
.tgl[disabled]{opacity:.55;cursor:not-allowed}
.more{background:none;border:0;color:var(--acc-text);font-size:11.5px;font-weight:700;cursor:pointer;padding:7px 0 0;letter-spacing:.03em}
.tot{display:flex;justify-content:space-between;align-items:baseline;padding:2px 0;font-size:13px}
.tot span{color:var(--dim);font-weight:600}
.tot b{font-family:var(--mono);font-size:20px;font-weight:700;letter-spacing:-.02em;color:var(--head)}
.tot.sm b{font-size:13.5px}
.note{font-size:11px;color:var(--dim);line-height:1.6;margin-top:9px}
.cfoot{padding:16px 22px 20px;border-top:1px solid var(--line);background:rgba(0,0,0,.18)}
.cfoot input{width:100%;background:rgba(255,255,255,.06);border:1.5px solid var(--line2);border-radius:10px;
  padding:11px 13px;font:600 13px var(--disp);color:var(--txt);margin-bottom:8px;transition:border-color .15s}
.cfoot input::placeholder{color:var(--dim)}
.cfoot input:focus{border-color:var(--acc);outline:none}
.cfoot input.err{border-color:var(--err)}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.send{width:100%;background:var(--grad);color:#fff;border:0;border-radius:10px;padding:14px;
  font-size:14px;font-weight:700;cursor:pointer;transition:filter .15s,box-shadow .15s;margin-top:3px;
  box-shadow:0 6px 24px rgba(238,79,39,.35)}
.send:hover:not(:disabled){filter:brightness(1.08);box-shadow:0 10px 32px rgba(238,79,39,.45)}
.send:disabled{background:rgba(255,255,255,.12);color:var(--dim);cursor:not-allowed}
.senderr{display:none;color:var(--err);font-size:12px;font-weight:600;text-align:center;margin-top:9px;line-height:1.5}
.senderr.on{display:block}
.safe{font-size:11px;color:var(--dim);text-align:center;margin-top:9px;line-height:1.5}

/* ================= done ================= */
.modal{position:fixed;inset:0;display:none;place-items:center;z-index:60;padding:20px;background:rgba(4,10,15,.7)}
.modal.on{display:grid}
.mcard{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line2);border-radius:16px;
  padding:30px;max-width:460px;width:100%;text-align:center;animation:rise .24s ease-out;
  box-shadow:0 2px 8px rgba(0,0,0,.35),0 14px 40px rgba(0,0,0,.35)}
@keyframes rise{from{transform:translateY(16px);opacity:0}to{transform:none;opacity:1}}
.tk{width:52px;height:52px;border-radius:50%;background:rgba(85,168,116,.15);display:grid;place-items:center;margin:0 auto 13px}
.mcard h2{font-family:var(--disp);font-size:22px;margin:0 0 7px;font-weight:700;color:var(--head);letter-spacing:-.022em}
.mcard>p{color:var(--dim);font-size:13.5px;margin:0 0 16px;line-height:1.6}
.rec{text-align:left;border-top:1px solid var(--line);padding-top:13px;display:flex;flex-direction:column;gap:6px;font-size:12.5px}
.rec div{display:flex;justify-content:space-between;gap:10px}
.rec span{color:var(--dim)}
.code{background:rgba(0,0,0,.3);border:1px solid var(--line);border-radius:10px;padding:11px;
  font:700 10px var(--mono);word-break:break-all;color:var(--dim);text-align:left;margin-top:13px}
.ghostb{width:100%;background:none;color:var(--head);border:0;box-shadow:inset 0 0 0 1.5px var(--line2);border-radius:10px;
  padding:13px;font-size:13.5px;font-weight:700;cursor:pointer;margin-top:14px;transition:box-shadow .15s}
.ghostb:hover{box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.35)}

@media(max-width:760px){
  .top{padding:13px 16px;gap:12px}
  .logo em{display:none}
  .whatlink{display:none}
  .stage{grid-template-columns:44px 1fr 44px;padding:4px 4px 0}
  .nav{width:40px;height:40px}
  .art{width:100%}
  .art svg{max-height:34vh;max-width:100%}
  .info{padding:4px 18px 10px}
  .price{font-size:21px}
  .badd{padding:12px 20px;font-size:13px}
  .style{gap:12px}
  .cartbtn span{display:none}
}
</style>
</head>
<body>

<div class="app">

  <!-- ============ top ============ -->
  <div class="top">
    <a class="logo" href="/"><b>PISMA<i>.</i></b><em>SHOWROOM</em></a>
    <a class="whatlink" href="/kritikes/">Τι είναι ο Τροχός; →</a>
    <span class="bizwrap"><input class="biz" id="f-biz" value="CAFÉ KYMA" maxlength="22" placeholder="ΤΟ ΜΑΓΑΖΙ ΣΟΥ" aria-label="Όνομα μαγαζιού"></span>
    <button class="cartbtn" id="cartbtn"><span>Καλάθι</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h13l-1.5 9h-10L6 7ZM6 7 5 4H3"/><circle cx="9.5" cy="20" r="1.4"/><circle cx="15.5" cy="20" r="1.4"/></svg>
      <i id="cartcount" style="display:none">0</i></button>
  </div>

  <!-- ============ stage ============ -->
  <div class="stage">
    <button class="nav" id="prev" aria-label="Προηγούμενο"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
    <div class="artwrap"><div class="spot"><div class="art" id="art"></div></div></div>
    <button class="nav" id="next" aria-label="Επόμενο"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
  </div>

  <!-- ============ info ============ -->
  <div class="info">
    <div class="l">
      <div class="idx" id="idx">01 / 16</div>
      <h1 id="stgname"></h1>
      <div class="sz" id="stgsize"></div>
    </div>
    <div class="r">
      <span class="price"><span id="stgprice"></span><small>/ πακέτο</small></span>
      <span id="stgact"></span>
    </div>
