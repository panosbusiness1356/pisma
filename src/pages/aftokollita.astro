<script>
import { FORM_ENDPOINT, optionById } from '../data/pricing';

/* Η πλατφόρμα του Τροχού τιμολογείται από το pricing.ts — μία πηγή αλήθειας. */
const PLATFORM_PRICE = optionById('auto-reviews')?.price ?? 39;

/* ================= PURE ================= */
function mb(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const GRID=(function(seed){const N=25,g=Array.from({length:N},()=>Array(N).fill(0)),rs=Array.from({length:N},()=>Array(N).fill(false)),rnd=mb(seed);
 const fin=(x,y)=>{for(let i=-1;i<8;i++)for(let j=-1;j<8;j++){const X=x+i,Y=y+j;if(X<0||Y<0||X>=N||Y>=N)continue;rs[Y][X]=true;
   const e=(i===0||i===6||j===0||j===6),k=(i>=2&&i<=4&&j>=2&&j<=4);g[Y][X]=(i>=0&&i<=6&&j>=0&&j<=6&&(e||k))?1:0;}};
 fin(0,0);fin(N-7,0);fin(0,N-7);
 for(let i=0;i<5;i++)for(let j=0;j<5;j++){const X=N-9+i,Y=N-9+j;rs[Y][X]=true;g[Y][X]=((i===0||i===4||j===0||j===4)||(i===2&&j===2))?1:0;}
 for(let i=8;i<N-8;i++){g[6][i]=i%2?0:1;rs[6][i]=true;g[i][6]=i%2?0:1;rs[i][6]=true;}
 for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(!rs[y][x])g[y][x]=rnd()>.5?1:0;return g;})(97);
function qrPath(x,y,s){const N=25,m=s/N;let d='';
 for(let r=0;r<N;r++)for(let c=0;c<N;c++)if(GRID[r][c])d+=`M${(x+c*m).toFixed(1)} ${(y+r*m).toFixed(1)}h${m.toFixed(1)}v${m.toFixed(1)}h-${m.toFixed(1)}z`;
 return d;}

const F=[
{id:'tameio', n:'Στο ταμείο',        sz:'10 × 10 cm · 25 τεμ.', pr:29, w:1000,h:1000, L:'stack',  cat:'in'},
{id:'trapezi',n:'Στο τραπέζι',       sz:'A6 σταντ · 10 τεμ.',   pr:35, w:820, h:1180, L:'stack',  cat:'table'},
{id:'pos',    n:'Δίπλα στο POS',     sz:'5 × 15 cm · 10 τεμ.',  pr:19, w:560, h:1400, L:'stack',  cat:'in'},
{id:'vitrina',n:'Στη βιτρίνα',       sz:'20 × 20 cm · 2 τεμ.',  pr:22, w:1000,h:1000, L:'stack',  cat:'in'},
{id:'tablet', n:'Στην ταμπλέτα',     sz:'Ø 7 cm · 50 τεμ.',     pr:25, w:1000,h:1000, L:'circle', cat:'in'},
{id:'apod',   n:'Στην απόδειξη',     sz:'4 × 4 cm · 200 τεμ.',  pr:18, w:700, h:700,  L:'mini',   cat:'hand'},
{id:'souver', n:'Σουβέρ',            sz:'Ø 9 cm · 100 τεμ.',    pr:32, w:1000,h:1000, L:'circle', cat:'table'},
{id:'menu',   n:'Γωνία μενού',       sz:'16 × 4 cm · 20 τεμ.',  pr:24, w:1600,h:420,  L:'split',  cat:'table'},
{id:'sakoula',n:'Σακούλα delivery',  sz:'6 × 6 cm · 200 τεμ.',  pr:21, w:700, h:700,  L:'mini',   cat:'hand'},
{id:'kathr',  n:'Καθρέφτης',         sz:'8 × 20 cm · 6 τεμ.',   pr:20, w:640, h:1500, L:'stack',  cat:'in'},
{id:'bar',    n:'Πάγκος μπαρ',       sz:'10 × 10 cm · 25 τεμ.', pr:29, w:1000,h:1000, L:'stack',  cat:'in', dark:true},
{id:'koup',   n:'Κουπόνι στο χέρι',  sz:'14 × 8 cm · 100 τεμ.', pr:27, w:1400,h:800,  L:'ticket', cat:'hand'},
{id:'psygeio',n:'Ψυγείο / take away',sz:'Ø 11 cm · 25 τεμ.',    pr:26, w:1000,h:1000, L:'wheel',  cat:'in'},
{id:'rafi',   n:'Ράφι premium',      sz:'8 × 8 cm · 40 τεμ.',   pr:23, w:800, h:800,  L:'mini',   cat:'in'},
{id:'arith',  n:'Αριθμός τραπεζιού', sz:'8 × 12 cm · 20 τεμ.',  pr:31, w:800, h:1200, L:'header', cat:'table'},
{id:'paidi',  n:'Παιδικό τραπέζι',   sz:'10 × 10 cm · 25 τεμ.', pr:29, w:1000,h:1000, L:'stack',  cat:'table'}
];
const CATS=[['all','Όλα'],['in','Μέσα'],['table','Τραπέζι'],['hand','Στο χέρι']];
const X=[
{id:'platform',n:'Η πλατφόρμα του Τροχού',pr:PLATFORM_PRICE,per:'month',lock:true,d:'Ο τροχός, τα δώρα, οι κριτικές.'},
{id:'stand',   n:'Σταντ plexiglass',   pr:6,  per:'once', d:'Βάση για το αυτοκόλλητο τραπεζιού.'},
{id:'nfc',     n:'NFC αυτοκόλλητα',    pr:45, per:'once', d:'Ακουμπάς το κινητό αντί να σκανάρεις. 10 τεμ.'},
{id:'logo',    n:'Σχεδιασμός λογοτύπου',pr:120,per:'once',d:'Αν δεν έχεις έτοιμο αρχείο.'},
{id:'shop2',   n:'Δεύτερο κατάστημα',  pr:19, per:'month',d:'Ξεχωριστός κωδικός και στατιστικά.'},
{id:'express', n:'Express εκτύπωση',   pr:25, per:'once', d:'3 εργάσιμες αντί για 7.'}
];
const PALS=[
 {id:'pisma', n:'PISMA',      paper:'#F7E3D4',ink:'#141414',acc:'#F2542D',fr:'#1B3A5C'},
 {id:'menta', n:'Μέντα',      paper:'#E9F1E7',ink:'#16241C',acc:'#E2643A',fr:'#1E5A44'},
 {id:'lemoni',n:'Λεμόνι',     paper:'#FBEFC9',ink:'#20211A',acc:'#EA6A17',fr:'#2E3A6B'},
 {id:'ourani',n:'Ουρανί',     paper:'#E1EFF5',ink:'#10222B',acc:'#F09E1A',fr:'#0F3547'},
 {id:'ammos', n:'Άμμος',      paper:'#F1E9DC',ink:'#1E1A15',acc:'#B4552C',fr:'#3E3226'},
 {id:'mavro', n:'Ασπρόμαυρο', paper:'#F2F1EE',ink:'#141414',acc:'#141414',fr:'#141414'}
];
const WORDS=['ΣΚΑΝΑΡΕ','ΠΑΙΞΕ','ΚΕΡΔΙΣΕ','ΔΩΡΟ'];
const S={cart:{},extras:{platform:1},pal:PALS[0],word:'ΣΚΑΝΑΡΕ',biz:'CAFÉ KYMA',cat:'all',cur:0,showAll:false,dir:1};

const FF="'Noto Sans Display','Arial Black',Arial,sans-serif";
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
function sticker(f,st){
  const W=f.w,H=f.h,P=st.pal,u=Math.min(W,H);
  const paper=f.dark?'#101922':P.paper, ink=f.dark?'#F4F1EA':P.ink, fr=f.dark?P.acc:P.fr, acc=P.acc;
  const sw=Math.max(6,u*.0095);let o='';
  const round=f.L==='circle'||f.L==='wheel';
  if(round){
    o+=`<circle cx="${W/2}" cy="${H/2}" r="${W/2-sw/2}" fill="${paper}" stroke="${fr}" stroke-width="${sw*2.3}"/>`;
    o+=`<circle cx="${W/2}" cy="${H/2}" r="${W/2-sw*3.3}" fill="none" stroke="${ink}" stroke-width="${sw*.7}" opacity=".85"/>`;
  }else{
    o+=`<rect x="${sw/2}" y="${sw/2}" width="${W-sw}" height="${H-sw}" rx="${u*.055}" fill="${paper}" stroke="${fr}" stroke-width="${sw*2.3}"/>`;
    o+=`<rect x="${sw*2.8}" y="${sw*2.8}" width="${W-sw*5.6}" height="${H-sw*5.6}" rx="${u*.035}" fill="none" stroke="${ink}" stroke-width="${sw*.7}" opacity=".85"/>`;
  }
  const T=(x,y,tx,s,c,o2)=>`<text x="${x}" y="${y}" font-family="${FF}" font-weight="${(o2&&o2.w)||900}" font-size="${s}" fill="${c}" text-anchor="${(o2&&o2.a)||'middle'}" letter-spacing="${(o2&&o2.ls)||0}"${o2&&o2.o?` opacity="${o2.o}"`:''}>${esc(tx)}</text>`;
  function QR(cx,cy,size){
    const p=size*.115,inner=size-p*2;
    let s=`<rect x="${cx-size/2}" y="${cy-size/2}" width="${size}" height="${size}" rx="${Math.min(size*.1,32)}" fill="#fff" stroke="${f.dark?'#141414':ink}" stroke-width="${sw}"/>`;
    s+=`<path d="${qrPath(cx-inner/2,cy-inner/2,inner)}" fill="#141414"/>`;
    const b=size*.155,of=size*.055,t=sw*1.1,x0=cx-size/2+of,y0=cy-size/2+of,x1=cx+size/2-of,y1=cy+size/2-of;
    const C=d=>`<path d="${d}" fill="none" stroke="#141414" stroke-width="${t}" stroke-linecap="round" stroke-linejoin="round"/>`;
    return s+C(`M${x0} ${y0+b}V${y0+t}H${x0+b}`)+C(`M${x1-b} ${y0}H${x1-t}V${y0+b}`)
            +C(`M${x0} ${y1-b}V${y1-t}H${x0+b}`)+C(`M${x1-b} ${y1}H${x1-t}V${y1-b}`);
  }
  const PIS=(x,y,a)=>T(x,y,'PISMA',u*.028,ink,{w:700,ls:u*.009,o:.42,a:a||'middle'});
  if(f.L==='stack'){
    o+=T(W/2,H*.13,st.biz,Math.min(W*.052,H*.042),ink,{w:700,ls:u*.008,o:.6});
    o+=T(W/2,H*.335,'−40%',Math.min(W*.26,H*.20),acc,{ls:-u*.008});
    o+=T(W/2,H*.42,st.word,Math.min(W*.072,H*.05),ink,{ls:u*.007});
    o+=QR(W/2,H*.66,Math.min(W*.66,H*.40));o+=PIS(W/2,H-u*.045);
  }else if(f.L==='mini'){
    o+=QR(W/2,H*.43,Math.min(W*.62,H*.56));
    o+=T(W/2,H*.82,st.word,W*.115,ink,{ls:2});
    o+=T(W/2,H*.915,st.biz,W*.048,ink,{w:700,ls:u*.007,o:.55});
  }else if(f.L==='circle'){
    o+=T(W/2,H*.20,st.biz,u*.044,ink,{w:700,ls:u*.008,o:.6});
    o+=T(W/2,H*.375,'−40%',u*.195,acc,{ls:-u*.006});
    o+=QR(W/2,H*.60,u*.33);o+=T(W/2,H*.845,st.word,u*.068,ink,{ls:u*.006});o+=PIS(W/2,H*.925);
  }else if(f.L==='split'){
    o+=QR(H*.52,H/2,H*.70);
    o+=T(H*1.02,H*.36,st.word,H*.15,ink,{ls:H*.02,a:'start'});
    o+=T(H*1.02,H*.80,'−40%',H*.44,acc,{ls:-H*.02,a:'start'});
    o+=T(W-H*.20,H*.42,st.biz,H*.11,ink,{w:700,ls:H*.015,a:'end',o:.6});o+=PIS(W-H*.20,H*.72,'end');
  }else if(f.L==='ticket'){
    const cut=W*.615;
    o+=T(W*.10,H*.24,st.biz,H*.062,ink,{w:700,ls:H*.012,a:'start',o:.6});
    o+=T(W*.10,H*.60,'−40%',H*.30,acc,{ls:-H*.014,a:'start'});
    o+=T(W*.10,H*.79,st.word,H*.10,ink,{ls:H*.014,a:'start'});
    o+=`<path d="M${cut} ${H*.12}V${H*.88}" stroke="${ink}" stroke-width="${sw*.8}" stroke-dasharray="${H*.05} ${H*.04}" opacity=".7"/>`;
    o+=QR((cut+W)/2,H/2,Math.min(H*.66,(W-cut)*.72));o+=PIS(W*.10,H*.92,'start');
  }else if(f.L==='wheel'){
    for(let i=0;i<10;i++){const a0=(i*36-90)*Math.PI/180,a1=((i+1)*36-90)*Math.PI/180,R=W/2-sw*3.6;
      if(i%2)o+=`<path d="M${W/2},${H/2} L${W/2+R*Math.cos(a0)},${H/2+R*Math.sin(a0)} A${R},${R} 0 0,1 ${W/2+R*Math.cos(a1)},${H/2+R*Math.sin(a1)} Z" fill="${acc}" opacity=".92"/>`;}
    o+=`<circle cx="${W/2}" cy="${H/2}" r="${u*.30}" fill="${paper}" stroke="${ink}" stroke-width="${sw}"/>`;
    o+=QR(W/2,H*.45,u*.27);o+=T(W/2,H*.665,st.word,u*.052,ink,{ls:u*.005});
    o+=T(W/2,H*.925,st.biz,u*.042,ink,{w:700,ls:u*.008,o:.7});
  }else if(f.L==='header'){
    const hh=H*.30;
    o+=`<path d="M${sw*2.8} ${sw*2.8}H${W-sw*2.8}V${hh}H${sw*2.8}Z" fill="${fr}"/>`;
    o+=T(W/2,hh*.42,st.biz,W*.055,'#fff',{w:700,ls:W*.012,o:.85});
    o+=T(W/2,hh*.88,'07',W*.24,'#fff');
    o+=T(W/2,H*.475,'−40%',W*.20,acc,{ls:-W*.008});
    o+=QR(W/2,H*.70,Math.min(W*.60,H*.32));
    o+=T(W/2,H*.905,st.word,W*.062,ink,{ls:W*.008});o+=PIS(W/2,H*.965);
  }
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}">${o}</svg>`;
}
/* ================= DOM ================= */
const $=id=>document.getElementById(id);
const items=()=>F.filter(f=>S.cart[f.id]>0);
const xitems=()=>X.filter(x=>S.extras[x.id]>0);
const once=()=>items().reduce((a,f)=>a+f.pr*S.cart[f.id],0)+xitems().filter(x=>x.per==='once').reduce((a,x)=>a+x.pr*S.extras[x.id],0);
const month=()=>xitems().filter(x=>x.per==='month').reduce((a,x)=>a+x.pr*S.extras[x.id],0);
const nItems=()=>items().reduce((a,f)=>a+S.cart[f.id],0);
const visible=()=>S.cat==='all'?F:F.filter(f=>f.cat===S.cat);
const cur=()=>visible()[S.cur];

/* controls */
$('dots').innerHTML=PALS.map(p=>`<button class="dot" data-p="${p.id}" title="${p.n}" aria-label="${p.n}" aria-pressed="${p.id===S.pal.id}">
  <i style="background:${p.paper}"></i><i style="background:${p.acc}"></i><i style="background:${p.fr}"></i></button>`).join('');
$('dots').querySelectorAll('.dot').forEach(b=>b.onclick=()=>{
  S.pal=PALS.find(p=>p.id===b.dataset.p);
  $('dots').querySelectorAll('.dot').forEach(x=>x.setAttribute('aria-pressed',x.dataset.p===S.pal.id));draw()});
$('words').innerHTML=WORDS.map(w=>`<button data-w="${w}" aria-pressed="${w===S.word}">${w}</button>`).join('');
$('words').querySelectorAll('button').forEach(b=>b.onclick=()=>{
  S.word=b.dataset.w;$('words').querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x.dataset.w===S.word));draw()});
$('f-biz').addEventListener('input',e=>{S.biz=e.target.value||' ';draw()});

/* nav */
function step(d){const v=visible();S.dir=d;S.cur=(S.cur+d+v.length)%v.length;draw(true)}
$('prev').onclick=()=>step(-1);
$('next').onclick=()=>step(1);
document.addEventListener('keydown',e=>{
  if(e.target&&/^(INPUT|TEXTAREA)$/.test(e.target.tagName))return; /* πληκτρολόγηση σε πεδίο ≠ πλοήγηση */
  if(e.key==='ArrowLeft')step(-1);
  if(e.key==='ArrowRight')step(1);
  if(e.key==='Escape'){cartOpen(false);$('done').classList.remove('on')}
});

/* draw */
function draw(animate){
  const v=visible();
  if(S.cur>=v.length)S.cur=0;
  const f=cur();

  /* stage */
  const art=$('art');
  art.classList.remove('in','rev');
  art.innerHTML=sticker(f,S);
  if(animate){void art.offsetWidth;art.classList.add('in');if(S.dir<0)art.classList.add('rev')}

  $('idx').textContent=String(S.cur+1).padStart(2,'0')+' / '+v.length;
  $('stgname').textContent=f.n;
  $('stgsize').textContent=f.sz;
  $('stgprice').textContent=f.pr+' €';
  const q=S.cart[f.id]||0;
  $('stgact').innerHTML=q
    ?`<span><span class="stq"><button data-d="-1" aria-label="Λιγότερα">−</button><span>${q}</span><button data-d="1" aria-label="Περισσότερα">+</button></span><span class="inbag">στο καλάθι</span></span>`
    :`<button class="badd">Πρόσθεσέ το</button>`;
  $('stgact').querySelectorAll('.stq button').forEach(b=>b.onclick=()=>{
    S.cart[f.id]=Math.max(0,Math.min(20,(S.cart[f.id]||0)+ +b.dataset.d));if(!S.cart[f.id])delete S.cart[f.id];draw()});
  const ba=$('stgact').querySelector('.badd');
  if(ba)ba.onclick=()=>{S.cart[f.id]=1;draw()};

  /* cats */
  $('cats').innerHTML=CATS.map(([id,n])=>`<button data-c="${id}" aria-pressed="${S.cat===id}">${n}</button>`).join('');
  $('cats').querySelectorAll('button').forEach(b=>b.onclick=()=>{S.cat=b.dataset.c;S.cur=0;draw(true)});

  /* strip */
  $('strip').innerHTML=v.map((t,i)=>{const tq=S.cart[t.id]||0;return `
    <button class="th" data-i="${i}" aria-pressed="${i===S.cur}" aria-label="${t.n}">
      ${tq?`<span class="n">${tq}</span>`:''}
      <span class="im">${sticker(t,S)}</span><b>${t.n}</b>
    </button>`}).join('');
  $('strip').querySelectorAll('.th').forEach(b=>b.onclick=()=>{
    const i=+b.dataset.i;S.dir=i>S.cur?1:-1;S.cur=i;draw(true)});
  const act=$('strip').querySelector('[aria-pressed="true"]');
  if(act)act.scrollIntoView({inline:'center',block:'nearest',behavior:animate?'smooth':'auto'});

  /* cart */
  const it=items();
  $('cartcount').style.display=it.length?'grid':'none';
  $('cartcount').textContent=nItems();
  $('lines').innerHTML=it.length?it.map(t=>`
    <div class="li" data-f="${t.id}">
      <span class="im">${sticker(t,S)}</span>
      <span class="tx"><b>${t.n}</b><span>${t.pr} € / πακ.</span></span>
      <span class="miniq"><button data-d="-1" aria-label="Λιγότερα">−</button><span>${S.cart[t.id]}</span><button data-d="1" aria-label="Περισσότερα">+</button></span>
      <span class="amt">${t.pr*S.cart[t.id]} €</span>
      <button class="x" aria-label="Αφαίρεση">×</button>
    </div>`).join('')
    :'<p class="empty">Άδειο ακόμα.<br>Διάλεξε από τη συλλογή και πάτα «Πρόσθεσέ το».</p>';
  $('lines').querySelectorAll('.li').forEach(r=>{
    const id=r.dataset.f;
    r.querySelectorAll('.miniq button').forEach(b=>b.onclick=()=>{
      S.cart[id]=Math.max(0,Math.min(20,S.cart[id]+ +b.dataset.d));if(!S.cart[id])delete S.cart[id];draw()});
    r.querySelector('.x').onclick=()=>{delete S.cart[id];draw()};
  });

  const list=S.showAll?X:X.slice(0,3);
  $('extras').innerHTML=list.map(x=>{const on=S.extras[x.id]>0;return `
    <div class="xr"><span class="tx"><b>${x.n}</b><span>${x.d}</span></span>
      <span class="pr">${x.pr} €${x.per==='month'?'/μ':''}</span>
      <button class="tgl" data-x="${x.id}" aria-pressed="${on}" ${x.lock?'disabled':''} aria-label="${x.n}"></button></div>`}).join('');
  $('extras').querySelectorAll('.tgl:not([disabled])').forEach(b=>b.onclick=()=>{
    const id=b.dataset.x;if(S.extras[id])delete S.extras[id];else S.extras[id]=1;draw()});
  $('showmore').textContent=S.showAll?'Λιγότερα':'Δες όλα τα έξτρα';

  $('t-once').textContent=once()+' €';
  $('t-month').textContent=month()+' €';
  $('send').disabled=!items().length;
}
$('showmore').onclick=()=>{S.showAll=!S.showAll;draw()};

/* cart open/close */
function cartOpen(o){$('cart').classList.toggle('on',o);$('ovl').classList.toggle('on',o)}
$('cartbtn').onclick=()=>cartOpen(true);
$('cartclose').onclick=()=>cartOpen(false);
$('ovl').onclick=()=>cartOpen(false);

/* submit */
function showDone(it,xt){
  $('rec').innerHTML=it.map(f=>`<div><span>${f.n} × ${S.cart[f.id]}</span><b>${f.pr*S.cart[f.id]} €</b></div>`).join('')
   +xt.map(x=>`<div><span>${x.n}</span><b>${x.pr} €${x.per==='month'?'/μ':''}</b></div>`).join('')
   +`<div style="border-top:1px solid var(--line);padding-top:7px"><span>Μία φορά</span><b>${once()} €</b></div>`
   +`<div><span>Κάθε μήνα</span><b>${month()} €</b></div>`;
  cartOpen(false);$('done').classList.add('on');
}
$('send').onclick=async()=>{
  const tel=$('f-tel').value.trim(),mail=$('f-mail').value.trim();
  if(!tel&&!mail){
    $('f-tel').classList.add('err');$('f-mail').classList.add('err');$('f-tel').focus();
    setTimeout(()=>{$('f-tel').classList.remove('err');$('f-mail').classList.remove('err')},2200);return;
  }
  const P=S.pal,it=items(),xt=xitems();
  const design={word:S.word,biz:S.biz,head:'−40%',link:'',showBiz:true,showLink:false,frame:true,brackets:true,pisma:true,
    paper:P.paper,ink:P.ink,acc:P.acc,frameCol:P.fr,stroke:9,radius:54,qr:43,shape:'square',variant:'full'};
  const code=btoa(unescape(encodeURIComponent(JSON.stringify(design))));
  $('code').textContent=code;

  /* honeypot: τα bots «πετυχαίνουν» σιωπηλά, χωρίς αποστολή */
  if($('f-hp').value){showDone(it,xt);return;}

  const order=it.map(f=>`${f.n} × ${S.cart[f.id]} πακ. — ${f.pr*S.cart[f.id]} €`)
    .concat(xt.map(x=>`${x.n} — ${x.pr} €${x.per==='month'?'/μήνα':''}`)).join('\n');
  const btn=$('send'),err=$('senderr');
  btn.disabled=true;btn.textContent='Στέλνεται…';err.classList.remove('on');
  try{
    const res=await fetch(FORM_ENDPOINT,{
      method:'POST',
      headers:{'Content-Type':'application/json',Accept:'application/json'},
      body:JSON.stringify({
        _subject:`Αυτοκόλλητα QR — ${S.biz.trim()||'—'} (${once()} € + ${month()} €/μήνα)`,
        'Είδος':'Παραγγελία αυτοκόλλητων QR (Τροχός των Κριτικών)',
        'Μαγαζί':S.biz.trim(),
        'Ονοματεπώνυμο':$('f-name').value.trim(),
        'Τηλέφωνο':tel,
        'Email':mail,
        'Παραγγελία':order,
        'Σύνολο εφάπαξ':`${once()} €`,
        'Σύνολο μηνιαία':`${month()} €`,
        'Design code (paste στο Sticker Studio)':code,
      }),
    });
    // Το FormSubmit απαντά 200 ακόμα και σε αποτυχία — έλεγχος και του JSON.
    const json=await res.json().catch(()=>null);
    if(!res.ok||!json||String(json.success)!=='true')throw new Error('send failed');
    showDone(it,xt);
  }catch{
    err.classList.add('on');
  }finally{
    btn.textContent="Στείλ' το";btn.disabled=!items().length;
  }
};

draw();
</script>
</body>
</html>
