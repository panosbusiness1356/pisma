---
import Base from '../layouts/Base.astro';
import { SITE, ELEGXOS, eur } from '../config';
import { CATEGORIES, optionById, sumOf } from '../data/pricing';

// Πλήρης «ταυτότητα» της PISMA για Google & AI — αναπληρώνει το (προσωρινά
// ανύπαρκτο) Google Business Profile. Ο τιμοκατάλογος βγαίνει από το pricing.ts.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  slogan: SITE.tagline,
  email: SITE.email,
  telephone: SITE.phone,
  url: SITE.url,
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Αττική',
    addressCountry: 'GR',
  },
  areaServed: [
    'Νότια προάστια Αθήνας',
    'Γλυφάδα',
    'Βούλα',
    'Βάρη-Βουλιαγμένη',
    'Άλιμος',
    'Ελληνικό-Αργυρούπολη',
    'Παλαιό Φάληρο',
    'Νέα Σμύρνη',
    'Ελλάδα (online)',
  ],
  knowsAbout: [
    'Κατασκευή ιστοσελίδων',
    'SEO',
    'Ορατότητα σε εργαλεία AI (GEO/AEO)',
    'Google Business Profile',
    'Κριτικές Google',
    'Αυτοματοποίηση γραφείου',
  ],
  description:
    'Ψηφιακή παρουσία και αυτοματοποίηση διαδικασιών για ελληνικές επιχειρήσεις. Site, ορατότητα σε Google και AI, κριτικές και αυτοματισμοί — με μέτρηση πριν και μετά, χωρίς δεσμεύσεις.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Υπηρεσίες & τιμές PISMA',
    itemListElement: CATEGORIES.map((c) => ({
      '@type': 'OfferCatalog',
      name: c.title,
      itemListElement: c.options.map((o) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: o.label,
          ...(o.detail ? { description: o.detail } : {}),
        },
        price: o.price,
        priceCurrency: 'EUR',
        description: o.type === 'monthly' ? `${eur(o.price)} τον μήνα` : `${eur(o.price)} εφάπαξ`,
      })),
    })),
  },
};

const steps = [
  { t: 'Αξιολόγηση', d: `${ELEGXOS.minutes} λεπτά, χωρίς χρέωση. Καταγράφουμε τι χάνετε σε πελάτες και ώρες.` },
  { t: 'Πρόταση', d: `Γραπτή, εντός ${ELEGXOS.reportHours} ωρών, με σταθερή τιμή.` },
  { t: 'Υλοποίηση', d: 'Σε 2–4 εβδομάδες, στα εργαλεία που ήδη χρησιμοποιείτε.' },
  { t: 'Υποστήριξη', d: 'Μηνιαία αναφορά αποτελεσμάτων σε ώρες και ευρώ.' },
];


/* Μίνι-preview του builder (section Τιμολόγηση) — πραγματικές υπηρεσίες και
   τιμές από το pricing.ts, ώστε το demo να μη δείχνει ποτέ ξεπερασμένα ποσά.
   Τα labels των generic βαθμίδων («Standard», «Setup») παίρνουν το όνομα της
   κατηγορίας τους για να στέκουν μόνα τους. */
const bdDefs: { id: string; label?: string }[] = [
  { id: 'web-standard', label: 'Ιστοσελίδα Standard' },
  { id: 'gbp-setup', label: 'Προφίλ Google — Setup' },
  { id: 'auto-reviews' },
  { id: 'care-web' },
];
const bdItems = bdDefs.map(({ id, label }) => {
  const o = optionById(id)!;
  return { label: label ?? o.label, price: o.price, type: o.type };
});
const bdTotals = sumOf(bdDefs.map((d) => d.id));
---

<Base
  title="PISMA — Ψηφιακή παρουσία & αυτοματοποίηση για ελληνικές επιχειρήσεις"
  description="Η PISMA σχεδιάζει την παρουσία της επιχείρησής σας σε ιστοσελίδα, Google και εφαρμογές AI, και αυτοματοποιεί πληρωμές, εισπράξεις και καθημερινή αναφορά. Σταθερές τιμές, μετρήσιμα αποτελέσματα."
  schema={schema}
>
  <!-- 1. Hero -->
  <section
    class="hero"
    aria-labelledby="hero-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-anchor="#hero-title"
    data-mascot-say="Καλώς ήρθατε στην PISMA. Συνεχίστε προς τα κάτω — θα σας δείξω τα βασικά."
  >
    <div class="beams" aria-hidden="true">
      <span class="beam beam--a"></span>
      <span class="beam beam--b"></span>
      <span class="beam beam--c"></span>
    </div>

    <!-- Αιωρούμενα λογότυπα πλατφορμών — αυθεντικά SVG στο /public/logos -->
    <div class="float-logos" aria-hidden="true">
      <span class="flogo flogo-ig" data-speed="0.10" style="left:5%;top:13%;--w:44px;--dur:5.2s"><img src="/logos/instagram-icon.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo-fb" data-speed="-0.07" style="left:12%;top:38%;--w:38px;--dur:6.4s"><img src="/logos/facebook.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo-gm" data-speed="0.13" style="left:4%;top:64%;--w:38px;--dur:7.1s"><img src="/logos/google-gmail.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo--sm flogo-ai" data-speed="-0.05" style="left:19%;top:22%;--w:28px;--dur:6s"><img class="inv" src="/logos/openai-icon.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo--sm flogo-vb" data-speed="0.08" style="left:3.5%;top:98%;--w:30px;--dur:5.8s"><img src="/logos/viber.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo--sm flogo-li" data-speed="-0.1" style="left:4%;top:94%;--w:28px;--dur:6.6s"><img src="/logos/linkedin-icon.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo-go" data-speed="0.08" style="right:5%;top:12%;--w:42px;--dur:5.6s"><img src="/logos/google-icon.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo-wa" data-speed="-0.11" style="right:12%;top:38%;--w:40px;--dur:6.8s"><img src="/logos/whatsapp-icon.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo-mp" data-speed="0.06" style="right:4%;top:64%;--w:30px;--dur:7.4s"><img src="/logos/google-maps.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo--sm flogo-xl" data-speed="0.12" style="right:19%;top:22%;--w:30px;--dur:6.2s"><img src="/logos/excel.svg" alt="" loading="lazy" /></span>
      <span class="flogo flogo--sm flogo-tt" data-speed="-0.08" style="right:5%;top:95%;--w:28px;--dur:5.4s"><img class="chip" src="/logos/tiktok-icon.svg" alt="" loading="lazy" /></span>
    </div>

    <div class="container hero-inner">
      <p class="hero-kicker blur-in" style="--d:.16s">Ψηφιακή παρουσία & αυτοματοποίηση</p>

      <h1 id="hero-title" class="blur-in" style="--d:.22s">
        Η επιχείρησή σας, ορατή στους πελάτες.<br />
        Η λειτουργία της, <span class="hero-hl">χωρίς χαμένες ώρες<svg class="hl-stroke" viewBox="0 0 320 30" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="hlGrad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#FF8A50" /><stop offset="1" stop-color="#D63E1B" /></linearGradient></defs><path d="M6 15 C 60 9, 130 21, 200 14 C 245 10, 285 12, 314 13 C 260 18, 200 22, 120 21 C 90 20.5, 72 19, 58 18" fill="none" stroke="url(#hlGrad)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" opacity=".95" /></svg></span>.
      </h1>
      <script is:inline>
        // Κρύβει την υπογράμμιση πριν το πρώτο paint — θα τη «ζωγραφίσει» ο Ντοτ.
        (function () {
          var p = document.querySelector('.hl-stroke path');
          if (p && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var L = p.getTotalLength();
            p.style.strokeDasharray = String(L);
            p.style.strokeDashoffset = String(L);
          }
        })();
      </script>
      <p class="sub blur-in" style="--d:.34s">
        Η PISMA σχεδιάζει και υλοποιεί την παρουσία της επιχείρησής σας σε ιστοσελίδα,
        Google και εφαρμογές AI, και αυτοματοποιεί τις καθημερινές διαδικασίες —
        πληρωμές, εισπράξεις, καθημερινή αναφορά. <span class="sub-more">Με προκαθορισμένο κόστος
        και μετρήσιμο αποτέλεσμα.</span>
      </p>

      <div class="hero-ctas blur-in" style="--d:.46s">
        <span class="btn-frame">
          <a class="btn btn--orange" href="/tablo/">Μετρήστε την επιχείρησή σας — Quiz</a>
        </span>
        <a class="btn btn--ghost" href="/elegxos/">Κλείστε δωρεάν αξιολόγηση</a>
      </div>
      <p class="btn-note blur-in" style="--d:.54s">Χωρίς email · χωρίς δέσμευση · 2 λεπτά και βλέπετε το σκορ</p>
    </div>

    <!-- Πριν → Μετά -->
    <div class="hero-ba blur-in" style="--d:.62s">
      <div class="ba-head">
        <p class="kicker">Πριν → Μετά</p>
        <h2>Τι αλλάζει όταν συνεργαστούμε</h2>
      </div>
      <div class="ba-grid">
        <div class="card ba-before">
          <p class="ba-label">Πριν</p>
          <ul class="ba-list">
            <li>Κριτικές <strong>με το σταγονόμετρο</strong></li>
            <li><strong>Δύσκολα</strong> σε βρίσκουν στη Google</li>
            <li>Η ρουτίνα <strong>με το χέρι</strong></li>
            <li><strong>Αόρατοι</strong> στο AI</li>
          </ul>
        </div>
        <div class="card card--navy ba-after">
          <span class="ba-shine" aria-hidden="true"></span>
          <p class="ba-label ba-label--after">Με την PISMA</p>
          <ul class="ba-list ba-list--after">
            <li><strong>Σταθερή ροή</strong> κριτικών</li>
            <li>Θέση <strong>που ανεβαίνει</strong> σε Google & Χάρτες</li>
            <li>Η ρουτίνα <strong>τρέχει μόνη της</strong></li>
            <li>Το AI <strong>σας βρίσκει</strong></li>
          </ul>
        </div>
      </div>
      <p class="ba-note">Τα δικά σας μεγέθη τα μετράμε πριν ξεκινήσουμε — και ξανά στους 3 μήνες.</p>
    </div>
  </section>

  <!-- 2. Υπηρεσίες -->
  <section
    class="section"
    aria-labelledby="svc-title"
    data-mascot-stop
    data-mascot-side="left"
    data-mascot-say="Δύο υπηρεσίες: προβολή που φέρνει πελάτες, και διαδικασίες που τρέχουν αυτόματα."
  >
    <span class="flogo sflogo" aria-hidden="true" style="right:4%;top:60px;--w:26px;--dur:6.2s"><img src="/logos/google-gmail.svg" alt="" loading="lazy" /></span>
    <span class="flogo sflogo" aria-hidden="true" style="left:4%;bottom:8px;--w:28px;--dur:5.6s"><img src="/logos/whatsapp-icon.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Υπηρεσίες</p>
        <h2 id="svc-title">Τι αναλαμβάνουμε</h2>
        <span class="fx-uline" aria-hidden="true"></span>
      </div>
      <div class="grid-2">
        <article class="card svc reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" />
            </svg>
          </span>
          <h3>Ψηφιακή προβολή</h3>
          <ul class="svc-list">
            <li>Ιστοσελίδα σχεδιασμένη να μετατρέπει επισκέπτες σε πελάτες</li>
            <li>Κατάταξη στην αναζήτηση και τους Χάρτες Google της περιοχής σας</li>
            <li>Παρουσία στις απαντήσεις εργαλείων AI, όπως το ChatGPT</li>
          </ul>
          <a class="card-arrow" href="/se-vriskoun/">Αναλυτικά →</a>
        </article>
        <article class="card svc svc--blue reveal">
          <span class="icon-chip icon-chip--blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3.2" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" />
            </svg>
          </span>
          <h3>Αυτοματοποίηση διαδικασιών</h3>
          <ul class="svc-list">
            <li>Αυτόματο ταίριασμα πληρωμών με τα τιμολόγιά τους</li>
            <li>Συστηματική παρακολούθηση και υπενθύμιση εισπράξεων</li>
            <li>Καθημερινή εικόνα της επιχείρησης σε ένα μήνυμα</li>
          </ul>
          <a class="card-arrow" href="/doulevei-mono-tou/">Αναλυτικά →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Μεθοδολογία -->
  <section
    class="section section--tight"
    aria-labelledby="method-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-say="Κάθε συνεργασία ξεκινά με δωρεάν αξιολόγηση 45 λεπτών — παραλαμβάνετε τα ευρήματα γραπτώς."
  >
    <span class="flogo sflogo" aria-hidden="true" style="right:4%;top:40px;--w:24px;--dur:5.9s"><img src="/logos/google-maps.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--yellow">Μεθοδολογία</p>
        <h2 id="method-title">Πώς δουλεύουμε — σε 4 βήματα</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-num num">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Ηλεκτρονική τιμολόγηση 2026: ΠΡΟΣΩΡΙΝΑ ΕΚΤΟΣ — φυλάσσεται στο
       components/Einvoice2026.astro, επαναφορά με <Einvoice2026 /> εδώ. -->

  <!-- 6. Τιμολόγηση — φτιάξτε το δικό σας πακέτο -->
  <section
    class="section section--tight"
    aria-labelledby="pricing-title"
    data-mascot-stop
    data-mascot-side="left"
    data-mascot-say="Κανένα έτοιμο πακέτο — διαλέγετε ό,τι χρειάζεστε και βλέπετε το σύνολο ζωντανά."
  >
    <span class="flogo sflogo" aria-hidden="true" style="left:4%;top:2px;--w:22px;--dur:6.4s"><img src="/logos/linkedin-icon.svg" alt="" loading="lazy" /></span>
    <span class="flogo sflogo" aria-hidden="true" style="right:4%;top:42px;--w:26px;--dur:6.8s"><img src="/logos/facebook.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="sec-head">
        <p class="kicker kicker--blue">Τιμολόγηση</p>
        <h2 id="pricing-title">Κανένα έτοιμο πακέτο — φτιάχνετε το δικό σας</h2>
        <p>Όλες οι τιμές δημόσιες. Διαλέγετε μόνο ό,τι χρειάζεστε — και ξέρετε το κόστος πριν από την πρώτη επικοινωνία.</p>
      </div>

      <div class="card bd reveal" id="builder-demo">
        <!-- Αριστερά: μίνι-preview του builder — δείγμα με πραγματικές τιμές -->
        <div class="bd-mock" aria-hidden="true">
          <p class="bd-mock-title">Η προσφορά σας <span class="tag tag--demo">Δείγμα</span></p>
          <ul class="bd-list">
            {bdItems.map((o) => (
              <li class="bd-item is-on" data-price={o.price} data-ptype={o.type}>
                <span class="bd-check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l4.8 4.8L19.5 6.8" /></svg>
                </span>
                <span class="bd-label">{o.label}</span>
                <span class="bd-price num">{eur(o.price)}{o.type === 'monthly' && <em>/μ</em>}</span>
              </li>
            ))}
          </ul>
          <div class="bd-totals">
            <span>Εφάπαξ</span><b class="num" id="bd-once">{eur(bdTotals.once)}</b>
            <span>Μηνιαία</span><b class="num bd-sm" id="bd-month">{eur(bdTotals.monthly)}</b>
          </div>
        </div>

        <!-- Δεξιά: πώς δουλεύει -->
        <div class="bd-text">
          <ol class="bd-steps">
            <li>
              <span class="bd-n num">1</span>
              <div>
                <h3>Διαλέγετε υπηρεσίες</h3>
                <p>Site, Google, ο Τροχός των Κριτικών, αυτοματισμοί — τικάρετε μόνο ό,τι σας χρειάζεται.</p>
              </div>
            </li>
            <li>
              <span class="bd-n num">2</span>
              <div>
                <h3>Βλέπετε το σύνολο ζωντανά</h3>
                <p>Εφάπαξ και μηνιαία, χωρίς ψιλά γράμματα — το άθροισμα ενημερώνεται μπροστά σας.</p>
              </div>
            </li>
            <li>
              <span class="bd-n num">3</span>
              <div>
                <h3>Τη λαμβάνετε γραπτώς</h3>
                <p>Καμία πληρωμή online — στέλνετε την προσφορά και τα λέμε.</p>
              </div>
            </li>
          </ol>
          <a class="btn btn--orange" href="/times/">Φτιάξτε το πακέτο σας →</a>
          <p class="btn-note">2 λεπτά · όλες οι τιμές δημόσιες · χωρίς στοιχεία</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Η εταιρία -->
  <section class="section section--tight" aria-labelledby="who-title">
    <span class="flogo sflogo" aria-hidden="true" style="right:5%;top:4px;--w:22px;--dur:6.6s"><img class="chip" src="/logos/tiktok-icon.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="card who reveal">
        <div>
          <p class="kicker">Η εταιρία</p>
          <h2 id="who-title">Άμεση συνεργασία, χωρίς ενδιάμεσους</h2>
          <p>
            Συνεργάζεστε απευθείας με τον υπεύθυνο σχεδιασμού και υλοποίησης — χωρίς
            τμήμα πωλήσεων. Ό,τι υλοποιείται, ανήκει στην επιχείρησή σας.
          </p>
          <div class="who-bridge" aria-hidden="true">
            <span class="wb-chip" id="bridge-you">Εσείς</span>
            <span class="wb-line" id="bridge-line"><span class="wb-fill"></span></span>
            <span class="wb-chip" id="bridge-pisma">PISMA<span class="wb-dot">.</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Τελικό κάλεσμα -->
  <section
    class="section final-cta"
    aria-labelledby="final-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-say="Ξεκινήστε με τη δωρεάν αξιολόγηση — 45 λεπτά, χωρίς δέσμευση."
  >
    <span class="flogo sflogo" aria-hidden="true" style="left:5%;top:12px;--w:24px;--dur:5.4s"><img src="/logos/viber.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <h2 id="final-title">Ξεκινήστε με μια δωρεάν<br /><span class="grad-text">αξιολόγηση 45 λεπτών</span></h2>
      <p>
        Καταγράφουμε τι χάνετε σε πελάτες και χρόνο — παραλαμβάνετε τα ευρήματα γραπτώς.
      </p>
      <a class="btn btn--orange" href="/elegxos/">Κλείστε τη δωρεάν αξιολόγηση</a>
      <p class="btn-note">45 λεπτά · χωρίς χρέωση · χωρίς δέσμευση</p>
    </div>
  </section>
</Base>

<script>
  // Parallax λογοτύπων στο scroll + μετρητής κριτικών — σέβονται το reduced motion.
  const reduceFx = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const flogos = Array.from(document.querySelectorAll<HTMLElement>('.float-logos .flogo'));
  if (!reduceFx && flogos.length) {
    let raf = 0;
    const apply = () => {
      raf = 0;
      const y = window.scrollY;
      for (const el of flogos) {
        el.style.transform = `translateY(${(y * parseFloat(el.dataset.speed || '0')).toFixed(1)}px)`;
      }
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(apply); }, { passive: true });
    apply();
  }

  // Τα σκόρπια λογότυπα αναδύονται όταν μπουν στην οθόνη
  const sflogos = Array.from(document.querySelectorAll('.sflogo'));
  if (sflogos.length) {
    if (reduceFx || !('IntersectionObserver' in window)) {
      sflogos.forEach((el) => el.classList.add('in'));
    } else {
      const sIo = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); sIo.unobserve(e.target); }
        }
      }, { rootMargin: '0px 0px -8% 0px' });
      sflogos.forEach((el) => sIo.observe(el));
    }
  }

  // Κινήσεις sections: οπλίζονται μόνο εδώ (.fx-armed) — χωρίς JS όλα ορατά.
  // Κάθε section πυροδοτεί (.fx-on) μία φορά, όταν μπει αρκετά στην οθόνη.
  const fxIds = ['svc-title', 'method-title', 'pricing-title', 'who-title', 'final-title'];
  const fxSections = fxIds
    .map((id) => document.getElementById(id)?.closest('section'))
    .filter((s): s is HTMLElement => !!s);
  if (!reduceFx && 'IntersectionObserver' in window && fxSections.length) {
    fxSections.forEach((s) => s.classList.add('fx-armed'));
    const fxIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('fx-on');
            fxIo.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 }
    );
    fxSections.forEach((s) => fxIo.observe(s));
  }

  // Μίνι-preview builder (Τιμολόγηση): οι υπηρεσίες «τικάρονται» μία-μία και το
  // σύνολο μεγαλώνει ζωντανά. Το HTML έχει το τελικό state — το JS απλώς το
  // ξανα-παίζει στο πρώτο scroll. Χωρίς JS ή με reduced motion: τελικό state.
  const bdDemo = document.getElementById('builder-demo');
  if (bdDemo && !reduceFx && 'IntersectionObserver' in window) {
    const items = Array.from(bdDemo.querySelectorAll<HTMLElement>('.bd-item'));
    const onceEl = document.getElementById('bd-once')!;
    const monthEl = document.getElementById('bd-month')!;
    const finalOnce = onceEl.textContent!;
    const finalMonth = monthEl.textContent!;
    const eurFmt = (n: number) => n.toLocaleString('el-GR') + '€';

    const bdIo = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        bdIo.disconnect();
        // Μηδενισμός και σταδιακό «τικάρισμα»
        let once = 0;
        let month = 0;
        items.forEach((li) => li.classList.remove('is-on'));
        onceEl.textContent = eurFmt(0);
        monthEl.textContent = eurFmt(0);
        items.forEach((li, i) => {
          window.setTimeout(() => {
            li.classList.add('is-on');
            const price = Number(li.dataset.price || 0);
            if (li.dataset.ptype === 'once') once += price;
            else month += price;
            onceEl.textContent = eurFmt(once);
            monthEl.textContent = eurFmt(month);
            // Δίχτυ ασφαλείας: στο τέλος, τα ποσά που ήρθαν από το build.
            if (i === items.length - 1) {
              onceEl.textContent = finalOnce;
              monthEl.textContent = finalMonth;
            }
          }, 500 + i * 550);
        });
      },
      { threshold: 0.45 }
    );
    bdIo.observe(bdDemo);
  }
</script>

