---
import Base from '../layouts/Base.astro';
import { SITE, ELEGXOS, PROMISE, eur } from '../config';
import { CATEGORIES, optionById, sumOf } from '../data/pricing';

// Πλήρης «ταυτότητα» της PISMA για Google & AI — αναπληρώνει το (προσωρινά
// ανύπαρκτο) Google Business Profile. Ο τιμοκατάλογος βγαίνει από το pricing.ts.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  slogan: SITE.tagline,
  email: SITE.email,
  telephone: SITE.phone,
  url: SITE.url,
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Αττική',
    addressCountry: 'GR',
  },
  areaServed: [
    'Νότια προάστια Αθήνας',
    'Γλυφάδα',
    'Βούλα',
    'Βάρη-Βουλιαγμένη',
    'Άλιμος',
    'Ελληνικό-Αργυρούπολη',
    'Παλαιό Φάληρο',
    'Νέα Σμύρνη',
    'Ελλάδα (online)',
  ],
  knowsAbout: [
    'Κατασκευή ιστοσελίδων',
    'SEO',
    'Ορατότητα σε εργαλεία AI (GEO/AEO)',
    'Google Business Profile',
    'Κριτικές Google',
    'Ψηφιακό μενού με QR',
    'Αυτοματοποίηση γραφείου',
  ],
  description:
    'Ψηφιακή παρουσία και αυτοματοποίηση διαδικασιών για ελληνικές επιχειρήσεις. Site, ορατότητα σε Google και AI, κριτικές και αυτοματισμοί — με μέτρηση πριν και μετά, χωρίς δεσμεύσεις.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Υπηρεσίες & τιμές PISMA',
    itemListElement: CATEGORIES.map((c) => ({
      '@type': 'OfferCatalog',
      name: c.title,
      itemListElement: c.options.map((o) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: o.label,
          ...(o.detail ? { description: o.detail } : {}),
        },
        price: o.price,
        priceCurrency: 'EUR',
        description: o.type === 'monthly' ? `${eur(o.price)} τον μήνα` : `${eur(o.price)} εφάπαξ`,
      })),
    })),
  },
};

const steps = [
  { t: 'Αξιολόγηση', d: `${ELEGXOS.minutes} λεπτά, δωρεάν. Μαθαίνουμε για την επιχείρησή σας και πώς μπορείτε να τη βελτιώσετε.` },
  { t: 'Πρόταση', d: `Σε ${ELEGXOS.reportHours} ώρες, γραπτά και με τελική τιμή.` },
  { t: 'Υλοποίηση', d: 'Έτοιμο σε 2–4 εβδομάδες, χωρίς να σταματήσει η δουλειά σας.' },
  { t: 'Υποστήριξη', d: 'Είμαστε δίπλα σας και μετά. Μηνιαία αναφορά με νούμερα, όχι με λόγια.' },
];


/* Μίνι-preview του builder (section Τιμολόγηση) — πραγματικές υπηρεσίες και
   τιμές από το pricing.ts, ώστε το demo να μη δείχνει ποτέ ξεπερασμένα ποσά.
   Τα labels των generic βαθμίδων («Standard», «Setup») παίρνουν το όνομα της
   κατηγορίας τους για να στέκουν μόνα τους. */
const bdDefs: { id: string; label?: string }[] = [
  { id: 'web-standard', label: 'Ιστοσελίδα — Βασική' },
  { id: 'gbp-setup', label: 'Προφίλ Google — Στήσιμο' },
  { id: 'auto-reviews' },
  { id: 'care-web' },
];
const bdItems = bdDefs.map(({ id, label }) => {
  const o = optionById(id)!;
  return { label: label ?? o.label, price: o.price, type: o.type };
});
const bdTotals = sumOf(bdDefs.map((d) => d.id));

/* Hero: τιμή-άγκυρα από τον τιμοκατάλογο + WhatsApp με προσυμπληρωμένο μήνυμα. */
const sitePriceFrom = optionById('web-basic')!.price;
const waHref = `${SITE.whatsapp}?text=${encodeURIComponent('Γεια σας! Θα ήθελα μια δωρεάν εκτίμηση για την επιχείρησή μου.')}`;
---

<Base
  title="PISMA — Ψηφιακή παρουσία & αυτοματισμοί για επιχειρήσεις"
  description="Η PISMA χτίζει την παρουσία της επιχείρησής σας σε site, Google και AI, και αυτοματοποιεί τη ρουτίνα του γραφείου. Σταθερές τιμές, μετρήσιμα αποτελέσματα."
  schema={schema}
>
  <!-- 1. Hero -->
  <section
    class="hero"
    aria-labelledby="hero-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-anchor="#hero-title"
    data-mascot-say="Καλώς ήρθατε στην PISMA. Συνεχίστε προς τα κάτω — θα σας δείξω τα βασικά."
  >
    <div class="beams" aria-hidden="true">
      <span class="beam beam--a"></span>
      <span class="beam beam--b"></span>
      <span class="beam beam--c"></span>
    </div>

    <!-- Αιωρούμενα λογότυπα πλατφορμών — αυθεντικά SVG στο /public/logos -->
    <div class="float-logos" aria-hidden="true">
      <span class="flogo flogo-ig" data-speed="0.10" style="left:5%;top:13%;--w:44px;--dur:5.2s"><img src="/logos/instagram-icon.svg" alt="" /></span>
      <span class="flogo flogo-fb" data-speed="-0.07" style="left:12%;top:38%;--w:38px;--dur:6.4s"><img src="/logos/facebook.svg" alt="" /></span>
      <span class="flogo flogo-gm" data-speed="0.13" style="left:4%;top:64%;--w:38px;--dur:7.1s"><img src="/logos/google-gmail.svg" alt="" /></span>
      <span class="flogo flogo--sm flogo-ai" data-speed="-0.05" style="left:19%;top:22%;--w:28px;--dur:6s"><img class="inv" src="/logos/openai-icon.svg" alt="" /></span>
      <span class="flogo flogo--sm flogo-vb" data-speed="0.08" style="left:3.5%;top:98%;--w:30px;--dur:5.8s"><img src="/logos/viber.svg" alt="" /></span>
      <span class="flogo flogo--sm flogo-li" data-speed="-0.1" style="left:4%;top:94%;--w:28px;--dur:6.6s"><img src="/logos/linkedin-icon.svg" alt="" /></span>
      <span class="flogo flogo-go" data-speed="0.08" style="right:5%;top:12%;--w:42px;--dur:5.6s"><img src="/logos/google-icon.svg" alt="" /></span>
      <span class="flogo flogo-wa" data-speed="-0.11" style="right:12%;top:38%;--w:40px;--dur:6.8s"><img src="/logos/whatsapp-icon.svg" alt="" /></span>
      <span class="flogo flogo-mp" data-speed="0.06" style="right:4%;top:64%;--w:30px;--dur:7.4s"><img src="/logos/google-maps.svg" alt="" /></span>
      <span class="flogo flogo--sm flogo-xl" data-speed="0.12" style="right:19%;top:22%;--w:30px;--dur:6.2s"><img src="/logos/excel.svg" alt="" /></span>
      <span class="flogo flogo--sm flogo-tt" data-speed="-0.08" style="right:5%;top:95%;--w:28px;--dur:5.4s"><img class="chip" src="/logos/tiktok-icon.svg" alt="" /></span>
    </div>

    <div class="container hero-inner">
      <p class="hero-kicker blur-in" style="--d:.16s">Ψηφιακή παρουσία & αυτοματοποίηση</p>

      <h1 id="hero-title" class="blur-in" style="--d:.22s">
        Η επιχείρησή σας, ορατή στους πελάτες.<br />
        Η λειτουργία της, <span class="hero-hl">χωρίς χαμένες ώρες<svg class="hl-stroke" viewBox="0 0 320 30" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="hlGrad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#FF8A50" /><stop offset="1" stop-color="#D63E1B" /></linearGradient></defs><path d="M6 15 C 60 9, 130 21, 200 14 C 245 10, 285 12, 314 13 C 260 18, 200 22, 120 21 C 90 20.5, 72 19, 58 18" fill="none" stroke="url(#hlGrad)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" opacity=".95" /></svg></span>.
      </h1>
      <script is:inline>
        // Κρύβει την υπογράμμιση πριν το πρώτο paint — θα τη «ζωγραφίσει» ο Ντοτ.
        (function () {
          var p = document.querySelector('.hl-stroke path');
          if (p && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var L = p.getTotalLength();
            p.style.strokeDasharray = String(L);
            p.style.strokeDashoffset = String(L);
          }
        })();
      </script>
      <p class="sub blur-in" style="--d:.34s">
        Στην PISMA σχεδιάζουμε και αναπτύσσουμε την παρουσία της επιχείρησής σας σε
        ιστοσελίδα, Google και AI, και αυτοματοποιούμε τις καθημερινές διαδικασίες σας.
        <span class="sub-more">Με προκαθορισμένο κόστος και μετρήσιμο αποτέλεσμα.</span>
      </p>

      <div class="hero-ctas blur-in" style="--d:.46s">
        <span class="btn-frame">
          <a class="btn btn--orange" href="/tablo/">Μετρήστε την επιχείρησή σας — Quiz</a>
        </span>
        <a class="btn btn--ghost" href="/elegxos/">Κλείστε δωρεάν αξιολόγηση</a>
      </div>
      <p class="btn-note blur-in" style="--d:.54s">Χωρίς email · χωρίς δέσμευση · 2 λεπτά και βλέπετε το σκορ</p>

      <!-- Άμεσα κανάλια: brand pills WhatsApp & Viber -->
      <div class="hero-chat blur-in" style="--d:.58s">
        <a class="chat-btn chat-btn--wa" href={waHref} target="_blank" rel="noopener">
          <span class="ic"><img src="/logos/whatsapp-icon.svg" alt="" width="19" height="19" /></span>
          WhatsApp
        </a>
        <a class="chat-btn chat-btn--vb" href={SITE.viber}>
          <span class="ic"><img src="/logos/viber.svg" alt="" width="19" height="19" /></span>
          Viber
        </a>
        <span class="chat-note">απαντάμε την ίδια μέρα</span>
      </div>
      <!-- Το viber:// ανοίγει μόνο με εγκατεστημένη εφαρμογή — αλλιώς δείχνουμε τον αριθμό. -->
      <p class="chat-fallback" id="vb-fallback" hidden>
        Το Viber ανοίγει μόνο αν έχετε την εφαρμογή στη συσκευή σας. Ο αριθμός μας:
        <button type="button" id="vb-copy">{SITE.phone} — πατήστε για αντιγραφή</button>
      </p>
      <script is:inline define:vars={{ vbPhone: SITE.phone, vbCopied: 'Αντιγράφηκε ✓' }}>
        // Viber: αν μείνουμε στη σελίδα μετά το κλικ (δεν άνοιξε εφαρμογή), δείξε τον αριθμό.
        (function () {
          var vb = document.querySelector('.chat-btn--vb');
          var fb = document.getElementById('vb-fallback');
          var copy = document.getElementById('vb-copy');
          if (!vb || !fb || !copy) return;
          vb.addEventListener('click', function () {
            var t = setTimeout(function () { fb.hidden = false; }, 1500);
            var cancel = function () { clearTimeout(t); };
            window.addEventListener('blur', cancel, { once: true });
            document.addEventListener('visibilitychange', cancel, { once: true });
          });
          copy.addEventListener('click', function () {
            if (!navigator.clipboard) return;
            navigator.clipboard.writeText(vbPhone).then(function () { copy.textContent = vbCopied; });
          });
        })();
      </script>

      <!-- Αριθμοί-δεσμεύσεις: τιμή-άγκυρα από το pricing.ts, χρόνοι από το config. -->
      <ul class="hero-stats blur-in" style="--d:.64s">
        <li><strong>από {eur(sitePriceFrom)}</strong><span>ιστοσελίδα</span></li>
        <li><strong>{PROMISE.previewHours} ώρες</strong><span>πρώτο preview</span></li>
        <li><strong>{ELEGXOS.reportHours} ώρες</strong><span>γραπτή πρόταση</span></li>
        <li><strong>100%</strong><span>δημόσιες τιμές</span></li>
      </ul>
    </div>

    <!-- Πριν → Μετά -->
    <div class="hero-ba blur-in" style="--d:.62s">
      <div class="ba-head">
        <p class="kicker">Πριν → Μετά</p>
        <h2>Τι αλλάζει όταν συνεργαστούμε</h2>
      </div>
      <div class="ba-grid">
        <div class="card ba-before">
          <p class="ba-label">Πριν</p>
          <ul class="ba-list">
            <li><strong>Λίγες</strong> κριτικές</li>
            <li><strong>Δύσκολα</strong> σας βρίσκουν στη Google</li>
            <li><strong>Χαμένες ώρες</strong> σε δουλειές ρουτίνας</li>
            <li>Το AI <strong>δεν σας εμφανίζει</strong></li>
          </ul>
        </div>
        <div class="card card--navy ba-after">
          <span class="ba-shine" aria-hidden="true"></span>
          <p class="ba-label ba-label--after">Με την PISMA</p>
          <ul class="ba-list ba-list--after">
            <li><strong>Καθημερινά</strong> καινούργιες κριτικές</li>
            <li><strong>Σας βρίσκουν</strong> στη Google & Χάρτες</li>
            <li>Η ρουτίνα <strong>γίνεται αυτόματα</strong></li>
            <li><strong>Σας προτείνει</strong> το AI</li>
          </ul>
        </div>
      </div>
      <p class="ba-note">Μετράμε μαζί πού είστε σήμερα και πού θα φτάσετε σε 3 μήνες από τώρα.</p>
    </div>
  </section>

  <!-- 2. Υπηρεσίες -->
  <section
    class="section"
    aria-labelledby="svc-title"
    data-mascot-stop
    data-mascot-side="left"
    data-mascot-say="Δύο υπηρεσίες: προβολή που φέρνει πελάτες, και διαδικασίες που τρέχουν αυτόματα."
  >
    <span class="flogo sflogo" aria-hidden="true" style="right:4%;top:60px;--w:26px;--dur:6.2s"><img src="/logos/google-gmail.svg" alt="" loading="lazy" /></span>
    <span class="flogo sflogo" aria-hidden="true" style="left:4%;bottom:8px;--w:28px;--dur:5.6s"><img src="/logos/whatsapp-icon.svg" alt="" loading="lazy" /></span>
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Υπηρεσίες</p>
        <h2 id="svc-title">Τι αναλαμβάνουμε</h2>
        <span class="fx-uline" aria-hidden="true"></span>
      </div>
      <div class="grid-2">
        <article class="card svc reveal">
          <span class="icon-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" />
            </svg>
          </span>
          <h3>Ψηφιακή προβολή</h3>
          <ul class="svc-list">
            <li>Να έχετε ιστοσελίδα που σας ταιριάζει και σας φέρνει πελάτες</li>
            <li>Να σας βρίσκουν στη Google</li>
            <li>Να σας προτείνει το AI</li>
            <li>Social media που μένουν ζωντανά — με δικό σας ή δικό μας υλικό</li>
          </ul>
          <a class="card-arrow" href="/se-vriskoun/">Περισσότερα →</a>
        </article>
        <article class="card svc svc--blue reveal">
          <span class="icon-chip icon-chip--blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3.2" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" />
            </svg>
          </span>
          <h3>Αυτοματισμοί</h3>
          <ul class="svc-list">
            <li>Αυτόματο ταίριασμα πληρωμών με τα τιμολόγιά τους</li>
            <li>Συστηματική παρακολούθηση και υπενθύμιση εισπράξεων</li>
            <li>Καθημερινή εικόνα της επιχείρησης σε ένα μήνυμα</li>
          </ul>
          <a class="card-arrow" href="/doulevei-mono-tou/">Περισσότερα →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- 2β. Κριτικές Google — «Η άνοδος στη Google»: όσο πέφτουν αστέρια-κριτικές,
       η επιχείρηση σκαρφαλώνει από την 3η στην 1η θέση των αποτελεσμάτων.
       Το HTML έχει το τελικό state (#1, κορώνα) — χωρίς JS ή με reduced motion
       μένει στατικό· το JS το «ξαναπαίζει» σε loop όσο το section είναι ορατό. -->
  <section
    class="section section--tight"
    aria-labelledby="rev-title"
    data-mascot-stop
    data-mascot-side="right"
    data-mascot-say="Κάθε νέα κριτική ανεβάζει την επιχείρηση πιο ψηλά στα αποτελέσματα της Google."
  >
    <div class="container">
      <div class="rev-grid">
      <div class="rev-copy">
        <div class="sec-head">
          <p class="kicker">Κριτικές Google</p>
          <h2 id="rev-title">Περισσότερες κριτικές, πιο ψηλά στη Google</h2>
        </div>
        <p class="rev-sub">
          Κάθε νέα κριτική μετράει. Η βαθμολογία ανεβαίνει και εμφανίζεστε ψηλότερα.
        </p>
        <div class="rev-cta">
          <a class="btn btn--ghost" href="/kritikes/">Δείτε το εργαλείο</a>
        </div>
      </div>

      <div class="rev-stage" id="rev-stage" aria-hidden="true">
        <div class="rev-fx" id="rev-fx"></div>
        <div class="rev-phone">
          <div class="rev-screen">
          <div class="rev-status">
            <span class="rev-time num">9:41</span>
            <span class="rev-island"></span>
            <span class="rev-sicons">
              <svg class="ri-signal" viewBox="0 0 18 12" aria-hidden="true"><rect x="0" y="7.5" width="3.2" height="4.5" rx="1"/><rect x="4.9" y="5.3" width="3.2" height="6.7" rx="1"/><rect x="9.8" y="2.8" width="3.2" height="9.2" rx="1"/><rect x="14.7" y="0" width="3.2" height="12" rx="1"/></svg>
              <svg class="ri-wifi" viewBox="0 0 16 12" aria-hidden="true"><path d="M2.5 5.5 A7.8 7.8 0 0 1 13.5 5.5" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><path d="M4.75 8.05 A4.6 4.6 0 0 1 11.25 8.05" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><circle cx="8" cy="10.6" r="1.5"/></svg>
              <svg class="ri-batt" viewBox="0 0 27 13" aria-hidden="true"><rect x="0.6" y="0.6" width="22.3" height="11.8" rx="3.8" fill="none" stroke="currentColor" stroke-width="1.1" opacity=".35"/><rect x="2.4" y="2.4" width="18.7" height="8.2" rx="2.2"/><path d="M24.8 4.4 v4.2 a2.15 2.15 0 0 0 0 -4.2 z" opacity=".4"/></svg>
            </span>
          </div>
          <div class="rev-search">
            <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.2-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C41.4 34.9 44 29.9 44 24c0-1.2-.1-2.4-.4-3.5z"/></svg>
            <span>καφέ κοντά μου</span>
          </div>
          <div class="rev-list">
            <div class="rev-row" id="rev-a" style="top:66px">
              <p>Καφέ Απέναντι</p>
              <p class="rev-meta"><b>4,6</b> <span class="rev-stars">★★★★★</span> (210)</p>
            </div>
            <div class="rev-row" id="rev-b" style="top:132px">
              <p>Καφέ Δίπλα</p>
              <p class="rev-meta"><b>4,4</b> <span class="rev-stars">★★★★★</span> (98)</p>
            </div>
            <div class="rev-row rev-row--you" id="rev-y" style="top:0px">
              <p>Η επιχείρησή σας<span class="rev-crown" id="rev-crown"><svg viewBox="0 0 24 24" fill="#e37400" aria-hidden="true"><path d="M2.6 18.2 1 7.6l6 3.9L12 4l5 7.5 6-3.9-1.6 10.6z"/><path d="M3.5 19.6h17v1.9h-17z"/></svg></span></p>
              <p class="rev-meta"><b id="rev-rating">4,9</b> <span class="rev-stars">★★★★★</span> (<span id="rev-count" class="num">234</span>)</p>
              <span class="rev-ring" id="rev-ring"></span>
            </div>
          </div>
          <p class="rev-win" id="rev-win">Πρώτη επιλογή της περιοχής ✓</p>
          <div class="rev-skel">
