      <div class="card bd reveal" id="builder-demo">
        <!-- Αριστερά: μίνι-preview του builder — δείγμα με πραγματικές τιμές -->
        <div class="bd-mock" aria-hidden="true">
          <p class="bd-mock-title">Το πακέτο σας <span class="tag tag--demo">Δείγμα</span></p>
          <ul class="bd-list">
            {bdItems.map((o) => (
              <li class="bd-item is-on" data-price={o.price} data-ptype={o.type}>
