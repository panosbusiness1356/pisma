  .float-logos .flogo:nth-child(10) { animation-delay: .8s; }
  .float-logos .flogo:nth-child(11) { animation-delay: .6s; }
  /* Τα σκόρπια στα sections: αναδύονται όταν πρωτοφανούν στην οθόνη */
