---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Ψηφιακή Προβολή — Ορατότητα σε Google και AI',
  serviceType: 'Κατασκευή ιστοσελίδων, Google Business Profile, SEO, GEO/AEO, Social media, Google Reviews',
  areaServed: SITE.region,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'Αττική',
      addressCountry: 'GR',
    },
  },
  description:
    'Site που πουλάει, πρώτες θέσεις στη Google και προτάσεις από το ChatGPT — με μέτρηση ορατότητας πριν και μετά.',
};

const services = [
  {
    t: 'Site που πουλάει',
    d: 'Γρήγορο, καθαρό, με ένα ξεκάθαρο επόμενο βήμα σε κάθε σελίδα. Όχι βιτρίνα — εργαλείο δουλειάς. Και με προαιρετική μηνιαία συντήρηση, τρέχει χωρίς να το σκέφτεστε.',
    icon: 'site',
  },
  {
    t: 'Site με online κρατήσεις',
    d: 'Οι πελάτες σας κλείνουν ραντεβού ή τραπέζι online και παίρνουν αυτόματη υπενθύμιση — τέλος τα «μου έστησε».',
    icon: 'cal',
    href: '#kratiseis',
  },
  {
    t: 'Google Business Profile',
    d: 'Στήσιμο και βελτιστοποίηση του προφίλ σας στους Χάρτες και την αναζήτηση Google — σωστά στοιχεία, κατηγορίες, φωτογραφίες.',
    icon: 'pin',
    href: '/odigoi/profil-google-maps/',
  },
  {
    t: 'Πρώτος στη Google (SEO)',
    d: 'Όταν ψάχνουν ό,τι κάνετε στην περιοχή σας, να βγαίνετε στα πρώτα αποτελέσματα. Με μηνιαία αναφορά θέσεων.',
    icon: 'seo',
  },
  {
    t: 'Να σε προτείνει το AI (GEO/AEO)',
    d: 'Ολοένα περισσότεροι ρωτάνε το ChatGPT «πού να πάω;». Φροντίζουμε η απάντηση να έχει το όνομά σας.',
    icon: 'ai',
  },
  {
    t: 'Social media',
    d: 'Προφίλ που δείχνουν ζωντανά: ξεκαθάρισμα και στήσιμο ή μηνιαία διαχείριση με posts και stories — με υλικό δικό σας ή δικό μας.',
    icon: 'social',
    href: '/odigoi/diaxeirisi-social-media/',
  },
  {
    t: 'Το Εργαλείο Κριτικών',
    d: 'Το εργαλείο μας που κάνει τις κριτικές Google να μαζεύονται μόνες τους. Πώς; Αυτό το δείχνουμε μόνο ζωντανά.',
    icon: 'star',
    href: '/kritikes/',
  },
  {
    t: 'Ψηφιακό Μενού με QR',
    d: 'QR στο τραπέζι: ο πελάτης σκανάρει και βλέπει το μενού στο κινητό του. Αλλάζετε τιμές και πιάτα όποτε θέλετε — χωρίς επανεκτυπώσεις.',
    icon: 'menu',
    href: '/psifiako-menou/',
  },
  {
    t: 'Μάτι στον ανταγωνισμό',
    d: 'Βλέπετε πού βγαίνει ο απέναντι και πού εσείς. Κάθε μήνα, στην ίδια αναφορά.',
    icon: 'eye',
  },
];

const faqItems = [
  {
    q: 'Σε πόσο καιρό φαίνεται αποτέλεσμα στο SEO;',
    a: 'Πρώτες ενδείξεις σε 2–3 μήνες, σταθερή άνοδο σε 4–6. Κάθε μήνα βλέπετε τα νούμερα — θέσεις, επισκέψεις, κλήσεις — και κρίνετε μόνοι σας την πορεία.',
  },
  {
    q: 'Τι είναι το GEO;',
    a: 'Generative Engine Optimization: να σας προτείνουν το ChatGPT, το Gemini και το Perplexity όταν κάποιος τα ρωτάει για ό,τι κάνετε. Είναι το SEO της εποχής του AI — και μετριέται, όπως και το κλασικό.',
  },
  {
    q: 'Έχω ήδη site — το κρατάμε;',
    a: 'Αν στέκει τεχνικά, ναι — χτίζουμε πάνω του και δεν πληρώνετε κάτι απ΄ την αρχή. Αν όχι, βλέπετε γραπτά τι κοστίζει η διόρθωση και τι το νέο, και αποφασίζετε εσείς.',
  },
  {
    q: 'Χρειάζομαι διαφημίσεις για να με βρίσκουν;',
    a: 'Όχι απαραίτητα. Η οργανική ορατότητα χτίζεται πιο αργά, αλλά μένει — και δεν πληρώνετε για κάθε κλικ. Αν κάπου αξίζουν διαφημίσεις, θα το δείτε με νούμερα, όχι με «πρέπει».',
  },
];
---

<Base
  title="Ψηφιακή Προβολή — SEO, ορατότητα σε AI & Reviews | PISMA"
  description="Site που πουλάει, πρώτες θέσεις στη Google και προτάσεις από το ChatGPT. Μετράμε την ορατότητά σας πριν και μετά — με νούμερα, όχι υποσχέσεις."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Πυλώνας Α'"
    sub="Όταν κάποιος ψάχνει ό,τι κάνετε στην περιοχή σας — να βγαίνετε εσείς. Στη Google και στο ChatGPT."
  >
    Ψηφιακή <span class="accent">Προβολή</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="svc-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Τι στήνουμε</p>
        <h2 id="svc-title">Εννιά δουλειές. Ένας στόχος: να σας βρίσκουν.</h2>
      </div>
      <div class="grid-3">
        {services.map((s) => (
          <article class="card reveal">
            <span class="icon-chip">
              {s.icon === 'site' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4.5" width="18" height="15" rx="2.5" /><path d="M3 9.5h18M6.4 7h.01M9.4 7h.01" />
                </svg>
              )}
              {s.icon === 'cal' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3.5" y="5" width="17" height="16" rx="2.5" /><path d="M3.5 9.8h17M8 2.8V6M16 2.8V6M8.5 14.5l2.3 2.3 4.4-4.6" />
                </svg>
              )}
              {s.icon === 'pin' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21.5s-7-6.2-7-11.3A7 7 0 0 1 19 10.2c0 5.1-7 11.3-7 11.3z" /><circle cx="12" cy="10" r="2.6" />
                </svg>
              )}
              {s.icon === 'social' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="6" cy="12" r="2.8" /><circle cx="17.5" cy="5.5" r="2.8" /><circle cx="17.5" cy="18.5" r="2.8" /><path d="M8.6 10.7l6.3-3.7M8.6 13.3l6.3 3.7" />
                </svg>
              )}
              {s.icon === 'seo' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /><path d="M7.4 12.4l2-2 1.7 1.5 2.5-2.8" />
                </svg>
              )}
              {s.icon === 'ai' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-2.9-.4-4.1-1L3 20l1-5.4A8.5 8.5 0 1 1 21 11.5z" /><path d="M12 8.5v5M9.5 11h5" />
                </svg>
              )}
              {s.icon === 'star' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
                </svg>
              )}
              {s.icon === 'menu' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="7" y="3" width="10" height="18" rx="2.5" /><path d="M10 7.5h4M10 11h4M10 14.5h2.5" />
                </svg>
              )}
              {s.icon === 'eye' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" />
                </svg>
              )}
            </span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            {s.href && <a class="card-arrow" href={s.href}>Μάθε τι κάνει →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 2β. «Site που πουλάει» — laptop mockup σε loop όπως οι άλλες σκηνές:
       το HTML έχει το τελικό state (site πλήρες, κράτηση κλεισμένη) — χωρίς
       JS ή με reduced motion μένει στατικό· το JS το «ξαναπαίζει» όσο το
       section είναι ορατό: η σελίδα χτίζεται κομμάτι-κομμάτι, ο κέρσορας
       πατά «Κλείσε ραντεβού» και η κράτηση επιβεβαιώνεται. -->
  <section class="section section--tight" id="kratiseis" aria-labelledby="lp-title">
    <div class="container">
      <div class="lp-grid">
        <div class="lp-copy">
          <div class="sec-head">
            <p class="kicker kicker--blue">Site με online κρατήσεις</p>
            <h2 id="lp-title">Ραντεβού που κλείνονται μόνα τους</h2>
          </div>
          <p class="lp-sub">
            Ο πελάτης βλέπει, διαλέγει ώρα και κλείνει — μέρα ή νύχτα, χωρίς
            τηλεφωνήματα. Εσείς απλώς βλέπετε το ημερολόγιο να γεμίζει.
          </p>
          <div class="lp-cta-row">
            <a class="btn btn--orange" href="/times/">Δες τιμές για site →</a>
          </div>
          <p class="lp-note">Ενδεικτική απεικόνιση — το δικό σας site στήνεται για τη δική σας δουλειά.</p>
        </div>

        <div class="lp-stage" id="lp-stage" aria-hidden="true">
          <div class="lp-laptop">
            <div class="lp-screen">
              <span class="lp-camdot"></span>
              <div class="lp-page is-dim" id="lp-page">
                <div class="lp-browser">
                  <span class="lp-dots"><i></i><i></i><i></i></span>
                  <span class="lp-url">anna-hair.gr</span>
                </div>
                <div class="lp-body">
                  <div class="lp-part lp-nav is-in">
                    <b>ANNA<span>hair studio</span></b>
                    <span class="lp-links"><i>Υπηρεσίες</i><i>Τιμές</i><i>Επικοινωνία</i></span>
                  </div>
                  <div class="lp-hero">
                    <div class="lp-part lp-hcopy is-in">
                      <p class="lp-h1">Λάμψε από την πρώτη ματιά</p>
                      <p class="lp-hsub">Κούρεμα, βαφή, styling — online κράτηση σε 30 δευτερόλεπτα.</p>
                      <span class="lp-btn" id="lp-cta">Κλείσε ραντεβού</span>
                    </div>
                    <div class="lp-part lp-hart is-in">
                      <img src="/site-demo/salon.jpg" alt="" loading="lazy" width="360" height="290" />
                      <span class="lp-hart-chip">★ 4,9 · 234 κριτικές</span>
                    </div>
                  </div>
                  <div class="lp-cards">
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6.5" r="2.6"/><circle cx="6" cy="17.5" r="2.6"/><path d="M8.3 8.2 20 19.4M8.3 15.8 20 4.6"/></svg>Κούρεμα <b class="num">15€</b></span>
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3.4 4.1 5.8 7.1 5.8 9.9a5.8 5.8 0 1 1-11.6 0c0-2.8 2.4-5.8 5.8-9.9z"/></svg>Βαφή <b class="num">45€</b></span>
                    <span class="lp-part lp-mini is-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l1.9 5.6 5.6 1.9-5.6 1.9L12 18.5l-1.9-5.6-5.6-1.9 5.6-1.9z"/><path d="M18.8 16.6l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>Styling <b class="num">20€</b></span>
                  </div>
                </div>
                <!-- Βήματα κράτησης: υπηρεσία → ώρα → επιβεβαίωση (μόνο με JS) -->
                <div class="lp-book" id="lp-book">
                  <p class="lp-book-t">Κλείσε ραντεβού</p>
                  <p class="lp-book-l">Υπηρεσία</p>
                  <div class="lp-chips">
                    <span class="lp-chip" id="lp-svc">Κούρεμα</span>
                    <span class="lp-chip">Βαφή</span>
                    <span class="lp-chip">Styling</span>
                  </div>
                  <p class="lp-book-l">Ημέρα</p>
                  <div class="lp-chips">
                    <span class="lp-chip">Πέμπτη</span>
                    <span class="lp-chip" id="lp-day">Παρασκευή</span>
                    <span class="lp-chip">Σάββατο</span>
                    <span class="lp-chip lp-chip--more">Άλλη μέρα ›</span>
                  </div>
                  <p class="lp-book-l">Ώρα</p>
                  <div class="lp-chips">
                    <span class="lp-chip">16:00</span>
                    <span class="lp-chip" id="lp-time">17:30</span>
                    <span class="lp-chip">19:00</span>
                  </div>
                  <span class="lp-confirm" id="lp-confirm">Επιβεβαίωση</span>
                </div>
                <div class="lp-done is-on" id="lp-done">
                  <span class="lp-done-check">✓</span>
                  <p class="lp-done-t">Το ραντεβού κλείστηκε!</p>
                  <p class="lp-done-s">Παρασκευή 17:30 · Κούρεμα</p>
                </div>
                <svg class="lp-cursor" id="lp-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 3.2 19 12.2l-6.6 1.1 3.4 6.4-2.7 1.4-3.4-6.4-4.2 4.6z" fill="#111" stroke="#fff" stroke-width="1.4"/></svg>
              </div>
            </div>
            <div class="lp-base"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Ρώτα το AI — demo -->
  <section class="section" aria-labelledby="chat-title">
    <div class="container container--narrow">
      <div class="sec-head sec-head--center">
        <p class="kicker">Δείτε το ζωντανά</p>
        <h2 id="chat-title">Ρώτα το AI</h2>
        <p>Κάπως έτσι μοιάζει η ερώτηση ενός πελάτη σήμερα — και η απάντηση που παίρνει.</p>
      </div>

      <div class="chat card" id="ai-chat">
        <div class="chat-head">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="chat-title">Συνομιλία με AI</span>
          <span class="tag tag--demo">Demo</span>
        </div>
        <div class="chat-body">
          <p class="msg msg--user">καλό κομμωτήριο κοντά μου;</p>
          <p class="msg msg--ai msg-typing" aria-hidden="true"><span class="tdot"></span><span class="tdot"></span><span class="tdot"></span></p>
          <div class="msg msg--ai">
            <p class="ai-intro">Με βάση κριτικές και online παρουσία, ξεχωρίζουν τρία:</p>
            <ol class="ai-list">
              <li class="ai-item">
                <strong>Salon «Ν.»</strong>
                <span class="ai-note">4,9 · 200+ κριτικές</span>
              </li>
              <li class="ai-item ai-item--you">
                <strong>Το δικό σας όνομα</strong>
                <span class="you-flag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5M11 6l-6 6 6 6" />
                  </svg>
                  εδώ πρέπει να είστε εσείς
                </span>
              </li>
              <li class="ai-item">
                <strong>Studio «Μ.»</strong>
                <span class="ai-note">δίπλα στην πλατεία</span>
              </li>
            </ol>
          </div>
        </div>
      </div>

      <div class="chat-cta">
        <a class="btn btn--orange" href="/tablo/">Μάθε αν σε προτείνει</a>
        <span class="btn-note">2 λεπτά · δωρεάν · χωρίς στοιχεία</span>
      </div>
    </div>
  </section>

  <!-- 4. AI Visibility Index -->
  <section class="section section--tight" aria-labelledby="avi-title">
    <div class="container">
      <div class="card avi reveal">
        <div class="avi-intro">
          <p class="kicker">AI Visibility Index</p>
          <h2 id="avi-title">Η ορατότητά σας στο AI, σε ένα νούμερο.</h2>
          <p>Το μετράμε πριν ξεκινήσουμε και κάθε μήνα μετά — για να βλέπετε την αλλαγή στο χαρτί.</p>
        </div>
        <ol class="avi-points">
          <li>
            <span class="avi-num num">1</span>
            <div>
              <h3>Τι είναι</h3>
              <p>Σε πόσες σχετικές ερωτήσεις — «κομμωτήριο κοντά μου», «καλός λογιστής» — σας προτείνει το AI.</p>
            </div>
          </li>
          <li>
            <span class="avi-num num">2</span>
            <div>
              <h3>Πώς βγαίνει</h3>
              <p>Ρωτάμε ChatGPT, Gemini και Perplexity πραγματικές ερωτήσεις πελατών και καταγράφουμε πού εμφανίζεστε.</p>
            </div>
          </li>
          <li>
            <span class="avi-num num">3</span>
            <div>
              <h3>Γιατί μετράει</h3>
              <p>Αν το AI δεν σας αναφέρει, ο πελάτης πάει αλλού — και δεν το μαθαίνετε ποτέ.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Πριν ρωτήσετε, ρώτησαν άλλοι.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. Τελικό CTA -->
  <CtaBand
    title="Δείτε πόσο σας βρίσκουν — πριν το δει ο ανταγωνισμός."
    sub="Το Ταμπλό σάς δίνει σκορ ορατότητας σε δύο λεπτά."
    ctaText="Μέτρησε την ορατότητά σου"
    ctaHref="/tablo/"
    note="2 λεπτά · δωρεάν · χωρίς στοιχεία"
  />
</Base>

<script>
  // «Ρώτα το AI»: τα μηνύματα υπάρχουν ήδη στο HTML — το JS μόνο τα κρύβει
  // (is-armed) και τα «ξαναπαίζει» σε loop όσο το chat είναι ορατό: ερώτηση →
  // «γράφει…» → απάντηση → παλμός στη δική σας θέση. Όταν βγει από την οθόνη,
  // σταματά και μένει στο τελικό state. Χωρίς JS, όλα ορατά από την αρχή.
  const chat = document.getElementById('ai-chat');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (chat) {
    if (!reduce && 'IntersectionObserver' in window) {
      chat.classList.add('is-armed'); // μόνο τώρα κρύβονται τα μηνύματα
      const youItem = chat.querySelector('.ai-item--you');
      let timers: number[] = [];
      let active = false;
      const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
      const stopAll = () => { timers.forEach(clearTimeout); timers = []; };
      const finalState = () => {
        chat.classList.add('is-play');
        chat.classList.remove('is-typing');
        youItem?.classList.remove('is-pulse');
      };
      const cycle = () => {
        stopAll();
        // Στιγμιαία επαναφορά στην αρχή, χωρίς transitions (is-snap)
        chat.classList.add('is-snap');
        chat.classList.remove('is-play', 'is-typing');
        youItem?.classList.remove('is-pulse');
        void (chat as HTMLElement).offsetWidth;
        chat.classList.remove('is-snap');
        later(() => chat.classList.add('is-play'), 60);
        later(() => chat.classList.add('is-typing'), 750);
        later(() => chat.classList.remove('is-typing'), 2050);
        later(() => youItem?.classList.add('is-pulse'), 3800);
        later(() => youItem?.classList.remove('is-pulse'), 6300);
        later(cycle, 8800);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && !active) { active = true; cycle(); }
            else if (!e.isIntersecting && active) { active = false; stopAll(); finalState(); }
          }
        },
        { threshold: 0.35 }
      );
      io.observe(chat);
    }
    // Με reduced-motion (ή χωρίς IO): καμία κλάση — τελικό state αμέσως.
  }

  // «Site με online κρατήσεις» (laptop): το HTML έχει το τελικό state (site
  // πλήρες, κράτηση επιβεβαιωμένη). Με JS + ορατότητα, σε loop: η σελίδα
  // χτίζεται κομμάτι-κομμάτι, ο κέρσορας πατά «Κλείσε ραντεβού» και περνάει
  // τα ΒΗΜΑΤΑ της κράτησης — υπηρεσία → ώρα → Επιβεβαίωση → «κλείστηκε».
  // Εκτός οθόνης: τελικό state.
  const lpStage = document.getElementById('lp-stage');
  if (lpStage && !reduce && 'IntersectionObserver' in window) {
    const lpPage = document.getElementById('lp-page')!;
    const lpCta = document.getElementById('lp-cta')!;
    const lpBook = document.getElementById('lp-book')!;
    const lpSvc = document.getElementById('lp-svc')!;
    const lpDay = document.getElementById('lp-day')!;
    const lpTime = document.getElementById('lp-time')!;
    const lpConfirm = document.getElementById('lp-confirm')!;
    const lpDone = document.getElementById('lp-done')!;
    const lpCursor = document.getElementById('lp-cursor')!;
    const lpParts = Array.from(lpStage.querySelectorAll<HTMLElement>('.lp-part'));
    let lpTimers: number[] = [];
    let lpActive = false;
    const lpLater = (fn: () => void, ms: number) => lpTimers.push(window.setTimeout(fn, ms));

    // Ο κέρσορας ταξιδεύει ώστε η μύτη του βέλους να πέφτει πάνω στο στοιχείο
    const lpGo = (el: HTMLElement, ms: number) => {
      const pr = lpPage.getBoundingClientRect();
      const br = el.getBoundingClientRect();
      lpCursor.style.transition = `opacity .3s ease, left ${ms}ms cubic-bezier(.3, .7, .25, 1), top ${ms}ms cubic-bezier(.3, .7, .25, 1)`;
      lpCursor.style.opacity = '1';
      lpCursor.style.left = `${Math.round(br.left - pr.left + br.width * 0.55)}px`;
      lpCursor.style.top = `${Math.round(br.top - pr.top + br.height * 0.55)}px`;
    };

    const lpFinal = () => {
      lpParts.forEach((p) => p.classList.add('is-in'));
      lpCta.classList.remove('is-press');
      lpConfirm.classList.remove('is-press');
      lpBook.classList.remove('is-on');
      lpSvc.classList.add('is-sel');
      lpDay.classList.add('is-sel');
      lpTime.classList.add('is-sel');
      lpPage.classList.add('is-dim');
      lpDone.classList.add('is-on');
      lpCursor.style.opacity = '0';
    };

    const lpCycle = () => {
      lpTimers.forEach(clearTimeout); lpTimers = [];
      const pr = lpPage.getBoundingClientRect();
      // Επαναφορά: άδεια σελίδα, κέρσορας κάτω-δεξιά, τίποτα επιλεγμένο
      lpParts.forEach((p) => p.classList.remove('is-in'));
      lpCta.classList.remove('is-press');
      lpConfirm.classList.remove('is-press');
      lpBook.classList.remove('is-on');
      lpSvc.classList.remove('is-sel');
      lpDay.classList.remove('is-sel');
      lpTime.classList.remove('is-sel');
      lpPage.classList.remove('is-dim');
      lpDone.classList.remove('is-on');
      lpCursor.style.transition = 'none';
      lpCursor.style.opacity = '0';
      lpCursor.style.left = `${Math.round(pr.width - 34)}px`;
      lpCursor.style.top = `${Math.round(pr.height - 30)}px`;
      // Η σελίδα «χτίζεται» κομμάτι-κομμάτι
      lpLater(() => {
        lpParts.forEach((p, i) => lpLater(() => p.classList.add('is-in'), i * 220));
      }, 600);
      // 1) Κλικ στο «Κλείσε ραντεβού» → ανοίγει η φόρμα βημάτων
      lpLater(() => lpGo(lpCta, 1000), 3200);
      lpLater(() => lpCta.classList.add('is-press'), 4400);
      lpLater(() => lpCta.classList.remove('is-press'), 4700);
      lpLater(() => { lpPage.classList.add('is-dim'); lpBook.classList.add('is-on'); }, 5000);
      // 2) Επιλογή υπηρεσίας
      lpLater(() => lpGo(lpSvc, 850), 5800);
      lpLater(() => lpSvc.classList.add('is-sel'), 6900);
      // 3) Επιλογή ημέρας
      lpLater(() => lpGo(lpDay, 850), 7400);
      lpLater(() => lpDay.classList.add('is-sel'), 8500);
      // 4) Επιλογή ώρας
      lpLater(() => lpGo(lpTime, 850), 9000);
      lpLater(() => lpTime.classList.add('is-sel'), 10100);
      // 5) Επιβεβαίωση → «Το ραντεβού κλείστηκε!»
      lpLater(() => lpGo(lpConfirm, 850), 10600);
      lpLater(() => lpConfirm.classList.add('is-press'), 11700);
      lpLater(() => lpConfirm.classList.remove('is-press'), 12000);
      lpLater(() => {
        lpBook.classList.remove('is-on');
        lpDone.classList.add('is-on');
        lpCursor.style.opacity = '0';
      }, 12400);
      // Δίχτυ ασφαλείας: κλείδωμα στο στατικό state
      lpLater(lpFinal, 16800);
      lpLater(lpCycle, 18600);
    };

    const lpIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !lpActive) { lpActive = true; lpCycle(); }
          else if (!e.isIntersecting && lpActive) {
            lpActive = false;
            lpTimers.forEach(clearTimeout); lpTimers = [];
            lpFinal();
          }
        }
      },
      { threshold: 0.35 }
    );
    lpIo.observe(lpStage);
  }
</script>

