---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Ψηφιακή Προβολή — Ορατότητα σε Google και AI',
  serviceType: 'Κατασκευή ιστοσελίδων, Κατασκευή e-shop Shopify, Διαχείριση Shopify, Google Business Profile, SEO, GEO/AEO, Social media, Google Reviews, Φωτογράφηση και βίντεο',
  areaServed: SITE.region,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'Αττική',
      addressCountry: 'GR',
    },
  },
  description:
    'Site που πουλάει, πρώτες θέσεις στη Google και προτάσεις από το ChatGPT — με μέτρηση ορατότητας πριν και μετά.',
};

const services = [
  {
    t: 'Site που πουλάει',
    d: 'Γρήγορο, καθαρό, με ένα ξεκάθαρο επόμενο βήμα σε κάθε σελίδα. Όχι βιτρίνα — εργαλείο δουλειάς. Και με προαιρετική μηνιαία συντήρηση, τρέχει χωρίς να το σκέφτεστε.',
    icon: 'site',
    href: '/site-pou-poulaei/',
  },
  {
    t: 'Site με online κρατήσεις',
    d: 'Οι πελάτες σας κλείνουν ραντεβού ή τραπέζι online και παίρνουν αυτόματη υπενθύμιση — τέλος τα «μου έστησε».',
    icon: 'cal',
    href: '/site-kratiseis/',
  },
  {
    t: 'Google Business Profile',
    d: 'Στήσιμο και βελτιστοποίηση του προφίλ σας στους Χάρτες και την αναζήτηση Google — σωστά στοιχεία, κατηγορίες, φωτογραφίες.',
    icon: 'pin',
    href: '/odigoi/profil-google-maps/',
  },
  {
    t: 'Πρώτος στη Google (SEO)',
    d: 'Όταν ψάχνουν ό,τι κάνετε στην περιοχή σας, να βγαίνετε στα πρώτα αποτελέσματα. Με μηνιαία αναφορά θέσεων.',
    icon: 'seo',
  },
  {
    t: 'Να σας προτείνει το AI (GEO/AEO)',
    d: 'Ολοένα περισσότεροι ρωτάνε το ChatGPT «πού να πάω;». Φροντίζουμε η απάντηση να έχει το όνομά σας.',
    icon: 'ai',
  },
  {
    t: 'Το Εργαλείο Κριτικών',
    d: 'Το εργαλείο μας που κάνει τις κριτικές Google να μαζεύονται μόνες τους. Πώς; Αυτό το δείχνουμε μόνο ζωντανά.',
    icon: 'star',
    href: '/kritikes/',
  },
  {
    t: 'E-shop σε Shopify',
    d: 'Ηλεκτρονικό κατάστημα στημένο σωστά από την πρώτη μέρα: προϊόντα, πληρωμές, αποστολές, όλα έτοιμα να πουλάνε. Και μετά, το διαχειρίζεστε εσείς — ή εμείς.',
    icon: 'shopify',
    size: 'big',
    href: '/shopify/',
  },
  {
    t: 'Διαχείριση Shopify',
    d: 'Έχετε ήδη e-shop; Το αναλαμβάνουμε μήνα-μήνα: νέα προϊόντα, αποθέματα, εκπτώσεις, apps, ενημερώσεις. Εσείς βλέπετε μόνο τις παραγγελίες.',
    icon: 'shopify',
    href: '/shopify/#diaxeirisi',
  },
  {
    t: 'Φωτογράφηση & Βίντεο',
    d: 'Ερχόμαστε στον χώρο σας: φωτογραφίες προϊόντων, πιάτων, χώρου και ομάδας, και μικρά βίντεο για site, Google και social. Δικό σας υλικό — όχι από το internet.',
    icon: 'camera',
    href: '/fotografisi-video/',
  },
  {
    t: 'Social media',
    d: 'Προφίλ που δείχνουν ζωντανά: ξεκαθάρισμα και στήσιμο ή μηνιαία διαχείριση με posts και stories — με υλικό δικό σας ή δικό μας.',
    icon: 'social',
    href: '/odigoi/diaxeirisi-social-media/',
  },
  {
    t: 'Ψηφιακό Μενού με QR',
    d: 'QR στο τραπέζι: ο πελάτης σκανάρει και βλέπει το μενού στο κινητό του. Αλλάζετε τιμές και πιάτα όποτε θέλετε — χωρίς επανεκτυπώσεις.',
    icon: 'menu',
    href: '/psifiako-menou/',
  },
  {
    t: 'Μάτι στον ανταγωνισμό',
    d: 'Βλέπετε πού βγαίνει ο απέναντι και πού εσείς. Κάθε μήνα, στην ίδια αναφορά.',
    icon: 'eye',
  },
];

const faqItems = [
  {
    q: 'Σε πόσο καιρό φαίνεται αποτέλεσμα στο SEO;',
    a: 'Πρώτες ενδείξεις σε 2–3 μήνες, σταθερή άνοδο σε 4–6. Κάθε μήνα βλέπετε τα νούμερα — θέσεις, επισκέψεις, κλήσεις — και κρίνετε μόνοι σας την πορεία.',
  },
  {
    q: 'Τι είναι το GEO;',
    a: 'Generative Engine Optimization: να σας προτείνουν το ChatGPT, το Gemini και το Perplexity όταν κάποιος τα ρωτάει για ό,τι κάνετε. Είναι το SEO της εποχής του AI — και μετριέται, όπως και το κλασικό.',
  },
  {
    q: 'Έχω ήδη site — το κρατάμε;',
    a: 'Αν στέκει τεχνικά, ναι — χτίζουμε πάνω του και δεν πληρώνετε κάτι απ’ την αρχή. Αν όχι, βλέπετε γραπτά τι κοστίζει η διόρθωση και τι το νέο, και αποφασίζετε εσείς.',
  },
  {
    q: 'Χρειάζομαι διαφημίσεις για να με βρίσκουν;',
    a: 'Όχι απαραίτητα. Η οργανική ορατότητα χτίζεται πιο αργά, αλλά μένει — και δεν πληρώνετε για κάθε κλικ. Αν κάπου αξίζουν διαφημίσεις, θα το δείτε με νούμερα, όχι με «πρέπει».',
  },
];
---

<Base
  title="Ψηφιακή Προβολή — SEO, ορατότητα σε AI & Reviews | PISMA"
  description="Site που πουλάει, πρώτες θέσεις στη Google και προτάσεις από το ChatGPT. Μετράμε την ορατότητά σας πριν και μετά — με νούμερα, όχι υποσχέσεις."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Πυλώνας Α΄"
    sub="Όταν κάποιος ψάχνει ό,τι κάνετε στην περιοχή σας — να βγαίνετε εσείς. Στη Google και στο ChatGPT."
  >
    Ψηφιακή <span class="accent">Προβολή</span>
  </PageHero>

  <!-- 2. Υπηρεσίες -->
  <section class="section section--tight" aria-labelledby="svc-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Τι στήνουμε</p>
        <h2 id="svc-title">Δώδεκα δουλειές. Ένας στόχος: να σας βρίσκουν.</h2>
      </div>
      <ServiceCards services={services} cta="Μάθετε τι κάνει →" />
    </div>
  </section>

  <!-- 3. Ρώτα το AI — demo -->
  <section class="section" aria-labelledby="chat-title">
    <div class="container container--narrow">
      <div class="sec-head sec-head--center">
        <p class="kicker">Δείτε το ζωντανά</p>
        <h2 id="chat-title">Ρωτήστε το AI</h2>
        <p>Κάπως έτσι μοιάζει η ερώτηση ενός πελάτη σήμερα — και η απάντηση που παίρνει.</p>
      </div>

      <div class="chat card" id="ai-chat">
        <div class="chat-head">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="chat-title">Συνομιλία με AI</span>
          <span class="tag tag--demo">Demo</span>
        </div>
        <div class="chat-body">
          <p class="msg msg--user">καλό κομμωτήριο κοντά μου;</p>
          <p class="msg msg--ai msg-typing" aria-hidden="true"><span class="tdot"></span><span class="tdot"></span><span class="tdot"></span></p>
          <div class="msg msg--ai">
            <p class="ai-intro">Με βάση κριτικές και online παρουσία, ξεχωρίζουν τρία:</p>
            <ol class="ai-list">
              <li class="ai-item">
                <strong>Salon «Ν.»</strong>
                <span class="ai-note">4,9 · 200+ κριτικές</span>
              </li>
              <li class="ai-item ai-item--you">
                <strong>Το δικό σας όνομα</strong>
                <span class="you-flag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5M11 6l-6 6 6 6" />
                  </svg>
                  εδώ πρέπει να είστε εσείς
                </span>
              </li>
              <li class="ai-item">
                <strong>Studio «Μ.»</strong>
                <span class="ai-note">δίπλα στην πλατεία</span>
              </li>
            </ol>
          </div>
        </div>
      </div>

      <div class="chat-cta">
        <a class="btn btn--orange" href="/tablo/">Μετρήστε την επιχείρησή σας</a>
        <span class="btn-note">2 λεπτά · δωρεάν · χωρίς στοιχεία</span>
      </div>
    </div>
  </section>

  <!-- 4. AI Visibility Index -->
  <section class="section section--tight" aria-labelledby="avi-title">
    <div class="container">
      <div class="card avi reveal">
        <div class="avi-intro">
          <p class="kicker">AI Visibility Index</p>
          <h2 id="avi-title">Η ορατότητά σας στο AI, σε ένα νούμερο.</h2>
          <p>Το μετράμε πριν ξεκινήσουμε και κάθε μήνα μετά — για να βλέπετε την αλλαγή στο χαρτί.</p>
        </div>
        <ol class="avi-points">
          <li>
            <span class="avi-num num">1</span>
            <div>
              <h3>Τι είναι</h3>
              <p>Σε πόσες σχετικές ερωτήσεις — «κομμωτήριο κοντά μου», «καλός λογιστής» — σας προτείνει το AI.</p>
            </div>
          </li>
          <li>
            <span class="avi-num num">2</span>
            <div>
              <h3>Πώς βγαίνει</h3>
              <p>Ρωτάμε ChatGPT, Gemini και Perplexity πραγματικές ερωτήσεις πελατών και καταγράφουμε πού εμφανίζεστε.</p>
            </div>
          </li>
          <li>
            <span class="avi-num num">3</span>
            <div>
              <h3>Γιατί μετράει</h3>
              <p>Αν το AI δεν σας αναφέρει, ο πελάτης πάει αλλού — και δεν το μαθαίνετε ποτέ.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Πριν ρωτήσετε, ρώτησαν άλλοι.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. Τελικό CTA -->
  <CtaBand
    title="Δείτε πόσο σας βρίσκουν — πριν το δει ο ανταγωνισμός."
    sub="Το Ταμπλό σάς δίνει σκορ ορατότητας σε δύο λεπτά."
    ctaText="Μετρήστε την επιχείρησή σας"
    ctaHref="/tablo/"
    note="2 λεπτά · δωρεάν · χωρίς στοιχεία"
  />
</Base>

<script>
  // «Ρώτα το AI»: τα μηνύματα υπάρχουν ήδη στο HTML — το JS μόνο τα κρύβει
  // (is-armed) και τα «ξαναπαίζει» σε loop όσο το chat είναι ορατό: ερώτηση →
  // «γράφει…» → απάντηση → παλμός στη δική σας θέση. Όταν βγει από την οθόνη,
  // σταματά και μένει στο τελικό state. Χωρίς JS, όλα ορατά από την αρχή.
  const chat = document.getElementById('ai-chat');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (chat) {
    if (!reduce && 'IntersectionObserver' in window) {
      chat.classList.add('is-armed'); // μόνο τώρα κρύβονται τα μηνύματα
      const youItem = chat.querySelector('.ai-item--you');
      let timers: number[] = [];
      let active = false;
      const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
      const stopAll = () => { timers.forEach(clearTimeout); timers = []; };
      const finalState = () => {
        chat.classList.add('is-play');
        chat.classList.remove('is-typing');
        youItem?.classList.remove('is-pulse');
      };
      const cycle = () => {
        stopAll();
        // Στιγμιαία επαναφορά στην αρχή, χωρίς transitions (is-snap)
        chat.classList.add('is-snap');
        chat.classList.remove('is-play', 'is-typing');
        youItem?.classList.remove('is-pulse');
        void (chat as HTMLElement).offsetWidth;
        chat.classList.remove('is-snap');
        later(() => chat.classList.add('is-play'), 60);
        later(() => chat.classList.add('is-typing'), 750);
        later(() => chat.classList.remove('is-typing'), 2050);
        later(() => youItem?.classList.add('is-pulse'), 3800);
        later(() => youItem?.classList.remove('is-pulse'), 6300);
        later(cycle, 8800);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && !active) { active = true; cycle(); }
            else if (!e.isIntersecting && active) { active = false; stopAll(); finalState(); }
          }
        },
        { threshold: 0.35 }
      );
      io.observe(chat);
    }
    // Με reduced-motion (ή χωρίς IO): καμία κλάση — τελικό state αμέσως.
  }
</script>

<style>
  /* ---------- Chat demo ---------- */
  .chat {
    max-width: 620px;
    margin-inline: auto;
    padding: 0;
    overflow: hidden;
  }
  .chat-head {
    display: flex; align-items: center; gap: 12px;
    padding: 13px 20px;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .win-dots { display: inline-flex; gap: 6px; }
  .win-dots i {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--line);
  }
  .chat-title { font-size: .88rem; font-weight: 700; color: var(--navy); margin-right: auto; }
  .chat-body { padding: clamp(18px, 3vw, 26px); display: grid; gap: 14px; }

  .msg--user {
    justify-self: end;
    background: var(--grad); color: #fff;
    border-radius: 16px 16px 4px 16px;
    padding: 11px 18px;
    max-width: 80%;
    font-weight: 600;
  }
  .msg--ai {
    justify-self: start;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px 16px 16px 4px;
    padding: 16px 18px;
    width: 100%;
  }
  .ai-intro { font-size: .95rem; color: var(--muted); }
  .ai-list {
    list-style: none; padding: 0;
    margin-top: 12px;
    display: grid; gap: 8px;
    counter-reset: shop;
  }
  .ai-item {
    display: flex; align-items: center; justify-content: space-between;
    gap: 6px 14px; flex-wrap: wrap;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 10px 16px;
    font-size: .95rem;
  }
  .ai-item::before {
    counter-increment: shop;
    content: counter(shop) '.';
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--muted);
  }
  .ai-item strong { color: var(--navy); margin-right: auto; }
  .ai-note { color: var(--muted); font-size: .85rem; }
  .ai-item--you {
    border: 2px solid var(--orange);
    background: var(--orange-soft);
  }
  .ai-item--you::before { color: var(--orange-text); }
  .you-flag {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--orange-text);
    font-size: .76rem; font-weight: 700;
    letter-spacing: .05em; text-transform: uppercase;
    white-space: nowrap;
  }
  .you-flag svg { width: 16px; height: 16px; flex: none; }

  .chat-cta { text-align: center; margin-top: clamp(24px, 4vw, 36px); }

  /* Staggered εμφάνιση μηνυμάτων (κρύβονται μόνο όταν το JS βάλει is-armed) */
  .chat.is-armed .msg,
  .chat.is-armed .ai-item {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .45s ease, transform .45s ease;
  }
  .chat.is-play .msg,
  .chat.is-play .ai-item { opacity: 1; transform: none; }
  .chat.is-play .msg--user { transition-delay: .15s; }
  .chat.is-play .msg--ai { transition-delay: 2s; }
  .chat.is-play .ai-item:nth-child(1) { transition-delay: 2.4s; }
  .chat.is-play .ai-item:nth-child(2) { transition-delay: 2.7s; }
  .chat.is-play .ai-item:nth-child(3) { transition-delay: 3s; }

  /* Επαναφορά loop χωρίς transitions — στιγμιαίο «σβήσιμο» πριν τον νέο κύκλο */
  .chat.is-snap .msg,
  .chat.is-snap .ai-item { transition: none !important; }

  /* «Γράφει…» — φαίνεται μόνο στο διάστημα is-typing, μεταξύ ερώτησης και απάντησης */
  .msg-typing { display: none; }
  .chat.is-typing .msg-typing {
    display: inline-flex; align-items: center; gap: 5px;
    width: max-content; padding: 13px 17px;
    opacity: 1; transform: none; transition: none;
  }
  .tdot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--muted);
    animation: tdot 1s infinite ease-in-out;
  }
  .tdot:nth-child(2) { animation-delay: .15s; }
  .tdot:nth-child(3) { animation-delay: .3s; }
  @keyframes tdot {
    0%, 100% { opacity: .35; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-3px); }
  }

  /* Παλμός στη θέση «εδώ πρέπει να είστε εσείς» */
  @keyframes youPulse {
    from { box-shadow: 0 0 0 0 rgba(var(--orange-rgb), .5); }
    to { box-shadow: 0 0 0 16px rgba(var(--orange-rgb), 0); }
  }
  .ai-item--you.is-pulse { animation: youPulse 1.1s ease-out 2; }

  @media (prefers-reduced-motion: reduce) {
    .chat.is-armed .msg,
    .chat.is-armed .ai-item {
      transition: none !important;
      transition-delay: 0s !important;
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- AI Visibility Index ---------- */
  .avi {
    display: grid;
    grid-template-columns: minmax(min(300px, 100%), .9fr) minmax(min(300px, 100%), 1.1fr);
    gap: clamp(26px, 5vw, 56px);
    align-items: start;
    padding: clamp(26px, 4vw, 48px);
  }
  @media (max-width: 760px) {
    .avi { grid-template-columns: 1fr; }
  }
  .avi-intro .kicker { margin-bottom: 14px; }
  .avi-intro p:not(.kicker) { margin-top: 12px; color: var(--muted); }
  .avi-points {
    list-style: none; padding: 0;
    display: grid; gap: 18px;
  }
  .avi-points li { display: flex; gap: 16px; align-items: flex-start; }
  .avi-num {
    flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 10px;
    background: var(--orange-soft); color: var(--orange-cta);
    font-weight: 700;
  }
  .avi-points h3 { font-size: 1rem; margin-bottom: 2px; }
  .avi-points p { font-size: .95rem; color: var(--muted); }
</style>
