---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, ELEGXOS, eur } from '../config';
import { optionById } from '../data/pricing';

// Το προϊόν κριτικών — μία πηγή αλήθειας: pricing.ts.
// Τιμές αυτοκόλλητων: πίνακας F στο /aftokollita/ (εφάπαξ, από 18 € το πακέτο).
// ΣΚΟΠΙΜΑ teaser: ο μηχανισμός του Τροχού δεν περιγράφεται πουθενά δημόσια —
// ούτε βήματα, ούτε demo link. Παρουσιάζεται μόνο ζωντανά, σε ραντεβού.
const wheel = optionById('auto-reviews')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Το Εργαλείο Κριτικών',
  serviceType: 'Αύξηση κριτικών Google για τοπικές επιχειρήσεις',
  areaServed: SITE.region,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: wheel.price,
    priceCurrency: 'EUR',
    description: `${eur(wheel.price)} τον μήνα, χωρίς δέσμευση — συν αυτοκόλλητα QR εφάπαξ.`,
  },
  description:
    'Το εργαλείο της PISMA που κάνει τις κριτικές Google να μαζεύονται μόνες τους. Ξεκινά από ένα αυτοκόλλητο QR στον χώρο της επιχείρησης — και παρουσιάζεται μόνο ζωντανά, σε ραντεβού.',
};

const what = [
  {
    t: 'Ο πελάτης το χαίρεται',
    d: 'Δεν είναι άλλο ένα «αφήστε μας κριτική» που το προσπερνάνε. Ξεκινά από ένα αυτοκόλλητο στον χώρο σου — στο τραπέζι, στο ταμείο, στη ρεσεψιόν — και γίνεται κάτι που ο πελάτης σου κάνει με χαμόγελο.',
  },
  {
    t: 'Δουλεύει χωρίς εσένα',
    d: 'Δεν χρειάζεται να θυμάσαι να ζητάς. Στήνεται μία φορά και δουλεύει κάθε μέρα, για κάθε πελάτη — εσύ απλώς βλέπεις τις κριτικές να ανεβαίνουν.',
  },
  {
    t: 'Μέσα στους κανόνες της Google',
    d: 'Καμία αγορασμένη κριτική, καμία στημένη, κανένα αντάλλαγμα. Ήταν η πρώτη προδιαγραφή όταν το σχεδιάζαμε — και στο ραντεβού θα δεις ακριβώς πώς τηρείται.',
  },
];

const faqItems = [
  {
    q: 'Τι είναι το Εργαλείο Κριτικών;',
    a: 'Το εργαλείο της PISMA για κριτικές Google: ξεκινά από ένα αυτοκόλλητο QR στον χώρο σου και κάνει τις κριτικές να μαζεύονται μόνες τους — με έναν τρόπο που οι πελάτες σου τον χαίρονται. Το πώς ακριβώς δουλεύει δεν το περιγράφουμε δημόσια· το βλέπεις ζωντανά.',
  },
  {
    q: 'Γιατί δεν δείχνετε πώς δουλεύει;',
    a: 'Γιατί ό,τι δουλεύει, αντιγράφεται. Το Εργαλείο το δείχνουμε μόνο ζωντανά — σε εσένα, στημένο για το δικό σου μαγαζί, με το όνομα και τα χρώματά σου. Μια βιντεοκλήση 15 λεπτών φτάνει για να καταλάβεις αν σου κάνει.',
  },
  {
    q: 'Είναι μέσα στους κανόνες της Google;',
    a: 'Ναι, απόλυτα. Η Google απαγορεύει τις αγορασμένες κριτικές, το αντάλλαγμα για κριτική και το φιλτράρισμα — το Εργαλείο δεν κάνει τίποτα από τα τρία. Στο ζωντανό ραντεβού θα δεις ακριβώς πώς το πετυχαίνουμε.',
  },
  {
    q: 'Τι χρειάζομαι για να ξεκινήσω;',
    a: 'Ένα προφίλ στο Google (αν δεν έχεις, το στήνουμε) και τα αυτοκόλλητα QR. Όλα τα υπόλοιπα τα στήνουμε εμείς — εσύ κολλάς τα αυτοκόλλητα.',
  },
  {
    q: 'Πόσο κοστίζει;',
    a: `${eur(wheel.price)} τον μήνα για την πλατφόρμα — χωρίς συμβόλαιο και χωρίς δέσμευση. Τα αυτοκόλλητα QR πληρώνονται μία φορά, από 18€ το πακέτο.`,
  },
  {
    q: 'Δουλεύει και για delivery;',
    a: 'Ναι — υπάρχουν αυτοκόλλητα για τη σακούλα και την απόδειξη, και το Εργαλείο δουλεύει το ίδιο καλά κι από το σπίτι του πελάτη.',
  },
];
---

<Base
  title="Το Εργαλείο Κριτικών — Περισσότερες κριτικές Google | PISMA"
  description="Το εργαλείο της PISMA που κάνει τις κριτικές Google να μαζεύονται μόνες τους. Δεν το δείχνουμε δημόσια — κλείσε να το δεις ζωντανά. Χωρίς δέσμευση."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Το Εργαλείο Κριτικών"
    sub="Το εργαλείο που κάνει τους πελάτες σου να θέλουν να αφήσουν κριτική στο Google — και να το χαίρονται κιόλας. Το πώς; Αυτό δεν το δείχνουμε δημόσια."
  >
    Κριτικές που μαζεύονται <span class="accent">μόνες τους</span>
  </PageHero>

  <!-- 2. Τι κάνει (αποτέλεσμα, όχι μηχανισμός) -->
  <section class="section section--tight" aria-labelledby="what-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Τι κάνει</p>
        <h2 id="what-title">Το αποτέλεσμα το βλέπεις. Τον μηχανισμό, μόνο από κοντά.</h2>
      </div>
      <div class="grid-3">
        {what.map((w) => (
          <article class="card reveal">
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Γιατί δεν το δείχνουμε -->
  <section class="section" aria-labelledby="secret-title">
    <div class="container container--narrow">
      <div class="card secret-card reveal">
        <p class="kicker">Γιατί δεν το δείχνουμε;</p>
        <h2 id="secret-title">Ό,τι δουλεύει, αντιγράφεται.</h2>
        <p class="secret-sub">
          Γι' αυτό το Εργαλείο δεν εξηγείται σε καμία σελίδα — παρουσιάζεται μόνο ζωντανά.
          Σε μια βιντεοκλήση 15 λεπτών ή από κοντά στο μαγαζί σου, το βλέπεις όπως θα
          το βλέπει ο πελάτης σου — στημένο με το όνομα και τα χρώματα του μαγαζιού σου.
        </p>
        <div class="secret-cta">
          <a class="btn btn--orange" href="/epikoinonia/">Κλείσε να τον δεις ζωντανά</a>
          <a class="btn btn--ghost" href="/elegxos/">Δωρεάν αξιολόγηση {ELEGXOS.minutes}′</a>
        </div>
        <p class="btn-note">15 λεπτά φτάνουν για να καταλάβεις αν σου κάνει.</p>
      </div>
    </div>
  </section>

  <!-- 4. Τιμή -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Τιμή — δημόσια, ίδια για όλους</p>
          <h2 id="price-title">
            <span class="price-num num">{eur(wheel.price)}</span> τον μήνα
          </h2>
          <p class="price-sub">
            Όλα μέσα — πλατφόρμα, στήσιμο, στατιστικά. Χωρίς συμβόλαιο, χωρίς δέσμευση:
            σταματάς όποτε θες.
          </p>
          <p class="price-sub">
            Συν τα αυτοκόλλητα QR, μία φορά — <strong>από 18€ το πακέτο</strong>,
            με 16 σχέδια για τραπέζι, ταμείο, βιτρίνα και delivery.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/aftokollita/">Διάλεξε τα αυτοκόλλητά σου →</a>
          <a class="btn btn--ghost" href="/epikoinonia/">Ρώτα μας ό,τι θες</a>
          <span class="btn-note">Καμία πληρωμή online — το κλείνουμε στο τηλέφωνο.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section section--tight" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Συχνές ερωτήσεις</p>
        <h2 id="faq-title">Πριν ρωτήσεις, ρώτησαν άλλοι.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Δες το Εργαλείο ζωντανά."
    sub="Μια βιντεοκλήση 15 λεπτών ή από κοντά στο μαγαζί σου — και καταλαβαίνεις αμέσως γιατί δεν το δείχνουμε δημόσια."
    ctaText="Κλείσε το ραντεβού"
    ctaHref="/epikoinonia/"
    note="Καμία πληρωμή online · χωρίς δέσμευση"
  />
</Base>

<style>
  /* ---- Μυστικό ---- */
  .secret-card {
    text-align: center;
    padding: clamp(28px, 4.5vw, 52px);
  }
  .secret-card .kicker { margin-bottom: 14px; }
  .secret-sub {
    color: var(--muted);
    max-width: 52ch;
    margin: 14px auto 22px;
  }
  .secret-cta {
    display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .secret-card .btn-note { margin: 0; }

  /* ---- Τιμή ---- */
  .price-card {
    display: grid;
    grid-template-columns: 1.2fr minmax(min(240px, 100%), .8fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(26px, 4vw, 48px);
  }
  @media (max-width: 720px) {
    .price-card { grid-template-columns: 1fr; }
  }
  .price-main .kicker { margin-bottom: 14px; }
  .price-num { font-size: clamp(2rem, 5vw, 2.8rem); color: var(--orange-text); }
  .price-sub { margin-top: 12px; color: var(--muted); }
  .price-sub strong { color: var(--ink); }
  .price-cta { display: flex; flex-direction: column; gap: 12px; }
  .price-cta .btn { text-align: center; }
  .price-cta .btn-note { text-align: center; }
</style>
