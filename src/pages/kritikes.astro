---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NotClassicQr from '../components/NotClassicQr.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, ELEGXOS, eur } from '../config';
import { optionById } from '../data/pricing';

// Το προϊόν κριτικών, μία πηγή αλήθειας: pricing.ts.
// Τιμές αυτοκόλλητων: πίνακας F στο /aftokollita/ (εφάπαξ, από 18 € το πακέτο).
// ΣΚΟΠΙΜΑ teaser: ο μηχανισμός του Εργαλείου Κριτικών δεν περιγράφεται πουθενά δημόσια, 
// ούτε βήματα, ούτε demo link. Παρουσιάζεται μόνο ζωντανά, σε ραντεβού.
const tool = optionById('auto-reviews')!;
const gbp = optionById('gbp-setup')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Το Εργαλείο Κριτικών',
  serviceType: 'Αύξηση κριτικών Google για τοπικές επιχειρήσεις',
  areaServed: SITE.region,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.name,
    email: SITE.email,
    telephone: SITE.phone,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    price: tool.price,
    priceCurrency: 'EUR',
    description: `${eur(tool.price)} τον μήνα, χωρίς δέσμευση, συν αυτοκόλλητα QR εφάπαξ.`,
  },
  description:
    'Το εργαλείο της PISMA για περισσότερες κριτικές Google, με αυτοκόλλητο QR στον χώρο της επιχείρησης και παρουσίαση μόνο ζωντανά.',
};

const what = [
  {
    t: 'Απλό για τον πελάτη',
    d: 'Ξεκινά από ένα αυτοκόλλητο QR στο τραπέζι, στο ταμείο ή στη ρεσεψιόν.',
  },
  {
    t: 'Στήνεται μία φορά',
    d: 'Δουλεύει κάθε μέρα για κάθε πελάτη, χωρίς να ζητάτε κριτικές.',
  },
  {
    t: 'Εντός κανόνων Google',
    d: 'Καμία αγορασμένη κριτική, κανένα αντάλλαγμα, κανένα φιλτράρισμα.',
  },
];

const faqItems = [
  {
    q: 'Τι είναι το Εργαλείο Κριτικών;',
    a: 'Το εργαλείο της PISMA για κριτικές Google: ξεκινά από ένα αυτοκόλλητο QR στον χώρο σας. Ο τρόπος λειτουργίας παρουσιάζεται μόνο ζωντανά.',
  },
  {
    q: 'Είναι μέσα στους κανόνες της Google;',
    a: 'Ναι. Η Google απαγορεύει τις αγορασμένες κριτικές, το αντάλλαγμα για κριτική και το φιλτράρισμα, και το Εργαλείο δεν κάνει τίποτα από τα τρία.',
  },
  {
    q: 'Τι χρειάζομαι για να ξεκινήσω;',
    a: `Ένα προφίλ στη Google (αν δεν υπάρχει, το στήνουμε: Setup ${eur(gbp.price)} εφάπαξ) και τα αυτοκόλλητα QR. Τα υπόλοιπα τα στήνουμε εμείς.`,
  },
  {
    q: 'Πόσο κοστίζει;',
    a: `${eur(tool.price)} τον μήνα για την πλατφόρμα, χωρίς συμβόλαιο και χωρίς δέσμευση. Τα αυτοκόλλητα QR πληρώνονται μία φορά, από 18€ το πακέτο.`,
  },
  {
    q: 'Δουλεύει και για delivery;',
    a: 'Ναι, με αυτοκόλλητα για τη σακούλα και την απόδειξη. Λειτουργεί το ίδιο και από το σπίτι του πελάτη.',
  },
];
---

<Base
  title="Το Εργαλείο Κριτικών: Περισσότερες κριτικές Google | PISMA"
  description="Το εργαλείο της PISMA για περισσότερες κριτικές Google, με παρουσίαση μόνο ζωντανά και χωρίς δέσμευση."
  schema={schema}
>
  <!-- 1. Hero -->
  <PageHero
    kicker="Το Εργαλείο Κριτικών"
    sub="Ένα εργαλείο για περισσότερες κριτικές Google, με παρουσίαση μόνο ζωντανά."
  >
    Κριτικές <span class="accent">Google</span>
    <div slot="extra"><NotClassicQr lang="el" /></div>
  </PageHero>

  <!-- 2. Τι κάνει (αποτέλεσμα, όχι μηχανισμός) -->
  <section class="section section--tight" aria-labelledby="what-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Τι κάνει</p>
        <h2 id="what-title">Τρία βασικά σημεία.</h2>
      </div>
      <div class="grid-3">
        {what.map((w) => (
          <article class="card reveal">
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Τιμή -->
  <section class="section section--tight" aria-labelledby="price-title">
    <div class="container container--narrow">
      <div class="card price-card reveal">
        <div class="price-main">
          <p class="kicker">Τιμή: δημόσια, ίδια για όλους</p>
          <h2 id="price-title">
            <span class="price-num num">{eur(tool.price)}</span> τον μήνα
          </h2>
          <p class="price-sub">
            Περιλαμβάνει πλατφόρμα, στήσιμο και στατιστικά. Χωρίς συμβόλαιο και χωρίς δέσμευση.
          </p>
          <p class="price-sub">
            Αυτοκόλλητα QR εφάπαξ, <strong>από 18€ το πακέτο</strong>,
            σε 16 σχέδια για τραπέζι, ταμείο, βιτρίνα και delivery.
          </p>
        </div>
        <div class="price-cta">
          <a class="btn btn--orange" href="/aftokollita/">Διαλέξτε αυτοκόλλητα&nbsp;→</a>
          <a class="btn btn--ghost" href="/epikoinonia/">Κλείστε ραντεβού</a>
          <span class="btn-note">Καμία πληρωμή online. Το κλείνουμε στο τηλέφωνο.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section section--tight" aria-labelledby="faq-title">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Απορίες</p>
        <h2 id="faq-title">Συχνές ερωτήσεις.</h2>
      </div>
      <Faq items={faqItems} withSchema />
    </div>
  </section>

  <!-- 6. CTA -->
  <CtaBand
    title="Δείτε το Εργαλείο ζωντανά."
    sub="Βιντεοκλήση 15 λεπτών ή επίσκεψη στον χώρο σας."
    ctaText="Κλείστε το ραντεβού"
    ctaHref="/epikoinonia/"
    note="Καμία πληρωμή online · χωρίς δέσμευση"
  />
</Base>

<style>
  /* ---- Τιμή ---- */
  .price-card {
    display: grid;
    grid-template-columns: 1fr minmax(min(280px, 100%), .95fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(26px, 4vw, 48px);
  }
  @media (max-width: 720px) {
    .price-card { grid-template-columns: 1fr; }
  }
  .price-main .kicker { margin-bottom: 14px; }
  .price-num { font-size: clamp(2rem, 5vw, 2.8rem); color: var(--orange-text); }
  .price-sub { margin-top: 12px; color: var(--muted); }
  .price-sub strong { color: var(--ink); }
  .price-cta { display: flex; flex-direction: column; gap: 12px; }
  .price-cta .btn { text-align: center; white-space: normal; padding-inline: 16px; font-size: .95rem; }
  .price-cta .btn-note { text-align: center; }
</style>
