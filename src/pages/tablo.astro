---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Quiz from '../components/Quiz.astro';
import { SITE } from '../config';

/*
 * Το Ταμπλό: 12 ερωτήσεις (1 φίλτρο + 7 κορμού + 4 κλάδου), σκορ ορατότητας και αυτοματισμού
 * και τα 3 πρώτα βήματα με τιμή από το pricing.ts. Δεδομένα: src/data/quiz.ts, λογική: Quiz.astro.
 */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Το Ταμπλό: Μετρήστε την επιχείρησή σας',
  url: `${SITE.url}/tablo/`,
  inLanguage: 'el',
  description:
    'Διαδραστικό τεστ 12 ερωτήσεων, προσαρμοσμένο στο πώς δουλεύει η επιχείρησή σας: σκορ ορατότητας και σκορ αυτοματισμού στα 100, με τα 3 πρώτα βήματα και τις τιμές τους.',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};
---

<Base
  title="Το Ταμπλό: Μετρήστε ορατότητα και αυτοματισμό | PISMA"
  description="12 γρήγορες ερωτήσεις, χωρίς email: δείτε πόσο εύκολα σας βρίσκουν οι πελάτες, πόσο μόνο του δουλεύει το γραφείο σας και ποια είναι τα 3 πρώτα βήματα για εσάς."
  schema={schema}
>
  <PageHero
    kicker="Το Ταμπλό"
    sub="12 γρήγορες ερωτήσεις, προσαρμοσμένες στο πώς δουλεύει η επιχείρησή σας. Χωρίς email, χωρίς στοιχεία: σκορ και πρώτα βήματα βγαίνουν μπροστά σας."
  >
    Δείτε το <span class="accent">σκορ</span> σας
  </PageHero>

  <section class="section--tight quiz-section" aria-label="Το τεστ του Ταμπλό">
    <div class="container">
      <Quiz lang="el" />
    </div>
  </section>
</Base>

<style>
  .quiz-section { padding-bottom: clamp(64px, 10vw, 120px); }
</style>
