---
import { SITE } from '../config';
import { langOf } from '../i18n';

const lang = langOf(Astro.url.pathname);

const T = {
  el: {
    tagline: SITE.tagline,
    cta: 'Κλείστε δωρεάν αξιολόγηση',
    ctaHref: '/elegxos/',
    solutionsTitle: 'Λύσεις',
    toolsTitle: 'Εργαλεία',
    contactTitle: 'Επικοινωνία',
    note: 'Με πείσμα, μέχρι να δουλεύει μόνο του.',
    solutions: [
      { href: '/se-vriskoun/', label: 'Ψηφιακή Προβολή' },
      { href: '/doulevei-mono-tou/', label: 'Αυτοματισμοί γραφείου' },
      { href: '/kritikes/', label: 'Το Εργαλείο Κριτικών' },
      { href: '/aftokollita/', label: 'Αυτοκόλλητα QR' },
    ],
    tools: [
      { href: '/tablo/', label: 'Το Ταμπλό' },
      { href: '/elegxos/', label: 'Ο Έλεγχος PISMA' },
      { href: '/apotelesmata/', label: 'Αποτελέσματα' },
      { href: '/odigoi/', label: 'Οδηγοί' },
    ],
    company: [
      { href: '/times/', label: 'Τιμές' },
      { href: '/epikoinonia/', label: 'Επικοινωνία' },
    ],
  },
  en: {
    tagline: SITE.taglineEn,
    cta: 'Book a free assessment',
    ctaHref: '/en/free-assessment/',
    solutionsTitle: 'Solutions',
    toolsTitle: 'Tools',
    contactTitle: 'Contact',
    note: 'Relentlessly, until it runs on its own.',
    solutions: [
      { href: '/en/get-found/', label: 'Digital Visibility' },
      { href: '/en/runs-by-itself/', label: 'Office automations' },
      { href: '/en/reviews/', label: 'The Reviews Tool' },
      { href: '/en/qr-stickers/', label: 'QR Stickers' },
    ],
    tools: [
      { href: '/en/business-check/', label: 'The Dashboard' },
      { href: '/en/free-assessment/', label: 'The PISMA Check' },
      { href: '/en/results/', label: 'Results' },
      { href: '/en/guides/', label: 'Guides' },
    ],
    company: [
      { href: '/en/pricing/', label: 'Pricing' },
      { href: '/en/contact/', label: 'Contact' },
    ],
  },
}[lang];

const { solutions, tools, company } = T;
---

<footer class="footer">
  <div class="container cols">
    <div class="brand">
      <p class="logo">PISMA<span>.</span></p>
      <p class="tagline">{T.tagline}</p>
      <a class="btn btn--orange btn--sm cta" href={T.ctaHref}>{T.cta}</a>
    </div>

    <nav aria-label={T.solutionsTitle}>
      <h2 class="col-title">{T.solutionsTitle}</h2>
      <ul>
        {solutions.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label={T.toolsTitle}>
      <h2 class="col-title">{T.toolsTitle}</h2>
      <ul>
        {tools.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="col-title">{T.contactTitle}</h2>
      <ul>
        {company.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <p>© {new Date().getFullYear()} PISMA</p>
    <p class="bottom-note">{T.note}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(70% 90% at 50% 120%, rgba(255, 122, 80, .06), transparent 70%),
      var(--bg-soft);
    margin-top: clamp(40px, 7vw, 80px);
  }
  .cols {
    display: grid; gap: 36px;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    padding-block: clamp(40px, 6vw, 64px) 28px;
  }
  .brand { max-width: 300px; }
  .logo { font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; color: var(--navy); }
  .logo span { color: var(--orange); }
  .tagline { margin-top: 10px; font-size: .95rem; color: var(--muted); font-style: italic; }
  .who { margin-top: 14px; font-size: .92rem; font-weight: 600; color: var(--navy); }
  .col-title { font-family: var(--font-body); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  ul { list-style: none; padding: 0; display: grid; gap: 9px; }
  ul a { text-decoration: none; font-size: .95rem; color: var(--ink); }
  ul a:hover { color: var(--orange-text); }
  .cta { margin-top: 20px; }
  .bottom {
    border-top: 1px solid var(--line); padding-block: 18px;
    font-size: .85rem; color: var(--muted);
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  }

  @media (max-width: 680px) {
    .cols { grid-template-columns: 1fr 1fr; gap: 24px 18px; padding-block: 34px 20px; }
    .brand { grid-column: 1 / -1; max-width: none; }
    .footer { margin-top: 36px; }
  }
</style>
