---
/**
 * Μπάνερ συγκατάθεσης cookies + Google Analytics 4.
 * GDPR: το GA φορτώνει ΜΟΝΟ μετά από «Αποδοχή» — πριν από αυτήν, κανένα cookie.
 * Η επιλογή θυμάται στο localStorage (pisma-consent: granted/denied).
 * Αν το SITE.gaId είναι κενό, δεν εμφανίζεται τίποτα και δεν φορτώνει τίποτα.
 */
import { langOf } from '../i18n';
import { SITE } from '../config';

const lang = langOf(Astro.url.pathname);
const t =
  lang === 'en'
    ? {
        text: 'We use cookies for anonymous visit statistics (Google Analytics). Is that OK?',
        accept: 'Accept',
        decline: 'No, thanks',
      }
    : {
        text: 'Χρησιμοποιούμε cookies για ανώνυμα στατιστικά επισκέψεων (Google Analytics). Συμφωνείτε;',
        accept: 'Αποδοχή',
        decline: 'Όχι, ευχαριστώ',
      };
---

{
  SITE.gaId && (
    <div class="consent" id="consent-banner" data-ga={SITE.gaId} role="region" aria-label="Cookies" hidden>
      <p>{t.text}</p>
      <div class="consent-btns">
        <button class="consent-accept" id="consent-accept">{t.accept}</button>
        <button class="consent-decline" id="consent-decline">{t.decline}</button>
      </div>
    </div>
  )
}

<style>
  .consent {
    position: fixed;
    bottom: 18px;
    left: 18px;
    max-width: 340px;
    z-index: 200;
    background: rgba(31, 28, 26, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line2, rgba(255, 255, 255, 0.16));
    border-radius: 16px;
    padding: 18px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
  }
  .consent p {
    margin: 0 0 13px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted, var(--dim, #a79dbb));
  }
  .consent-btns {
    display: flex;
    gap: 9px;
  }
  .consent button {
    border: 0;
    border-radius: 100px;
    padding: 9px 18px;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.2;
    cursor: pointer;
    transition: filter 0.15s, color 0.15s, box-shadow 0.15s;
  }
  .consent-accept {
    background: var(--grad, linear-gradient(92deg, #cc431c, #ac3213));
    color: #fff;
    box-shadow: 0 5px 18px rgba(var(--cta-rgb), 0.3);
  }
  .consent-accept:hover {
    filter: brightness(1.08);
  }
  .consent-decline {
    background: none;
    color: var(--muted, var(--dim, #a79dbb));
    box-shadow: inset 0 0 0 1.5px var(--line2, rgba(255, 255, 255, 0.16));
  }
  .consent-decline:hover {
    color: var(--head, #f5f2fb);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35);
  }
  @media (max-width: 480px) {
    .consent {
      left: 12px;
      right: 12px;
      bottom: 12px;
      max-width: none;
    }
  }
</style>

<script>
  const box = document.getElementById('consent-banner');
  if (box) {
    const KEY = 'pisma-consent';
    const gaId = (box as HTMLElement).dataset.ga || '';
    const w = window as any;

    const loadGA = () => {
      if (!gaId || w.__gaLoaded) return;
      w.__gaLoaded = true;
      const s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      s.async = true;
      document.head.appendChild(s);
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () {
        w.dataLayer.push(arguments);
      };
      w.gtag('js', new Date());
      w.gtag('config', gaId, { anonymize_ip: true });
    };

    let choice: string | null = null;
    try {
      choice = localStorage.getItem(KEY);
    } catch {}

    if (choice === 'granted') loadGA();
    else if (!choice) box.hidden = false;

    const set = (v: string) => {
      try {
        localStorage.setItem(KEY, v);
      } catch {}
      box.hidden = true;
      if (v === 'granted') loadGA();
    };
    document.getElementById('consent-accept')?.addEventListener('click', () => set('granted'));
    document.getElementById('consent-decline')?.addEventListener('click', () => set('denied'));
  }
</script>
