---
/**
 * Μπάνερ συγκατάθεσης cookies + Google Analytics 4.
 * GDPR: το GA φορτώνει ΜΟΝΟ μετά από «Αποδοχή» — πριν από αυτήν, κανένα cookie.
 * Η επιλογή θυμάται στο localStorage (pisma-consent: granted/denied).
 * Αν το SITE.gaId είναι κενό, δεν εμφανίζεται τίποτα και δεν φορτώνει τίποτα.
 */
import { langOf } from '../i18n';
import { SITE } from '../config';

const lang = langOf(Astro.url.pathname);
const t =
  lang === 'en'
    ? {
        text: 'We use cookies for anonymous visit statistics (Google Analytics). Is that OK?',
        accept: 'Accept',
        decline: 'No, thanks',
      }
    : {
        text: 'Χρησιμοποιούμε cookies για ανώνυμα στατιστικά επισκέψεων (Google Analytics). Συμφωνείτε;',
        accept: 'Αποδοχή',
        decline: 'Όχι, ευχαριστώ',
      };
---

{
  SITE.gaId && (
    <div class="consent" id="consent-banner" data-ga={SITE.gaId} role="region" aria-label="Cookies" hidden>
      <p>{t.text}</p>
      <div class="consent-btns">
        <button class="consent-accept" id="consent-accept">{t.accept}</button>
        <button class="consent-decline" id="consent-decline">{t.decline}</button>
      </div>
    </div>
  )
}

<style>
  .consent {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    max-width: 520px;
    margin-inline: auto;
    z-index: 200;
    background: var(--card, #171221);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    border-radius: 14px;
    padding: 16px 18px;
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.5);
  }
  .consent p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted, var(--dim, #a79dbb));
    flex: 1 1 240px;
  }
  .consent-btns {
    display: flex;
    gap: 8px;
  }
  .consent button {
    border: 0;
    border-radius: 9px;
    padding: 9px 16px;
    font: 700 0.85rem inherit;
    font-family: inherit;
    cursor: pointer;
  }
  .consent-accept {
    background: var(--grad, #c2401b);
    color: #fff;
  }
  .consent-decline {
    background: none;
    color: var(--muted, var(--dim, #a79dbb));
    box-shadow: inset 0 0 0 1.5px var(--line, rgba(255, 255, 255, 0.16));
  }
</style>

<script>
  const box = document.getElementById('consent-banner');
  if (box) {
    const KEY = 'pisma-consent';
    const gaId = (box as HTMLElement).dataset.ga || '';
    const w = window as any;

    const loadGA = () => {
      if (!gaId || w.__gaLoaded) return;
      w.__gaLoaded = true;
      const s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      s.async = true;
      document.head.appendChild(s);
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () {
        w.dataLayer.push(arguments);
      };
      w.gtag('js', new Date());
      w.gtag('config', gaId, { anonymize_ip: true });
    };

    let choice: string | null = null;
    try {
      choice = localStorage.getItem(KEY);
    } catch {}

    if (choice === 'granted') loadGA();
    else if (!choice) box.hidden = false;

    const set = (v: string) => {
      try {
        localStorage.setItem(KEY, v);
      } catch {}
      box.hidden = true;
      if (v === 'granted') loadGA();
    };
    document.getElementById('consent-accept')?.addEventListener('click', () => set('granted'));
    document.getElementById('consent-decline')?.addEventListener('click', () => set('denied'));
  }
</script>
