---
/**
 * Το Ταμπλό / The Dashboard: το quiz, κοινό για EL και EN.
 * Δεδομένα: src/data/quiz.ts (EL), src/data/quiz.en.ts (EN). Τιμές: src/data/pricing.ts.
 * Ροή: ερώτηση φίλτρο (τύπος επιχείρησης) → 7 κορμού → 4 κλάδου → αποτέλεσμα με τα 3 πρώτα βήματα.
 */
import { TYPES, QUESTIONS, STRINGS } from '../data/quiz';
import { TYPES_EN, QUESTIONS_EN, STRINGS_EN } from '../data/quiz.en';
import { ELEGXOS } from '../config';

interface Props { lang: 'el' | 'en' }
const { lang } = Astro.props;
const en = lang === 'en';
const types = en ? TYPES_EN : TYPES;
const questions = en ? QUESTIONS_EN : QUESTIONS;
const t = en ? STRINGS_EN : STRINGS;

/* 1 φίλτρο + 7 κορμού + 4 κλάδου: ίδιο πλήθος για κάθε τύπο */
const TOTAL = 1 + questions.filter((q) => !q.types).length + 4;
---

<!-- Χωρίς .reveal: η κάρτα εμφανίζεται αμέσως, χωρίς θόλωμα εισόδου -->
<div class="card quiz" id="tablo-quiz" data-lang={lang} data-total={TOTAL}>
  <div class="quiz-top">
    <button class="quiz-back" type="button" id="quiz-back" hidden>{t.back}</button>
    <div class="dots" id="quiz-dots" aria-hidden="true">
      {Array.from({ length: TOTAL }).map(() => <span class="dot"></span>)}
    </div>
    <span class="quiz-count num" id="quiz-count">{t.count(1, TOTAL)}</span>
  </div>

  <div class="quiz-steps" aria-live="polite">
    <div class="quiz-step" data-key="type" role="group" tabindex="-1">
      <h2 class="quiz-q">{t.typeQ}</h2>
      <div class="quiz-opts">
        {types.map((ty) => (
          <button type="button" class="opt opt--type" data-type={ty.id} aria-pressed="false">
            <span class="opt-label">{ty.label}</span>
            <span class="opt-detail">{ty.detail}</span>
          </button>
        ))}
      </div>
    </div>

    {questions.map((q) => (
      <div class="quiz-step" data-key={q.key} role="group" tabindex="-1" hidden>
        <h2 class="quiz-q">{q.q}</h2>
        <div class="quiz-opts">
          {q.opts.map((o) => (
            <button type="button" class="opt" data-val={o.v === null ? 'na' : String(o.v)} aria-pressed="false">
              {o.label}
            </button>
          ))}
        </div>
      </div>
    ))}

    <div class="quiz-step quiz-result" id="quiz-result" role="group" tabindex="-1" hidden>
      <h2 class="quiz-q">{t.resultTitle}</h2>

      <div class="rings">
        <div class="ring">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="ring-bg" cx="60" cy="60" r="52"></circle>
            <circle class="ring-val" id="ring-vis" cx="60" cy="60" r="52"></circle>
          </svg>
          <span class="ring-num num" id="num-vis" aria-hidden="true">0</span>
          <span class="ring-label">{t.vis}</span>
        </div>
        <div class="ring">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="ring-bg" cx="60" cy="60" r="52"></circle>
            <circle class="ring-val" id="ring-auto" cx="60" cy="60" r="52"></circle>
          </svg>
          <span class="ring-num num" id="num-auto" aria-hidden="true">0</span>
          <span class="ring-label">{t.auto}</span>
        </div>
      </div>

      <p class="quiz-verdict" id="quiz-verdict"></p>
      <p class="visually-hidden" id="result-sr"></p>

      <div class="steps-wrap" id="steps-wrap">
        <h3 class="steps-title">{t.stepsTitle}</h3>
        <ol class="qsteps" id="steps"></ol>
      </div>
      <p class="quiz-perfect" id="quiz-perfect" hidden>{t.perfect}</p>

      <div class="strong-wrap" id="strong-wrap" hidden>
        <h3 class="strong-title">{t.strongTitle}</h3>
        <ul class="qstrong" id="strong"></ul>
      </div>

      <div class="result-cta result-cta--two">
        <a class="btn btn--orange" id="cta-pricing" href={t.pricingHref}>{t.ctaPricing}</a>
        <a class="btn btn--ghost" href={t.checkHref}>{t.ctaCheck(ELEGXOS.minutes)}</a>
      </div>
      <p class="btn-note result-note" id="cta-note">{t.ctaNote}</p>
      <div class="result-actions">
        <button type="button" class="btn btn--ghost btn--sm" id="quiz-copy" aria-live="polite">{t.copy}</button>
        <button type="button" class="btn btn--ghost btn--sm" id="quiz-restart">{t.restart}</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { QUESTIONS, STRINGS } from '../data/quiz';
  import type { QuizQuestion, QuizStrings, BizType, Rec } from '../data/quiz';
  import { QUESTIONS_EN, STRINGS_EN } from '../data/quiz.en';
  import { CATEGORIES } from '../data/pricing';
  import { CATEGORIES_EN } from '../data/pricing.en';

  const quiz = document.getElementById('tablo-quiz')!;
  const en = quiz.dataset.lang === 'en';
  const questions: QuizQuestion[] = en ? QUESTIONS_EN : QUESTIONS;
  const t: QuizStrings = en ? STRINGS_EN : STRINGS;
  const TOTAL = Number(quiz.dataset.total);

  /* Πληροφορίες τιμοκαταλόγου ανά υπηρεσία: τιμή, τύπος, κατηγορία και θέση μέσα της */
  const PRICE: Record<string, { label: string; price: number; monthly: boolean; cat: string; radio: boolean; idx: number }> = {};
  for (const c of en ? CATEGORIES_EN : CATEGORIES) {
    c.options.forEach((o, idx) => {
      PRICE[o.id] = { label: o.label, price: o.price, monthly: o.type === 'monthly', cat: c.id, radio: c.mode === 'radio', idx };
    });
  }
  const eur = (n: number) => (en ? '€' + n.toLocaleString('en-US') : n.toLocaleString('el-GR') + '€');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CIRC = 2 * Math.PI * 52;

  const stepEls = new Map<string, HTMLElement>();
  quiz.querySelectorAll<HTMLElement>('.quiz-step[data-key]').forEach((s) => stepEls.set(s.dataset.key!, s));
  const resultEl = document.getElementById('quiz-result')!;

  const backBtn = document.getElementById('quiz-back')!;
  const dotsWrap = document.getElementById('quiz-dots')!;
  const dots = Array.from(dotsWrap.children) as HTMLElement[];
  const countEl = document.getElementById('quiz-count')!;

  const ringVis = document.getElementById('ring-vis') as unknown as SVGCircleElement;
  const ringAuto = document.getElementById('ring-auto') as unknown as SVGCircleElement;
  const numVis = document.getElementById('num-vis')!;
  const numAuto = document.getElementById('num-auto')!;
  const verdictEl = document.getElementById('quiz-verdict')!;
  const resultSr = document.getElementById('result-sr')!;
  const stepsWrap = document.getElementById('steps-wrap')!;
  const stepsEl = document.getElementById('steps')!;
  const perfectEl = document.getElementById('quiz-perfect')!;
  const strongWrap = document.getElementById('strong-wrap')!;
  const strongEl = document.getElementById('strong')!;
  const ctaPricing = document.getElementById('cta-pricing') as HTMLAnchorElement;
  const ctaNote = document.getElementById('cta-note')!;
  const copyBtn = document.getElementById('quiz-copy')!;
  const copyLabel = copyBtn.textContent!.trim();
  const restartBtn = document.getElementById('quiz-restart')!;

  let bizType: BizType | null = null;
  /* Η ακολουθία των βημάτων: 'type', μετά τα keys των ενεργών ερωτήσεων */
  let seq: string[] = ['type'];
  let cur = 0;
  const answers: Record<string, number | null> = {};
  let last: { visibility: number; automation: number; recs: Array<Rec & { price: string }>; strong: string[] } | null = null;

  /* Ενεργές ερωτήσεις: κορμός με τη σειρά του αρχείου, μετά οι ερωτήσεις κλάδου,
     πρώτα ορατότητα και μετά αυτοματισμός, ώστε η σειρά να μένει «σε βρίσκουν → δουλεύει μόνο του». */
  const active = (): QuizQuestion[] => {
    const core = questions.filter((q) => !q.types);
    const branch = questions.filter((q) => q.types && bizType !== null && q.types.includes(bizType));
    return [...core, ...branch.filter((q) => q.dim === 'vis'), ...branch.filter((q) => q.dim === 'auto')];
  };

  function buildSeq() {
    seq = ['type', ...active().map((q) => q.key)];
  }

  function show(i: number, moveFocus = true) {
    cur = i;
    const isResult = i >= seq.length;
    stepEls.forEach((el, key) => { el.hidden = isResult || key !== seq[i]; });
    resultEl.hidden = !isResult;
    const visible = isResult ? resultEl : stepEls.get(seq[i])!;
    /* Το focus πάει στο βήμα (όχι στον τίτλο): ο τίτλος μένει χωρίς focus ring και χωρίς ξαναζωγράφισμα */
    if (moveFocus) visible.focus({ preventScroll: true });
    backBtn.hidden = i === 0;
    dotsWrap.hidden = isResult;
    countEl.hidden = isResult;
    if (isResult) { showResults(); return; }
    dots.forEach((d, di) => {
      d.classList.toggle('dot--now', di === i);
      d.classList.toggle('dot--done', di < i);
    });
    countEl.textContent = t.count(i + 1, TOTAL);
  }

  function press(step: HTMLElement, btn: HTMLElement) {
    step.querySelectorAll('.opt').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
  }
  const advance = () => window.setTimeout(() => show(cur + 1), reduce ? 0 : 180);

  /* Ερώτηση φίλτρο */
  const typeStep = stepEls.get('type')!;
  typeStep.querySelectorAll<HTMLElement>('.opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      bizType = btn.dataset.type as BizType;
      press(typeStep, btn);
      buildSeq();
      advance();
    });
  });

  /* Ερωτήσεις */
  questions.forEach((q) => {
    const step = stepEls.get(q.key)!;
    step.querySelectorAll<HTMLElement>('.opt').forEach((btn) => {
      btn.addEventListener('click', () => {
        answers[q.key] = btn.dataset.val === 'na' ? null : Number(btn.dataset.val);
        press(step, btn);
        advance();
      });
    });
  });

  backBtn.addEventListener('click', () => { if (cur > 0) show(cur - 1); });

  /* Σκορ */
  function score(dim: 'vis' | 'auto'): number {
    let sum = 0;
    let n = 0;
    for (const q of active()) {
      if (q.dim !== dim) continue;
      const v = answers[q.key];
      if (v === null || v === undefined) continue;
      sum += v;
      n += 1;
    }
    return n === 0 ? 100 : Math.round((sum / (3 * n)) * 100);
  }
  const band = (v: number) => (v < 40 ? 'c-red' : v < 70 ? 'c-orange' : 'c-ok');

  /* Μέτρημα αριθμών και γέμισμα δαχτυλιδιών με setTimeout/setInterval, ΟΧΙ requestAnimationFrame:
     σε webviews και throttled tabs το rAF αργεί ή δεν τρέχει, και οι ενδείξεις έμεναν στο 0. */
  const counters = new Map<HTMLElement, number>();
  function stopCount(el: HTMLElement) {
    const id = counters.get(el);
    if (id !== undefined) { window.clearInterval(id); counters.delete(el); }
  }
  function countUp(el: HTMLElement, target: number) {
    stopCount(el);
    if (reduce) { el.textContent = String(target); return; }
    const t0 = performance.now();
    const dur = 1000;
    const id = window.setInterval(() => {
      const p = Math.min((performance.now() - t0) / dur, 1);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(target * e));
      if (p >= 1) { window.clearInterval(id); counters.delete(el); }
    }, 33);
    counters.set(el, id);
  }
  function setRing(circle: SVGCircleElement, numEl: HTMLElement, v: number) {
    circle.classList.remove('c-red', 'c-orange', 'c-ok');
    circle.classList.add(band(v));
    const off = CIRC * (1 - v / 100);
    if (reduce) {
      circle.style.strokeDashoffset = String(off);
      numEl.textContent = String(v);
      return;
    }
    circle.style.strokeDashoffset = String(CIRC);
    void circle.getBoundingClientRect(); // flush, ώστε το transition να ξεκινήσει από το κενό δαχτυλίδι
    window.setTimeout(() => { circle.style.strokeDashoffset = String(off); }, 40);
    countUp(numEl, v);
  }

  /* Τα 3 πρώτα βήματα: κατά απάντηση (0 πρώτα), μετά κατά priority. Μία υπηρεσία ανά
     κατηγορία «μία επιλογή» (ιστοσελίδα, social), κρατώντας την πιο πλήρη. */
  function pickRecs(): Array<Rec & { price: string }> {
    const cands: Array<{ rec: Rec; v: number; priority: number }> = [];
    for (const q of active()) {
      const v = answers[q.key];
      if (v === null || v === undefined) continue;
      const rec = q.recs[v];
      if (rec) cands.push({ rec, v, priority: q.priority });
    }
    cands.sort((a, b) => a.v - b.v || a.priority - b.priority);
    const chosen: Array<{ rec: Rec; v: number; priority: number }> = [];
    for (const c of cands) {
      const p = PRICE[c.rec.id];
      if (!p) continue;
      const dupIdx = chosen.findIndex((x) => x.rec.id === c.rec.id || (p.radio && PRICE[x.rec.id].cat === p.cat));
      if (dupIdx === -1) { chosen.push(c); continue; }
      const prev = chosen[dupIdx];
      if (PRICE[prev.rec.id].idx < p.idx) {
        /* Κρατάμε την πιο πλήρη υπηρεσία, με τον λόγο της χειρότερης απάντησης */
        const why = prev.v < c.v ? prev.rec.why : c.rec.why;
        chosen[dupIdx] = { rec: { ...c.rec, why }, v: Math.min(prev.v, c.v), priority: Math.min(prev.priority, c.priority) };
      }
    }
    chosen.sort((a, b) => a.v - b.v || a.priority - b.priority);
    return chosen.slice(0, 3).map((c) => {
      const p = PRICE[c.rec.id];
      const price = (c.rec.from ? t.from + ' ' : '') + eur(p.price) + (p.monthly ? t.monthly : ' ' + t.once);
      return { ...c.rec, label: c.rec.label || p.label, price };
    });
  }

  function showResults() {
    const visibility = score('vis');
    const automation = score('auto');
    const recs = pickRecs();
    const strong: string[] = [];
    for (const q of active()) if (answers[q.key] === 3 && !strong.includes(q.name)) strong.push(q.name);
    last = { visibility, automation, recs, strong };

    setRing(ringVis, numVis, visibility);
    setRing(ringAuto, numAuto, automation);

    const avg = (visibility + automation) / 2;
    const base = avg < 40 ? t.verdict.low : avg < 70 ? t.verdict.mid : t.verdict.high;
    const gap = visibility - automation;
    const focus = Math.abs(gap) < 15 ? '' : gap < 0 ? ' ' + t.verdict.visGap : ' ' + t.verdict.autoGap;
    verdictEl.textContent = base + focus;
    resultSr.textContent = `${t.vis} ${visibility}/100, ${t.auto} ${automation}/100.`;

    stepsEl.innerHTML = '';
    recs.forEach((r, i) => {
      const li = document.createElement('li');
      li.className = 'qstep';
      li.innerHTML =
        `<span class="step-n num">${i + 1}</span>` +
        `<span class="step-body"><strong class="step-label"></strong><span class="step-why"></span></span>` +
        `<span class="step-price num"></span>`;
      li.querySelector('.step-label')!.textContent = r.label!;
      li.querySelector('.step-why')!.textContent = r.why;
      li.querySelector('.step-price')!.textContent = r.price;
      stepsEl.appendChild(li);
    });
    stepsWrap.hidden = recs.length === 0;
    perfectEl.hidden = recs.length > 0;
    ctaNote.hidden = recs.length === 0;

    strongEl.innerHTML = '';
    for (const name of strong) {
      const li = document.createElement('li');
      li.textContent = name;
      strongEl.appendChild(li);
    }
    strongWrap.hidden = strong.length === 0;

    const base_href = t.pricingHref;
    ctaPricing.href = recs.length ? `${base_href}?add=${recs.map((r) => r.id).join(',')}#builder` : base_href;
  }

  copyBtn.addEventListener('click', async () => {
    if (!last) return;
    const lines = [
      `${t.copyHead} · ${t.vis}: ${last.visibility}/100 · ${t.auto}: ${last.automation}/100`,
      ...(last.recs.length ? [t.copySteps + ':', ...last.recs.map((r, i) => `${i + 1}. ${r.label} · ${r.price}`)] : []),
    ];
    try {
      await navigator.clipboard.writeText(lines.join('\n'));
      copyBtn.textContent = t.copied;
    } catch {
      copyBtn.textContent = t.copyFail;
    }
    window.setTimeout(() => { copyBtn.textContent = copyLabel; }, 2000);
  });

  restartBtn.addEventListener('click', () => {
    Object.keys(answers).forEach((k) => delete answers[k]);
    bizType = null;
    last = null;
    quiz.querySelectorAll('.opt').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    [ringVis, ringAuto].forEach((c) => {
      c.classList.remove('c-red', 'c-orange', 'c-ok');
      c.style.strokeDashoffset = String(CIRC);
    });
    stopCount(numVis);
    stopCount(numAuto);
    numVis.textContent = '0';
    numAuto.textContent = '0';
    resultSr.textContent = '';
    buildSeq();
    show(0);
  });

  show(0, false);
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .quiz {
    max-width: 720px;
    margin-inline: auto;
    padding: clamp(24px, 4vw, 44px);
  }

  .quiz-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    margin-bottom: clamp(20px, 4vw, 32px);
  }
  .quiz-back {
    justify-self: start;
    background: none;
    border: 0;
    cursor: pointer;
    font-weight: 700;
    color: var(--navy);
    padding: 8px 14px;
    border-radius: 999px;
    white-space: nowrap;
    transition: background-color .15s ease;
  }
  .quiz-back:hover { background: var(--orange-soft); }

  .dots { display: flex; gap: 8px; justify-self: center; flex-wrap: wrap; justify-content: center; }
  .dots[hidden] { display: none; }
  .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--line);
    transition: background-color .25s ease, transform .25s ease;
  }
  .dot--done { background: var(--navy); }
  .dot--now { background: var(--orange); transform: scale(1.3); }

  .quiz-count { justify-self: end; font-size: .82rem; color: var(--muted); white-space: nowrap; }

  /* Τα βήματα είναι <div>, ΟΧΙ <section>: ο global κανόνας «main section:nth-of-type(2n)» έδινε
     σκούρο φόντο και γραμμές σε κάθε δεύτερη ερώτηση (φαινόταν σαν μαύρο πίσω από τα γράμματα). */
  .quiz-step { outline: none; background: none; border: 0; }
  .quiz-q {
    font-size: clamp(1.25rem, 2.8vw, 1.6rem);
    text-align: center;
    margin-bottom: clamp(20px, 3.5vw, 30px);
    text-wrap: balance;
  }
  .quiz-opts { display: grid; gap: 12px; }
  .opt {
    text-align: left;
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 16px 20px;
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--navy);
    cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease, transform .15s ease;
  }
  .opt:hover { border-color: var(--orange); transform: translateY(-2px); }
  .opt[aria-pressed='true'] {
    border-color: var(--orange);
    background: var(--orange-soft);
  }
  .opt--type { display: grid; gap: 3px; }
  .opt-label { font-size: 1.08rem; }
  .opt-detail { font-weight: 500; font-size: .9rem; color: var(--muted); }

  .rings {
    display: flex;
    justify-content: center;
    gap: clamp(24px, 6vw, 56px);
    flex-wrap: wrap;
    margin-bottom: clamp(20px, 3vw, 28px);
  }
  .ring { position: relative; width: clamp(120px, 18vw, 156px); text-align: center; }
  .ring svg { transform: rotate(-90deg); }
  .ring-bg, .ring-val { fill: none; stroke-width: 10; }
  .ring-bg { stroke: var(--line); }
  .ring-val {
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-dasharray: 326.726;
    stroke-dashoffset: 326.726;
    transition: stroke-dashoffset 1s ease;
  }
  .ring-val.c-red { stroke: var(--red); }
  .ring-val.c-orange { stroke: var(--orange); }
  .ring-val.c-ok { stroke: var(--ok); }
  .ring-num {
    position: absolute;
    top: 33%; left: 0; right: 0;
    font-size: 1.85rem; font-weight: 700; color: var(--navy);
  }
  .ring-label { display: block; margin-top: 10px; font-size: .88rem; color: var(--muted); }

  .quiz-verdict {
    text-align: center; max-width: 46ch; margin: 0 auto;
    font-weight: 600; color: var(--navy); text-wrap: balance;
  }

  /* Τα 3 πρώτα βήματα */
  .steps-wrap, .strong-wrap { margin-top: clamp(24px, 4vw, 34px); }
  .steps-wrap[hidden], .strong-wrap[hidden] { display: none; }
  .steps-title, .strong-title {
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 12px;
  }
  /* Τα στοιχεία της λίστας φτιάχνονται με JS, άρα :global για να πιάσουν τα styles */
  .qsteps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .qsteps :global(.qstep) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
  }
  .qsteps :global(.step-n) {
    width: 30px; height: 30px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--orange); color: #111;
    font-weight: 700; font-size: .9rem;
  }
  .qsteps :global(.step-body) { display: grid; gap: 2px; min-width: 0; }
