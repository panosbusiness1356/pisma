---
// Κάρτες υπηρεσιών «Ψηφιακής Προβολής» σε διάταξη bento (επιλογή χρήστριας: σχέδιο Ε6).
// Δύο «ναυαρχίδες» σε διπλό πλάτος (site, star), το «μάτι» κλείνει ως φαρδιά ρηχή λωρίδα,
// και πάνω σε κάθε κάρτα: πραγματικά λογότυπα όπου υπάρχει brand (Google Maps, Google,
// ChatGPT, Instagram/Facebook/TikTok), αλλιώς έγχρωμο flat SVG αντικείμενο.
// Χωρίς μωβ αποχρώσεις — μόνο ζεστή πορτοκαλί λάμψη στις μεγάλες (ρητό αίτημα).
interface Service {
  t: string;
  d: string;
  icon: string;
  href?: string;
  /* Προαιρετικές παρακάμψεις των defaults που βγαίνουν από το icon: */
  size?: 'big' | 'strip' | 'strip3';
  art?: string;
  logos?: string[];
  stars?: boolean;
}
interface Props {
  services: Service[];
  cta: string;
}
const { services, cta } = Astro.props;

