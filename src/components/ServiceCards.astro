};

// Πραγματικά λογότυπα (self-hosted στο public/logos/) όπου υπάρχει brand
const logos: Record<string, string[]> = {
  pin: ['google-maps.svg'],
  seo: ['google-icon.svg'],
  ai: ['openai-icon.svg'],
  social: ['instagram-icon.svg', 'facebook.svg', 'tiktok-icon.svg'],
  star: ['google-icon.svg'],
  shopify: ['shopify.svg'],
};

const goldStar =
  '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="#F6C34C"/>';

/* Defaults από το icon, με προαιρετική παράκαμψη ανά υπηρεσία */
const sizeOf = (s: Service) =>
  s.size ?? (s.icon === 'site' || s.icon === 'star' ? 'big' : s.icon === 'eye' ? 'strip' : undefined);
const sizeClass = (s: Service) => {
  const size = sizeOf(s);
  return size === 'big' ? 'svc-big' : size === 'strip' ? 'svc-strip' : size === 'strip3' ? 'svc-strip svc-strip3' : '';
};
const logosOf = (s: Service) => s.logos ?? logos[s.icon];
const artOf = (s: Service) => s.art ?? (art[s.icon] ? s.icon : undefined);
const starsOf = (s: Service) => s.stars ?? s.icon === 'star';
const isStrip = (s: Service) => sizeOf(s) === 'strip' || sizeOf(s) === 'strip3';
---

<div class="svc-grid">
  {services.map((s) => (
    <article class={`card reveal ${sizeClass(s)}`}>
      <span class={`svc-viz ${isStrip(s) ? 'svc-viz--strip' : ''}`} aria-hidden="true">
        {artOf(s) && (
          <span class={`svc-art ${isStrip(s) ? 'svc-art--sm' : ''}`}>
            <svg viewBox="0 0 96 72" set:html={art[artOf(s)]} />
          </span>
        )}
        {logosOf(s) && logosOf(s).map((f) => (
          <span class="svc-chip"><img src={`/logos/${f}`} alt="" width="30" height="30" loading="lazy" /></span>
        ))}
        {logosOf(s) && starsOf(s) && (
          <span class="svc-stars">
            {[0, 1, 2, 3, 4].map(() => (
              <svg viewBox="0 0 24 24" set:html={goldStar} />
            ))}
          </span>
        )}
      </span>
      {isStrip(s) ? (
        <div>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </div>
      ) : (
        <>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          {s.href && <a class="card-arrow" href={s.href}>{cta}</a>}
        </>
      )}
    </article>
  ))}
</div>
