---
/**
 * Silk — «μετάξι» φόντου (η λογική WebGL είναι στο src/scripts/silk.ts, φορτώνεται από το Base): πτυχές υφάσματος που κυματίζουν αργά με μια απαλή
 * γυαλάδα στο accent χρώμα. WebGL shader, 0 KB αρχεία, μισή ανάλυση.
 *
 * Παίρνει τα χρώματα ζωντανά από τις CSS μεταβλητές (--bg / --navy / --cta-*),
 * άρα ακολουθεί όποιο θέμα φορτωθεί. Σταματά εκτός οθόνης, παγώνει σε ένα καρέ
 * με prefers-reduced-motion, και κρύβεται τελείως χωρίς WebGL (μένει το απλό φόντο).
 *
 * Ο γονέας πρέπει να έχει position: relative· το περιεχόμενο πάνω από το μετάξι
 * θέλει position: relative + z-index: 1. Όταν το WebGL δουλεύει, ο γονέας παίρνει
 * την κλάση .silk-on (π.χ. για να κρυφτούν fallback διακοσμητικά).
 */
interface Props {
  /** hero = πλήρης ένταση, soft = εσωτερικές σελίδες, band = μέσα σε κάρτα CTA */
  variant?: 'hero' | 'soft' | 'band';
  /** Ποια CSS μεταβλητή είναι το φόντο πίσω από το μετάξι (default --bg) */
  bgVar?: string;
}
const { variant = 'hero', bgVar = '--bg' } = Astro.props;
const strength = { hero: 0.9, soft: 0.62, band: 0.8 }[variant];
---

<canvas class="silk" data-silk={variant} data-strength={strength} data-bg={bgVar} aria-hidden="true"></canvas>

<style>
  .silk {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; display: block;
    pointer-events: none;
    opacity: 0; transition: opacity 1.4s ease;
  }
  .silk.is-ready { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .silk { transition: none; }
  }
</style>
