---
/*
  «Ο εξοπλισμός μας» — σελίδα Φωτογράφηση & Βίντεο (EL/EN).
  Οι συσκευές είναι διανυσματικά σχέδια (inline SVG), όχι φωτογραφίες:
  καθαρές, χωρίς φόντο, στην ασπρόμαυρη αισθητική «Σκηνή» του site, με
  πορτοκαλί μόνο στα κουμπιά εγγραφής. Αίτημα χρήστριας 10/09/2026:
  «βάλε τα εργαλεία μας με εικόνες καθαρές χωρίς background ενσωματωμένες στο site».
*/
interface Props {
  lang?: 'el' | 'en';
}
const { lang = 'el' } = Astro.props;

const t =
  lang === 'en'
    ? {
        kicker: 'Our gear',
        title: 'Two cameras, chosen for real-world shoots.',
        items: [
          {
            name: 'DJI Osmo Pocket 4',
            role: 'Video',
            d: 'A pocket camera on a 3-axis gimbal. Steady footage while walking through your space — reels, stories, quick tours, no shaking.',
          },
          {
            name: 'Canon PowerShot G7 X Mark III',
            role: 'Photo',
            d: 'A compact camera with a bright lens for products, dishes, the space and the team — sharp, natural colour, ready for site and e-shop.',
          },
        ],
      }
    : {
        kicker: 'Ο εξοπλισμός μας',
        title: 'Δύο κάμερες, διαλεγμένες για γυρίσματα στον χώρο σας.',
        items: [
          {
            name: 'DJI Osmo Pocket 4',
            role: 'Βίντεο',
            d: 'Κάμερα τσέπης πάνω σε gimbal τριών αξόνων. Σταθερό πλάνο ενώ περπατάμε μέσα στον χώρο σας — reels, stories, μικρές περιηγήσεις, χωρίς τρέμουλο.',
          },
          {
            name: 'Canon PowerShot G7 X Mark III',
            role: 'Φωτογραφία',
            d: 'Compact κάμερα με φωτεινό φακό για προϊόντα, πιάτα, χώρο και ομάδα — καθαρή εικόνα, φυσικό χρώμα, έτοιμη για site και e-shop.',
          },
        ],
      };
---

<section class="section section--tight gear" aria-labelledby="gear-title">
  <div class="container">
    <div class="sec-head">
      <p class="kicker kicker--blue">{t.kicker}</p>
      <h2 id="gear-title">{t.title}</h2>
    </div>
    <div class="grid-2">
      <!-- DJI Osmo Pocket 4 -->
      <article class="card gear-card reveal">
        <figure class="gear-fig" aria-hidden="true">
          <svg viewBox="0 0 220 270" class="gear-svg gear-svg--pocket">
            <defs>
              <linearGradient id="gp-body" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#3A3A3A"/><stop offset=".45" stop-color="#1F1F1F"/><stop offset="1" stop-color="#121212"/>
              </linearGradient>
              <linearGradient id="gp-cam" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#3D3D3D"/><stop offset="1" stop-color="#171717"/>
              </linearGradient>
              <radialGradient id="gp-glass" cx=".38" cy=".35" r=".75">
                <stop offset="0" stop-color="#5C7A9A"/><stop offset=".55" stop-color="#16202C"/><stop offset="1" stop-color="#05080C"/>
              </radialGradient>
              <linearGradient id="gp-screen" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#3C3C3C"/><stop offset="1" stop-color="#191919"/>
              </linearGradient>
              <radialGradient id="gp-floor" cx=".5" cy=".5" r=".5">
                <stop offset="0" stop-color="#000" stop-opacity=".55"/><stop offset="1" stop-color="#000" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <!-- σκιά στο «δάπεδο» -->
            <ellipse cx="108" cy="256" rx="70" ry="9" fill="url(#gp-floor)"/>

            <!-- βραχίονας gimbal: από τη λαβή δεξιά και πάνω, μέχρι το μοτέρ κλίσης -->
            <path d="M112 106 h32 a6 6 0 0 0 6 -6 v-32" fill="none" stroke="#2A2A2A" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M112 106 h32 a6 6 0 0 0 6 -6 v-32" fill="none" stroke="#4A4A4A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity=".7"/>
            <!-- μοτέρ pan (πάνω στη λαβή) -->
            <circle cx="108" cy="106" r="11" fill="#262626" stroke="#4A4A4A" stroke-width="1.2"/>
            <circle cx="108" cy="106" r="5" fill="#161616" stroke="#3A3A3A" stroke-width="1"/>
            <!-- μοτέρ κλίσης (δίπλα στην κάμερα) -->
            <circle cx="150" cy="64" r="11" fill="#2C2C2C" stroke="#4E4E4E" stroke-width="1.2"/>
            <circle cx="150" cy="64" r="4.5" fill="#181818"/>

            <!-- κεφαλή κάμερας -->
            <rect x="90" y="40" width="50" height="48" rx="12" fill="url(#gp-cam)" stroke="#4A4A4A" stroke-width="1.2"/>
            <rect x="93" y="43" width="44" height="14" rx="8" fill="#fff" opacity=".05"/>
            <circle cx="115" cy="64" r="17" fill="#0E0E0E" stroke="#3E3E3E" stroke-width="1.4"/>
            <circle cx="115" cy="64" r="12.5" fill="none" stroke="#5A5A5A" stroke-width="1"/>
            <circle cx="115" cy="64" r="9.5" fill="url(#gp-glass)"/>
            <ellipse cx="111" cy="59.5" rx="3.2" ry="2" fill="#fff" opacity=".55"/>
            <!-- μικρόφωνα -->
            <circle cx="98" cy="48" r="1.3" fill="#6A6A6A"/><circle cx="102" cy="48" r="1.3" fill="#6A6A6A"/>

            <!-- λαβή -->
            <rect x="84" y="112" width="48" height="136" rx="15" fill="url(#gp-body)" stroke="#3E3E3E" stroke-width="1.2"/>
            <path d="M89 126 v108" stroke="#fff" stroke-width="1.4" stroke-linecap="round" opacity=".14"/>
            <!-- οθόνη (οριζόντια, όπως στη συσκευή) -->
            <rect x="90" y="122" width="36" height="24" rx="3.5" fill="#080808" stroke="#3A3A3A" stroke-width="1"/>
            <rect x="92.5" y="124.5" width="31" height="19" rx="2" fill="url(#gp-screen)"/>
            <path d="M96 138 l6 -6 l5 4 l7 -8 l5 5" fill="none" stroke="#fff" stroke-width="1.2" opacity=".35" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- joystick + κουμπί εγγραφής -->
            <circle cx="99" cy="165" r="7" fill="#1C1C1C" stroke="#4A4A4A" stroke-width="1.2"/>
            <circle cx="99" cy="165" r="3" fill="#2E2E2E"/>
            <circle cx="118" cy="165" r="6.5" fill="#1C1C1C" stroke="#4A4A4A" stroke-width="1.2"/>
            <circle cx="118" cy="165" r="3.6" style="fill:var(--orange-cta)"/>
            <!-- λαστιχένια επιφάνεια λαβής -->
            <g fill="#fff" opacity=".07">
              <rect x="92" y="184" width="32" height="2" rx="1"/><rect x="92" y="191" width="32" height="2" rx="1"/>
              <rect x="92" y="198" width="32" height="2" rx="1"/><rect x="92" y="205" width="32" height="2" rx="1"/>
              <rect x="92" y="212" width="32" height="2" rx="1"/><rect x="92" y="219" width="32" height="2" rx="1"/>
            </g>
            <!-- θύρα στη βάση -->
            <rect x="103" y="241" width="10" height="3" rx="1.5" fill="#0A0A0A" stroke="#3A3A3A" stroke-width=".8"/>
          </svg>
        </figure>
        <p class="gear-role">{t.items[0].role}</p>
        <h3>{t.items[0].name}</h3>
        <p>{t.items[0].d}</p>
      </article>

      <!-- Canon PowerShot G7 X Mark III -->
      <article class="card gear-card reveal">
        <figure class="gear-fig" aria-hidden="true">
          <svg viewBox="0 0 320 220" class="gear-svg gear-svg--g7x">
            <defs>
              <linearGradient id="gc-body" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#333"/><stop offset=".5" stop-color="#1E1E1E"/><stop offset="1" stop-color="#121212"/>
              </linearGradient>
              <linearGradient id="gc-top" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#4A4A4A"/><stop offset="1" stop-color="#232323"/>
              </linearGradient>
              <radialGradient id="gc-barrel" cx=".5" cy=".5" r=".5">
                <stop offset="0" stop-color="#2A2A2A"/><stop offset=".85" stop-color="#1A1A1A"/><stop offset="1" stop-color="#0E0E0E"/>
              </radialGradient>
              <radialGradient id="gc-glass" cx=".38" cy=".34" r=".78">
                <stop offset="0" stop-color="#6A86A4"/><stop offset=".45" stop-color="#1C2836"/><stop offset=".8" stop-color="#0A1018"/><stop offset="1" stop-color="#03050A"/>
              </radialGradient>
              <radialGradient id="gc-floor" cx=".5" cy=".5" r=".5">
                <stop offset="0" stop-color="#000" stop-opacity=".55"/><stop offset="1" stop-color="#000" stop-opacity="0"/>
              </radialGradient>
              <pattern id="gc-grip" width="5" height="5" patternUnits="userSpaceOnUse">
                <circle cx="2.5" cy="2.5" r="1" fill="#fff" opacity=".09"/>
              </pattern>
            </defs>
            <ellipse cx="160" cy="203" rx="120" ry="9" fill="url(#gc-floor)"/>

            <!-- πάνω πλάκα: φλας, κουμπί κλείστρου με μοχλό zoom, επιλογέας -->
            <rect x="46" y="36" width="228" height="24" rx="8" fill="url(#gc-top)" stroke="#4A4A4A" stroke-width="1.2"/>
            <rect x="70" y="30" width="30" height="10" rx="3" fill="#2A2A2A" stroke="#4A4A4A" stroke-width="1"/>
            <rect x="74" y="33" width="22" height="4" rx="2" fill="#0F0F0F"/>
            <circle cx="206" cy="38" r="13" fill="#262626" stroke="#4E4E4E" stroke-width="1.2"/>
            <path d="M195 33 a13 13 0 0 1 22 0" fill="none" stroke="#6A6A6A" stroke-width="1.2" stroke-linecap="round"/>
            <circle cx="206" cy="36" r="6.5" fill="#3A3A3A" stroke="#5A5A5A" stroke-width="1"/>
            <circle cx="244" cy="38" r="13" fill="#232323" stroke="#4E4E4E" stroke-width="1.2"/>
            <circle cx="244" cy="38" r="9" fill="none" stroke="#5C5C5C" stroke-width="1" stroke-dasharray="1.5 2.2"/>
            <rect x="243" y="26" width="2" height="5" rx="1" fill="#DDD" opacity=".7"/>
            <circle cx="162" cy="40" r="3" fill="#0C0C0C" stroke="#4A4A4A" stroke-width=".8"/>

            <!-- σώμα -->
            <rect x="36" y="52" width="248" height="130" rx="16" fill="url(#gc-body)" stroke="#444" stroke-width="1.2"/>
            <rect x="40" y="55" width="240" height="20" rx="10" fill="#fff" opacity=".045"/>
            <!-- λαβή αριστερά -->
            <path d="M52 62 h26 a8 8 0 0 1 8 8 v100 a8 8 0 0 1 -8 8 h-26 a12 12 0 0 1 -12 -12 v-92 a12 12 0 0 1 12 -12z" fill="#171717" stroke="#3A3A3A" stroke-width="1"/>
            <path d="M52 62 h26 a8 8 0 0 1 8 8 v100 a8 8 0 0 1 -8 8 h-26 a12 12 0 0 1 -12 -12 v-92 a12 12 0 0 1 12 -12z" fill="url(#gc-grip)"/>
            <!-- λαμπάκι AF -->
            <circle cx="232" cy="78" r="4" fill="#2C1E14" stroke="#4A3A2C" stroke-width="1"/>
            <circle cx="231" cy="77" r="1.2" fill="#fff" opacity=".5"/>
            <!-- ονομασία (απλό κείμενο, όχι λογότυπο) -->
            <text x="266" y="168" text-anchor="end" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" font-weight="700" fill="#8A8A8A" letter-spacing=".5">G7 X</text>

            <!-- φακός -->
            <circle cx="160" cy="118" r="50" fill="url(#gc-barrel)" stroke="#4A4A4A" stroke-width="1.4"/>
            <circle cx="160" cy="118" r="45" fill="none" stroke="#5A5A5A" stroke-width="2" stroke-dasharray="2 2.6"/>
            <circle cx="160" cy="118" r="39" fill="#121212" stroke="#333" stroke-width="1"/>
            <circle cx="160" cy="118" r="32" fill="#0A0A0A" stroke="#3A3A3A" stroke-width="1"/>
            <circle cx="160" cy="118" r="27" fill="url(#gc-glass)"/>
            <circle cx="160" cy="118" r="12" fill="none" stroke="#7A8EA6" stroke-width="1" opacity=".35"/>
            <circle cx="160" cy="118" r="6" fill="#000" opacity=".6"/>
            <ellipse cx="149" cy="106" rx="7" ry="4" fill="#fff" opacity=".5" transform="rotate(-30 149 106)"/>
            <path d="M126 118 a34 34 0 0 1 34 -34" fill="none" stroke="#fff" stroke-width="1.6" opacity=".18" stroke-linecap="round"/>
          </svg>
        </figure>
        <p class="gear-role">{t.items[1].role}</p>
        <h3>{t.items[1].name}</h3>
        <p>{t.items[1].d}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .gear-card { display: flex; flex-direction: column; }
  .gear-fig {
    margin: 0 0 18px;
    display: flex; align-items: flex-end; justify-content: center;
    height: 230px;
    /* απαλός «προβολέας» πίσω από τη συσκευή — χωρίς πλαίσιο, χωρίς φόντο */
    background: radial-gradient(ellipse 60% 70% at 50% 60%, rgba(255, 255, 255, .06), transparent 70%);
    border-radius: var(--r);
  }
  .gear-svg { height: 100%; width: auto; max-width: 100%; display: block; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, .45)); transition: transform var(--dur) var(--ease); }
  .gear-svg--g7x { height: 88%; }
  .gear-card:hover .gear-svg { transform: translateY(-4px); }
  .gear-role {
    font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--orange-text); margin-bottom: 6px;
  }
  .gear-card h3 { margin-bottom: 6px; }
  .gear-card p:last-child { color: var(--muted); font-size: .95rem; }
  @media (max-width: 560px) {
    .gear-fig { height: 190px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gear-svg { transition: none; }
  }
</style>
