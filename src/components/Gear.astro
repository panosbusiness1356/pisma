---
/*
  «Ο εξοπλισμός μας», σελίδα Φωτογράφηση & Βίντεο (EL/EN).
  Επίσημα renders των προϊόντων με διαφανές φόντο (public/gear/*.webp):
  DJI από τη σελίδα dji.com/osmo-pocket-4, Canon από το CDN της canon.gr.
  Κομμένα στα όρια του αντικειμένου, χωρίς φόντο, με σκιά «δαπέδου» από CSS.
  Αίτημα χρήστριας 10/09/2026: «κανονικές εικόνες από τα προϊόντα αλλά χωρίς
  background, ενσωματωμένες στο site» (τα SVG σχέδια απορρίφθηκαν ως «καρτούν»).
*/
interface Props {
  lang?: 'el' | 'en';
}
const { lang = 'el' } = Astro.props;

const t =
  lang === 'en'
    ? {
        kicker: 'Our gear',
        title: 'Three cameras, chosen for real-world shoots.',
        items: [
          {
            name: 'DJI Osmo Pocket 4',
            role: 'Video',
            d: 'A pocket camera on a 3-axis gimbal. Steady footage while walking through your space: reels, stories, quick tours, no shaking.',
          },
          {
            name: 'Canon PowerShot G7 X Mark III',
            role: 'Photo',
            d: 'A compact camera with a bright lens for products, dishes, the space and the team: sharp, natural colour, ready for site and e-shop.',
          },
          {
            name: 'Nikon D750',
            role: 'Photo',
            d: 'A full-frame DSLR for the shots that need depth: portraits of the team, the space in low light, products with a soft background.',
          },
        ],
      }
    : {
        kicker: 'Ο εξοπλισμός μας',
        title: 'Τρεις κάμερες, διαλεγμένες για γυρίσματα στον χώρο σας.',
        items: [
          {
            name: 'DJI Osmo Pocket 4',
            role: 'Βίντεο',
            d: 'Κάμερα τσέπης πάνω σε gimbal τριών αξόνων. Σταθερό πλάνο ενώ περπατάμε μέσα στον χώρο σας: reels, stories, μικρές περιηγήσεις, χωρίς τρέμουλο.',
          },
          {
            name: 'Canon PowerShot G7 X Mark III',
            role: 'Φωτογραφία',
            d: 'Compact κάμερα με φωτεινό φακό για προϊόντα, πιάτα, χώρο και ομάδα: καθαρή εικόνα, φυσικό χρώμα, έτοιμη για site και e-shop.',
          },
          {
            name: 'Nikon D750',
            role: 'Φωτογραφία',
            d: 'Full-frame DSLR για τις λήψεις που θέλουν βάθος: πορτρέτα της ομάδας, ο χώρος σε χαμηλό φως, προϊόντα με απαλό φόντο.',
          },
        ],
      };

// Ίδια σειρά με τα items (και στις δύο γλώσσες). Διαστάσεις = πραγματικά pixels των WebP.
const images = [
  { file: 'dji-osmo-pocket-4.webp', w: 335, h: 900, key: 'pocket' },
  { file: 'canon-g7x-mark-iii.webp', w: 1190, h: 700, key: 'g7x' },
  { file: 'nikon-d750.webp', w: 619, h: 496, key: 'd750' }
];
---

<section class="section section--tight gear" aria-labelledby="gear-title">
  <div class="container">
    <div class="sec-head">
      <p class="kicker kicker--blue">{t.kicker}</p>
      <h2 id="gear-title">{t.title}</h2>
    </div>
    <div class="grid-3 gear-grid">
      {t.items.map((it, i) => (
        <article class="card gear-card reveal">
          <figure class="gear-fig" aria-hidden="true" style={`--float-delay:${-(i * 1.9).toFixed(1)}s`}>
            <span class="gear-float">
              <img src={`/gear/${images[i].file}`} alt="" width={images[i].w} height={images[i].h} loading="lazy" decoding="async" class={`gear-img gear-img--${images[i].key}`} />
            </span>
            <span class="gear-shadow"></span>
          </figure>
          <p class="gear-role">{it.role}</p>
          <h3>{it.name}</h3>
          <p>{it.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .gear-card { display: flex; flex-direction: column; }
  .gear-fig {
    position: relative;
    margin: 0 0 18px;
    display: flex; align-items: flex-end; justify-content: center;
    height: 236px;
    /* Χωρίς φόντο/προβολέα πίσω από τη συσκευή (χρήστρια 10/09/2026: «φαίνεται ένα γκρι σαν κύκλος από πίσω») */
  }
  /* Αιώρηση: το περιτύλιγμα κινείται (transform μόνο), η εικόνα με το drop-shadow
     ρασταρίζεται μία φορά. Κάθε κάρτα σε άλλη φάση (--float-delay). */
  .gear-float {
    display: flex; align-items: flex-end; justify-content: center;
    height: 100%; padding-bottom: 16px; box-sizing: border-box;
    animation: gear-float 5.6s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
    transform-origin: 50% 80%;
    will-change: transform;
  }
  .gear-img {
    display: block; height: 100%; width: auto; max-width: 100%; object-fit: contain;
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, .5));
    transition: transform var(--dur) var(--ease);
  }
  .gear-img--g7x { height: 72%; }
  .gear-img--d750 { height: 86%; }
  .gear-card:hover .gear-img { transform: translateY(-4px); }
  /* Σκιά δαπέδου: μικραίνει και ξεθωριάζει όσο η συσκευή ανεβαίνει */
  .gear-shadow {
    position: absolute; left: 50%; bottom: 4px;
    width: 56%; height: 18px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, .65), rgba(0, 0, 0, 0) 70%);
    transform: translateX(-50%) scaleX(1);
    animation: gear-shadow 5.6s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
    will-change: transform, opacity;
    pointer-events: none;
  }
  /* Ελαφριά κλίση κατά την αιώρηση, όχι τελείως κατακόρυφη (χρήστρια 10/09/2026) */
  @keyframes gear-float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-11px) rotate(2.5deg); }
  }
  @keyframes gear-shadow {
    0%, 100% { transform: translateX(-50%) scaleX(1); opacity: .95; }
    50% { transform: translateX(-50%) scaleX(.8); opacity: .55; }
  }
  .gear-role {
    font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--orange-text); margin-bottom: 6px;
  }
  .gear-card h3 { margin-bottom: 6px; }
  .gear-card p:last-child { color: var(--muted); font-size: .95rem; }
  @media (max-width: 560px) {
    .gear-fig { height: 190px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gear-img { transition: none; }
    .gear-float, .gear-shadow { animation: none; }
  }
</style>
