---
/**
 * «ΟΧΙ το κλασικό QR» (χρήστρια 10/09/2026): στο hero της σελίδας Κριτικών, ένα σχέδιο του
 * συνηθισμένου προϊόντος που έχουν όλοι (καρτελάκι τραπεζιού με Google, αστέρια, QR,
 * «Κάντε μας κριτική») και από πάνω ένα μεγάλο κόκκινο Χ που «γράφεται» μόλις φανεί.
 * Σχέδιο SVG, όχι φωτογραφία (κανόνας: καμία stock εικόνα). Το Χ είναι SVG stroke με
 * dashoffset, μόνο transform/opacity/stroke-dashoffset. Reduced motion: στατικό.
 * Δεν λέει τίποτα για το πώς δουλεύει το δικό μας εργαλείο (κανόνας teaser).
 */
interface Props { lang?: 'el' | 'en' }
const { lang = 'el' } = Astro.props;
const T = lang === 'el'
  ? { title: 'Κάντε μας κριτική', scan: 'Σκανάρετε εδώ', no: 'ΟΧΙ', caption: 'το κλασικό QR «κάντε μας κριτική» που έχουν όλοι.' }
  : { title: 'Leave us a review', scan: 'Scan here', no: 'NOT', caption: 'the classic "leave us a review" QR that everyone has.' };

// Ψεύτικο QR: σταθερό μοτίβο 21x21 (χωρίς πραγματικό περιεχόμενο)
const N = 21;
const cells: [number, number][] = [];
const finder = (x: number, y: number) => {
  for (let i = 0; i < 7; i++) for (let j = 0; j < 7; j++) {
    const edge = i === 0 || i === 6 || j === 0 || j === 6;
    const core = i >= 2 && i <= 4 && j >= 2 && j <= 4;
    if (edge || core) cells.push([x + i, y + j]);
  }
};
finder(0, 0); finder(N - 7, 0); finder(0, N - 7);
let seed = 7;
const rnd = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };
for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
  const inFinder = (x < 8 && y < 8) || (x >= N - 8 && y < 8) || (x < 8 && y >= N - 8);
  if (!inFinder && rnd() < 0.45) cells.push([x, y]);
}
---

<div class="ncq" aria-hidden="true">
  <div class="ncq-card">
    <div class="ncq-top">
      <img src="/logos/google-icon.svg" alt="" width="22" height="22" loading="lazy" />
      <span class="ncq-stars">★★★★★</span>
    </div>
    <p class="ncq-title">{T.title}</p>
    <svg class="ncq-qr" viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges">
      {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
    </svg>
    <p class="ncq-scan">{T.scan}</p>
  </div>
  <svg class="ncq-x" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    <path class="ncq-x1" d="M8 8L92 92" pathLength="100" />
    <path class="ncq-x2" d="M92 8L8 92" pathLength="100" />
  </svg>
</div>
<p class="ncq-caption"><b>{T.no}</b> {T.caption}</p>

<style>
  .ncq {
    position: relative; width: min(230px, 62vw); margin: 0 auto;
    transform: rotate(-3deg);
  }
  .ncq-card {
    background: #F4F4F4; color: #2B2B2B; border-radius: 14px;
    padding: 16px 18px 14px; text-align: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .5);
  }
  .ncq-top { display: flex; align-items: center; justify-content: center; gap: 8px; }
  .ncq-stars { color: #F6C34C; font-size: .95rem; letter-spacing: .04em; }
  .ncq-title { margin: 8px 0 10px; max-width: none; font-weight: 800; font-size: 1.02rem; line-height: 1.15; color: #161616; }
  .ncq-qr { width: 60%; margin: 0 auto; fill: #161616; }
  .ncq-scan { margin: 10px 0 0; max-width: none; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: #6B6B6B; }

  /* Το κόκκινο Χ: ξεχειλίζει λίγο έξω από την κάρτα, «γράφεται» με dashoffset */
  .ncq-x {
    position: absolute; inset: -10%; width: 120%; height: 120%;
    overflow: visible; pointer-events: none;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, .45));
  }
  .ncq-x path {
    fill: none; stroke: var(--red); stroke-width: 9; stroke-linecap: round;
    stroke-dasharray: 100; stroke-dashoffset: 100;
    animation: ncq-draw .45s cubic-bezier(.3, 0, .2, 1) forwards;
  }
  .ncq-x1 { animation-delay: .9s !important; }
  .ncq-x2 { animation-delay: 1.25s !important; }
  @keyframes ncq-draw { to { stroke-dashoffset: 0; } }

  .ncq-caption {
    margin: 22px auto 0; max-width: 40ch; text-align: center;
    font-size: clamp(.98rem, 1.5vw, 1.12rem); color: var(--ink);
  }
  .ncq-caption b { color: var(--red-text); font-weight: 800; letter-spacing: .04em; }

  @media (prefers-reduced-motion: reduce) {
    .ncq-x path { animation: none; stroke-dashoffset: 0; }
  }
</style>
