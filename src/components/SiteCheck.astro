---
/**
 * Στιγμιαίος έλεγχος site (11/09/2026): ο επισκέπτης γράφει τη διεύθυνσή του και βλέπει σε 10-30 s
 * τέσσερα σκορ (ταχύτητα, SEO, προσβασιμότητα, καλές πρακτικές) σε κινητό, το στιγμιότυπο της
 * σελίδας του και τα 3 πιο βαριά ευρήματα. Πραγματικά δεδομένα από το PageSpeed Insights της Google
 * (Lighthouse), το αίτημα φεύγει από τον browser του επισκέπτη (χωρίς κλειδί, δικό του όριο ανά IP).
 * Τελειώνει στην κράτηση: η διεύθυνση και τα σκορ μπαίνουν στο κρυφό πεδίο «site» της φόρμας.
 * Τίποτα δεν αποθηκεύεται από εμάς. Δίγλωσσο μέσω prop.
 */
import { PSI_KEY } from '../config';
interface Props { lang?: 'el' | 'en' }
const { lang = 'el' } = Astro.props;

const T = {
  el: {
    kicker: 'Δοκιμάστε το τώρα',
    title: 'Γράψτε το site σας.',
    sub: 'Ταχύτητα, SEO, προσβασιμότητα και καλές πρακτικές, όπως τα βλέπει η Google σε κινητό. Πραγματική μέτρηση, μισό λεπτό.',
    label: 'Διεύθυνση ιστοσελίδας',
    btn: 'Μέτρηση',
    hint: 'Η μέτρηση γίνεται με το PageSpeed Insights της Google. Δεν αποθηκεύουμε τίποτα.',
    scores: ['Ταχύτητα', 'SEO', 'Προσβασιμότητα', 'Πρακτικές'],
    findings: 'Τι βαραίνει περισσότερο',
    clean: 'Κανένα βαρύ εύρημα. Καλή βάση.',
    cta: 'Κλείστε τον δωρεάν Έλεγχο',
    ctaNote: 'Τα νούμερα έρχονται μαζί με την κράτηση.',
    steps: ['Φορτώνουμε τη σελίδα σε κινητό', 'Μετράμε την ταχύτητα', 'Ελέγχουμε SEO και προσβασιμότητα', 'Σχεδόν έτοιμο'],
    errInvalid: 'Γράψτε μια πλήρη διεύθυνση, π.χ. www.example.gr',
    errFail: 'Δεν μπορέσαμε να μετρήσουμε τη σελίδα. Κλείστε τον Έλεγχο και το βλέπουμε μαζί.',
    errBusy: 'Πολλές μετρήσεις αυτή τη στιγμή. Δοκιμάστε ξανά σε λίγο.',
    shotAlt: 'Η σελίδα σας σε κινητό',
    mobile: 'Κινητό',
  },
  en: {
    kicker: 'Try it now',
    title: 'Type your website.',
    sub: 'Speed, SEO, accessibility and best practices, the way Google sees them on mobile. A real measurement, half a minute.',
    label: 'Website address',
    btn: 'Measure',
    hint: 'Measured with Google PageSpeed Insights. We store nothing.',
    scores: ['Speed', 'SEO', 'Accessibility', 'Practices'],
    findings: 'What weighs the most',
    clean: 'No heavy findings. A solid base.',
    cta: 'Book the free Check',
    ctaNote: 'The numbers travel with your booking.',
    steps: ['Loading your page on mobile', 'Measuring speed', 'Checking SEO and accessibility', 'Almost there'],
    errInvalid: 'Type a full address, e.g. www.example.com',
    errFail: 'We could not measure the page. Book the Check and we look at it together.',
    errBusy: 'Too many measurements right now. Try again in a moment.',
    shotAlt: 'Your page on mobile',
    mobile: 'Mobile',
  },
}[lang];
---

<section class="section section--tight" aria-labelledby="sk-title">
  <div class="container">
    <div class="sec-head sec-head--center">
      <p class="kicker">{T.kicker}</p>
      <h2 id="sk-title">{T.title}</h2>
      <p>{T.sub}</p>
    </div>

    <form class="card sk reveal" id="sitecheck" data-lang={lang} data-key={PSI_KEY} novalidate>
      <label class="sk-label" for="sk-url">{T.label}</label>
      <div class="sk-row">
        <input id="sk-url" type="text" inputmode="url" placeholder="www.example.gr" autocomplete="url" spellcheck="false" required />
        <button class="btn btn--orange" type="submit" id="sk-btn">{T.btn}</button>
      </div>
      <p class="sk-hint">{T.hint}</p>

      <div class="sk-progress" id="sk-progress" role="status" aria-live="polite" hidden>
        <span class="sk-spin" aria-hidden="true"></span>
        <span id="sk-step"></span>
      </div>
      <p class="sk-error" id="sk-error" role="alert" hidden></p>

      <div class="sk-result" id="sk-result" hidden>
        <figure class="sk-shot">
          <span class="sk-shot-tag">{T.mobile}</span>
          <img id="sk-shot" alt={T.shotAlt} width="120" height="240" />
        </figure>
        <div class="sk-body">
          <p class="sk-host num" id="sk-host"></p>
          <ul class="sk-scores" id="sk-scores">
            {T.scores.map((s) => (
              <li class="sk-score" data-grade="">
                <svg viewBox="0 0 44 44" aria-hidden="true">
                  <circle class="sk-track" cx="22" cy="22" r="19" />
                  <circle class="sk-arc" cx="22" cy="22" r="19" pathLength="100" />
                </svg>
                <b class="num">0</b>
                <span>{s}</span>
              </li>
            ))}
          </ul>
          <p class="sk-ftitle" id="sk-ftitle">{T.findings}</p>
          <ul class="sk-findings" id="sk-findings"></ul>
          <p class="sk-cta">
            <a class="btn btn--orange" href="#booking-title" id="sk-cta">{T.cta}</a>
            <span class="btn-note">{T.ctaNote}</span>
          </p>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('sitecheck') as HTMLFormElement | null;
  if (form) {
    const lang = form.dataset.lang === 'en' ? 'en' : 'el';
    const T = lang === 'en'
      ? { steps: ['Loading your page on mobile', 'Measuring speed', 'Checking SEO and accessibility', 'Almost there'], errInvalid: 'Type a full address, e.g. www.example.com', errFail: 'We could not measure the page. Book the Check and we look at it together.', errBusy: 'Too many measurements right now. Try again in a moment.', clean: 'No heavy findings. A solid base.', btn: 'Measure' }
      : { steps: ['Φορτώνουμε τη σελίδα σε κινητό', 'Μετράμε την ταχύτητα', 'Ελέγχουμε SEO και προσβασιμότητα', 'Σχεδόν έτοιμο'], errInvalid: 'Γράψτε μια πλήρη διεύθυνση, π.χ. www.example.gr', errFail: 'Δεν μπορέσαμε να μετρήσουμε τη σελίδα. Κλείστε τον Έλεγχο και το βλέπουμε μαζί.', errBusy: 'Πολλές μετρήσεις αυτή τη στιγμή. Δοκιμάστε ξανά σε λίγο.', clean: 'Κανένα βαρύ εύρημα. Καλή βάση.', btn: 'Μέτρηση' };

    const input = document.getElementById('sk-url') as HTMLInputElement;
    const btn = document.getElementById('sk-btn') as HTMLButtonElement;
    const progress = document.getElementById('sk-progress')!;
    const stepEl = document.getElementById('sk-step')!;
    const errEl = document.getElementById('sk-error')!;
    const result = document.getElementById('sk-result')!;
    const shot = document.getElementById('sk-shot') as HTMLImageElement;
    const hostEl = document.getElementById('sk-host')!;
    const scoreEls = Array.from(document.querySelectorAll<HTMLElement>('#sk-scores .sk-score'));
    const findingsEl = document.getElementById('sk-findings')!;
    const ftitle = document.getElementById('sk-ftitle')!;
    const cta = document.getElementById('sk-cta') as HTMLAnchorElement;
    const siteField = document.getElementById('f-site') as HTMLInputElement | null;

    const CATS = ['performance', 'seo', 'accessibility', 'best-practices'] as const;
    let stepTimer = 0;
    let running = false;

    /** «www.example.gr», «example.gr/sel», «https://…» → κανονικό https URL, ή null. */
    const normalize = (raw: string): URL | null => {
      let s = raw.trim();
      if (!s) return null;
      if (!/^https?:\/\//i.test(s)) s = 'https://' + s;
      try {
        const u = new URL(s);
        if (!/^[a-z0-9.-]+\.[a-z]{2,}$/i.test(u.hostname)) return null;
        return u;
      } catch { return null; }
    };

    const showError = (msg: string) => {
      errEl.textContent = msg;
      errEl.hidden = false;
    };
    const setBusy = (on: boolean) => {
      running = on;
      btn.disabled = on;
      input.readOnly = on;
      progress.hidden = !on;
      if (on) {
        let i = 0;
        stepEl.textContent = T.steps[0];
        stepTimer = window.setInterval(() => { i = Math.min(i + 1, T.steps.length - 1); stepEl.textContent = T.steps[i]; }, 5500);
      } else {
        clearInterval(stepTimer);
      }
    };

    const grade = (n: number) => (n >= 90 ? 'ok' : n >= 50 ? 'mid' : 'low');

    type Audit = { id: string; title: string; score: number | null; scoreDisplayMode: string; displayValue?: string };
    type LHR = {
      finalDisplayedUrl?: string;
      categories: Record<string, { score: number | null; auditRefs: Array<{ id: string; weight: number; group?: string }> }>;
      audits: Record<string, Audit>;
    };

    const render = (u: URL, lhr: LHR) => {
      hostEl.textContent = (lhr.finalDisplayedUrl || u.href).replace(/^https?:\/\//, '').replace(/\/$/, '');
      const scores = CATS.map((c) => Math.round(((lhr.categories[c]?.score ?? 0) as number) * 100));
      scoreEls.forEach((el, i) => {
        const n = scores[i];
        el.dataset.grade = grade(n);
        el.querySelector('b')!.textContent = String(n);
        const arc = el.querySelector<SVGCircleElement>('.sk-arc')!;
        arc.style.strokeDasharray = '0 100';
        requestAnimationFrame(() => requestAnimationFrame(() => { arc.style.strokeDasharray = `${n} 100`; }));
      });
      // Στιγμιότυπο της σελίδας σε κινητό (Lighthouse «final-screenshot», data URI)
      const data = (lhr.audits['final-screenshot'] as unknown as { details?: { data?: string } } | undefined)?.details?.data;
      shot.src = data || '';
      shot.parentElement!.hidden = !data;

      // Ευρήματα: αποτυχημένα audits με βάρος, από τις 3 κατηγορίες που «μιλούν» σε ιδιοκτήτη, τα 3 βαρύτερα.
      const seen = new Set<string>();
      const bad: Array<{ w: number; a: Audit }> = [];
      for (const c of ['performance', 'seo', 'accessibility'] as const) {
        for (const ref of lhr.categories[c]?.auditRefs ?? []) {
          const a = lhr.audits[ref.id];
          if (!a || seen.has(a.id) || ref.weight <= 0) continue;
          if (a.score === null || a.score >= 0.9) continue;
          if (a.scoreDisplayMode !== 'binary' && a.scoreDisplayMode !== 'numeric') continue;
          seen.add(a.id);
          bad.push({ w: ref.weight * (1 - a.score), a });
        }
      }
      bad.sort((x, y) => y.w - x.w);
      findingsEl.replaceChildren();
      for (const { a } of bad.slice(0, 3)) {
        const li = document.createElement('li');
        const t = document.createElement('span');
        t.textContent = a.title;
        li.appendChild(t);
        if (a.displayValue) {
          const v = document.createElement('b');
          v.className = 'num';
          v.textContent = a.displayValue;
          li.appendChild(v);
        }
        findingsEl.appendChild(li);
      }
      if (!bad.length) {
        const li = document.createElement('li');
        li.className = 'is-clean';
        li.textContent = T.clean;
        findingsEl.appendChild(li);
      }
      ftitle.hidden = false;
      result.hidden = false;

      // Η μέτρηση ταξιδεύει με την κράτηση (κρυφό πεδίο «site» της φόρμας).
      if (siteField) siteField.value = `${u.href} | ${CATS.map((c, i) => `${c}:${scores[i]}`).join(', ')}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (running) return;
      errEl.hidden = true;
      const u = normalize(input.value);
      if (!u) { showError(T.errInvalid); input.focus(); return; }
      input.value = u.hostname + (u.pathname !== '/' ? u.pathname : '');

      // Ίδια διεύθυνση στην ίδια επίσκεψη: από τη μνήμη, όχι νέα μέτρηση.
      const key = 'pisma-sitecheck:' + u.href;
      try {
        const cached = sessionStorage.getItem(key);
        if (cached) { render(u, JSON.parse(cached)); return; }
      } catch { /* χωρίς cache */ }

      result.hidden = true;
      setBusy(true);
      const ctrl = new AbortController();
      const kill = setTimeout(() => ctrl.abort(), 75000);
      try {
        const api = new URL('https://www.googleapis.com/pagespeedonline/v5/runPagespeed');
        api.searchParams.set('url', u.href);
        api.searchParams.set('strategy', 'mobile');
        api.searchParams.set('locale', lang);
        if (form.dataset.key) api.searchParams.set('key', form.dataset.key);
        for (const c of CATS) api.searchParams.append('category', c);
        const res = await fetch(api.href, { signal: ctrl.signal });
        if (res.status === 429) throw new Error('busy');
        const json = await res.json().catch(() => null);
        const lhr: LHR | undefined = json?.lighthouseResult;
        if (!res.ok || !lhr?.categories) throw new Error('fail');
        // Κρατάμε μόνο ό,τι χρειάζεται (το πλήρες JSON είναι μερικά MB).
        const slim: LHR = {
          finalDisplayedUrl: lhr.finalDisplayedUrl,
          categories: Object.fromEntries(CATS.map((c) => [c, lhr.categories[c]])) as LHR['categories'],
          audits: Object.fromEntries(
            Object.values(lhr.audits)
              .filter((a) => a.id === 'final-screenshot' || (a.score !== null && a.score < 0.9))
              .map((a) => [a.id, a.id === 'final-screenshot' ? a : { id: a.id, title: a.title, score: a.score, scoreDisplayMode: a.scoreDisplayMode, displayValue: a.displayValue }])
          ),
        };
        try { sessionStorage.setItem(key, JSON.stringify(slim)); } catch { /* γεμάτο */ }
        render(u, slim);
        (window as unknown as { pismaSound?: { play: (n: string) => void } }).pismaSound?.play('on');
      } catch (err) {
        showError((err as Error).message === 'busy' ? T.errBusy : T.errFail);
      } finally {
        clearTimeout(kill);
        setBusy(false);
      }
    });

    // Το CTA πάει στην κράτηση, μέσω Lenis όπου υπάρχει (αλλιώς το native scroll ακυρώνεται από το raf του).
    cta.addEventListener('click', (e) => {
      const target = document.getElementById('booking-title');
      const lenis = (window as unknown as { lenis?: { scrollTo: (t: Element, o?: object) => void } }).lenis;
      if (target && lenis) { e.preventDefault(); lenis.scrollTo(target, { offset: -90 }); }
    });
  }
</script>

<style>
  .sk { max-width: 760px; margin-inline: auto; }
  /* Το display των μπλοκ δεν πρέπει να νικά το hidden */
  .sk-progress[hidden], .sk-result[hidden], .sk-error[hidden], .sk-shot[hidden] { display: none; }
  .sk-label { display: block; font-weight: 600; font-size: .95rem; color: var(--navy); margin-bottom: 8px; }
  .sk-row { display: flex; gap: 10px; }
  .sk-row input {
    flex: 1; min-width: 0;
    border: 1.5px solid var(--line-strong); border-radius: 12px; background: var(--bg-soft);
    padding: 13px 16px; transition: border-color .15s ease;
  }
  .sk-row input:focus { border-color: var(--orange); }
  .sk-row input:focus:not(:focus-visible) { outline: none; }
  .sk-row .btn { flex: none; }
  .sk-hint { margin-top: 10px; font-size: .82rem; color: var(--muted); }
  @media (max-width: 520px) {
    .sk-row { flex-direction: column; }
    .sk-row .btn { width: 100%; }
  }

  .sk-progress {
    display: flex; align-items: center; gap: 12px;
    margin-top: 18px; padding: 14px 16px;
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 12px;
    font-size: .95rem; font-weight: 600; color: var(--ink);
  }
  .sk-spin {
    flex: none; width: 18px; height: 18px; border-radius: 50%;
    border: 2px solid var(--line-strong); border-top-color: var(--orange);
    animation: sk-spin .8s linear infinite;
  }
  @keyframes sk-spin { to { transform: rotate(360deg); } }
  .sk-error {
    margin-top: 16px; padding: 14px 18px; border-radius: 12px;
    background: var(--red-soft); color: var(--red-text); font-size: .95rem; font-weight: 600;
  }

  /* Αποτέλεσμα: στιγμιότυπο κινητού αριστερά, σκορ και ευρήματα δεξιά */
  .sk-result {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(18px, 3vw, 30px);
    margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line);
    animation: sk-in .5s var(--ease) both;
  }
  @keyframes sk-in { from { opacity: 0; transform: translateY(8px); } }
  .sk-shot {
    position: relative; width: 132px; margin: 0;
    background: #17171a; border: 1px solid #45454d; border-radius: 22px; padding: 6px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, .5);
  }
  .sk-shot img {
    width: 120px; height: 240px; object-fit: cover; object-position: top;
    border-radius: 17px; background: #fff;
  }
  .sk-shot-tag {
    position: absolute; left: 50%; bottom: -10px; transform: translateX(-50%);
    background: var(--card-2); border: 1px solid var(--line-strong); border-radius: 999px;
    padding: 2px 10px; font-size: .68rem; font-weight: 700; color: var(--muted); white-space: nowrap;
  }
  .sk-host { font-size: .82rem; color: var(--muted); margin-bottom: 14px; overflow-wrap: anywhere; }
  .sk-scores {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px;
  }
  .sk-score {
    position: relative; text-align: center;
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 14px;
    padding: 12px 6px 10px;
  }
  .sk-score svg { width: 52px; height: 52px; margin: 0 auto 6px; transform: rotate(-90deg); }
  .sk-track { fill: none; stroke: var(--line-strong); stroke-width: 4; }
  .sk-arc {
    fill: none; stroke-width: 4; stroke-linecap: round;
    stroke-dasharray: 0 100; transition: stroke-dasharray 1.2s cubic-bezier(.3, .8, .3, 1);
    stroke: var(--ok);
  }
  .sk-score[data-grade="mid"] .sk-arc { stroke: var(--yellow); }
  .sk-score[data-grade="low"] .sk-arc { stroke: var(--red); }
  .sk-score b { display: block; font-size: 1.15rem; color: var(--navy); line-height: 1; }
  .sk-score span { display: block; margin-top: 4px; font-size: .7rem; font-weight: 600; color: var(--muted); }
  .sk-ftitle { margin: 18px 0 8px; font-size: .8rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .sk-findings { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  /* Τα ευρήματα φτιάχνονται από JS (χωρίς scope attribute): :global */
  .sk-findings :global(li) {
    display: flex; justify-content: space-between; gap: 12px; align-items: baseline;
    padding: 10px 12px; border-radius: 10px;
    background: var(--bg-soft); border: 1px solid var(--line);
    font-size: .92rem; color: var(--ink);
  }
  .sk-findings :global(li::before) { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--orange); align-self: center; }
  .sk-findings :global(li span) { flex: 1; }
  .sk-findings :global(li b) { flex: none; font-size: .82rem; color: var(--orange-text); }
  .sk-findings :global(li.is-clean) { color: var(--ok-text); }
  .sk-findings :global(li.is-clean::before) { background: var(--ok); }
  .sk-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 20px; }
  @media (max-width: 640px) {
    .sk-result { grid-template-columns: 1fr; }
    .sk-shot { margin-inline: auto; }
    .sk-scores { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sk-cta { align-items: stretch; text-align: center; }
  }
</style>
