---
/**
 * Βήματα οδηγού σε κάθετη χρονογραμμή: αριθμός + εικονίδιο + τίτλος + ΜΙΑ γραμμή.
 * Κάθε βήμα μπαίνει με το .reveal του Base και, όταν πάρει .is-in, «τραβιέται» η γραμμή
 * που το ενώνει με το επόμενο (scaleY, μόνο transform). Reduced motion: όλα στατικά.
 */
import { guideIcons } from './icons';

interface Step { icon?: string; t: string; d: string }
interface Props { items: Step[] }
const { items } = Astro.props;
---

<ol class="gs">
  {items.map((s, i) => (
    <li class="gs-step reveal">
      <span class="gs-rail" aria-hidden="true">
        <span class="gs-num num">{i + 1}</span>
        {i < items.length - 1 && <span class="gs-line"></span>}
      </span>
      <div class="gs-body">
        {s.icon && (
          <span class="icon-chip gs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={guideIcons[s.icon]} />
          </span>
        )}
        <div>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .gs { list-style: none; padding: 0; margin: 0 0 8px; display: grid; }
  .gs-step { display: grid; grid-template-columns: 40px 1fr; gap: 0 16px; }
  .gs-rail { display: flex; flex-direction: column; align-items: center; }
  .gs-num {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 40px; height: 40px; border-radius: 12px;
    background: var(--grad); color: var(--cta-ink); font-weight: 700; font-size: .95rem;
  }
  .gs-line {
    flex: 1; width: 2px; min-height: 22px; margin: 6px 0;
    background: var(--line-strong);
    transform: scaleY(0); transform-origin: top;
    transition: transform .7s var(--ease) .35s;
  }
  .gs-step.is-in .gs-line { transform: scaleY(1); }
  .gs-body {
    display: flex; align-items: flex-start; gap: 14px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r);
    padding: 16px 18px; margin-bottom: 12px;
  }
  .gs-icon { width: 40px; height: 40px; border-radius: 11px; margin: 0; flex: none; }
  .gs-icon svg { width: 21px; height: 21px; }
  .gs-body h3 { font-size: 1rem; margin: 0 0 3px; }
  .gs-body p { margin: 0; font-size: .92rem; color: var(--muted); }
  @media (max-width: 460px) {
    .gs-step { grid-template-columns: 34px 1fr; gap: 0 12px; }
    .gs-num { width: 34px; height: 34px; border-radius: 10px; font-size: .88rem; }
    .gs-icon { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gs-line { transform: none; transition: none; }
  }
</style>
