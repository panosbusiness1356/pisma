---
/**
 * Hero εσωτερικής σελίδας — μικρή «Σκηνή», ίδια γλώσσα με την αρχική (06/09/2026):
 * καπνός WebGL (src/scripts/smoke.ts, ρυθμίσεις «Αργά σύννεφα» όπως η αρχική) πάνω από
 * CSS ομίχλη — χωρίς λωρίδες φωτός, όπως η αρχική — όλα στο κέντρο
 * σε στοίβα (ετικέτα → τίτλος → υπότιτλος), απλώνεται πίσω από το sticky μενού
 * και σβήνει απαλά στο φόντο. Στον τίτλο επιτρέπεται <span class="accent">: λευκό
 * με πορτοκαλί υπογράμμιση, όπως το «ορατή στους πελάτες» της αρχικής.
 * Χωρίς WebGL μένει η CSS ομίχλη· reduced-motion = στατικό, χωρίς είσοδο.
 */
interface Props {
  kicker?: string;
  sub?: string;
}
const { kicker, sub } = Astro.props;
const hasExtra = Astro.slots.has('extra');
---

<section class="hero">
  <div class="stg" aria-hidden="true">
    <span class="stg-fog stg-fog--1"></span><span class="stg-fog stg-fog--2"></span>
    <canvas class="stg-smoke" data-strength=".55" data-scale="1.4" data-warp="2.2" data-lo=".4" data-hi=".98" data-bottom=".6" data-rise=".06" data-speed=".55" data-glow=".7" data-glowy=".6" data-glowr="2"></canvas>
  </div>
  <div class="container container--narrow hero-inner">
    {kicker && <p class="hero-kicker blur-in" style="--d:.1s">{kicker}</p>}
    <h1 class="blur-in" style="--d:.18s"><slot /></h1>
    {sub && <p class="sub blur-in" style="--d:.3s">{sub}</p>}
    {hasExtra && <div class="hero-extra blur-in" style="--d:.4s"><slot name="extra" /></div>}
  </div>
</section>

<script>
  import '../scripts/smoke';
</script>

<style>
  /* Η σκηνή απλώνεται και πίσω από το sticky μενού (72px) — μενού και hero «ένα», όπως στην αρχική. */
  .hero {
    position: relative; overflow: hidden; text-align: center;
    margin-top: -72px;
    padding-top: calc(clamp(56px, 8vw, 104px) + 72px);
    padding-bottom: clamp(52px, 7vw, 92px);
    min-height: min(56svh, 600px);
    display: flex; flex-direction: column; justify-content: center;
  }
  .hero-inner {
    position: relative; z-index: 1; width: 100%;
    display: flex; flex-direction: column; align-items: center;
  }
  .hero-kicker {
    margin-bottom: clamp(16px, 2.5vw, 24px);
    font-size: .76rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--orange-text); text-wrap: balance;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.6rem); line-height: 1.06; letter-spacing: -.03em;
    max-width: 20ch; margin-inline: auto;
    text-shadow: 0 10px 60px rgba(0, 0, 0, .6);
  }
  /* Η λέξη-κλειδί: λευκή με πορτοκαλί υπογράμμιση (όχι πορτοκαλί κείμενο) — όπως στην αρχική */
  .hero h1 :global(.accent) {
    color: inherit;
    text-decoration: underline; text-decoration-color: var(--orange-cta);
    text-decoration-thickness: .07em; text-underline-offset: .13em; text-decoration-skip-ink: none;
  }
  .hero .sub {
    margin: clamp(16px, 2.5vw, 24px) auto 0;
    color: var(--muted); font-size: 1.12rem; max-width: 56ch; text-wrap: pretty;
  }
  .hero-extra { margin-top: clamp(22px, 3vw, 32px); width: 100%; }

  /* ---------- Σκηνή: ομίχλη, καπνός, σβήσιμο ---------- */
  .stg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .stg-fog { position: absolute; border-radius: 50%; filter: blur(60px); animation: phDrift 22s ease-in-out infinite alternate; }
  .stg-fog--1 { width: 70vw; height: 34vw; left: -12vw; top: 18%; background: radial-gradient(closest-side, rgba(255, 255, 255, .15), transparent); }
  .stg-fog--2 { width: 60vw; height: 30vw; right: -14vw; top: 30%; background: radial-gradient(closest-side, rgba(255, 255, 255, .11), transparent); animation-delay: -9s; animation-duration: 26s; }
  @keyframes phDrift { to { transform: translate(5vw, -2vw) scale(1.1); } }
  .stg-smoke { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.2s ease; }
  .stg-smoke.is-on { opacity: .9; }
  .stg:has(.stg-smoke.is-on) .stg-fog { opacity: .35; }
  .stg::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 120px; background: linear-gradient(transparent, var(--bg)); }

  /* Είσοδος όπως στην αρχική: ανάδυση με ξεθόλωμα */
  .blur-in {
    opacity: 0; filter: blur(12px); transform: translateY(12px);
    animation: phIn 1.1s cubic-bezier(.2, .8, .25, 1) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes phIn { to { opacity: 1; filter: blur(0); transform: none; } }

  /* Οθόνες αφής: (α) η CSS ομίχλη χωρίς filter: blur και χωρίς κίνηση — ένα blur(60px) σε στοιχείο 70vw που
     κινείται συνεχώς είναι από τα ακριβότερα πράγματα για GPU κινητού· (β) οι είσοδοι χωρίς blur
     (το blur animation τρέχει στο main thread). Το ξεθώριασμα/ανάδυση μένει. */
  @media (pointer: coarse) {
    .stg-fog { filter: none; animation: none; }
    .stg-fog--1 { background: radial-gradient(closest-side, rgba(255, 255, 255, .11), transparent); }
    .stg-fog--2 { background: radial-gradient(closest-side, rgba(255, 255, 255, .08), transparent); }
    .blur-in { filter: none; animation-name: phInLite; }
    @keyframes phInLite { to { opacity: 1; transform: none; } }
  }
  @media (max-width: 680px) {
    .hero { padding-top: calc(40px + 72px); padding-bottom: 40px; min-height: 0; }
    .hero h1 { font-size: clamp(1.75rem, 8vw, 2.3rem); }
    .hero .sub { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blur-in { animation: none; opacity: 1; filter: none; transform: none; }
  }
</style>
