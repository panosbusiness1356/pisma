---
/*
  Οι τρεις κάμερες (ίδια αρχεία με το Gear.astro) αγκυρωμένες σε σταθερά σημεία
  της σελίδας Φωτογράφηση & Βίντεο, κυλούν μαζί της. Nikon αριστερά στο hero,
  DJI δεξιά στο «Τι κερδίζετε», Canon αριστερά στο «Τι τραβάμε» (θέσεις που
  έδειξε η χρήστρια με κύκλους, 11/09/2026), μέσα στα πλαϊνά περιθώρια έξω από το
  container των 1120px, ώστε να μην πέφτουν ποτέ πάνω σε κείμενο. Πολύ ήπια
  αιώρηση επί τόπου. Η Canon «ρίχνει φλας» όταν περνά ο δείκτης από πάνω της.
  Η Nikon ρίχνει φλας μόνη της μία φορά στο άνοιγμα της σελίδας, διπλό «ποπ»
  όπως μια DSLR (προ-φλας και κύριο), μόλις εμφανιστεί (χρήστρια 11/09/2026:
  «βάλε η Nikon να κάνει φλας όταν ανοίγεις τη σελίδα»). Το ίδιο και η Canon,
  την πρώτη φορά που μπαίνει στην οθόνη με το scroll (χρήστρια 11/09/2026:
  «κάνε το και στην g7x»), και συνεχίζει να φλασάρει με τον δείκτη.
  Αίτημα χρήστριας 11/09/2026: «βάλε τα να είναι σταθερά κάπου μέσα στη σελίδα,
  η μία κάμερα να κάνει κάτι σαν φλας όταν περνάς από μπροστά της, χώρισέ τες
  καλά μέσα στη σελίδα, μην κάνεις λάθη».

  Κανόνες:
  - Στρώμα position:absolute μέσα στο <main> (που είναι position:relative),
    ύψος όσο η σελίδα, pointer-events none (μόνο η Canon πιάνει τον δείκτη).
  - Εμφανίζεται μόνο όταν υπάρχει πραγματικό περιθώριο (≥ 1340px πλάτος).
  - Tablet (641 έως 1339px, iPad): δεν υπάρχει πλαϊνό περιθώριο, οπότε οι τρεις
    κάμερες κάθονται δεξιά από τον τίτλο της ενότητάς τους (anchorM), στο κενό
    που αφήνει η επικεφαλίδα (max-width 680px, αριστερή στοίχιση). Το JS μετρά το
    πραγματικό πλάτος του κειμένου του τίτλου και μικραίνει ή κρύβει την κάμερα
    αν δεν χωρά (χρήστρια 11/09/2026: «οι κάμερες μέσα στη σελίδα όταν ανοίγω
    το iPad δεν φαίνονται»).
  - Μόνο transform/opacity/filter σε μικρά στοιχεία. Καμία επίδραση στο layout.
  - Με prefers-reduced-motion: ακίνητες, χωρίς φλας.
*/
// Σειρά από πάνω προς τα κάτω (χρήστρια 11/09/2026, με κύκλους σε screenshot):
// Nikon αριστερά στο hero, DJI δεξιά στο «Τι κερδίζετε», Canon αριστερά στο «Τι τραβάμε».
// anchor = η ενότητα, frac = σε ποιο ύψος της ενότητας κάθεται το κέντρο της κάμερας.
const items = [
  { file: 'nikon-d750.webp', w: 619, h: 496, key: 'd750', flash: true, auto: true, anchor: 'section.hero', frac: 0.56, anchorM: '#why-title', fracM: 0.5, wt: 150 },
  { file: 'dji-osmo-pocket-4.webp', w: 335, h: 900, key: 'pocket', flash: false, auto: false, anchor: '[aria-labelledby="why-title"]', frac: 0.58, anchorM: '#shoot-title', fracM: 0.5, wt: 62 },
  { file: 'canon-g7x-mark-iii.webp', w: 1190, h: 700, key: 'g7x', flash: true, auto: true, anchor: '[aria-labelledby="shoot-title"]', frac: 0.42, anchorM: '#faq-title', fracM: 0.5, wt: 150 },
];
---

<div class="gear-sky" aria-hidden="true" data-gear-sky>
  {items.map((i) => (
    <span class={`sky sky--${i.key}`} data-flash={i.flash ? '' : undefined} data-auto={i.auto ? '' : undefined} data-anchor={i.anchor} data-frac={i.frac} data-anchor-m={i.anchorM} data-frac-m={i.fracM} data-wt={i.wt}>
      <img src={`/gear/${i.file}`} alt="" width={i.w} height={i.h} loading="lazy" decoding="async" />
      {i.flash && <span class="flash"></span>}
    </span>
  ))}
</div>

<script>
  const sky = document.querySelector<HTMLElement>('[data-gear-sky]');
  if (sky) {
    // Αγκύρωση: κάθε κάμερα κάθεται στο ύψος της ενότητάς της (offsetTop ως προς το <main>,
    // ίδιο σύστημα συντεταγμένων με το στρώμα). Ξανατρέχει σε resize και όταν φορτώσουν οι εικόνες.
    const cams = [...sky.querySelectorAll<HTMLElement>('.sky')];
    const mainEl = sky.parentElement as HTMLElement; // το <main>, position: relative
    const place = () => {
      // Κινητό (≤ 640px) και tablet (641 έως 1339px): άλλη άγκυρα (ο τίτλος της ενότητας), βλ. anchorM/fracM.
      const mobile = matchMedia('(max-width: 640px)').matches;
      const tablet = !mobile && matchMedia('(max-width: 1339px)').matches;
      const mainRect = mainEl.getBoundingClientRect();
      const mainTop = mainRect.top;
      for (const cam of cams) {
        const sel = ((mobile || tablet) && cam.dataset.anchorM) || cam.dataset.anchor || '';
        const sec = document.querySelector<HTMLElement>(sel);
        if (!sec) continue;
        const frac = Number(((mobile || tablet) && cam.dataset.fracM) || cam.dataset.frac || 0.5);
        const r = sec.getBoundingClientRect();
        const h0 = () => cam.getBoundingClientRect().height || cam.offsetHeight;
        let top = 0;
        if (tablet) {
          // Δεξιά από το κείμενο του τίτλου: μετράμε το μελάνι (Range), όχι το block που πιάνει όλο το πλάτος.
          const rng = document.createRange();
          rng.selectNodeContents(sec);
          const txt = rng.getBoundingClientRect();
          const gap = mainRect.right - txt.right; // ελεύθερος χώρος δεξιά από τον τίτλο
          const img = cam.querySelector('img') as HTMLImageElement;
          const ratio = Number(img.getAttribute('height')) / Number(img.getAttribute('width'));
          // Κέντρο στο μπλοκ ετικέτα+τίτλος (.sec-head), και όχι ψηλότερη από αυτό συν λίγο,
          // ώστε να μην πέφτει στις κάρτες από κάτω (η DJI είναι ψηλή και στενή).
          const head = (sec.closest('.sec-head') || sec).getBoundingClientRect();
          const blockH = r.bottom - head.top;
          let w = Math.min(Number(cam.dataset.wt || 140), gap - 56, (blockH + 40) / ratio);
          if (w < 40) { cam.style.visibility = 'hidden'; continue; }
          cam.style.visibility = '';
          cam.style.width = `${Math.round(w)}px`;
          cam.style.right = `${Math.round(Math.max(20, (gap - w) / 2))}px`;
          cam.style.left = 'auto';
          const h = w * ratio;
          top = (head.top + r.bottom) / 2 - mainTop - h / 2;
          // ποτέ κάτω από τον τίτλο (12px απόσταση, καλύπτει και την κλίση της κάμερας)
          top = Math.min(top, r.bottom - mainTop - h - 12);
        } else {
          cam.style.visibility = ''; cam.style.width = ''; cam.style.right = ''; cam.style.left = '';
          top = r.top - mainTop + r.height * frac - h0() / 2;
        }
        cam.style.top = `${Math.round(top)}px`;
      }
    };
    place();
    for (const img of sky.querySelectorAll('img')) img.addEventListener('load', place, { once: true });
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = setTimeout(place, 120); });
    if ('fonts' in document) (document as any).fonts.ready.then(place);

    // Ήπια είσοδος αφού «κάτσει» η σελίδα (μετά το page-in του <main>).
    setTimeout(() => { place(); sky.classList.add('is-on'); }, 900);

    // Φλας: μία έκλαμψη (0,65 s) και μικρή «νεκρή» περίοδος ώστε να μην ξαναρχίσει
    // πριν τελειώσει. Canon: και όταν ο δείκτης περάσει από πάνω της. Αυτόματο
    // (data-auto, Nikon και Canon): διπλό ποπ (προ-φλας + κύριο), μία φορά, την
    // πρώτη φορά που η κάμερα είναι στην οθόνη: η Nikon (hero) 1,3 s αφού
    // εμφανιστεί το στρώμα, η Canon 0,35 s αφού μπει στην οθόνη με το scroll.
    // Όχι με reduced motion, ούτε όταν το στρώμα είναι κρυφό (οθόνες < 1340px).
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const fire = (cam: HTMLElement) => {
        if (cam.dataset.busy) return;
        cam.dataset.busy = '1';
        cam.classList.add('is-flashing');
        setTimeout(() => cam.classList.remove('is-flashing'), 650);
        setTimeout(() => { delete cam.dataset.busy; }, 1200);
      };
      for (const cam of sky.querySelectorAll<HTMLElement>('[data-flash]')) {
        cam.addEventListener('pointerenter', () => fire(cam));
        // και με πάτημα/άγγιγμα (χρήστρια 11/09/2026: «η Nikon όταν την πατάς να κάνει φλας»)
        cam.addEventListener('pointerdown', () => fire(cam));
      }
      const shown = () => getComputedStyle(sky).display !== 'none' && !document.hidden;
      const pop = (cam: HTMLElement) => {
        if (!shown() || cam.dataset.popped) return;
        cam.dataset.popped = '1';
        cam.classList.add('is-flashing');
        setTimeout(() => cam.classList.remove('is-flashing'), 260);
        setTimeout(() => fire(cam), 300);
      };
      const tOn = performance.now() + 900; // πότε εμφανίζεται το στρώμα (is-on)
      const autos = [...sky.querySelectorAll<HTMLElement>('[data-auto]')];
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => {
          for (const e of es) {
            if (!e.isIntersecting || e.intersectionRatio < .5) continue;
            const cam = e.target as HTMLElement;
            io.unobserve(cam);
            const wait = Math.max(350, tOn + 1300 - performance.now());
            setTimeout(() => pop(cam), wait);
          }
        }, { threshold: [.5] });
        autos.forEach((cam) => io.observe(cam));
      } else {
        autos.forEach((cam) => setTimeout(() => pop(cam), 900 + 1300));
      }
    }
  }
</script>

<style>
  .gear-sky {
    --g: calc((100vw - 1120px) / 2); /* πλάτος κάθε πλαϊνού περιθωρίου */
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    z-index: 2; pointer-events: none; overflow: hidden;
    display: none;
    opacity: 0; transition: opacity 1.4s ease;
  }
  .gear-sky.is-on { opacity: 1; }
  @media (min-width: 1340px) {
    .gear-sky { display: block; }
  }
  /* Tablet (iPad, 641 έως 1339px): ορατό, οι κάμερες δεξιά από τον τίτλο κάθε ενότητας.
     Πλάτος/right τα ορίζει το JS (μετρά το κείμενο του τίτλου)· εδώ μόνο τα fallback. */
  @media (min-width: 641px) and (max-width: 1339px) {
    .gear-sky { display: block; }
    .sky--d750 { left: auto; right: 24px; width: 150px; }
    .sky--pocket { left: auto; right: 40px; width: 62px; }
    .sky--g7x { left: auto; right: 24px; width: 150px; }
  }
  .sky {
    position: absolute; display: block;
    will-change: transform;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .sky img { display: block; width: 100%; height: auto; }

  /* Θέσεις: Nikon αριστερά (hero), DJI δεξιά («Τι κερδίζετε»), Canon αριστερά («Τι τραβάμε»).
     Το ύψος (top) το ορίζει το JS πάνω στην ενότητα· εδώ μόνο fallback. Καθεμιά στο κέντρο του περιθωρίου της. */
  .sky--d750 {
    width: min(240px, calc(var(--g) * .8));
    left: calc(var(--g) / 2 - min(240px, calc(var(--g) * .8)) / 2);
    top: 3%;
    animation-name: skyD750; animation-duration: 10s;
    pointer-events: auto; cursor: pointer; /* φλας με hover ή πάτημα */
  }
  .sky--pocket {
    width: min(104px, calc(var(--g) * .5));
    right: calc(var(--g) / 2 - min(104px, calc(var(--g) * .5)) / 2);
    top: 14%;
    animation-name: skyPocket; animation-duration: 9s;
  }
  .sky--g7x {
    width: min(240px, calc(var(--g) * .8));
    left: calc(var(--g) / 2 - min(240px, calc(var(--g) * .8)) / 2);
    top: 28%;
    animation-name: skyG7x; animation-duration: 11s;
    pointer-events: auto; cursor: pointer;
  }
  /* Ήπια αιώρηση επί τόπου, με τη βασική κλίση της καθεμιάς */
  @keyframes skyPocket {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(12deg); }
    50%      { transform: translate3d(-4px, -12px, 0) rotate(9deg); }
  }
  @keyframes skyG7x {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-8deg); }
    50%      { transform: translate3d(5px, -14px, 0) rotate(-11deg); }
  }
  @keyframes skyD750 {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-7deg); }
    50%      { transform: translate3d(5px, -12px, 0) rotate(-4deg); }
  }

  /* Φλας: λευκή έκλαμψη από τη θέση του φλας κάθε κάμερας (Canon πάνω αριστερά,
     Nikon το ενσωματωμένο φλας πάνω από την πρίσμα, στο κέντρο) + στιγμιαίο φώτισμα του σώματος */
  .flash {
    position: absolute; left: 24%; top: 10%;
    width: 44px; height: 44px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, rgba(255, 255, 255, .95) 22%, rgba(255, 255, 255, .35) 48%, rgba(255, 255, 255, 0) 72%);
    transform: translate(-50%, -50%) scale(.2);
    opacity: 0; pointer-events: none;
  }
  .sky--d750 .flash { left: 58%; top: 5%; width: 60px; height: 60px; }
  .is-flashing .flash { animation: skyFlash .6s ease-out; }
  .is-flashing img { animation: skyFlashBody .5s ease-out; }
  @keyframes skyFlash {
    0%   { opacity: 0; transform: translate(-50%, -50%) scale(.2); }
    8%   { opacity: 1; transform: translate(-50%, -50%) scale(1.4); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(5); }
  }
  @keyframes skyFlashBody {
    0%   { filter: brightness(1); }
    10%  { filter: brightness(2.4) contrast(1.1); }
    100% { filter: brightness(1); }
  }

  /* Κινητό: μικρές, ακίνητες (με την κλίση τους), δεξιά από τον σύντομο τίτλο κάθε ενότητας
     (χρήστρια 11/09/2026: «στα κενά της σελίδας, μικρές, όπως στον υπολογιστή αλλά σταθερές») */
  @media (max-width: 640px) {
    .gear-sky { display: block; }
    .sky { animation: none; }
    /* Εναλλάξ: Nikon αριστερά, DJI δεξιά, Canon αριστερά (χρήστρια 11/09/2026). Ο τίτλος της
       ενότητας πάει στην απέναντι πλευρά (CSS της σελίδας), ώστε να μην ακουμπούν. */
    .sky--d750 { left: 12px; right: auto; width: 96px; transform: rotate(7deg); }
    .sky--pocket { left: auto; right: 22px; width: 42px; transform: rotate(10deg); }
    .sky--g7x { left: 12px; right: auto; width: 88px; transform: rotate(8deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky, .flash, .is-flashing img { animation: none; }
    .sky--pocket { transform: rotate(12deg); }
    .sky--g7x { transform: rotate(-8deg); }
    .sky--d750 { transform: rotate(-7deg); }
    .gear-sky { transition: none; }
  }
</style>
