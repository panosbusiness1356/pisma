---
/*
  Οι τρεις κάμερες (ίδια αρχεία με το Gear.astro) αγκυρωμένες σε σταθερά σημεία
  της σελίδας Φωτογράφηση & Βίντεο, κυλούν μαζί της. Nikon αριστερά στο hero,
  DJI δεξιά στο «Τι κερδίζετε», Canon αριστερά στο «Τι τραβάμε» (θέσεις που
  έδειξε η χρήστρια με κύκλους, 11/09/2026), μέσα στα πλαϊνά περιθώρια έξω από το
  container των 1120px, ώστε να μην πέφτουν ποτέ πάνω σε κείμενο. Πολύ ήπια
  αιώρηση επί τόπου. Η Canon «ρίχνει φλας» όταν περνά ο δείκτης από πάνω της.
  Αίτημα χρήστριας 11/09/2026: «βάλε τα να είναι σταθερά κάπου μέσα στη σελίδα,
  η μία κάμερα να κάνει κάτι σαν φλας όταν περνάς από μπροστά της, χώρισέ τες
  καλά μέσα στη σελίδα, μην κάνεις λάθη».

  Κανόνες:
  - Στρώμα position:absolute μέσα στο <main> (που είναι position:relative),
    ύψος όσο η σελίδα, pointer-events none (μόνο η Canon πιάνει τον δείκτη).
  - Εμφανίζεται μόνο όταν υπάρχει πραγματικό περιθώριο (≥ 1340px πλάτος).
  - Μόνο transform/opacity/filter σε μικρά στοιχεία. Καμία επίδραση στο layout.
  - Με prefers-reduced-motion: ακίνητες, χωρίς φλας.
*/
// Σειρά από πάνω προς τα κάτω (χρήστρια 11/09/2026, με κύκλους σε screenshot):
// Nikon αριστερά στο hero, DJI δεξιά στο «Τι κερδίζετε», Canon αριστερά στο «Τι τραβάμε».
// anchor = η ενότητα, frac = σε ποιο ύψος της ενότητας κάθεται το κέντρο της κάμερας.
const items = [
  { file: 'nikon-d750.webp', w: 619, h: 496, key: 'd750', flash: false, anchor: 'section.hero', frac: 0.56 },
  { file: 'dji-osmo-pocket-4.webp', w: 335, h: 900, key: 'pocket', flash: false, anchor: '[aria-labelledby="why-title"]', frac: 0.58 },
  { file: 'canon-g7x-mark-iii.webp', w: 1190, h: 700, key: 'g7x', flash: true, anchor: '[aria-labelledby="shoot-title"]', frac: 0.42 },
];
---

<div class="gear-sky" aria-hidden="true" data-gear-sky>
  {items.map((i) => (
    <span class={`sky sky--${i.key}`} data-flash={i.flash ? '' : undefined} data-anchor={i.anchor} data-frac={i.frac}>
      <img src={`/gear/${i.file}`} alt="" width={i.w} height={i.h} loading="lazy" decoding="async" />
      {i.flash && <span class="flash"></span>}
    </span>
  ))}
</div>

<script>
  const sky = document.querySelector<HTMLElement>('[data-gear-sky]');
  if (sky) {
    // Αγκύρωση: κάθε κάμερα κάθεται στο ύψος της ενότητάς της (offsetTop ως προς το <main>,
    // ίδιο σύστημα συντεταγμένων με το στρώμα). Ξανατρέχει σε resize και όταν φορτώσουν οι εικόνες.
    const cams = [...sky.querySelectorAll<HTMLElement>('.sky')];
    const place = () => {
      for (const cam of cams) {
        const sec = document.querySelector<HTMLElement>(cam.dataset.anchor || '');
        if (!sec) continue;
        const frac = Number(cam.dataset.frac || 0.5);
        const h = cam.getBoundingClientRect().height || cam.offsetHeight;
        cam.style.top = `${Math.round(sec.offsetTop + sec.offsetHeight * frac - h / 2)}px`;
      }
    };
    place();
    for (const img of sky.querySelectorAll('img')) img.addEventListener('load', place, { once: true });
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = setTimeout(place, 120); });
    if ('fonts' in document) (document as any).fonts.ready.then(place);

    // Ήπια είσοδος αφού «κάτσει» η σελίδα (μετά το page-in του <main>).
    setTimeout(() => { place(); sky.classList.add('is-on'); }, 900);

    // Φλας όταν ο δείκτης περάσει πάνω από την κάμερα (όχι με reduced motion).
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      for (const cam of sky.querySelectorAll<HTMLElement>('[data-flash]')) {
        let busy = false;
        cam.addEventListener('pointerenter', () => {
          if (busy) return;
          busy = true;
          cam.classList.add('is-flashing');
          setTimeout(() => cam.classList.remove('is-flashing'), 650);
          setTimeout(() => { busy = false; }, 1200);
        });
      }
    }
  }
</script>

<style>
  .gear-sky {
    --g: calc((100vw - 1120px) / 2); /* πλάτος κάθε πλαϊνού περιθωρίου */
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    z-index: 2; pointer-events: none; overflow: hidden;
    display: none;
    opacity: 0; transition: opacity 1.4s ease;
  }
  .gear-sky.is-on { opacity: 1; }
  @media (min-width: 1340px) {
    .gear-sky { display: block; }
  }
  .sky {
    position: absolute; display: block;
    will-change: transform;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .sky img { display: block; width: 100%; height: auto; }

  /* Θέσεις: Nikon αριστερά (hero), DJI δεξιά («Τι κερδίζετε»), Canon αριστερά («Τι τραβάμε»).
     Το ύψος (top) το ορίζει το JS πάνω στην ενότητα· εδώ μόνο fallback. Καθεμιά στο κέντρο του περιθωρίου της. */
  .sky--d750 {
    width: min(240px, calc(var(--g) * .8));
    left: calc(var(--g) / 2 - min(240px, calc(var(--g) * .8)) / 2);
    top: 3%;
    animation-name: skyD750; animation-duration: 10s;
  }
  .sky--pocket {
    width: min(104px, calc(var(--g) * .5));
    right: calc(var(--g) / 2 - min(104px, calc(var(--g) * .5)) / 2);
    top: 14%;
    animation-name: skyPocket; animation-duration: 9s;
  }
  .sky--g7x {
    width: min(240px, calc(var(--g) * .8));
    left: calc(var(--g) / 2 - min(240px, calc(var(--g) * .8)) / 2);
    top: 28%;
    animation-name: skyG7x; animation-duration: 11s;
    pointer-events: auto; cursor: default;
  }
  /* Ήπια αιώρηση επί τόπου, με τη βασική κλίση της καθεμιάς */
  @keyframes skyPocket {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(12deg); }
    50%      { transform: translate3d(-4px, -12px, 0) rotate(9deg); }
  }
  @keyframes skyG7x {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-8deg); }
    50%      { transform: translate3d(5px, -14px, 0) rotate(-11deg); }
  }
  @keyframes skyD750 {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-7deg); }
    50%      { transform: translate3d(5px, -12px, 0) rotate(-4deg); }
  }

  /* Φλας: λευκή έκλαμψη από τη θέση του φλας της Canon (πάνω αριστερά) + στιγμιαίο φώτισμα του σώματος */
  .flash {
    position: absolute; left: 24%; top: 10%;
    width: 44px; height: 44px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, rgba(255, 255, 255, .95) 22%, rgba(255, 255, 255, .35) 48%, rgba(255, 255, 255, 0) 72%);
    transform: translate(-50%, -50%) scale(.2);
    opacity: 0; pointer-events: none;
  }
  .is-flashing .flash { animation: skyFlash .6s ease-out; }
  .is-flashing img { animation: skyFlashBody .5s ease-out; }
  @keyframes skyFlash {
    0%   { opacity: 0; transform: translate(-50%, -50%) scale(.2); }
    8%   { opacity: 1; transform: translate(-50%, -50%) scale(1.4); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(5); }
  }
  @keyframes skyFlashBody {
    0%   { filter: brightness(1); }
    10%  { filter: brightness(2.4) contrast(1.1); }
    100% { filter: brightness(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky, .flash, .is-flashing img { animation: none; }
    .sky--pocket { transform: rotate(12deg); }
    .sky--g7x { transform: rotate(-8deg); }
    .sky--d750 { transform: rotate(-7deg); }
    .gear-sky { transition: none; }
  }
</style>
