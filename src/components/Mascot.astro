---
/**
 * Ντοτ — η τελεία της PISMA που ζωντάνεψε.
 * Σύννεφο από πορτοκαλί κουκίδες με googly μάτια που ακολουθούν τον κέρσορα.
 * Ξεναγεί τον επισκέπτη: ταξιδεύει από section σε section (data-mascot-stop),
 * αλλάζει πλευρές και δείχνει συννεφάκι με το μήνυμα κάθε στάσης.
 * Οι κουκίδες παράγονται με seeded τυχαιότητα στο build — ίδιο σχήμα σε κάθε build.
 */
const palette = ['#FF7A45', '#FF9159', '#E8481F', '#FFB27A', '#FFD9A8'];
let seed = 7;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
type Dot = { x: number; y: number; r: number; c: string; o: number };
const dots: Dot[] = [];
for (let i = 0; i < 135; i++) {
  const a = rnd() * Math.PI * 2;
  const rr = 78 * Math.pow(rnd(), 0.55);
  dots.push({
    x: +(100 + Math.cos(a) * rr).toFixed(1),
    y: +(100 + Math.sin(a) * rr * 0.98).toFixed(1),
    r: +(rnd() < 0.12 ? 3.4 + rnd() * 1.8 : 1.2 + rnd() * 2.2).toFixed(1),
    c: palette[Math.floor(rnd() * palette.length)],
    o: +(0.45 + rnd() * 0.55).toFixed(2),
  });
}
const half = Math.ceil(dots.length / 2);
const cloudA = dots.slice(0, half);
const cloudB = dots.slice(half);
---

<div id="pisma-mascot" aria-hidden="true">
  <div class="m-motion">
    <div class="m-bob">
      <svg viewBox="0 0 200 200" fill="none">
        <g class="d-spin">
          {cloudA.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.c} opacity={d.o} />)}
        </g>
        <g class="d-spin2">
          {cloudB.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.c} opacity={d.o} />)}
        </g>
        <g class="d-eyes">
          <circle cx="78" cy="95" r="18" fill="#FFF8F0" />
          <circle cx="120" cy="90" r="15" fill="#FFF8F0" />
          <g class="d-pup-l"><circle cx="78" cy="95" r="9" fill="#14101E" /></g>
          <g class="d-pup-r"><circle cx="120" cy="90" r="7.5" fill="#14101E" /></g>
        </g>
        <circle cx="101" cy="117" r="12.5" fill="#E8481F" />
      </svg>
    </div>
  </div>
</div>

<script>
  const el = document.getElementById('pisma-mascot')!;
  const motion = el.querySelector<HTMLElement>('.m-motion')!;
  const pupL = el.querySelector<HTMLElement>('.d-pup-l')!;
  const pupR = el.querySelector<HTMLElement>('.d-pup-r')!;
  const stops = [...document.querySelectorAll<HTMLElement>('[data-mascot-stop]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touchScreen = window.matchMedia('(pointer: coarse)').matches;
  const isMobile = () => window.matchMedia('(max-width: 680px)').matches;

  const W = () => (isMobile() ? 80 : 110);
  const H = () => W();

  /* Σημείο γέννησης: στην αρχική (EL και EN) βγαίνει από την τελεία του logo· κάθε
     άλλη σελίδα τον γεννάει από δικό της, σχετικό σημείο (τιμή, chat, κουκίδα...).
     Αν το σημείο δεν είναι ορατό στο φόρτωμα, πέφτει στον τίτλο της σελίδας. */
  const SPAWNS: Array<[string, string]> = [
    ['/se-vriskoun', '.msg--user'],
    ['/doulevei-mono-tou', '.term-title'],
    ['/times', '.plan-setup'],
    ['/apotelesmata', '.after-num'],
    ['/tablo', '.dot'],
    ['/epikoinonia', '.c-value'],
    ['/elegxos', 'main h1'],
  ];
  const resolveSpawn = (): HTMLElement | null => {
    const path = location.pathname.replace(/\/$/, '') || '/';
    if (path === '/' || path === '/en') return document.querySelector('.logo span');
    const visible = (e: HTMLElement | null) => {
      if (!e) return false;
      const r = e.getBoundingClientRect();
      return r.width > 0 && r.bottom > 90 && r.top < window.innerHeight - 60;
    };
    let el: HTMLElement | null = null;
    for (const [prefix, sel] of SPAWNS) {
      if (path.startsWith(prefix)) { el = document.querySelector(sel); break; }
    }
    if (!visible(el)) el = document.querySelector('main h1');
    if (!visible(el)) el = document.querySelector('.logo span');
    return el;
  };
  const spawnEl = resolveSpawn();

  /* Το ορατό κέντρο του σημείου γέννησης. Για χαρακτήρα όπως η τελεία του logo
     το getBoundingClientRect() δίνει όλο το κουτί γραμμής (line box) — η ορατή
     κουκίδα όμως κάθεται στη γραμμή βάσης, κι έτσι το κέντρο του κουτιού πέφτει
     πιο πάνω/δίπλα ανάλογα με γραμματοσειρά και οθόνη. Μετράμε το πραγματικό
     «μελάνι» του γλυφικού με canvas TextMetrics για σημείο ακριβείας. */
  let inkCtx: CanvasRenderingContext2D | null | undefined; // ένας κοινός context για όλες τις μετρήσεις
  const inkCenter = (e: HTMLElement) => {
    const r = e.getBoundingClientRect();
    const txt = (e.textContent || '').trim();
    if (txt.length === 1 && !e.firstElementChild) {
      try {
        const cs = getComputedStyle(e);
        if (inkCtx === undefined) inkCtx = document.createElement('canvas').getContext('2d');
        const ctx = inkCtx;
        if (ctx) {
          ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
          const m = ctx.measureText(txt);
          if (m.fontBoundingBoxDescent !== undefined) {
            const baseline = r.bottom - m.fontBoundingBoxDescent;
            return {
              x: r.left + (m.actualBoundingBoxRight - m.actualBoundingBoxLeft) / 2,
              y: baseline + (m.actualBoundingBoxDescent - m.actualBoundingBoxAscent) / 2,
            };
          }
        }
      } catch { /* πέφτουμε στο κέντρο του rect */ }
    }
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  };

  /* Ο μικρός Ντοτ συρρικνώνεται γύρω από το transform-origin του .m-motion
     (50% 60%) — άρα εκεί πρέπει να κάτσει το σημείο γέννησης, όχι στο 50% 50%. */
  const ORIGIN_Y = 0.6;
  const spawnPos = () => {
    const p = inkCenter(spawnEl!);
    return { x: p.x - W() / 2, y: p.y - H() * ORIGIN_Y };
  };

  let px = window.innerWidth - W() - 20;
  let py = window.innerHeight - H() - 24;
  let dotPos: { x: number; y: number } | null = null;
  if (spawnEl) {
    dotPos = spawnPos();
    px = dotPos.x;
    py = dotPos.y;
  }
  /* Η γέννηση ξεκινά 600 ms αφότου «φανεί» η σελίδα (ορίζεται στο start() πιο κάτω):
     χωρίς intro = 600 ms μετά το φόρτωμα, με intro = 600 ms μετά το τέλος του πέπλου.
     Μέχρι τότε (Infinity) ο Ντοτ μένει καρφωμένος, μικρός, στο σημείο γέννησης. */
  const birth = { start: Infinity, dur: 900 };
  let scale = dotPos ? 0.08 : 1;
  let pulsed = false;

  /* Χορογραφία εισόδου: πετάει ως το «μόνο του» και ζωγραφίζει την υπογράμμιση
     σαν μαρκαδόρο, συγχρονισμένη με τη θέση του — μετά ξεκινά η ξενάγηση. */
  const hlSpan = document.querySelector<HTMLElement>('.hero-hl');
  const hlPath = document.querySelector<SVGPathElement>('.hl-stroke path');
  const hlLen = hlPath?.style.strokeDasharray ? parseFloat(hlPath.style.strokeDasharray) : 0;
  let phase: 'approach' | 'draw' | 'tour' = hlSpan && hlPath && hlLen > 0 && !reduce ? 'approach' : 'tour';
  const finishStroke = () => {
    if (hlPath) hlPath.style.strokeDashoffset = '0';
  };

  let rot = 0;
  let lastY = window.scrollY;
  let activeIdx = -2;
  let lastSide = 'right';
  let arrivedAt = 0;
  let bubbleOn = false;
  let greeted = false;
  let spokenIdx = -99;
  let mouseX = -1;
  let mouseY = -1;
  let eyeX = 0;
  let eyeY = 0;
  let lastEye = '';
  let lastPos = '';
  let lastMot = '';

  el.style.width = W() + 'px';

  /* Στις φαρδιές οθόνες κάθεται στο «λούκι» δίπλα στο περιεχόμενο· αλλιώς
     δεν χωράει δίπλα στο κείμενο, οπότε μένει χαμηλά στη γωνία της πλευράς του. */
  const gutter = () => (window.innerWidth - 1160) / 2 - W() - 8;
  const hasGutter = () => gutter() >= 14;
  const sideX = (side: string) => {
    const m = hasGutter() ? gutter() : 14;
    return side === 'left' ? m : window.innerWidth - W() - m;
  };

  const targetPos = () => {
    if (!stops.length) {
      return { x: window.innerWidth - W() - 20, y: window.innerHeight - H() - 24, idx: -1, side: 'right' };
    }
    const mid = window.innerHeight * 0.5;
    let idx = 0;
    let best = Infinity;
    stops.forEach((s, i) => {
      const r = s.getBoundingClientRect();
      const inView = r.top <= mid && r.bottom >= mid;
      const d = inView ? 0 : Math.min(Math.abs(r.top - mid), Math.abs(r.bottom - mid));
      if (d < best) { best = d; idx = i; }
    });
    const s = stops[idx];
    const r = s.getBoundingClientRect();
    const side = s.dataset.mascotSide || (idx % 2 ? 'left' : 'right');
    if (s.dataset.mascotPose === 'sit') {
      return { x: r.right - W() - r.width * 0.05, y: r.top - H() * 0.62, idx, side };
    }
    /* Στάση δίπλα σε συγκεκριμένο στοιχείο (π.χ. δίπλα στον τίτλο του hero). */
    const anchorSel = s.dataset.mascotAnchor;
    if (anchorSel) {
      const a = document.querySelector(anchorSel);
      if (a) {
        const ar = a.getBoundingClientRect();
        const x = side === 'left' ? ar.left - W() - 26 : ar.right + 26;
        const fits = x >= 8 && x + W() <= window.innerWidth - 8;
        if (fits) {
          const ay = Math.min(
            Math.max(ar.top + ar.height * 0.5 - H() * 0.5, 100),
            window.innerHeight - H() - 40
          );
          return { x, y: ay, idx, side };
        }
      }
    }
    const y = hasGutter()
      ? Math.min(Math.max(r.top + r.height * 0.3, 250), window.innerHeight - H() - 60)
      : window.innerHeight - H() - 28;
    return { x: sideX(side), y, idx, side };
  };

  /* Συννεφάκι: αφαιρέθηκε — αποσπούσε την προσοχή και έπαιρνε χώρο.
     Ο Ντοτ απλώς πηγαίνει στα σημεία που θέλουν προσοχή. Οι συναρτήσεις
     μένουν ως no-ops ώστε η χορογραφία να μείνει ανέπαφη. */
  const showBubble = (_msg: string | undefined, _side: string) => {};
  const hideBubble = () => {};

  const GREETING = '';

  window.addEventListener('pointermove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  }, { passive: true });

  /* Έναρξη: 600 ms μετά, η τελεία του logo πάλλεται και ο Ντοτ ξεπετάγεται από μέσα της. */
  const start = () => {
    birth.start = performance.now() + 600;
    if (reduce) {
      el.style.transform = `translate(${px}px, ${py}px)`;
      el.classList.add('is-ready');
    } else {
      /* Η κίνηση κανονικοποιείται στον πραγματικό χρόνο κάθε καρέ (delta time),
         αλλιώς σε οθόνες 120/144Hz ο Ντοτ ταξιδεύει 2-3x πιο γρήγορα απ' ό,τι στα 60Hz. */
      let lastT = performance.now();
      /* Οι στάσεις μετρώνται (getBoundingClientRect) μόνο όταν αλλάξει scroll/viewport
         ή κάθε 250ms — όχι σε κάθε καρέ, που έκανε layout thrash σε κινητά. */
      let tCache: ReturnType<typeof targetPos> | null = null;
      let tKey = '';
      let tAt = 0;
      /* Το scrollY/μέγεθος από listeners, ΟΧΙ ανάγνωση σε κάθε καρέ: μετά από γράψιμο στα μάτια (SVG) το layout
         είναι «βρώμικο» και το window.scrollY το ανάγκαζε σε κάθε καρέ (forced layout). */
      let sY = window.scrollY, vW = window.innerWidth, vH = window.innerHeight;
      window.addEventListener('scroll', () => { sY = window.scrollY; }, { passive: true });
      window.addEventListener('resize', () => { vW = window.innerWidth; vH = window.innerHeight; }, { passive: true });
      const targetCached = (nowT: number) => {
        const key = `${sY}|${vW}|${vH}`;
        if (tCache && key === tKey && nowT - tAt < 250) return tCache;
        tCache = targetPos(); tKey = key; tAt = nowT;
        return tCache;
      };
      /* Ύπνος: όταν ο Ντοτ ηρεμήσει (θέση, μάτια, κλίση σταθερά — ούτε γέννηση ούτε είσοδος),
         ο βρόχος σταματά· ξυπνά με scroll/resize/pointer ή όταν αλλάξει το layout της σελίδας.
         Πριν έτρεχε 60 φορές το δευτερόλεπτο για πάντα, ακόμη και κρυμμένος. */
      let idleFrames = 0;
      let running = false;
      let hlRect: DOMRect | null = null;
      let hlRectAt = 0;
      let spawnAt = 0;
      let prevEyeX = 0, prevEyeY = 0, prevRot = 0;
      const loop = (nowT: number) => {
        /* Software rendering (html.gpu-soft, το βάζει το smoke.ts): κάθε καρέ κίνησης κοστίζει ~100 ms
           στο main thread — ο Ντοτ παρκάρει στη στάση του και σταματά ο βρόχος (ξυπνά ξανά μόνο από scroll).
           Η υπογράμμιση εμφανίζεται ολόκληρη αμέσως — δεν θα τη ζωγραφίσει ο Ντοτ. */
        if (document.documentElement.classList.contains('gpu-soft')) {
          phase = 'tour';
          finishStroke();
          const tp = targetPos();
          el.style.transform = `translate(${tp.x.toFixed(1)}px, ${tp.y.toFixed(1)}px)`;
          motion.style.transform = '';
          running = false;
          return;
        }
        const f = Math.min(3, (nowT - lastT) / 16.667);
        lastT = nowT;
        const smooth = (k: number) => 1 - Math.pow(1 - k, f);
        let t = targetCached(nowT);

        /* Φάσεις εισόδου: πάνω από το «μόνο του», τραβώντας τη γραμμή. */
        if (phase !== 'tour') {
          if (!hlSpan || window.scrollY > 80) {
            phase = 'tour';
            finishStroke();
          } else {
            /* Το rect του τίτλου το πολύ κάθε 100 ms (όχι κάθε καρέ: forced layout πάνω σε κινούμενη σελίδα). */
            if (!hlRect || nowT - hlRectAt > 100) { hlRect = hlSpan.getBoundingClientRect(); hlRectAt = nowT; }
            const sr = hlRect;
            const yLine = sr.bottom - H() * 0.35;
            if (phase === 'approach') {
              t = { x: sr.left - W() * 0.55, y: yLine, idx: -2, side: 'right' };
              if (Math.hypot(t.x - px, t.y - py) < 24) phase = 'draw';
            }
            if (phase === 'draw') {
              t = { x: sr.right - W() * 0.4, y: yLine, idx: -2, side: 'right' };
              const p = Math.min(1, Math.max(0, (px + W() / 2 - sr.left) / sr.width));
              hlPath!.style.strokeDashoffset = String(hlLen * (1 - p));
              if (p >= 0.97) {
                phase = 'tour';
                finishStroke();
              }
            }
          }
        }

        lastSide = t.side;
        if (t.idx !== activeIdx) {
          activeIdx = t.idx;
          arrivedAt = 0;
          if (bubbleOn) hideBubble();
        }

        /* Φάση γέννησης: καρφωμένος στην τελεία του logo, φουσκώνει με spring. */
        const now = performance.now();
        const birthing = dotPos && now < birth.start + birth.dur;
        if (birthing) {
          /* Ξαναμετράμε (κάθε 100 ms — όχι κάθε καρέ): αν φορτώσει αργά η γραμματοσειρά ή κουνηθεί
             το layout, ο Ντοτ μένει καρφωμένος πάνω στην κουκίδα. */
          if (nowT - spawnAt > 100) { dotPos = spawnPos(); spawnAt = nowT; }
          px = dotPos.x;
          py = dotPos.y;
          if (now >= birth.start) {
            if (!pulsed) {
              pulsed = true;
              try {
                /* Μικρά στοιχεία (τελεία) πάλλονται έντονα, μεγάλα πιο διακριτικά. */
                const sw = spawnEl!.getBoundingClientRect().width;
                const k = sw < 40 ? 2.2 : sw < 140 ? 1.35 : 1.12;
                if (getComputedStyle(spawnEl!).display === 'inline') spawnEl!.style.display = 'inline-block';
                /* Ο παλμός μόνο σε μικρά στοιχεία: στον h1 (εσωτερικές σελίδες) μια δεύτερη transform-animation πάνω
                   στην είσοδό του τον έβγαζε από τον compositor («incompatible animations») — και σε 12 % δεν φαινόταν. */
                if (sw < 140) spawnEl!.animate(
                  [{ transform: 'scale(1)' }, { transform: `scale(${k})` }, { transform: 'scale(1)' }],
                  { duration: 550, easing: 'ease-out' }
                );
              } catch { /* χωρίς παλμό */ }
            }
            const t01 = Math.min(1, (now - birth.start) / birth.dur);
            const c1 = 1.70158;
            const eased = 1 + (c1 + 1) * Math.pow(t01 - 1, 3) + c1 * Math.pow(t01 - 1, 2);
            scale = 0.08 + 0.92 * eased;
          }
        } else {
          scale = 1;
        }

        const dx = t.x - px;
        const dy = t.y - py;
        if (!birthing) {
          const k = smooth(phase === 'tour' ? 0.032 : 0.045);
          px += dx * k;
          py += dy * k;
        }
        const dist = Math.hypot(dx, dy);

        const y = window.scrollY;
        const vel = y - lastY;
        lastY = y;
        const lean = Math.max(-10, Math.min(10, dx * 0.028 + (vel / f) * 0.25));
        rot += (lean - rot) * smooth(0.06);

        /* Τα μάτια κοιτούν τον κέρσορα — ή προς τα εκεί που ταξιδεύει. */
        const cx = px + W() / 2;
        const cy = py + H() / 2;
        let tx = 0;
        let ty = 0;
        if (mouseX >= 0) {
          tx = mouseX - cx;
          ty = mouseY - cy;
        } else if (dist > 24) {
          tx = dx;
          ty = dy;
        }
        const len = Math.hypot(tx, ty) || 1;
        const max = 7;
        const k = Math.min(1, len / 160);
        const ek = smooth(0.14);
        eyeX += ((tx / len) * max * k - eyeX) * ek;
        eyeY += ((ty / len) * max * k - eyeY) * ek;
        /* Γράψιμο στο DOM ΜΟΝΟ όταν αλλάζει η τιμή: κάθε αλλαγή στα μάτια/κλίση ξαναζωγραφίζει
           το SVG των 135 κύκλων — όταν ο Ντοτ κάθεται ακίνητος, το καρέ δεν κοστίζει τίποτα. */
        const q = (v: number, step: number) => (Math.round(v / step) * step).toFixed(2); // κβάντιση: αόρατη, 10× λιγότερα repaints
      const qEye = touchScreen ? 1 : .25, qRot = touchScreen ? .5 : .1; // οθόνες αφής: χωρίς ποντίκι, πιο χοντρά βήματα = λιγότερα SVG layouts
        const posStr = `translate(${px.toFixed(1)}px, ${py.toFixed(1)}px)`;
        if (posStr !== lastPos) { lastPos = posStr; el.style.transform = posStr; }
        /* Τα μάτια και η κλίση αλλάζουν το ίδιο το SVG (repaint των 135 κύκλων) — μόνο
           όταν η αλλαγή περνά το κατώφλι (0,25 px / 0,1°). */
        const eyeStr = `translate(${q(eyeX, qEye)}px, ${q(eyeY, qEye)}px)`;
        if (eyeStr !== lastEye) {
          lastEye = eyeStr;
          pupL.style.transform = eyeStr;
          pupR.style.transform = `translate(${q(eyeX * 0.85, qEye)}px, ${q(eyeY * 0.85, qEye)}px)`;
        }
        const motStr = `rotate(${q(rot, qRot)}deg) scale(${scale.toFixed(3)})`;
        if (motStr !== lastMot) { lastMot = motStr; motion.style.transform = motStr; }

        if (dist < 40 && phase === 'tour') {
          if (!arrivedAt) arrivedAt = performance.now();
          else if (!bubbleOn && spokenIdx !== activeIdx && performance.now() - arrivedAt > 350) {
            spokenIdx = activeIdx;
            if (activeIdx >= 0) {
              showBubble(stops[activeIdx].dataset.mascotSay, t.side);
            } else if (!greeted) {
              greeted = true;
              showBubble(GREETING, 'right');
            }
          }
        } else if (dist > 130 && bubbleOn) {
          hideBubble();
        }

        const busy = !!birthing || phase !== 'tour' || dist > 0.5 ||
          Math.abs(eyeX - prevEyeX) > 0.01 || Math.abs(eyeY - prevEyeY) > 0.01 || Math.abs(rot - prevRot) > 0.01;
        prevEyeX = eyeX; prevEyeY = eyeY; prevRot = rot;
        idleFrames = busy ? 0 : idleFrames + 1;
        if (idleFrames < 20) requestAnimationFrame(loop);
        else running = false;
      };
      const wake = () => {
        if (running) return;
        running = true; idleFrames = 0; lastT = performance.now();
        requestAnimationFrame(loop);
      };
      wake();
      requestAnimationFrame(() => el.classList.add('is-ready'));
      for (const ev of ['scroll', 'resize', 'pointermove', 'pointerdown', 'touchstart'] as const) window.addEventListener(ev, wake, { passive: true });
      if ('ResizeObserver' in window) new ResizeObserver(wake).observe(document.body);
    }
  };

  /* Το intro της αρχικής (Intro.astro) σκεπάζει όλο το site — και το logo — με μαύρο
     πέπλο για ~2,7 s (λιγότερο με skip). Αν γεννιόταν στα 600 ms όπως πριν, ο Ντοτ θα
     ξεπεταγόταν κάτω από το πέπλο και κανείς δεν θα τον έβλεπε. Γι' αυτό περιμένει το
     τέλος του intro (το <html> χάνει το data-intro-run: κανονικό τέλος, skip ή δίχτυ 7 s)
     και γεννιέται 600 ms μετά — ακριβώς όπως γεννιόταν 600 ms μετά το φόρτωμα. Από εκεί
     και πέρα η χορογραφία είναι η ίδια όπως πάντα: υπογράμμιση, στάση δίπλα στον τίτλο, ξενάγηση.
     Χωρίς intro (επόμενες σελίδες, reduced motion, 2η επίσκεψη) ξεκινά αμέσως. */
  const introRunning = () => document.documentElement.hasAttribute('data-intro-run');
  if (!introRunning()) {
    start();
  } else {
    const mo = new MutationObserver(() => {
      if (introRunning()) return;
      mo.disconnect();
      start();
    });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-intro-run'] });
  }

  window.addEventListener('resize', () => {
    el.style.width = W() + 'px';
    // Ξανακλείδωσε τον Ντοτ μέσα στο νέο viewport (π.χ. αλλαγή προσανατολισμού),
    // αλλιώς μένει παρκαρισμένος εκτός οθόνης μέχρι το επόμενο scroll.
    px = Math.min(Math.max(px, 6), Math.max(6, window.innerWidth - W() - 6));
    py = Math.min(Math.max(py, 6), Math.max(6, window.innerHeight - H() - 6));
    if (reduce) el.style.transform = `translate(${px}px, ${py}px)`;
  });

  /* Κλικ: χοροπηδηματάκι + ήχος + ξαναδείχνει το μήνυμα της στάσης. */
  el.addEventListener('pointerdown', () => {
    el.classList.remove('is-boing');
    void el.offsetWidth;
    el.classList.add('is-boing');
    const api = (window as unknown as { pismaSound?: { enabled: boolean; play: (n: string) => void } }).pismaSound;
    if (api?.enabled) api.play('click');
    if (!bubbleOn) {
      if (activeIdx >= 0) showBubble(stops[activeIdx].dataset.mascotSay, lastSide);
      else showBubble(GREETING, 'right');
    }
  });
</script>

<style>
  #pisma-mascot {
    position: fixed; left: 0; top: 0; z-index: 90;
    width: 110px; opacity: 0; cursor: pointer;
    will-change: transform;
    transition: opacity .7s ease;
    /* Μόνο οι ζωγραφισμένες κουκίδες πιάνουν κλικ — οι άδειες γωνίες του
       κουτιού αφήνουν τα taps να περνούν στο περιεχόμενο από κάτω. */
    pointer-events: none;
  }
  /* Η απαλή πορτοκαλί λάμψη κάτω από τον Ντοτ: στατικό gradient, ΟΧΙ filter: drop-shadow —
     το filter ξανα-ραστεροποιούσε και τους 135 κύκλους σε κάθε καρέ (μάτια, κλίση, περιστροφή)
     και ήταν ο κύριος λόγος που «κολλούσε» το κινητό. Ίδια εικόνα, μηδενικό κόστος. */
  #pisma-mascot::before {
    content: ''; position: absolute; left: 6%; top: 18%; width: 88%; height: 88%;
    border-radius: 50%; pointer-events: none; z-index: -1;
    background: radial-gradient(closest-side, rgba(var(--cta-rgb), .26), rgba(var(--cta-rgb), .1) 55%, transparent);
  }
  #pisma-mascot circle { pointer-events: auto; }
  #pisma-mascot.is-ready { opacity: 1; }
  #pisma-mascot svg { overflow: visible; width: 100%; height: auto; }

  .m-motion { transform-origin: 50% 60%; will-change: transform; } /* δικό του layer: η κλίση/κλίμακα δεν ξαναζωγραφίζει το SVG */
  .m-bob { animation: m-bob 4.6s ease-in-out infinite alternate; }
  @keyframes m-bob {
    from { transform: translateY(0) scale(1); }
    to { transform: translateY(5px) scale(1.03); }
  }

  /* Το σύννεφο κουκίδων γυρίζει αργά — δύο στρώσεις, αντίθετες φορές. */
  .d-spin, .d-spin2 {
    transform-box: fill-box;
    transform-origin: center;
  }
  .d-spin { animation: d-spin 75s linear infinite; }
  .d-spin2 { animation: d-spin 110s linear infinite reverse; }
  @keyframes d-spin {
    to { transform: rotate(360deg); }
  }

  .d-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: m-blink 5.4s infinite;
  }
  @keyframes m-blink {
    0%, 93.5%, 100% { transform: scaleY(1); }
    96.5% { transform: scaleY(.08); }
  }

  #pisma-mascot.is-boing svg { animation: m-boing .55s cubic-bezier(.34, 1.56, .64, 1); }
  @keyframes m-boing {
    30% { transform: scale(1.14, .88) translateY(3px); }
    60% { transform: scale(.94, 1.08) translateY(-4px); }
    100% { transform: scale(1) translateY(0); }
  }

  /* Οθόνες αφής: η αργή περιστροφή του σύννεφου (75 s) δεν φαίνεται σε 80 px, αλλά ξαναζωγραφίζει
     το SVG 60 φορές το δευτερόλεπτο — μένουν το λίκνισμα και το βλεφάρισμα. */
  @media (pointer: coarse) {
    .d-spin, .d-spin2 { animation: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .m-bob, .d-spin, .d-spin2, .d-eyes { animation: none; }
  }
  /* Software rendering (χωρίς GPU): καμία κίνηση — δες smoke.ts (html.gpu-soft) */
  :global(html.gpu-soft) .m-bob, :global(html.gpu-soft) .d-spin, :global(html.gpu-soft) .d-spin2, :global(html.gpu-soft) .d-eyes { animation: none; }
  @media print { #pisma-mascot { display: none; } }
</style>
