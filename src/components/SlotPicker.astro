---
/**
 * Επιλογή ώρας μέσα στη φόρμα κράτησης (11/09/2026): πλέγμα με τις επόμενες 6 εργάσιμες
 * (Δευτέρα έως Παρασκευή, όπως λέει η Επικοινωνία) επί Πρωί / Μεσημέρι / Απόγευμα. Έως 3 επιλογές,
 * γράφονται στο κρυφό πεδίο «slots» και φεύγουν με το email της κράτησης. Οι ημέρες υπολογίζονται
 * στον browser (τοπική ώρα του επισκέπτη), χωρίς JS το πλέγμα δεν εμφανίζεται και η φόρμα δουλεύει όπως πριν.
 * Δεν κλείνει ώρα από μόνο του (χωρίς ημερολόγιο), η επιβεβαίωση γίνεται με μήνυμα.
 */
interface Props { lang?: 'el' | 'en' }
const { lang = 'el' } = Astro.props;
const T = {
  el: { legend: 'Πότε σας βολεύει;', hint: 'Έως 3 επιλογές. Επιβεβαιώνουμε την ώρα με μήνυμα.', parts: ['Πρωί', 'Μεσημέρι', 'Απόγευμα'], day: 'Ημέρα', max: 'Έως 3 επιλογές.' },
  en: { legend: 'When suits you?', hint: 'Up to 3 picks. We confirm the time by message.', parts: ['Morning', 'Midday', 'Afternoon'], day: 'Day', max: 'Up to 3 picks.' },
}[lang];
---

<fieldset class="slots" id="slots" data-lang={lang} data-parts={T.parts.join('|')} data-max={T.max} hidden>
  <legend>{T.legend}</legend>
  <p class="slots-hint" id="slots-hint">{T.hint}</p>
  <div class="slots-grid" id="slots-grid" role="group" aria-label={T.legend}>
    <span class="slots-corner" aria-hidden="true"></span>
    {T.parts.map((p) => <span class="slots-head">{p}</span>)}
  </div>
  <input type="hidden" name="slots" id="f-slots" />
</fieldset>

<script>
  const wrap = document.getElementById('slots') as HTMLFieldSetElement | null;
  if (wrap) {
    const lang = wrap.dataset.lang === 'en' ? 'en' : 'el';
    const parts = (wrap.dataset.parts || '').split('|');
    const grid = document.getElementById('slots-grid')!;
    const hint = document.getElementById('slots-hint')!;
    const out = document.getElementById('f-slots') as HTMLInputElement;
    const hintText = hint.textContent || '';
    const MAX = 3;

    const fmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'el-GR', { weekday: 'short', day: '2-digit', month: '2-digit' });
    const days: Date[] = [];
    const d = new Date();
    d.setHours(12, 0, 0, 0);
    while (days.length < 6) {
      d.setDate(d.getDate() + 1);
      const wd = d.getDay();
      if (wd >= 1 && wd <= 5) days.push(new Date(d));
    }

    const picked = new Set<string>();
    const sync = () => {
      out.value = Array.from(picked).join(', ');
      const full = picked.size >= MAX;
      grid.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
        const on = b.getAttribute('aria-pressed') === 'true';
        b.disabled = full && !on;
      });
      hint.textContent = full ? (wrap.dataset.max || hintText) : hintText;
    };

    for (const day of days) {
      const label = document.createElement('span');
      label.className = 'slots-day';
      label.textContent = fmt.format(day).replace(/\.$/, '');
      grid.appendChild(label);
      for (const p of parts) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'slots-cell';
        b.setAttribute('aria-pressed', 'false');
        b.setAttribute('aria-label', `${label.textContent} ${p}`);
        const key = `${label.textContent} ${p}`;
        b.addEventListener('click', () => {
          const on = b.getAttribute('aria-pressed') === 'true';
          if (on) { picked.delete(key); b.setAttribute('aria-pressed', 'false'); }
          else if (picked.size < MAX) { picked.add(key); b.setAttribute('aria-pressed', 'true'); }
          sync();
        });
        grid.appendChild(b);
      }
    }
    wrap.hidden = false;
    // Μετά από επιτυχή αποστολή η φόρμα κάνει reset: καθάρισε και το πλέγμα.
    wrap.closest('form')?.addEventListener('reset', () => {
      picked.clear();
      grid.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      sync();
    });
  }
</script>

<style>
  .slots { border: 0; padding: 0; margin: 0 0 22px; }
  .slots legend { font-weight: 600; font-size: .95rem; color: var(--navy); margin-bottom: 4px; padding: 0; }
  .slots-hint { font-size: .82rem; color: var(--muted); margin-bottom: 12px; }
  .slots-grid {
    display: grid; grid-template-columns: auto repeat(3, minmax(0, 1fr)); gap: 6px 8px; align-items: center;
  }
  .slots-head { font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); text-align: center; }
  /* Τα κελιά/ημέρες φτιάχνονται από JS: χωρίς scope attribute, άρα :global */
  .slots-grid :global(.slots-day) { font-size: .86rem; font-weight: 600; color: var(--ink); white-space: nowrap; padding-right: 6px; font-variant-numeric: tabular-nums; }
  .slots-grid :global(.slots-cell) {
    height: 38px; border-radius: 10px; cursor: pointer;
    border: 1.5px solid var(--line); background: var(--bg-soft);
    transition: border-color .15s ease, background-color .15s ease, transform .15s ease;
    position: relative;
  }
  .slots-grid :global(.slots-cell:hover:not(:disabled)) { border-color: var(--orange); }
  .slots-grid :global(.slots-cell[aria-pressed="true"]) { border-color: var(--orange); background: var(--orange-soft); }
  .slots-grid :global(.slots-cell[aria-pressed="true"]::after) {
    content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 10px; border-radius: 50%;
    background: var(--orange); transform: translate(-50%, -50%);
  }
  .slots-grid :global(.slots-cell:disabled) { opacity: .35; cursor: not-allowed; }
  .slots-grid :global(.slots-cell:focus-visible) { outline: 2px solid var(--orange); outline-offset: 2px; }
</style>
