---
// Οι 3 υπηρεσίες ζουν σε αναδιπλούμενο «Υπηρεσίες» (desktop dropdown)·
// στο mobile μενού εμφανίζονται σκέτες, στην ίδια θέση, χωρίς trigger.
// Δίγλωσσο: όλα τα λεκτικά/links του μενού ανά γλώσσα — η γλώσσα βγαίνει από το URL.
import { langOf, altOf } from '../i18n';

const lang = langOf(Astro.url.pathname);
const altHref = altOf(Astro.url.pathname);

const NAV = {
  el: {
    services: [
      { href: '/se-vriskoun/', label: 'Ψηφιακή Προβολή' },
      { href: '/doulevei-mono-tou/', label: 'Αυτοματισμοί γραφείου' },
      { href: '/kritikes/', label: 'Κριτικές Google' },
    ],
    links: [
      { href: '/times/', label: 'Τιμές' },
      { href: '/apotelesmata/', label: 'Αποτελέσματα' },
      { href: '/odigoi/', label: 'Οδηγοί' },
    ],
    servicesLabel: 'Υπηρεσίες',
    home: '/',
    cta: 'Μετρήστε την επιχείρησή σας',
    ctaHref: '/tablo/',
    cta2: 'Δωρεάν αξιολόγηση 45′',
    cta2Href: '/elegxos/',
    sounds: 'Ήχοι κλικ',
    menuAria: 'Κύριο μενού',
    burgerAria: 'Μενού',
    langBtn: 'EN',
    langAria: 'Switch to English',
    langMobile: 'English',
  },
  en: {
    services: [
      { href: '/en/get-found/', label: 'Digital Visibility' },
      { href: '/en/runs-by-itself/', label: 'Office automations' },
      { href: '/en/reviews/', label: 'Google Reviews' },
    ],
    links: [
      { href: '/en/pricing/', label: 'Pricing' },
      { href: '/en/results/', label: 'Results' },
      { href: '/en/guides/', label: 'Guides' },
    ],
    servicesLabel: 'Services',
    home: '/en/',
    cta: 'Measure your business',
    ctaHref: '/en/business-check/',
    cta2: 'Free 45-minute assessment',
    cta2Href: '/en/free-assessment/',
    sounds: 'Click sounds',
    menuAria: 'Main menu',
    burgerAria: 'Menu',
    langBtn: 'ΕΛ',
    langAria: 'Αλλαγή σε ελληνικά',
    langMobile: 'Ελληνικά',
  },
}[lang];

// Κανονικοποίηση χωρίς trailing slash και στις δύο πλευρές της σύγκρισης.
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const path = norm(Astro.url.pathname);
const inServices = NAV.services.some((s) => path === norm(s.href));
---

<header class="nav-wrap">
  <nav class="container nav" aria-label={NAV.menuAria}>
    <a class="logo" href={NAV.home}>PISMA<span>.</span></a>

    <ul class="nav-links" id="nav-links">
      <li class="nav-sub">
        <button
          type="button"
          class:list={['sub-trigger', { 'is-active': inServices }]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="sub-panel"
        >
          {NAV.servicesLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div class="sub-panel" id="sub-panel">
          <div class="sub-card">
            {NAV.services.map((s) => (
              <a class="sub-item" href={s.href} aria-current={path === norm(s.href) ? 'page' : undefined}>
                <span class="sub-label">{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </li>
      {NAV.links.map((l) => (
        <li>
          <a href={l.href} aria-current={path === norm(l.href) ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
      <li class="nav-lang-mobile">
        <a href={altHref} aria-label={NAV.langAria}>
          {NAV.langMobile}
          <span class="lang-badge" aria-hidden="true">{NAV.langBtn}</span>
        </a>
      </li>
      <li class="nav-sound-mobile">
        <button type="button" data-sound-toggle aria-pressed="true">
          {NAV.sounds}
          <span class="switch" aria-hidden="true"></span>
        </button>
      </li>
      <li class="nav-cta-mobile"><a class="btn btn--orange btn--sm" href={NAV.ctaHref}>{NAV.cta}</a></li>
      <li class="nav-cta-mobile nav-cta-mobile--second"><a class="btn btn--ghost btn--sm" href={NAV.cta2Href}>{NAV.cta2}</a></li>
    </ul>

    <a class="lang-btn" href={altHref} aria-label={NAV.langAria} title={NAV.langAria}>{NAV.langBtn}</a>

    <button class="sound-btn" type="button" data-sound-toggle aria-pressed="true" aria-label={NAV.sounds} title={NAV.sounds}>
      <svg class="s-on" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" stroke-width="2" />
        <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 6a9 9 0 0 1 0 12" stroke-width="2.6" />
      </svg>
      <svg class="s-off" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
        <path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" stroke-width="2" />
        <path d="m16 9 5 6M21 9l-5 6" stroke-width="2.6" />
      </svg>
    </button>

    <a class="btn btn--orange btn--sm nav-quiz" href={NAV.ctaHref}>{NAV.cta}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="nav-links" aria-label={NAV.burgerAria}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path class="i-open" d="M4 7h16M4 12h16M4 17h16" />
        <path class="i-close" d="M6 6l12 12M18 6L6 18" style="display:none" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  const nav = document.getElementById('nav-links')!;
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    nav.classList.toggle('is-open', !open);
    // Το μενού ζει ΜΕΣΑ στην κάψουλα — όσο είναι ανοιχτό, η κάψουλα παίρνει φόντο
    wrap.classList.toggle('menu-open', !open);
    (burger.querySelector('.i-open') as SVGElement).style.display = open ? '' : 'none';
    (burger.querySelector('.i-close') as SVGElement).style.display = open ? 'none' : '';
  });

  // Dropdown «Υπηρεσίες»: hover/focus το ανοίγουν με CSS· το κλικ (touch/desktop)
  // εναλλάσσει την .open, κλείνει με κλικ έξω ή Escape. Στο mobile δεν υπάρχει trigger.
  const sub = document.querySelector<HTMLElement>('.nav-sub');
  const subTrigger = sub?.querySelector<HTMLButtonElement>('.sub-trigger');
  const setSub = (open: boolean) => {
    sub?.classList.toggle('open', open);
    subTrigger?.setAttribute('aria-expanded', String(open));
  };
  subTrigger?.addEventListener('click', () => setSub(!sub!.classList.contains('open')));
  document.addEventListener('click', (e) => {
    if (sub && !sub.contains(e.target as Node)) setSub(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setSub(false);
  });

  // Floating nav: μαζεύει σε «κάψουλα» με blur μετά από λίγο scroll.
  const wrap = document.querySelector<HTMLElement>('.nav-wrap')!;
  const onScroll = () => wrap.classList.toggle('is-scrolled', window.scrollY > 50);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Διακόπτες ήχων (εικονίδιο στο nav + σειρά στο mobile μενού) —
  // συγχρονίζονται όλοι μεταξύ τους μέσω του window.pismaSound (ορίζεται στο Base).
  const soundToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]'));
  const syncSound = (on: boolean) => {
    for (const btn of soundToggles) {
      btn.setAttribute('aria-pressed', String(on));
      const sOn = btn.querySelector<SVGElement>('.s-on');
      const sOff = btn.querySelector<SVGElement>('.s-off');
      if (sOn) sOn.style.display = on ? '' : 'none';
      if (sOff) sOff.style.display = on ? 'none' : '';
    }
  };
  try {
    syncSound(localStorage.getItem('pisma-sound') !== 'off');
  } catch { /* default: on */ }
  for (const btn of soundToggles) {
    btn.addEventListener('click', () => {
      const api = (window as unknown as { pismaSound?: { toggle: () => boolean } }).pismaSound;
      if (api) syncSound(api.toggle());
    });
  }
</script>

<style>
  .nav-wrap {
    position: sticky; top: 0; z-index: 100;
    padding: 8px 10px 0;
  }
  .nav {
    display: flex; align-items: center; gap: 16px; height: 64px;
    max-width: 1160px; /* λίγο φαρδύτερο από το .container (1120) — δένει με το περιεχόμενο */
    border: 1px solid transparent; border-radius: 18px;
    transition: max-width .35s ease, background-color .35s ease, border-color .35s ease, box-shadow .35s ease;
  }
  /* Με το dropdown «Υπηρεσίες» το περιεχόμενο θέλει ~775px — η κάψουλα
     μαζεύει στα 960px ώστε να «αγκαλιάζει» τα στοιχεία χωρίς άδεια κενά. */
  .nav-wrap.is-scrolled .nav,
  .nav-wrap.menu-open .nav {
    max-width: 960px;
    background: rgba(13, 10, 20, .72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .nav-wrap.menu-open .nav { background: rgba(13, 10, 20, .92); }
  .logo {
    font-family: var(--font-display); font-weight: 800; font-size: 1.25rem;
    color: var(--navy); text-decoration: none; letter-spacing: .01em; margin-right: auto;
    white-space: nowrap; flex: none;
  }
  .logo span { color: var(--orange); }
  .nav-links { display: flex; align-items: center; gap: 16px; list-style: none; padding: 0; flex-wrap: nowrap; }
  /* Desktop (απόφαση χρήστριας):
     - Κορυφή σελίδας: λινκ ΑΚΡΙΒΩΣ στο κέντρο, ήχος+CTA τέρμα δεξιά.
     - Στο scroll (κάψουλα): όλα μαζεύονται σε ΜΙΑ παρέα στη μέση.
     Στα 901-1079px το «ακριβώς κέντρο» δεν χωράει (τα λινκ θα έπεφταν
     πάνω στο CTA) — εκεί ισχύει παντού η διάταξη-παρέα. */
  @media (min-width: 901px) {
    .logo { margin-right: 0; }
    .nav-links { margin-left: auto; }
    .nav-quiz { margin-right: auto; }
  }
  .nav-links a:not(.btn) {
    text-decoration: none; font-weight: 600; font-size: .95rem; color: var(--muted);
    padding: 6px 2px; border-radius: 6px;
    transition: color .15s ease;
    white-space: nowrap;
  }
  .nav-links a:not(.btn):hover { color: var(--navy); }
  .nav-links a[aria-current='page']:not(.sub-item) {
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--orange);
  }
  /* Dropdown «Υπηρεσίες» (desktop): hover/focus/click ανοίγουν το πάνελ. */
  .nav-sub { position: relative; }
  .sub-trigger {
    display: inline-flex; align-items: center; gap: 6px;
    background: none; border: 0; cursor: pointer;
    font: inherit; font-weight: 600; font-size: .95rem; color: var(--muted);
    padding: 6px 2px; border-radius: 6px; white-space: nowrap;
    transition: color .15s ease;
  }
  .sub-trigger:hover { color: var(--navy); }
  .sub-trigger.is-active {
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--orange);
  }
  .sub-trigger svg { flex: none; transition: transform .2s ease; }
  .nav-sub:hover .sub-trigger svg,
  .nav-sub:focus-within .sub-trigger svg,
  .nav-sub.open .sub-trigger svg { transform: rotate(180deg); }
  /* Το wrapper έχει διάφανο padding-top ώστε το hover να μη «σπάει» στο κενό
     ανάμεσα σε trigger και κάρτα. */
  .sub-panel {
    display: none;
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    padding-top: 14px; z-index: 10;
  }
  .nav-sub:hover .sub-panel,
  .nav-sub:focus-within .sub-panel,
  .nav-sub.open .sub-panel { display: block; }
  .sub-card {
    min-width: 320px;
    background: var(--card); border: 1px solid var(--line-strong);
    border-radius: 14px; padding: 8px; box-shadow: var(--shadow);
  }
  .nav-links a.sub-item {
    display: block; padding: 10px 12px; border-radius: 10px; white-space: nowrap;
  }
  .nav-links a.sub-item:hover { background: rgba(255, 255, 255, .05); }
  .sub-label { display: block; font-weight: 600; font-size: .95rem; color: var(--navy); }
  .nav-links a.sub-item[aria-current='page'] .sub-label {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--orange);
  }

  .nav-cta-mobile { display: none; }
  .nav-sound-mobile { display: none; }
  .nav-lang-mobile { display: none; }
  /* Κουμπί γλώσσας (desktop): διακριτικό pill δίπλα στον ήχο. */
  .lang-btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 34px; padding: 0 12px; border-radius: 10px; flex: none;
    border: 1px solid var(--line-strong);
    font-weight: 700; font-size: .8rem; letter-spacing: .06em;
    color: var(--muted); text-decoration: none;
    transition: color .15s ease, border-color .15s ease;
  }
  .lang-btn:hover { color: var(--navy); border-color: var(--orange); }
  .sound-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 10px; flex: none;
    background: none; border: 0;
    color: var(--navy); cursor: pointer;
    transition: opacity .15s ease;
  }
  .sound-btn:hover { opacity: .8; }
  .sound-btn[aria-pressed='false'] { opacity: .65; }
  .sound-btn svg { flex: none; display: block; width: 26px; height: 26px; }
  .nav-quiz { flex: none; }
  .burger { display: none; background: none; border: 0; cursor: pointer; color: var(--navy); padding: 8px; border-radius: 10px; }
  .burger svg { width: 26px; height: 26px; }

  /* 900px: με το dropdown το μενού θέλει μόλις ~775px — τα tablet landscape
     βλέπουν πλέον το κανονικό μενού, burger μόνο κάτω από 900. */
  @media (max-width: 900px) {
    .nav { gap: 14px; flex-wrap: wrap; height: auto; min-height: 64px; }
    .nav-quiz { display: none; }
    .burger { display: inline-flex; }
    .sound-btn { display: none; }
    .lang-btn { display: none; }
    .burger svg { width: 30px; height: 30px; }
    /* Το ανοιχτό μενού είναι ΜΕΡΟΣ της κάψουλας: static, σπάει σε νέα σειρά
       μέσα στο ίδιο στρογγυλεμένο κουτί — κανένα ξεχωριστό πάνελ, κανένα κενό. */
    .nav-links {
      display: none;
      position: static; order: 10; width: 100%;
      flex-direction: column; align-items: stretch; gap: 4px;
      background: none; border: 0; box-shadow: none;
      border-top: 1px solid var(--line);
      margin-top: 2px; padding: 8px 4px 16px;
    }
    .nav-links.is-open { display: flex; }
    .nav-links a:not(.btn) { display: block; padding: 12px 4px; font-size: 1.05rem; }
    /* Mobile: χωρίς dropdown — οι 3 υπηρεσίες εμφανίζονται σκέτες στη λίστα,
       σαν κανονικά links, στην ίδια θέση (πάνω πάνω). */
    .nav-sub { position: static; }
    .sub-trigger { display: none; }
    .sub-panel { display: block; position: static; transform: none; padding: 0; }
    .sub-card { min-width: 0; background: none; border: 0; border-radius: 0; padding: 0; box-shadow: none; }
    .nav-links a.sub-item { padding: 12px 4px; border-radius: 6px; white-space: normal; }
    .nav-links a.sub-item:hover { background: none; }
    .sub-label { font-size: 1.05rem; color: var(--muted); }
    .nav-links a.sub-item:hover .sub-label { color: var(--navy); }
    /* Γλώσσα στο mobile μενού: σειρά σαν link, με badge της άλλης γλώσσας. */
    .nav-lang-mobile { display: block; border-top: 1px solid var(--line); margin-top: 6px; }
    .nav-lang-mobile a {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 14px 4px; text-decoration: none;
      font-weight: 600; font-size: 1.05rem; color: var(--navy);
    }
    .nav-lang-mobile .lang-badge {
      flex: none; padding: 4px 10px; border-radius: 8px;
      border: 1px solid var(--line-strong);
      font-size: .78rem; font-weight: 700; letter-spacing: .06em; color: var(--muted);
    }
    .nav-sound-mobile { display: block; border-top: 1px solid var(--line); margin-top: 6px; }
    .nav-sound-mobile button {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      width: 100%; padding: 14px 4px; background: none; border: 0; cursor: pointer;
      font: inherit; font-weight: 600; font-size: 1.05rem; color: var(--navy); text-align: left;
    }
    .nav-sound-mobile .switch {
      position: relative; flex: none; width: 46px; height: 26px; border-radius: 13px;
      background: var(--card-2); border: 1px solid var(--line-strong);
      transition: background .2s ease, border-color .2s ease;
    }
    .nav-sound-mobile .switch::after {
      content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px;
      border-radius: 50%; background: var(--muted);
      transition: transform .2s ease, background .2s ease;
    }
    .nav-sound-mobile button[aria-pressed='true'] .switch {
      background: var(--orange-soft); border-color: var(--orange);
    }
    .nav-sound-mobile button[aria-pressed='true'] .switch::after {
      transform: translateX(20px); background: var(--orange);
    }
    .nav-cta-mobile { display: block; margin-top: 10px; }
    .nav-cta-mobile--second { margin-top: 8px; }
    .nav-cta-mobile .btn { width: 100%; }
  }
</style>
