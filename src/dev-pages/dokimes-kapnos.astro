---
// ΠΡΟΣΩΡΙΝΗ σελίδα δοκιμών — ΜΟΝΟ dev, δεν μπαίνει στο build.
// Έξι εκδοχές καπνού (ίδιος WebGL shader, άλλες ρυθμίσεις) πάνω στο hero της
// αρχικής, για να διαλέξει η χρήστρια. Τα data-attributes είναι ακριβώς αυτά
// που θα μπουν στο <canvas class="stg-smoke"> της αρχικής.
import '../styles/fonts.css';
const variants = [
  { n: 1, t: 'Λεπτές τολύπες', d: 'Αραιός, λεπτός καπνός που στρίβει — σαν καπνός τσιγάρου σε σκοτεινό δωμάτιο.', a: { strength: '.5', scale: '3.4', warp: '5', lo: '.46', hi: '1', bottom: '.5', rise: '.2', speed: '1.2' } },
  { n: 2, t: 'Πυκνή ομίχλη', d: 'Βαρύς, μαλακός καπνός που καλύπτει το κάτω μέρος και αραιώνει προς τα πάνω (το τωρινό, λίγο πιο πυκνό).', a: { strength: '.7', scale: '2.2', warp: '3.5', lo: '.34', hi: '.95', bottom: '.85', rise: '.12', speed: '.9' } },
  { n: 3, t: 'Σύννεφα', d: 'Μεγάλοι, απαλοί σχηματισμοί, πολύ αργοί — ήρεμο, σχεδόν ακίνητο.', a: { strength: '.55', scale: '1.3', warp: '2.2', lo: '.4', hi: '.98', bottom: '.6', rise: '.06', speed: '.6' } },
  { n: 4, t: 'Κορδέλες', d: 'Έντονο στρίψιμο, ψηλή αντίθεση — φαίνονται καθαρά οι «κλωστές» του καπνού.', a: { strength: '.65', scale: '2.8', warp: '6', lo: '.5', hi: '.9', bottom: '.6', rise: '.18', speed: '1' } },
  { n: 5, t: 'Προβολείς μέσα στον καπνό', d: 'Ίδιος καπνός με το 2, αλλά με πέντε ακτίνες φωτός από ψηλά που τρεμοπαίζουν — σκηνή συναυλίας.', a: { strength: '.6', scale: '2.2', warp: '3.5', lo: '.36', hi: '.96', bottom: '.8', rise: '.12', speed: '.9', rays: '1' } },
  { n: 6, t: 'Ανεβαίνει από κάτω', d: 'Πυκνός στο πάτωμα, ανεβαίνει σταθερά προς τα πάνω σαν ξηρός πάγος.', a: { strength: '.7', scale: '2.6', warp: '3', lo: '.35', hi: '.95', bottom: '.95', rise: '.5', speed: '1' } },
];
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Δοκιμές — 6 εκδοχές καπνού</title>
  </head>
  <body>
    <nav class="pick" aria-label="Επιλογή">{variants.map((v) => <a href={`#k${v.n}`}><b>{v.n}</b>{v.t}</a>)}</nav>
    <header class="intro">
      <p class="intro-k">Δοκιμές · καπνός</p>
      <h1>Έξι εκδοχές καπνού</h1>
      <p>Ίδια αρχική, άλλος καπνός σε κάθε μπλοκ. Κινούνται ζωντανά — αφήστε τα λίγα δευτερόλεπτα. Πείτε μου νούμερο.</p>
    </header>

    {variants.map((v) => (
      <section class="hero" id={`k${v.n}`}>
        <div class="stg" aria-hidden="true">
          <span class="stg-ghost">PISMA<i>.</i></span>
          <canvas class="stg-smoke" data-strength={v.a.strength} data-scale={v.a.scale} data-warp={v.a.warp} data-lo={v.a.lo} data-hi={v.a.hi} data-bottom={v.a.bottom} data-rise={v.a.rise} data-speed={v.a.speed} data-rays={v.a.rays ?? '0'}></canvas>
        </div>
        <div class="lab"><b>{v.n} — {v.t}</b> {v.d}</div>
        <nav class="nav"><span class="logo">PISMA<i>.</i></span><span class="links"><a>Υπηρεσίες</a><a>Τιμές</a><a>Αποτελέσματα</a><a>Οδηγοί</a></span><a class="cta">Μετρήστε την επιχείρησή σας</a></nav>
        <div class="inner">
          <p class="k">Ψηφιακή παρουσία &amp; αυτοματοποίηση</p>
          <h2>Η επιχείρησή σας,<br />ορατή στους πελάτες.<br />Η λειτουργία της,<br />χωρίς χαμένες ώρες.</h2>
          <p class="sub">Στην PISMA σχεδιάζουμε και αναπτύσσουμε την παρουσία της επιχείρησής σας σε ιστοσελίδα, Google και AI, και αυτοματοποιούμε τις καθημερινές διαδικασίες σας.</p>
          <div class="btns"><a class="btn" href="#">Μετρήστε την επιχείρησή σας — 2 λεπτά</a><a class="ghostbtn" href="#">Κλείστε τον δωρεάν Έλεγχο</a></div>
          <ul class="stats"><li><b>από 220 €</b><span>ιστοσελίδα</span></li><li><b>72 ώρες</b><span>πρώτο preview</span></li><li><b>48 ώρες</b><span>γραπτή πρόταση</span></li><li><b>100%</b><span>δημόσιες τιμές</span></li></ul>
        </div>
      </section>
    ))}

    <footer class="outro"><p>Πείτε μου νούμερο και το περνάω στην αρχική EL + EN.</p></footer>
    <script>
      import '../scripts/smoke';
    </script>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', system-ui, sans-serif; background: #0B0B0B; color: #fff; -webkit-font-smoothing: antialiased; }
  h1, h2, p, ul { margin: 0; }
  .pick { position: fixed; top: 14px; right: 14px; z-index: 100; display: flex; gap: 4px; background: rgba(20,20,20,.85); backdrop-filter: blur(10px); padding: 6px; border-radius: 999px; border: 1px solid rgba(255,255,255,.15); }
  .pick a { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 999px; color: #fff; text-decoration: none; font-size: .76rem; font-weight: 600; }
  .pick a b { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: #fff; color: #111; font-size: .7rem; }
  .intro { padding: 72px clamp(20px, 3vw, 44px) 40px; max-width: 900px; }
  .intro-k { color: #FF9A73; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; font-size: .76rem; }
  .intro h1 { font-size: clamp(1.8rem, 4vw, 3rem); margin: 10px 0 14px; line-height: 1.1; font-weight: 800; letter-spacing: -.02em; }
  .intro p { color: #bbb; font-size: 1.05rem; line-height: 1.6; }
  .outro { padding: 60px clamp(20px, 3vw, 44px) 120px; color: #bbb; }
  .lab { position: relative; z-index: 2; margin: 14px clamp(12px, 3vw, 44px) 0; padding: 10px 14px; border-radius: 12px; background: rgba(255,122,80,.14); border: 1px solid rgba(255,122,80,.35); font-size: .92rem; color: #eee; width: fit-content; max-width: 90%; }
  .lab b { color: #FFA284; }

  .hero { position: relative; overflow: hidden; min-height: min(100vh, 900px); display: flex; flex-direction: column; justify-content: center; padding: 0 0 56px; margin-top: 24px; border-top: 1px solid rgba(255,255,255,.08); }
  .stg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .stg-ghost { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-family: 'Inter', system-ui, sans-serif; font-weight: 800; font-size: clamp(6rem, 21vw, 19rem); letter-spacing: -.05em; white-space: nowrap; line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.22); background: linear-gradient(180deg, rgba(255,255,255,.34), rgba(255,255,255,.07)); -webkit-background-clip: text; background-clip: text; filter: drop-shadow(0 0 40px rgba(255,255,255,.10)); }
  .stg-ghost i { font-style: normal; }
  .stg-smoke { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .nav, .inner { position: relative; z-index: 1; max-width: 1120px; margin-inline: auto; width: 100%; padding-inline: clamp(20px, 4vw, 36px); }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; margin-top: 8px; }
  .logo { font-family: 'Unbounded', 'Inter', sans-serif; font-weight: 800; font-size: 1.25rem; } .logo i { color: #FF7A50; font-style: normal; }
  .links { display: flex; gap: 22px; font-size: .92rem; } .links a { color: #E4E4E4; text-decoration: none; }
  .cta { background: linear-gradient(92deg, #CC431C, #AC3213); color: #fff; padding: 10px 18px; border-radius: 12px; font-weight: 700; font-size: .9rem; text-decoration: none; }
  .inner { padding-top: clamp(24px, 4vw, 48px); }
  .k { font-size: .76rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #FFA284; margin-bottom: 20px; }
  .hero h2 { font-size: clamp(2.3rem, 5.8vw, 4.8rem); line-height: 1.02; letter-spacing: -.035em; font-weight: 800; text-shadow: 0 10px 60px rgba(0,0,0,.6); }
  .sub { margin: 24px 0 0; font-size: 1.1rem; color: #9C9C9C; max-width: 62ch; line-height: 1.6; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
  .btn { background: linear-gradient(92deg, #CC431C, #AC3213); color: #fff; padding: 15px 24px; border-radius: 12px; font-weight: 700; text-decoration: none; box-shadow: 0 6px 24px rgba(238,79,39,.35); }
  .ghostbtn { padding: 15px 22px; border-radius: 12px; font-weight: 700; color: #fff; text-decoration: none; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.18); }
  .stats { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 34px; margin: 30px 0 0; }
  .stats li { display: grid; gap: 2px; } .stats b { font-family: 'Unbounded', 'Inter', sans-serif; font-weight: 800; font-size: 1.18rem; } .stats span { font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #9C9C9C; }
  @media (max-width: 860px) { .pick { top: auto; bottom: 12px; left: 12px; right: 12px; justify-content: center; flex-wrap: wrap; } .links { display: none; } }
</style>
