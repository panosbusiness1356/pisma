// ΠΡΟΣΩΡΙΝΗ σελίδα δοκιμών — ΜΟΝΟ dev, δεν μπαίνει στο build.
// Οκτώ «aesthetic» κατευθύνσεις: ήρεμες παλέτες, κομψές γραμματοσειρές (Google
// Fonts μόνο για τη δοκιμή), πολύς αέρας, λεπτές λεπτομέρειες. Ίδια κείμενα
// και αριθμοί με το ζωντανό site — καμία επινόηση.
const styles = [
  { id: 'a', t: 'Λινό', d: 'Ζεστό λευκό, φασκόμηλο, EB Garamond πλάγια + Manrope. Boutique ηρεμία.' },
  { id: 'b', t: 'Μεταξωτή νύχτα', d: 'Βαθύ μπλε της νύχτας, σαμπανιζέ κείμενο, χρυσές λεπτές γραμμές. Κομψό σκούρο.' },
  { id: 'c', t: 'Άμμος & Ωκεανός', d: 'Άμμος και βαθύ πετρόλ, μεγάλο στρογγυλεμένο μπλοκ, Literata. Μεσογειακό-μοντέρνο.' },
  { id: 'd', t: 'Ροδάκινο', d: 'Απαλό gradient ροδάκινο-κρεμ με κόκκο, γυάλινο μενού, λευκές κάρτες. Ονειρικό, ανάλαφρο.' },
  { id: 'e', t: 'Γκαλερί', d: 'Λευκό μουσείου, μαύρο, μία πλάγια λέξη, μικρές λεζάντες, τεράστιος αέρας. Μινιμαλισμός.' },
  { id: 'f', t: 'Ελαιόλαδο', d: 'Βαθύ λαδί μπλοκ με κρεμ γράμματα, Literata, στρογγυλεμένα φύλλα. Γήινο premium.' },
  { id: 'g', t: 'Σκόνη ροζ', d: 'Ροζ-μπεζ και ανθρακί, Alegreya πλάγια, λεπτές γραμμές. Αίσθηση beauty brand.' },
