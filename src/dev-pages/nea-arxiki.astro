</main>

<script is:inline>
  // Το nav-CTA γεμίζει με accent μόνο αφού το hero βγει από την οθόνη.
  const nav = document.getElementById('nav');
  const hero = document.getElementById('hero');
  let raf = 0;
  const update = () => { raf = 0; nav.classList.toggle('on', window.scrollY > hero.offsetTop + hero.offsetHeight - 80); };
  addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
  update();
</script>
</body>
