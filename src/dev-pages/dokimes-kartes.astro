const e6logos: Record<string, string[]> = {
  pin: ['google-maps.svg'],
  seo: ['google-icon.svg'],
  ai: ['openai-icon.svg'],
  social: ['instagram-icon.svg', 'facebook.svg', 'tiktok-icon.svg'],
  star: ['google-icon.svg'],
};

// Ε7: αντικείμενο Ε5 + μικρό στρογγυλό badge με το πραγματικό λογότυπο
const e7badge: Record<string, string> = {
  pin: 'google-maps.svg',
  seo: 'google-icon.svg',
  ai: 'openai-icon.svg',
  social: 'instagram-icon.svg',
  star: 'google-icon.svg',
};

const goldStar =
  '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="#F6C34C"/>';

const hues = ['orange', 'blue', 'ok', 'yellow'];
const hue = (i: number) => hues[i % hues.length];
const big = (s: { icon: string }) => s.icon === 'site' || s.icon === 'star';
const flagship = services[0];
const rest = services.slice(1);

// Σειρά εμφάνισης για τέλειο tiling σε 4 στήλες:
// [site(2), cal, pin] [seo, ai, star(2)] [social, menu, eye(λωρίδα 2)]
const byIcon = Object.fromEntries(services.map((s) => [s.icon, s]));
const ordered = ['site', 'cal', 'pin', 'seo', 'ai', 'star', 'social', 'menu', 'eye'].map((k) => byIcon[k]);
const veClass = (s: { icon: string }) =>
  big(s) ? 've-card--big' : s.icon === 'eye' ? 've-card--strip' : '';

// Ε4 ψηφιδωτό 6 στηλών: 3+3 / 2+2+2 / 2+2+2 / 6 — κλείνει ακριβώς
const e4list = [
  { s: byIcon.site, c: 'e4-big' },
  { s: byIcon.star, c: 'e4-big' },
  { s: byIcon.cal, c: 'e4-mid' },
  { s: byIcon.pin, c: 'e4-mid' },
  { s: byIcon.social, c: 'e4-mid' },
  { s: byIcon.menu, c: 'e4-mid' },
  { s: byIcon.seo, c: 'e4-mid' },
  { s: byIcon.ai, c: 'e4-mid' },
  { s: byIcon.eye, c: 'e4-strip' },
];
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Δοκιμές Β΄ — bento κάρτες</title>
  </head>
  <body>
    <header class="dk-top">
      <div class="container">
        <p class="kicker">Δοκιμές Β΄</p>
        <h1>Το Ε σε τέσσερις παραλλαγές</h1>
        <p class="muted">Πάνω: το Ε όπως το είδες. Από κάτω: Ε1–Ε4, όλα bento με άλλη «γεύση». Πες μου ποιο (ή συνδυασμό).</p>
        <nav class="dk-nav">
          <a href="#e">Ε (βάση)</a><a href="#e1">Ε1</a><a href="#e2">Ε2</a><a href="#e3">Ε3</a><a href="#e4">Ε4</a><a href="#e5">Ε5</a><a href="#e6">Ε6 — λογότυπα</a><a href="#e7">Ε7 — μεικτό</a><a href="#aut">ΑΥΤΟΜΑΤΙΣΜΟΙ — νέο</a>
        </nav>
      </div>
    </header>

    <!-- Ε — η βάση που διάλεξες -->
    <section class="section section--tight" id="e">
      <div class="container">
        <div class="dk-label"><strong>Ε — η βάση</strong> — όπως στο πρώτο γύρο: δύο μεγάλες «ναυαρχίδες», οι υπόλοιπες συμπαγείς, και το «Μάτι στον ανταγωνισμό» κλείνει σαν φαρδιά λωρίδα</div>
        <div class="ve-grid">
          {ordered.map((s) => (
            <article class={`ve-card ${veClass(s)}`}>
              <span class={`icon-chip ${''}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} /></span>
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ε1 — bento + χρώμα ανά υπηρεσία -->
    <section class="section section--tight" id="e1">
      <div class="container">
        <div class="dk-label"><strong>Ε1 — Bento με χρώμα</strong> — ίδια διάταξη, αλλά κάθε υπηρεσία παίρνει δική της απόχρωση στο chip, και στο hover «ανάβει» περίγραμμα στο χρώμα της</div>
        <div class="ve-grid">
          {ordered.map((s, i) => (
            <article class={`ve-card e1-${hue(i)} ${veClass(s)}`}>
              <span class="icon-chip e1-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} /></span>
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow e1-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ε2 — ναυαρχίδα ολόπλατη πρώτη -->
    <section class="section section--tight" id="e2">
      <div class="container">
        <div class="dk-label"><strong>Ε2 — Ναυαρχίδα ολόπλατη</strong> — το «Site που πουλάει» γίνεται μία μεγάλη οριζόντια κάρτα πάνω-πάνω με μεγαλύτερο τίτλο, το «Εργαλείο Κριτικών» κρατά διπλό πλάτος, τα υπόλοιπα συμπαγή από κάτω</div>
        <div class="e2-grid">
          <article class="ve-card e2-hero">
            <div>
              <span class="icon-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.site} /></span>
              <h3 class="e2-hero-t">{flagship.t}</h3>
              <p>{flagship.d}</p>
              <a class="card-arrow" href="#">Μάθε τι κάνει →</a>
            </div>
            <div class="e2-hero-art" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons.site} />
            </div>
          </article>
          {rest.map((s) => (
            <article class={`ve-card ${s.icon === 'star' ? 've-card--big' : s.icon === 'eye' ? 've-card--strip e2-strip' : ''}`}>
              <span class={`icon-chip ${''}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} /></span>
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ε3 — bento με υδατογράφημα-εικονίδιο -->
    <section class="section section--tight" id="e3">
      <div class="container">
        <div class="dk-label"><strong>Ε3 — Υδατογράφημα</strong> — όπως το Ε, αλλά οι δύο μεγάλες έχουν το εικονίδιό τους τεράστιο και αχνό στη γωνία, σαν σφραγίδα — δίνει βάθος χωρίς φασαρία</div>
        <div class="ve-grid">
          {ordered.map((s) => (
            <article class={`ve-card ${veClass(s)} ${big(s) ? 'e3-big' : ''}`}>
              {big(s) && (
                <span class="e3-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
                </span>
              )}
              <span class={`icon-chip ${''}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} /></span>
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ε4 — ψηφιδωτό με τρία μεγέθη -->
    <section class="section section--tight" id="e4">
      <div class="container">
        <div class="dk-label"><strong>Ε4 — Ψηφιδωτό</strong> — οι δύο ναυαρχίδες δίπλα-δίπλα πάνω-πάνω, από κάτω δύο σειρές των τριών, και το «Μάτι στον ανταγωνισμό» κλείνει σαν ολόπλατη λεπτή λωρίδα</div>
        <div class="e4-grid">
          {e4list.map(({ s, c }) => (
            <article class={`ve-card ${c}`}>
              <span class={`icon-chip ${''}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} /></span>
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ε5 — χρωματιστά αντικείμενα ανά κάρτα -->
    <section class="section section--tight" id="e5">
      <div class="container">
        <div class="dk-label"><strong>Ε5 — Χρωματιστά αντικείμενα</strong> — κάθε κάρτα έχει ένα μικρό έγχρωμο «αντικείμενο» αντί για το μονόχρωμο εικονίδιο: μίνι site με κουμπί και γράφημα, ημερολόγιο με πράσινο ✓, χάρτης με κόκκινη πινέζα, αποτέλεσμα Google με χρυσό «1ο», συννεφάκι AI, καρδιά/like/σχόλιο, χρυσά αστέρια, QR με πίτσα, γράφημα εσύ-vs-απέναντι</div>
        <div class="ve-grid">
          {ordered.map((s) => (
            <article class={`ve-card e5-card ${veClass(s)}`}>
              <span class={`e5-art ${s.icon === 'eye' ? 'e5-art--sm' : ''}`} aria-hidden="true">
                <svg viewBox="0 0 96 72" set:html={art[s.icon]} />
              </span>
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ε6 — πραγματικά λογότυπα -->
    <section class="section section--tight" id="e6">
      <div class="container">
        <div class="dk-label"><strong>Ε6 — Κανονικά λογότυπα</strong> — όπου υπάρχει πραγματικό brand μπαίνει το επίσημο λογότυπό του: Google Maps στο προφίλ, το G της Google στο SEO, ChatGPT στο AI, Instagram/Facebook/TikTok στα social, G + χρυσά αστέρια στις κριτικές. Όπου δεν υπάρχει brand (site, κρατήσεις, μενού, ανταγωνισμός) μένει το χρωματιστό αντικείμενο του Ε5</div>
        <div class="ve-grid">
          {ordered.map((s) => (
            <article class={`ve-card e5-card ${veClass(s)}`}>
              {e6logos[s.icon] ? (
                <span class={`e6-logos ${s.icon === 'eye' ? 'e6-logos--strip' : ''}`} aria-hidden="true">
                  {e6logos[s.icon].map((f) => (
                    <span class="e6-chip"><img src={`/logos/${f}`} alt="" loading="lazy" /></span>
                  ))}
                  {s.icon === 'star' && (
                    <span class="e6-stars">
                      {[0, 1, 2, 3, 4].map(() => (
                        <svg viewBox="0 0 24 24" set:html={goldStar} />
                      ))}
                    </span>
                  )}
                </span>
              ) : (
                <span class={`e5-art ${s.icon === 'eye' ? 'e5-art--sm' : ''}`} aria-hidden="true">
                  <svg viewBox="0 0 96 72" set:html={art[s.icon]} />
                </span>
              )}
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ε7 — αντικείμενα Ε5 + badge λογότυπου -->
    <section class="section section--tight" id="e7">
      <div class="container">
        <div class="dk-label"><strong>Ε7 — Μεικτό</strong> — τα χρωματιστά αντικείμενα του Ε5, και πάνω τους ένα μικρό στρογγυλό badge με το πραγματικό λογότυπο στη γωνία: Maps στον χάρτη, G στην αναζήτηση και στα αστέρια, ChatGPT στο συννεφάκι, Instagram στα social</div>
        <div class="ve-grid">
          {ordered.map((s) => (
            <article class={`ve-card e5-card ${veClass(s)}`}>
              <span class={`e7-wrap ${s.icon === 'eye' ? 'e7-wrap--sm' : ''}`} aria-hidden="true">
                <span class={`e5-art ${s.icon === 'eye' ? 'e5-art--sm' : ''}`}>
                  <svg viewBox="0 0 96 72" set:html={art[s.icon]} />
                </span>
                {e7badge[s.icon] && (
                  <span class="e7-badge"><img src={`/logos/${e7badge[s.icon]}`} alt="" loading="lazy" /></span>
                )}
              </span>
              {s.icon === 'eye' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ΑΥΤΟΜΑΤΙΣΜΟΙ — πρόταση για τη σελίδα «Δουλεύει μόνο του», στυλ Ε6 -->
    <section class="section section--tight" id="aut">
      <div class="container">
        <div class="sec-head">
          <p class="kicker kicker--ok">Πρόταση</p>
          <h2>Οκτώ δουλειές ρουτίνας που φεύγουν από το κεφάλι σας.</h2>
        </div>
        <div class="dk-label"><strong>Αυτοματισμοί σε στυλ Ε6</strong> — ναυαρχίδες το «Ταίριασμα πληρωμών» (παζλ που κουμπώνει με ✓) και το «Εργαλείο Κριτικών» (G + αστέρια)· Excel/WhatsApp/Viber ως πραγματικά λογότυπα· κάρτα με σφραγίδες και δωράκι στην Πιστότητα· ο «Κατάσκοπος» κλείνει ως λωρίδα με το ίδιο γράφημα του «Ματιού» της Προβολής</div>
        <div class="ve-grid">
          {aut.map((s) => (
            <article class={`ve-card e5-card ${s.cls === 'aut-big' ? 've-card--big' : s.cls === 'aut-strip' ? 've-card--strip aut-strip3' : ''}`}>
              <span class={`aut-viz ${s.cls === 'aut-strip' ? 'aut-viz--strip' : ''}`} aria-hidden="true">
                {s.art && (
                  <span class={`e5-art ${s.cls === 'aut-strip' ? 'e5-art--sm' : ''}`}>
                    <svg viewBox="0 0 96 72" set:html={autArt[s.art] || art[s.art]} />
                  </span>
                )}
                {s.logos && s.logos.map((f) => (
                  <span class="e6-chip"><img src={`/logos/${f}`} alt="" loading="lazy" /></span>
                ))}
                {s.stars && (
                  <span class="e6-stars">
                    {[0, 1, 2, 3, 4].map(() => (
                      <svg viewBox="0 0 24 24" set:html={goldStar} />
                    ))}
                  </span>
                )}
              </span>
              {s.cls === 'aut-strip' ? (
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ) : (
                <>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.href && <a class="card-arrow" href="#">Μάθετε τι κάνει →</a>}
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <footer class="dk-foot">
      <div class="container"><p class="muted">Προσωρινή σελίδα — δεν μπαίνει στο live site.</p></div>
    </footer>
  </body>
</html>

<style>
  /* ---------- σκελετός σελίδας δοκιμών ---------- */
  .dk-top { padding: clamp(40px, 7vw, 72px) 0 8px; }
  .dk-top h1 { margin: 14px 0 10px; }
  .dk-nav { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
  .dk-nav a {
    display: inline-flex; padding: 8px 16px; border-radius: 999px;
    background: var(--card); border: 1px solid var(--line);
    text-decoration: none; font-weight: 700; font-size: .92rem;
  }
  .dk-nav a:hover { border-color: var(--line-strong); }
  .dk-label {
    margin-bottom: 22px; padding: 12px 16px; border-radius: 12px;
    background: var(--orange-soft); border: 1px solid rgba(var(--orange-rgb), .3);
    color: var(--ink); font-size: .95rem; max-width: none;
  }
  .dk-label strong { color: var(--orange-text); }
  .dk-foot { padding: 40px 0 60px; }

  /* ---------- Ε βάση: bento ---------- */
  .ve-grid { display: grid; gap: 18px; grid-template-columns: repeat(4, 1fr); }
  .ve-card {
    background: linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,0) 60%), var(--card);
    border: 1px solid var(--line); border-radius: var(--r);
    box-shadow: var(--shadow); padding: 22px 20px;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .ve-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); border-color: var(--line-strong); }
  .ve-card h3 { margin-bottom: 8px; color: var(--navy); }
  .ve-card p { font-size: .94rem; color: var(--muted); }
  .ve-card--big {
    grid-column: span 2;
    background:
      radial-gradient(120% 130% at 20% -10%, rgba(var(--cta-rgb), .18), transparent 60%),
      radial-gradient(110% 120% at 95% 110%, rgba(var(--orange-rgb), .09), transparent 55%),
      var(--card-2);
    border-color: var(--line-strong);
    padding: clamp(24px, 3vw, 32px);
  }
  .ve-card--big p { font-size: .99rem; }
  /* λωρίδα-κλείσιμο: φαρδιά και ρηχή, εικονίδιο αριστερά */
  .ve-card--strip {
    grid-column: span 2;
    display: flex; align-items: center; gap: 18px;
    padding: 18px 22px;
  }
  .ve-card--strip .icon-chip { margin-bottom: 0; flex: 0 0 auto; }
  .ve-card--strip h3 { margin-bottom: 4px; }
  .ve-card--strip p { font-size: .92rem; }
  @media (max-width: 980px) { .ve-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .ve-grid { grid-template-columns: 1fr; }
    .ve-card--big, .ve-card--strip { grid-column: span 1; }
    .ve-card--strip { flex-direction: column; align-items: flex-start; gap: 12px; }
  }

  /* ---------- Ε1: bento + χρώμα ---------- */
  .e1-orange { --e1: var(--orange); --e1-soft: var(--orange-soft); --e1-icon: var(--orange); --e1-text: var(--orange-text); }
  .e1-blue   { --e1: var(--blue);   --e1-soft: var(--blue-soft);   --e1-icon: #8FAECB; --e1-text: var(--blue-text); }
  .e1-ok     { --e1: var(--ok);     --e1-soft: var(--ok-soft);     --e1-icon: var(--ok);     --e1-text: var(--ok-text); }
  .e1-yellow { --e1: var(--yellow); --e1-soft: var(--yellow-soft); --e1-icon: var(--yellow); --e1-text: var(--yellow-text); }
  .e1-chip { background: var(--e1-soft); color: var(--e1-icon); }
  .e1-arrow { color: var(--e1-text); }
  .ve-card[class*='e1-']:hover { border-color: color-mix(in srgb, var(--e1) 55%, transparent); }

  /* ---------- Ε2: ναυαρχίδα ολόπλατη ---------- */
  .e2-grid { display: grid; gap: 18px; grid-template-columns: repeat(4, 1fr); }
  .e2-hero {
    grid-column: 1 / -1;
    display: flex; align-items: center; gap: clamp(20px, 4vw, 48px);
    background:
      radial-gradient(120% 160% at 12% -20%, rgba(var(--cta-rgb), .2), transparent 55%),
      radial-gradient(100% 140% at 100% 120%, rgba(var(--orange-rgb), .1), transparent 55%),
