---
// ΠΡΟΣΩΡΙΝΗ σελίδα δοκιμών — ΜΟΝΟ dev, δεν μπαίνει στο build.
// Οκτώ εφέ ΜΕ ΤΟ ΠΟΝΤΙΚΙ (hover) για το μεγάλο «PISMA.» της αρχικής.
import '../styles/fonts.css';
const fx = [
  { id: 'magnet', t: 'Μαγνήτης', d: 'Τα γράμματα «τραβιούνται» ελαφρά προς το ποντίκι και επιστρέφουν ελαστικά όταν φύγει.' },
  { id: 'spot', t: 'Προβολέας', d: 'Ένα φως ακολουθεί το ποντίκι μέσα στα γράμματα — φωτίζονται μόνο εκεί που περνάει.' },
  { id: 'tilt', t: 'Κλίση 3D', d: 'Όλη η λέξη γέρνει σε τρεις διαστάσεις προς το ποντίκι, με σκιά.' },
  { id: 'lift', t: 'Γράμμα που σηκώνεται', d: 'Το γράμμα κάτω από το ποντίκι ανεβαίνει, μεγαλώνει και λάμπει· τα διπλανά λίγο.' },
  { id: 'ripple', t: 'Κύμα φωτός', d: 'Από το γράμμα που αγγίζετε, ένα κύμα φωτός απλώνεται στα υπόλοιπα.' },
  { id: 'fill', t: 'Γεμίζει με φως', d: 'Όσο μένει το ποντίκι πάνω, τα γράμματα γεμίζουν φως από κάτω προς τα πάνω, σαν υγρό.' },
  { id: 'focus', t: 'Εστίαση', d: 'Το γράμμα κάτω από το ποντίκι γίνεται καθαρό και φωτεινό, τα υπόλοιπα θολώνουν ελαφρά.' },
  { id: 'scatter', t: 'Σκόρπισμα', d: 'Με το ποντίκι πάνω τα γράμματα σκορπίζουν λίγο και «τρέμουν»· φεύγει, και ξαναμαζεύονται.' },
];
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Δοκιμές — 8 εφέ hover για το PISMA</title>
  </head>
  <body>
    <nav class="pick" aria-label="Επιλογή">{fx.map((f, i) => <a href={`#fx-${f.id}`}><b>{i + 1}</b>{f.t}</a>)}</nav>
    <header class="intro">
      <p class="intro-k">Δοκιμές · hover στο PISMA</p>
      <h1>Οκτώ εφέ με το ποντίκι</h1>
      <p>Περάστε το ποντίκι πάνω από το «PISMA.» σε κάθε μπλοκ. Πείτε μου νούμερο (συνδυάζονται και με τα εφέ 2+3 που ήδη έχει).</p>
    </header>

    {fx.map((f, i) => (
      <section class={`hero fx-${f.id}`} id={`fx-${f.id}`}>
        <div class="fog fog-1"></div><div class="fog fog-2"></div><div class="fog fog-3"></div>
        <div class="lab"><b>{i + 1} — {f.t}</b> {f.d}</div>
        <div class="inner">
          <p class="k">Ψηφιακή παρουσία &amp; αυτοματοποίηση</p>
          <h2>Η επιχείρησή σας, ορατή στους πελάτες.</h2>
          <div class="word" data-fx={f.id} aria-hidden="true"><span>P</span><span>I</span><span>S</span><span>M</span><span>A</span><span>.</span></div>
          <div class="btns"><a class="btn" href="#">Μετρήστε την επιχείρησή σας — 2 λεπτά</a><a class="ghostbtn" href="#">Κλείστε τον δωρεάν Έλεγχο</a></div>
          <ul class="stats"><li><b>από 220 €</b><span>ιστοσελίδα</span></li><li><b>72 ώρες</b><span>πρώτο preview</span></li><li><b>48 ώρες</b><span>γραπτή πρόταση</span></li><li><b>100%</b><span>δημόσιες τιμές</span></li></ul>
        </div>
      </section>
    ))}

    <footer class="outro"><p>Πείτε μου νούμερο και το περνάω στην αρχική EL + EN.</p></footer>

    <script is:inline>
      (function () {
        var words = document.querySelectorAll('.word');
        words.forEach(function (w) {
          var fx = w.dataset.fx, spans = Array.prototype.slice.call(w.querySelectorAll('span'));
          // 1 μαγνήτης
          if (fx === 'magnet') {
            w.addEventListener('mousemove', function (e) {
              spans.forEach(function (s) { var r = s.getBoundingClientRect(); var cx = r.left + r.width / 2, cy = r.top + r.height / 2; var dx = e.clientX - cx, dy = e.clientY - cy; var d = Math.hypot(dx, dy); var f = Math.max(0, 1 - d / 420); s.style.transform = 'translate(' + (dx * .18 * f) + 'px,' + (dy * .18 * f) + 'px) scale(' + (1 + .08 * f) + ')'; s.style.color = 'rgba(255,255,255,' + (.17 + .35 * f) + ')'; });
            });
            w.addEventListener('mouseleave', function () { spans.forEach(function (s) { s.style.transform = ''; s.style.color = ''; }); });
          }
          // 2 προβολέας
          if (fx === 'spot') {
            w.addEventListener('mousemove', function (e) { var r = w.getBoundingClientRect(); w.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%'); w.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%'); w.classList.add('on'); });
            w.addEventListener('mouseleave', function () { w.classList.remove('on'); });
          }
          // 3 κλίση
          if (fx === 'tilt') {
            w.addEventListener('mousemove', function (e) { var r = w.getBoundingClientRect(); var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5; w.style.transform = 'perspective(900px) rotateX(' + (-y * 16) + 'deg) rotateY(' + (x * 20) + 'deg)'; });
            w.addEventListener('mouseleave', function () { w.style.transform = ''; });
          }
          // 5 κύμα φωτός
          if (fx === 'ripple') {
            spans.forEach(function (s, i) { s.addEventListener('mouseenter', function () { spans.forEach(function (o, j) { o.style.transitionDelay = (Math.abs(i - j) * 70) + 'ms'; o.classList.add('lit'); }); }); });
            w.addEventListener('mouseleave', function () { spans.forEach(function (o, j) { o.style.transitionDelay = (j * 40) + 'ms'; o.classList.remove('lit'); }); });
          }
          // 8 σκόρπισμα
          if (fx === 'scatter') {
            var timer = null;
            var jitter = function () { spans.forEach(function (s) { s.style.transform = 'translate(' + ((Math.random() - .5) * 26) + 'px,' + ((Math.random() - .5) * 26) + 'px) rotate(' + ((Math.random() - .5) * 8) + 'deg)'; }); };
            w.addEventListener('mouseenter', function () { jitter(); timer = setInterval(jitter, 420); w.classList.add('on'); });
            w.addEventListener('mouseleave', function () { clearInterval(timer); spans.forEach(function (s) { s.style.transform = ''; }); w.classList.remove('on'); });
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', system-ui, sans-serif; background: #0B0B0B; color: #fff; -webkit-font-smoothing: antialiased; }
  h1, h2, p, ul { margin: 0; }
  .pick { position: fixed; top: 14px; right: 14px; z-index: 100; display: flex; gap: 3px; flex-wrap: wrap; max-width: 720px; justify-content: flex-end; background: rgba(20,20,20,.85); backdrop-filter: blur(10px); padding: 6px; border-radius: 18px; border: 1px solid rgba(255,255,255,.15); }
  .pick a { display: inline-flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 999px; color: #fff; text-decoration: none; font-size: .72rem; font-weight: 600; }
  .pick a b { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #fff; color: #111; font-size: .66rem; }
  .intro { padding: 72px clamp(20px, 3vw, 44px) 40px; max-width: 900px; }
  .intro-k { color: #FF9A73; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; font-size: .76rem; }
  .intro h1 { font-size: clamp(1.8rem, 4vw, 3rem); margin: 10px 0 14px; line-height: 1.1; font-weight: 800; letter-spacing: -.02em; }
  .intro p { color: #bbb; font-size: 1.05rem; line-height: 1.6; }
  .outro { padding: 60px clamp(20px, 3vw, 44px) 120px; color: #bbb; }
  .lab { position: relative; z-index: 2; margin: 16px auto 0; padding: 10px 14px; border-radius: 12px; background: rgba(255,122,80,.14); border: 1px solid rgba(255,122,80,.35); font-size: .92rem; color: #eee; width: fit-content; max-width: 90%; }
  .lab b { color: #FFA284; }

  .hero { position: relative; overflow: hidden; min-height: 760px; display: flex; flex-direction: column; padding: 0 clamp(20px, 4vw, 40px) 56px; margin-top: 24px; border-top: 1px solid rgba(255,255,255,.08); background: #0B0B0B; }
  .fog { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; animation: drift 20s ease-in-out infinite alternate; }
  .fog-1 { width: 70vw; height: 40vw; left: -10vw; top: 14%; background: radial-gradient(closest-side, rgba(255,255,255,.16), transparent); }
  .fog-2 { width: 60vw; height: 36vw; right: -12vw; top: 26%; background: radial-gradient(closest-side, rgba(255,255,255,.12), transparent); animation-delay: -7s; animation-duration: 24s; }
  .fog-3 { width: 90vw; height: 30vw; left: 5vw; bottom: -6vw; background: radial-gradient(closest-side, rgba(255,255,255,.2), transparent); animation-delay: -12s; animation-duration: 28s; }
  @keyframes drift { to { transform: translate(6vw, -3vw) scale(1.12); } }
  .inner { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; max-width: 1120px; margin: 0 auto; width: 100%; }
  .k { font-size: .76rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #FFA284; margin-bottom: 18px; }
  .hero h2 { font-size: clamp(2rem, 3.6vw, 3.4rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 800; text-shadow: 0 10px 60px rgba(0,0,0,.6); white-space: nowrap; }
  .word { position: relative; display: block; margin: clamp(4px, 1.5vw, 16px) auto clamp(10px, 2.5vw, 26px); font-family: 'Unbounded', 'Inter', sans-serif; font-weight: 800; font-size: clamp(4.6rem, 16vw, 15rem); line-height: .95; letter-spacing: .01em; white-space: nowrap; user-select: none; color: rgba(255,255,255,.17); text-shadow: 0 0 80px rgba(255,255,255,.22); cursor: default; }
  .word span { display: inline-block; transition: transform .45s cubic-bezier(.22,1,.36,1), color .35s ease, filter .35s ease, text-shadow .35s ease; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }
  .btn { background: linear-gradient(92deg, #CC431C, #AC3213); color: #fff; padding: 15px 24px; border-radius: 12px; font-weight: 700; text-decoration: none; box-shadow: 0 6px 24px rgba(238,79,39,.35); }
  .ghostbtn { padding: 15px 22px; border-radius: 12px; font-weight: 700; color: #fff; text-decoration: none; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.18); }
  .stats { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 34px; margin: 26px 0 0; }
  .stats li { display: grid; gap: 2px; } .stats b { font-family: 'Unbounded', 'Inter', sans-serif; font-weight: 800; font-size: 1.18rem; } .stats span { font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #9C9C9C; }

  /* 1 μαγνήτης: μόνο JS + transition */
  .fx-magnet .word span { transition: transform .25s ease-out, color .25s ease-out; }
  /* 2 προβολέας */
  .fx-spot .word { color: rgba(255,255,255,.14); }
  .fx-spot .word.on { color: transparent; background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.95), rgba(255,255,255,.35) 40%, rgba(255,255,255,.14) 70%); -webkit-background-clip: text; background-clip: text; text-shadow: none; }
  /* 3 κλίση */
  .fx-tilt .word { transition: transform .18s ease-out; transform-style: preserve-3d; text-shadow: 0 30px 60px rgba(0,0,0,.6), 0 0 80px rgba(255,255,255,.2); }
  /* 4 σηκώνεται */
  .fx-lift .word span:hover { transform: translateY(-.08em) scale(1.08); color: rgba(255,255,255,.7); text-shadow: 0 0 60px rgba(255,255,255,.6); }
  .fx-lift .word span:has(+ span:hover), .fx-lift .word span:hover + span { transform: translateY(-.03em); color: rgba(255,255,255,.35); }
  /* 5 κύμα */
  .fx-ripple .word span.lit { color: rgba(255,255,255,.7); text-shadow: 0 0 60px rgba(255,255,255,.6); transform: translateY(-.04em); }
  /* 6 γεμίζει */
  .fx-fill .word { color: transparent; background: linear-gradient(0deg, rgba(255,255,255,.75) 0%, rgba(255,255,255,.75) 50%, rgba(255,255,255,.17) 50%, rgba(255,255,255,.17) 100%); background-size: 100% 200%; background-position: 0 0; -webkit-background-clip: text; background-clip: text; transition: background-position 1.4s cubic-bezier(.22,1,.36,1); }
  .fx-fill .word:hover { background-position: 0 100%; }
  /* 7 εστίαση */
  .fx-focus .word:hover span { filter: blur(3px); color: rgba(255,255,255,.12); }
  .fx-focus .word span:hover { filter: blur(0); color: rgba(255,255,255,.8); text-shadow: 0 0 60px rgba(255,255,255,.6); transform: scale(1.04); }
  /* 8 σκόρπισμα */
  .fx-scatter .word span { transition: transform .4s cubic-bezier(.22,1,.36,1); }
  .fx-scatter .word.on span { color: rgba(255,255,255,.3); }

  @media (max-width: 860px) { .pick { top: auto; bottom: 12px; left: 12px; right: 12px; max-width: none; justify-content: center; } .hero h2 { white-space: normal; font-size: clamp(1.7rem, 8.2vw, 2.3rem); } }
</style>
