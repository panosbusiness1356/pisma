<script is:inline>
  // nav: γυαλί μετά το πρώτο scroll
  const nav = document.getElementById('nav');
  addEventListener('scroll', () => nav.classList.toggle('on', scrollY > 40), { passive: true });

  // marquee: διπλασιασμός περιεχομένου για αδιάκοπο loop
  const marq = document.getElementById('marq');
  marq.innerHTML += marq.innerHTML;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // reveals + «άναμμα» βημάτων
  const io = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) {
      e.target.classList.add('in');
      if (e.target.classList.contains('stepx')) {
        const i = [...document.querySelectorAll('.stepx')].indexOf(e.target);
        setTimeout(() => e.target.classList.add('lit'), 350 + i * 420);
      }
      io.unobserve(e.target);
    }
  }, { threshold: .2 });
  document.querySelectorAll('.rv, .stepx').forEach((el) => io.observe(el));

  // αριθμοί που μετράνε
  const fmt = (el, v) => { el.textContent = (el.dataset.pre || '') + v; };
  const nio = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) {
      const el = e.target, target = +el.dataset.n, t0 = performance.now();
      if (reduced) { fmt(el, target); nio.unobserve(el); continue; }
      const tick = (t) => {
        const p = Math.min(1, (t - t0) / 1100);
        fmt(el, Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      nio.unobserve(el);
    }
  }, { threshold: .6 });
  document.querySelectorAll('.num').forEach((el) => nio.observe(el));

  // parallax στο φωτογραφικό διάλειμμα
  const pimg = document.getElementById('parallaxImg');
  if (pimg && !reduced) {
    const loop = () => {
      const r = pimg.parentElement.getBoundingClientRect();
      if (r.bottom > 0 && r.top < innerHeight) {
        const p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
        pimg.style.transform = `translateY(${(-p * 46).toFixed(1)}px)`;
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>
</body>
