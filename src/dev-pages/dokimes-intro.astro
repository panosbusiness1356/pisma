<style is:global>
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body { margin: 0; font-family: 'Inter', system-ui, sans-serif; background: #0B0B0B; color: #fff; -webkit-font-smoothing: antialiased; overflow-x: clip; }
  h1, h2, p, ul { margin: 0; }
  a { color: inherit; text-decoration: none; }
  .uf, .iword, .logo, .hero-word, .stats b, .count, .w2 { font-family: 'Unbounded', 'Inter', sans-serif; font-weight: 800; }

  /* ---------- Hero mock (ίδια διάταξη με το live) ---------- */
  .hero { position: relative; overflow: hidden; min-height: 100svh; display: flex; flex-direction: column; padding-bottom: 56px; }
  .stg { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .stg-fog { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .35; }
  .stg-fog--1 { width: 70vw; height: 40vw; left: -10vw; top: 14%; background: radial-gradient(closest-side, rgba(255,255,255,.17), transparent); }
  .stg-fog--2 { width: 60vw; height: 36vw; right: -12vw; top: 26%; background: radial-gradient(closest-side, rgba(255,255,255,.13), transparent); }
  .stg-fog--3 { width: 90vw; height: 30vw; left: 5vw; bottom: -6vw; background: radial-gradient(closest-side, rgba(255,255,255,.2), transparent); }
  .stg-smoke { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: .95; }
  .veiled .stg-smoke { display: none; }
  .stg-floor { position: absolute; left: 0; right: 0; bottom: 0; height: 30%; background: linear-gradient(180deg, transparent, rgba(255,255,255,.08) 60%, rgba(255,255,255,.13)); }
  .stg::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 140px; background: linear-gradient(transparent, #0B0B0B); }
  .nav, .inner { position: relative; z-index: 1; max-width: 1160px; margin-inline: auto; width: 100%; padding-inline: clamp(20px, 4vw, 36px); }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; margin-top: 8px; }
  .logo { font-size: 1.25rem; } .logo i, .hero-word i { color: #FF7A50; font-style: normal; }
  .links { display: flex; gap: 22px; font-size: .92rem; } .links a { color: #E4E4E4; }
  .cta { background: linear-gradient(92deg, #CC431C, #AC3213); color: #fff; padding: 10px 18px; border-radius: 12px; font-weight: 700; font-size: .9rem; }
  .inner { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding-top: 24px; }
  .k { font-size: .76rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #FFA284; margin-bottom: 20px; }
  .hero h1 { font-size: clamp(2rem, 3.6vw, 3.4rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 800; text-shadow: 0 10px 60px rgba(0,0,0,.6); white-space: nowrap; }
  .hl { border-bottom: 6px solid #EE4F27; }
  .hero-word { margin: clamp(4px, 1.5vw, 16px) auto clamp(10px, 2.5vw, 26px); font-size: clamp(4.6rem, 16vw, 15rem); line-height: .95; letter-spacing: .01em; white-space: nowrap; user-select: none; color: rgba(255,255,255,.17); text-shadow: 0 0 80px rgba(255,255,255,.22); }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn { background: linear-gradient(92deg, #CC431C, #AC3213); color: #fff; padding: 15px 24px; border-radius: 12px; font-weight: 700; box-shadow: 0 6px 24px rgba(238,79,39,.35); }
  .ghostbtn { padding: 15px 22px; border-radius: 12px; font-weight: 700; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.18); }
  .note { margin-top: 14px; font-size: .82rem; color: #9C9C9C; }
  .stats { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 34px; margin: 30px 0 0; }
  .stats li { display: grid; gap: 2px; } .stats b { font-size: 1.18rem; } .stats span { font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #9C9C9C; }
  .sub { margin: 30px auto 0; font-size: 1.1rem; color: #9C9C9C; max-width: 62ch; line-height: 1.6; }
  /* blur-in του hero — ξεκινά μόνο όταν το hero πάρει .is-in (λίγο πριν φύγει το πέπλο) */
  .bi { opacity: 0; }
