  @keyframes biIn { from { opacity: 0; filter: blur(12px); transform: translateY(14px); } to { opacity: 1; filter: blur(0); transform: none; } }

  .shot .panel, .shot .pick { display: none; }
  /* ---------- Πάνελ δοκιμής ---------- */
  .panel { position: fixed; top: 14px; left: 14px; z-index: 200; width: min(360px, calc(100vw - 28px)); background: rgba(16,16,16,.86); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.14); border-radius: 16px; padding: 14px 16px; font-size: .86rem; }
