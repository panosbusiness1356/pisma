  .panel-row { display: flex; gap: 12px; align-items: center; margin-top: 10px; flex-wrap: wrap; }
  .panel button { background: #fff; color: #111; border: 0; border-radius: 999px; padding: 6px 12px; font-weight: 700; cursor: pointer; font: inherit; font-weight: 700; }
  .panel label { display: flex; gap: 6px; align-items: center; color: #ddd; }
  .panel-note { margin-top: 10px; font-size: .74rem; color: #888; }
  .pick { position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 200; display: flex; gap: 4px; flex-wrap: wrap; justify-content: center; max-width: calc(100vw - 28px); background: rgba(16,16,16,.86); backdrop-filter: blur(12px); padding: 6px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); }
  .pick button { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 999px; color: #fff; background: transparent; border: 0; font: inherit; font-size: .76rem; font-weight: 600; cursor: pointer; }
  .pick button b { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: rgba(255,255,255,.18); color: #fff; font-size: .7rem; }
  .pick button.on { background: rgba(255,122,80,.2); } .pick button.on b { background: #FF7A50; color: #111; }
  @media (max-width: 860px) { .pick button span, .pick button { font-size: .7rem; } .links { display: none; } .hero h1 { white-space: normal; max-width: 18ch; font-size: clamp(1.7rem, 8.2vw, 2.3rem); } }

  /* ---------- Intro (πέπλο) ---------- */
  #intro { position: fixed; inset: 0; z-index: 150; cursor: pointer; }
  .intro.dark { background: #0B0B0B; }
  .intro-gl, .intro-2d { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .iword { position: absolute; left: 50%; top: var(--wy, 50%); transform: translate(-50%, -50%); font-size: clamp(4.6rem, 16vw, 15rem); line-height: .95; letter-spacing: .01em; white-space: nowrap; color: #fff; display: inline-flex; text-shadow: 0 0 60px rgba(255,255,255,.35); pointer-events: none; }
  .ltr { display: inline-block; will-change: transform, filter, opacity; }
  .dot { color: #FF7A50; text-shadow: 0 0 40px rgba(255,122,80,.9); }
  .halo { position: absolute; left: 50%; top: 50%; width: 60vmin; height: 60vmin; margin: -30vmin 0 0 -30vmin; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,122,80,.55), rgba(255,122,80,.18) 40%, transparent); filter: blur(20px); pointer-events: none; }
  .halo--big { width: 140vmin; height: 140vmin; margin: -70vmin 0 0 -70vmin; background: radial-gradient(closest-side, rgba(255,122,80,.5), rgba(255,122,80,.12) 45%, transparent); }
  /* 2 */
  .v2 .iword { transform: translate(-50%, -50%); } .v2 .w2 { display: inline-block; }
  /* 3 */
  .beam { position: absolute; top: -12vh; width: 20vw; height: 170vmax; transform-origin: top center; filter: blur(18px); opacity: 0; background: linear-gradient(180deg, rgba(255,255,255,.95), rgba(255,255,255,.45) 45%, transparent 85%); }
  .beam-l { left: 2vw; } .beam-r { right: 2vw; }
  .flood { position: absolute; left: 50%; top: 50%; width: 120vmax; height: 120vmax; margin: -60vmax 0 0 -60vmax; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,235,220,.85), rgba(255,160,120,.35) 40%, transparent); transform: scale(0); }
  /* 5 */
  .count { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: grid; grid-template-columns: auto auto; align-items: baseline; justify-content: center; color: #fff; }
  .count b { font-size: clamp(6rem, 22vw, 18rem); line-height: 1; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .count i { font-style: normal; font-size: clamp(2rem, 7vw, 6rem); margin-left: .1em; }
  .count span { grid-column: 1 / -1; text-align: center; font-family: 'Inter', sans-serif; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; font-size: .8rem; color: #9C9C9C; margin-top: 10px; }
  .count .bar { grid-column: 1 / -1; height: 3px; margin-top: 18px; background: linear-gradient(90deg, #FF8A3D, #D63E1B); transform-origin: left; transform: scaleX(0); border-radius: 2px; box-shadow: 0 0 24px rgba(255,122,80,.7); }
  /* 7 */
  .engr { width: min(92vw, 1100px); height: auto; overflow: visible; }
  .engr text { font-family: 'Unbounded', 'Inter', sans-serif; font-weight: 800; font-size: 200px; letter-spacing: 2px; fill: rgba(255,255,255,0); stroke: #fff; stroke-width: 2.2; stroke-dasharray: 1800; stroke-dashoffset: 1800; paint-order: stroke; }
  .engr .d { stroke: #FF7A50; }
  /* 8 */
  .v8 { background: #0B0B0B; }
  .v8 .iword { transform-origin: center; }
  /* 9 */
  .half { position: absolute; left: 0; right: 0; height: 50%; background: #0B0B0B; }
  .half-t { top: 0; box-shadow: 0 6px 40px rgba(0,0,0,.8); } .half-b { bottom: 0; box-shadow: 0 -6px 40px rgba(0,0,0,.8); }
  .line { position: absolute; left: 6vw; right: 6vw; top: 50%; height: 2px; margin-top: -1px; background: #FFB08C; border-radius: 2px; box-shadow: 0 0 30px 4px rgba(255,122,80,.9); transform: scaleX(0); }
  .puff { position: absolute; left: 0; right: 0; top: 50%; height: 26vh; margin-top: -13vh; background: radial-gradient(ellipse at 30% 50%, rgba(255,255,255,.35), transparent 60%), radial-gradient(ellipse at 70% 50%, rgba(255,255,255,.3), transparent 60%); filter: blur(30px); opacity: 0; }
</style>
