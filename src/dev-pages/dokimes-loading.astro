---
// ΠΡΟΣΩΡΙΝΗ σελίδα δοκιμών — ΜΟΝΟ dev, δεν μπαίνει στο build.
// Δέκα εκδοχές «loading» ΠΡΙΝ από το intro της αρχικής (το intro μένει όπως είναι).
// Κάθε σύνδεσμος ανοίγει την πραγματική αρχική με ?loader=N&fresh=1 (ξαναπαίζει το intro κάθε φορά).
// Όλες: μόνο compositor ιδιότητες (transform/opacity), πραγματική πρόοδος (γραμματοσειρές, καπνός, layout),
// 0,5–1,2 s, κλικ = παράλειψη. Η επιλογή γίνεται προεπιλογή (LOADER_DEFAULT στο Intro.astro).
import '../styles/fonts.css';
const variants = [
  { n: 1, t: 'Τελεία + γραμμή', d: 'Η τελεία του logo αναπνέει στη θέση της· από κάτω λεπτή πορτοκαλί γραμμή που μεγαλώνει με την πραγματική πρόοδο. Στο τέλος η τελεία ανάβει και γεννά τον καπνό.' },
  { n: 2, t: 'Τελεία μόνη', d: 'Μόνο η τελεία-κάρβουνο που αναπνέει στο μαύρο. Το πιο μινιμάλ.' },
  { n: 3, t: 'Αύρα + τελεία', d: 'Απαλό πορτοκαλί φως αναπνέει στο κέντρο της λέξης και δυναμώνει καθώς φορτώνει· η τελεία από πάνω. Ο καπνός «ξυπνά» μέσα στο φως.' },
  { n: 4, t: 'Κάρβουνα', d: 'Σπίθες ανεβαίνουν αργά από τη βάση της λέξης, το «πριν τη φωτιά». Η τελεία αναπνέει, στο τέλος ανάβει.' },
  { n: 5, t: 'Μετρητής 0 → 100 %', d: 'Αριθμός στη γραμματοσειρά του logo, στη θέση της λέξης, με πραγματική πρόοδο. Στο 100 % εμφανίζεται η τελεία και ανάβει.' },
  { n: 6, t: 'Η φράση', d: '«Με πείσμα.» ξεθωριάζει μέσα κάτω από τη θέση της λέξης, η τελεία αναπνέει από πάνω. Λέει κάτι αντί να δείχνει loader.' },
  { n: 7, t: 'Δακτύλιος', d: 'Λεπτός πορτοκαλί δακτύλιος γύρω από την τελεία «γράφεται» με την πρόοδο και στο τέλος συρρικνώνεται μέσα της.' },
  { n: 8, t: 'Ορίζοντας', d: 'Μια λωρίδα φωτός σκηνής, σε όλο το πλάτος, στο ύψος της λέξης — δυναμώνει καθώς φορτώνει. Η τελεία μέσα στο φως.' },
  { n: 9, t: 'Σπίθα', d: 'Μια σπίθα τρέχει πέρα-δώθε πάνω σε αχνή γραμμή· όταν όλα είναι έτοιμα σταματά και γίνεται η τελεία που ανάβει.' },
  { n: 10, t: 'Αύρα + τελεία + γραμμή', d: 'Ο συνδυασμός 1 + 3: το φως στο κέντρο, η τελεία που αναπνέει, η γραμμή προόδου.' },
];
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Δοκιμές — 10 εκδοχές loading</title>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body { background: #0B0B0B; color: #E4E4E4; font-family: 'Inter', system-ui, sans-serif; padding: 28px 18px 60px; line-height: 1.5; }
      h1 { font-family: 'Unbounded', 'Inter', sans-serif; font-weight: 800; font-size: 1.4rem; color: #fff; margin-bottom: 6px; }
      h1 span { color: #FF7A50; }
      .lead { color: #9C9C9C; font-size: .95rem; max-width: 60ch; margin-bottom: 22px; }
      ol { list-style: none; padding: 0; display: grid; gap: 10px; max-width: 720px; }
      a.v { display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: start; text-decoration: none; color: inherit; background: #151515; border: 1px solid rgba(255,255,255,.1); border-radius: 14px; padding: 14px 16px; }
      a.v:active { background: #1B1B1B; }
      .n { font-family: 'Unbounded', sans-serif; font-weight: 800; font-size: 1.3rem; color: #FF7A50; line-height: 1.1; }
      .t { font-weight: 700; color: #fff; }
      .d { color: #9C9C9C; font-size: .9rem; margin-top: 2px; }
      .note { color: #9C9C9C; font-size: .85rem; margin-top: 22px; max-width: 60ch; }
    </style>
  </head>
  <body>
    <h1>PISMA<span>.</span> — εκδοχές loading</h1>
    <p class="lead">Δέκα loading πριν από το intro. Το intro μετά είναι ακριβώς το ίδιο σε όλες. Πάτα έναν αριθμό, δες το, και γύρνα με το κουμπί «↩ Εκδοχές loading» κάτω αριστερά.</p>
    <ol>
      {variants.map((v) => (
        <li><a class="v" href={`/?loader=${v.n}&fresh=1`}><span class="n">{v.n}</span><span><span class="t">{v.t}</span><br /><span class="d">{v.d}</span></span></a></li>
      ))}
    </ol>
    <p class="note">Όλες κρατούν 0,5–1,2 s (όσο χρειάζεται να είναι έτοιμα γραμματοσειρές, καπνός, layout) και τρέχουν αποκλειστικά στην κάρτα γραφικών. Κλικ οπουδήποτε στο μαύρο = παράλειψη.</p>
  </body>
</html>
