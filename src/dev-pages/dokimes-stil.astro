      (function(){var s=document.getElementById('d-spot'),sec=document.getElementById('st-d');if(!s||!sec)return;
        sec.addEventListener('mousemove',function(e){var r=sec.getBoundingClientRect();s.style.setProperty('--x',(e.clientX-r.left)+'px');s.style.setProperty('--y',(e.clientY-r.top)+'px');});})();
      // Ε: μετρητής κριτικών 4,2 → 4,8 όταν φανεί
      (function(){var el=document.getElementById('e-count');if(!el)return;var done=false;
        var io=new IntersectionObserver(function(es){if(!es[0].isIntersecting||done)return;done=true;var t0=performance.now();
          (function tick(now){var t=Math.min(1,(now-t0)/1800);var v=4.2+0.6*(1-Math.pow(1-t,3));el.textContent=v.toFixed(1).replace('.',',');if(t<1)requestAnimationFrame(tick);})(t0);},{threshold:.4});
        io.observe(el);})();
      // Θ: ο τίτλος «πληκτρολογείται» όταν φανεί
      (function(){var el=document.getElementById('h-type');if(!el)return;var txt='Η επιχείρησή σας, ορατή στους πελάτες.\nΗ λειτουργία της, χωρίς χαμένες ώρες.';var done=false;
        new IntersectionObserver(function(es){if(!es[0].isIntersecting||done)return;done=true;var i=0;(function step(){el.textContent=txt.slice(0,i);i++;if(i<=txt.length)setTimeout(step,txt[i-2]==='\n'?400:38);})();},{threshold:.3}).observe(el);})();
