---
// ΠΡΟΣΩΡΙΝΗ σελίδα δοκιμών — ΜΟΝΟ dev, δεν μπαίνει στο build.
// Έξι εντελώς διαφορετικές αισθητικές για ΟΛΟ το site (διάταξη, τυπογραφία,
// κίνηση, ύφος) — κάθε μία ως μία «οθόνη»: μενού + hero + ενότητα υπηρεσιών.
// Κείμενα/αριθμοί: όπως στο ζωντανό site (καμία επινόηση).
import '../styles/fonts.css';

const styles = [
  { id: 'a', n: 'Α', t: 'Εφημερίδα', d: 'Editorial: σπασμένο λευκό, ελληνική display γραμματοσειρά, λεπτές γραμμές, αρίθμηση, πολύς αέρας. Ήρεμο, κύρος.' },
  { id: 'b', n: 'Β', t: 'Αφίσα', d: 'Poster/brutalist: κρεμ, μαύρα χοντρά περιγράμματα, τεράστια κεφαλαία, marquee, σφραγίδα. Τολμηρό, αξέχαστο.' },
  { id: 'c', n: 'Γ', t: 'Γυαλί', d: 'Soft SaaS: παστέλ κινούμενο φόντο, θολά γυάλινα κάρτες, στρογγυλεμένα, οι συσκευές σας «αιωρούνται». Μοντέρνο, φιλικό.' },
  { id: 'd', n: 'Δ', t: 'Προβολέας', d: 'Σκούρο κινηματογραφικό: μαύρο, ένας προβολέας που ακολουθεί το ποντίκι, mono ετικέτες, λεπτό πλέγμα. Τεχνολογικό, premium.' },
  { id: 'e', n: 'Ε', t: 'Ταμπλό', d: 'Bento: το hero ΕΙΝΑΙ ένα ταμπλό από πλακίδια — κριτικές που ανεβαίνουν, χάρτης, μήνυμα WhatsApp, αριθμοί. Δείχνει το αποτέλεσμα, όχι λόγια.' },
  { id: 'f', n: 'Ζ', t: 'Μεσόγειος', d: 'Ζεστό χαρτί: κρεμ με υφή, τερακότα και ελιά, καμάρα-παράθυρο, χειροποίητη υπογράμμιση. Ανθρώπινο, ελληνικό.' },
  { id: 'g', n: 'Η', t: 'Σκίτσο', d: 'Τετράδιο: μιλιμετρέ χαρτί, «χειροποίητα» πλαίσια που γέρνουν, αυτοκόλλητα post-it, βελάκια-σημειώσεις. Οικείο, ανθρώπινο, με χιούμορ.' },
  { id: 'h', n: 'Θ', t: 'Τερματικό', d: 'Οθόνη υπολογιστή: μαύρο-πράσινο, monospace, ο τίτλος «πληκτρολογείται», πλαίσια ASCII, δρομέας που αναβοσβήνει. Για όσους αγαπούν την τεχνολογία.' },
  { id: 'i', n: 'Ι', t: 'Πολυτέλεια', d: 'Μαύρο και χρυσό: λεπτές γραμμές, κεντραρισμένη διάταξη, αραιά κεφαλαία, απόλυτη ησυχία. Boutique, ακριβό.' },
  { id: 'j', n: 'Κ', t: 'Ρετρό 70s', d: 'Χοντρές λωρίδες χρώματος (μουσταρδί, τερακότα, ελιά, κρεμ), στρογγυλεμένα χοντρά γράμματα, ήλιος με ακτίνες. Ζεστό, χαρούμενο, νοσταλγικό.' },
  { id: 'k', n: 'Λ', t: 'Παιχνίδι', d: 'Καραμέλα: κοραλί, μέντα, λεμονί, τεράστια στρογγυλά σχήματα που χοροπηδούν, παχιά περιγράμματα. Ενέργεια, χαμόγελο.' },
  { id: 'l', n: 'Μ', t: 'Σχέδιο', d: 'Blueprint: μπλε μηχανικού με λευκές γραμμές, διαστάσεις, ετικέτες, τεχνικό σχέδιο των υπηρεσιών. Ακρίβεια, μέθοδος.' },
];
