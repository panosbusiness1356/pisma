---
/**
 * Layout νομικών σελίδων (Πολιτική Απορρήτου, Όροι Χρήσης), EL και EN.
 * Ίδια «Σκηνή» και ίδια πρόζα με τους οδηγούς, χωρίς FAQ/CTA: λιτό κείμενο,
 * ημερομηνία τελευταίας ενημέρωσης και link προς την άλλη νομική σελίδα.
 */
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  /** Πλήρης <title>, π.χ. «Πολιτική Απορρήτου | PISMA» */
  title: string;
  description: string;
  /** Ο τίτλος της σελίδας (h1) */
  heading: string;
  sub?: string;
  /** ISO ημερομηνία τελευταίας ενημέρωσης, π.χ. '2026-09-11' */
  updated: string;
  lang?: 'el' | 'en';
}
const { title, description, heading, sub, updated, lang = 'el' } = Astro.props;

const T = {
  el: { kicker: 'Νομικά', updatedLabel: 'Τελευταία ενημέρωση:', locale: 'el-GR' },
  en: { kicker: 'Legal', updatedLabel: 'Last updated:', locale: 'en-US' },
}[lang];

const updatedHuman = new Date(updated + 'T12:00:00').toLocaleDateString(T.locale, {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Base title={title} description={description}>
  <PageHero kicker={T.kicker} sub={sub}>{heading}</PageHero>

  <article class="section--tight">
    <div class="container container--narrow legal-prose">
      <slot />
      <p class="legal-meta">
        {T.updatedLabel} <time datetime={updated}>{updatedHuman}</time>
      </p>
    </div>
  </article>
</Base>

<style>
  /* Ίδια πρόζα με το Guide.astro, τα στοιχεία έρχονται από slot, άρα :global */
  .legal-prose { max-width: 760px; }
  .legal-prose :global(h2) {
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    margin: clamp(34px, 5vw, 52px) 0 14px;
  }
  .legal-prose :global(h3) { margin: 26px 0 10px; }
  .legal-prose :global(p) { margin: 0 0 16px; color: var(--ink); }
  .legal-prose :global(ul), .legal-prose :global(ol) { margin: 0 0 16px; padding-left: 24px; }
  .legal-prose :global(li) { margin-bottom: 8px; }
  .legal-prose :global(li::marker) { color: var(--orange); font-weight: 700; }
  .legal-prose :global(strong) { color: var(--navy); }
  .legal-prose :global(a) { color: var(--orange-text); text-underline-offset: 3px; }
  .legal-prose :global(table) {
    width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: .95rem;
  }
  .legal-prose :global(th), .legal-prose :global(td) {
    text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line);
  }
  .legal-prose :global(th) { color: var(--navy); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
  .legal-prose :global(td) { color: var(--ink); }

  .legal-meta {
    margin-top: clamp(30px, 4vw, 44px); padding-top: 18px; border-top: 1px solid var(--line);
    font-size: .88rem; color: var(--muted);
  }
</style>
